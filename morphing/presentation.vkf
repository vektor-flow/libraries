# Geometry adapter for the existing VKF screen-space simplex renderer.
# No coverage image is enlarged: zero crossings produce actual triangles.
b:.biological
s:.state
Curve:(knots:[num],values:[num],second:[num],count:int,width:int,mode:int)
Plan:(curve:Curve,dimension:int,size:int,cells:int,carriers:int,stride:int,smooth_start:bit,smooth_end:bit,join:num)

# Clip each lattice triangle against its linearly interpolated signed field.
# Shared lattice edges have identical crossings; holes remain empty geometry.
triangles(values:[num],size:int,extent:num,color:[num])->[num]:
    @:clip(values,size,extent,color,6)

# Position-only packet for simulation consumers; same topology and vertex order.
positions(values:[num],size:int,extent:num)->[num]:
    @:clip(values,size,extent,[1,1,1,1],2)

clip(values:[num],size:int,extent:num,color:[num],attributes:int)->[num]:
    (attributes=2 \/ attributes=6)?! "invalid presentation attributes"
    (size>=3 /\ values.length()%size=0 /\ values.length()>=2*size /\ extent>0 /\ color.length()=4)?! "invalid presentation lattice"
    height:values.length()//size
    capacity:0
    capacity_y:0
    capacity_y<height-1?>
        capacity_x:0
        capacity_x<size-1?>
            origin:capacity_y*size+capacity_x
            values.(origin)>=0 \/ values.(origin+1)>=0 \/ values.(origin+size)>=0 \/ values.(origin+size+1)>=0? .capacity:capacity+12*attributes
            .capacity_x:capacity_x+1
        .capacity_y:capacity_y+1
    [num] storage:[0:capacity]
    count:0
    [num] rectangle:[0:12]
    [int] corners:[0:6]
    [num] polygon:[0:8]
    [num] corner_x:[0:6]
    [num] corner_y:[0:6]
    y:0
    y<height-1?>
        x:0
        x<size-1?>
            corner:y*size+x
            v00:values.(corner)
            v10:values.(corner+1)
            v01:values.(corner+size)
            v11:values.(corner+size+1)
            empty:v00<0 /\ v10<0 /\ v01<0 /\ v11<0
            empty? .empty:|v00|<10^100 /\ |v10|<10^100 /\ |v01|<10^100 /\ |v11|<10^100
            empty? .x:x+1
            ~empty?
                stop:x
                filling:true
                stop<size-1 /\ filling?>
                    at:y*size+stop
                    values.(at)>=0 /\ values.(at+1)>=0 /\ values.(at+size)>=0 /\ values.(at+size+1)>=0? .stop:stop+1
                    ~(values.(at)>=0 /\ values.(at+1)>=0 /\ values.(at+size)>=0 /\ values.(at+size+1)>=0)? .filling:false
                full:stop>x
                full?
                    rectangle.(0):num(x)
                    rectangle.(1):num(y)
                    rectangle.(2):num(stop)
                    rectangle.(3):num(y)
                    rectangle.(4):num(stop)
                    rectangle.(5):num(y+1)
                    rectangle.(6):num(x)
                    rectangle.(7):num(y)
                    rectangle.(8):num(stop)
                    rectangle.(9):num(y+1)
                    rectangle.(10):num(x)
                    rectangle.(11):num(y+1)
                    vertex:0
                    vertex<6?>
                        storage.(count):rectangle.(2*vertex)*extent/(size-1)
                        storage.(count+1):rectangle.(2*vertex+1)*extent/(size-1)
                        channel:0
                        attributes=6 /\ channel<4?>
                            storage.(count+2+channel):color.(channel)
                            .channel:channel+1
                        .count:count+attributes
                        .vertex:vertex+1
                    .x:stop
                ~full?
                    corners.(0):y*size+x
                    corners.(1):y*size+x+1
                    corners.(2):(y+1)*size+x+1
                    corners.(3):y*size+x
                    corners.(4):(y+1)*size+x+1
                    corners.(5):(y+1)*size+x
                    corner_x.(0):num(x)
                    corner_x.(1):num(x+1)
                    corner_x.(2):num(x+1)
                    corner_x.(3):num(x)
                    corner_x.(4):num(x+1)
                    corner_x.(5):num(x)
                    corner_y.(0):num(y)
                    corner_y.(1):num(y)
                    corner_y.(2):num(y+1)
                    corner_y.(3):num(y)
                    corner_y.(4):num(y+1)
                    corner_y.(5):num(y+1)
                    half:0
                    half<2?>
                        n:0
                        edge:0
                        edge<3?>
                            ia:half*3+edge
                            ic:half*3+(edge+1)%3
                            a:corners.(ia)
                            c:corners.(ic)
                            va:values.(a)
                            vc:values.(c)
                            (|va|<10^100 /\ |vc|<10^100)?! "nonfinite presentation field"
                            va>=0?
                                polygon.(2*n):corner_x.(ia)*extent/(size-1)
                                polygon.(2*n+1):corner_y.(ia)*extent/(size-1)
                                .n:n+1
                            (va<0 /\ vc>0) \/ (va>0 /\ vc<0)?
                                t:va/(va-vc)
                                polygon.(2*n):(corner_x.(ia)+t*(corner_x.(ic)-corner_x.(ia)))*extent/(size-1)
                                polygon.(2*n+1):(corner_y.(ia)+t*(corner_y.(ic)-corner_y.(ia)))*extent/(size-1)
                                .n:n+1
                            .edge:edge+1
                        fan:1
                        fan<n-1?>
                            vertex:0
                            vertex<3?>
                                at:0
                                vertex=1? .at:fan
                                vertex=2? .at:fan+1
                                storage.(count):polygon.(2*at)
                                storage.(count+1):polygon.(2*at+1)
                                channel:0
                                attributes=6 /\ channel<4?>
                                    storage.(count+2+channel):color.(channel)
                                    .channel:channel+1
                                .count:count+attributes
                                .vertex:vertex+1
                            .fan:fan+1
                        .half:half+1
                    .x:x+1
        .y:y+1
    [num] packed:[0:count]
    i:0
    i<count?>
        packed.(i):storage.(i)
        .i:i+1
    @:packed

# The caller supplies the scale already calibrated by sample_geometry. This
# evaluates the same native field on a separate geometry lattice, once only.
Surface:(plan:Plan,values:[num],scale:num,neck:num)
prepare_surface(plan:Plan,coordinate:num,scale:num)->Surface:
    (scale>0)?! "invalid surface scale"
    evaluated:s.evaluate(plan.curve,coordinate,plan.smooth_start,plan.smooth_end)
    mapping:s.clock(plan.curve.knots,coordinate,plan.smooth_start,plan.smooth_end)
    interval:s.interval(plan.curve.knots,mapping.coordinate)
    u:(mapping.coordinate-plan.curve.knots.(interval))/(plan.curve.knots.(interval+1)-plan.curve.knots.(interval))
    neck:plan.join*16*u*u*(1-u)*(1-u)
    # Field lookup consumes only spatial layout. Do not transport the unused
    # complete time curve again with every row of resolved geometry.
    basis:s.prepare([0,1],[0,0],1,0)
    layout:(curve:basis,dimension:plan.dimension,size:plan.size,cells:plan.cells,carriers:plan.carriers,stride:plan.stride,smooth_start:false,smooth_end:false,join:0.0)
    @:(plan:layout,values:evaluated.value,scale:scale,neck:neck)

surface_row(surface:Surface,size:int,row:int,lo:[num],hi:[num],extent:num,color:[num])->[num]:
    (surface.plan.dimension=2 /\ size>=3 /\ row>=0 /\ row<size-1 /\ lo.length()=2 /\ hi.length()=2 /\ hi.(0)>lo.(0) /\ hi.(1)>lo.(1))?! "invalid presentation domain"
    [num] values:[0:2*size]
    i:0
    i<values.length()?>
        x:lo.(0)+num(i%size)*(hi.(0)-lo.(0))/(size-1)
        y:lo.(1)+num(row+i//size)*(hi.(1)-lo.(1))/(size-1)
        value:b.field(surface.plan,surface.values,0,x,y,0,surface.scale)
        k:1
        k<surface.plan.carriers?>
            .value:b.union(value,b.field(surface.plan,surface.values,k,x,y,0,surface.scale),surface.neck)
            .k:k+1
        values.(i):value
        .i:i+1
    packed:triangles(values,size,extent,color)
    j:1
    j<packed.length()?>
        packed.(j):packed.(j)+num(row)*extent/(size-1)
        .j:j+6
    @:packed

surface2d_row(plan:Plan,coordinate:num,scale:num,size:int,row:int,lo:[num],hi:[num],extent:num,color:[num])->[num]:
    @:surface_row(prepare_surface(plan,coordinate,scale),size,row,lo,hi,extent,color)
