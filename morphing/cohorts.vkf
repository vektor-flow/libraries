# Prepared biological example states for the Morphing example library.
# Geometry, carrier correspondence and endpoint fields are entirely VKF.
b:.biological
math:.math
Curve:(knots:[num],values:[num],second:[num],count:int,width:int,mode:int)
Plan:(curve:Curve,dimension:int,size:int,cells:int,carriers:int,stride:int,smooth_start:bit,smooth_end:bit,join:num)

prepare(dimension:int,mode:int,smooth_start:bit,smooth_end:bit,example:int)->Plan:
    (example>=0 /\ example<=4)?! "unknown biological example"
    size:49
    cells:size*size
    dimension=3? .cells:cells*size
    [num] fields:[0:5*cells]
    object:0
    object<5?>
        radius:0.7
        hole:0.25
        amplitude:0.08
        object>=1 /\ object<=3?
            .radius:0.41
            .hole:0.14
            .amplitude:0.05
        object=1? .amplitude:0
        example=1? .amplitude:0
        example=2? .hole: -1
        i:0
        i<cells?>
            x:2*num(i%size)/(size-1)-1
            y:2*num((i//size)%size)/(size-1)-1
            z:0.0
            dimension=3? .z:2*num(i//(size*size))/(size-1)-1
            r:math.sqrt(x*x+y*y+z*z)
            denominator:b.maximum(r^6,0.000000001)
            lobes:(x^6-15*x^4*y*y+15*x*x*y^4-y^6)/denominator
            value:b.minimum(radius+amplitude*lobes-r,r-hole)
            example=3?
                bar:radius*0.26
                .value:b.maximum(b.minimum(radius-|x|,bar-|y|),b.minimum(bar-|x|,radius-|y|))
            example=4?
                square:b.maximum(|x|,|y|)
                .value:b.minimum(radius-square,square-hole)
            fields.(object*cells+i):value
            .i:i+1
        .object:object+1
    [num] centers:[0:5*dimension]
    centers.(dimension): -0.68
    centers.(dimension+1): -0.45
    centers.(2*dimension):0.68
    centers.(2*dimension+1): -0.45
    centers.(3*dimension+1):0.72
    [num] extents:[1:5*dimension]
    @:b.prepare([0,1,2],[0,1,4,5],[0,0,0,0,1,2,0,0,0],3,centers,extents,fields,size,dimension,mode,smooth_start,smooth_end,0.12)

