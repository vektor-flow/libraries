# Six persistent-stroke state embeddings. All coordinates and motion are VKF.
# ABI: example, coordinate[0,2], mode, smooth-start, smooth-end, resolution.
m:.math
s:.segment
state:.state
# Explicit range-reduced polynomial keeps native and real-f32 GPU math aligned.
# Domain of these embeddings is [-3.2,14.2]; approximation error below 0.000001.
sine(angle:num)->num:
    num x:angle
    x>3.141592653589793? .x:x-6.283185307179586
    x>3.141592653589793? .x:x-6.283185307179586
    x< -3.141592653589793? .x:x+6.283185307179586
    z:x*x
    @:x*(1+z*(-1/6+z*(1/120+z*(-1/5040+z*(1/362880+z*(-1/39916800+z/6227020800.0))))))
cosine(angle:num)->num:sine(angle+1.5707963267948966)
blend(a:num,b:num,c:num,q:num,mode:int)->num:
    num middle:0
    mode=1? .middle:1.5*(c-2*b+a)
    q<=1? @:s.value(a,b,0,middle,1,q)
    @:s.value(b,c,middle,0,1,q-1)
segments(example:int,n:int)->int:
    example=1? @:18*n
    example=2? @:2*n
    example=4? @:12+8*n
    example=5? @:32
    @:n
node(index:int,key:int,axis:int)->num:
    angle:6.283185307179586*index/8
    key=0?
        axis=0? @:0.68*cosine(angle)
        @:0.68*sine(angle)
    key=1?
        axis=0? @:-0.66+0.44*(index%4)
        @:-0.35+0.7*(index//4)
    axis=0? @:-0.7+0.2*index
    @:0.6-0.32*(index%3)
point(example:int,line:int,t:num,key:int,axis:int,n:int)->num:
    example=0?
        x:-0.86+1.72*t
        axis=0? @:x
        key=0? @:0.48*sine(6.283185307179586*t)
        key=1? @:1.3*x*x-0.42
        @:0.38*sine(12.566370614359172*t)
    example=1?
        x:-0.8+1.6*t
        y:-0.8+0.2*(line%9)
        line>=9?
            .y:x
            .x:-0.8+0.2*(line%9)
        key=1?
            axis=0? @:x+0.12*sine(4*y)
            @:y+0.12*sine(4*x)
        key=2?
            angle:0.55*(x*x+y*y)
            axis=0? @:x*cosine(angle)-y*sine(angle)
            @:x*sine(angle)+y*cosine(angle)
        axis=0? @:x
        @:y
    example=2?
        angle:key*0.7853981633974483+line*1.5707963267948966
        axis=0? @:(-0.72+1.44*t)*cosine(angle)
        @:(-0.72+1.44*t)*sine(angle)
    example=3?
        angle:6.283185307179586*t
        axis=0? @:0.72*cosine(angle)
        key=1? @:0.44*sine(2*angle)
        key=2? @:0.35*sine(angle)
        @:0.72*sine(angle)
    example=4?
        line<12?
            a:line%8
            b:(line+1)%8
            line>=8? .b:(a+4)%8
            @:(1-t)*node(a,key,axis)+t*node(b,key,axis)
        index:line-12
        angle:6.283185307179586*t
        axis=0? @:node(index,key,axis)+0.055*cosine(angle)
        @:node(index,key,axis)+0.055*sine(angle)
    index:line//4
    edge:line%4
    cx:node(index,key,0)*0.9
    cy:node(index,key,1)*0.9
    x:-0.09
    y:-0.065
    edge=0? .x:-0.09+0.18*t
    edge=1?
        .x:0.09
        .y:-0.065+0.13*t
    edge=2?
        .x:0.09-0.18*t
        .y:0.065
    edge=3? .y:0.065-0.13*t
    axis=0? @:cx+x
    @:cy+y
coordinate(example:int,line:int,t:num,q:num,mode:int,axis:int,n:int)->num:
    @:blend(point(example,line,t,0,axis,n),point(example,line,t,1,axis,n),point(example,line,t,2,axis,n),q,mode)
triangle(index:int,params:[num],values:[num])->[num]:
    (params.length()>=6)?! "diagram input"
    example:int(params.(0))
    n:int(params.(5))
    (example>=0 /\ example<6 /\ n>=8 /\ n<=128)?! "diagram input"
    (index>=0 /\ index<2*segments(example,n))?! "diagram input"
    q:state.coordinate_map(values,params.(1),params.(3)>0,params.(4)>0)
    mode:int(params.(2))
    segment:index//2
    line:0
    t0:num(segment)/n
    t1:num(segment+1)/n
    example=1 \/ example=2?
        .line:segment//n
        .t0:num(segment%n)/n
        .t1:num(segment%n+1)/n
    example=4?
        segment<12?
            .line:segment
            .t0:0
            .t1:1
        segment>=12?
            .line:12+(segment-12)//n
            .t0:num((segment-12)%n)/n
            .t1:num((segment-12)%n+1)/n
    example>=5?
        .line:segment
        .t0:0
        .t1:1
    ax:coordinate(example,line,t0,q,mode,0,n)
    ay:coordinate(example,line,t0,q,mode,1,n)
    bx:coordinate(example,line,t1,q,mode,0,n)
    by:coordinate(example,line,t1,q,mode,1,n)
    dx:bx-ax
    dy:by-ay
    num length:m.sqrt(dx*dx+dy*dy)
    num nx:0
    num ny:0
    length>0.0000001?
        .nx:-dy*0.004/length
        .ny:dx*0.004/length
    [num] result:[0:21]
    vertex:0
    vertex<3?>
        corner:vertex
        index%2=1?
            .corner:vertex+1
            vertex=0? .corner:0
        x:ax+nx
        y:ay+ny
        corner=1?
            .x:ax-nx
            .y:ay-ny
        corner=2?
            .x:bx-nx
            .y:by-ny
        corner=3?
            .x:bx+nx
            .y:by+ny
        result.(vertex*7):x
        result.(vertex*7+1):y
        result.(vertex*7+2):0
        result.(vertex*7+3):0.18+0.09*example
        result.(vertex*7+4):0.85-0.06*example
        result.(vertex*7+5):0.95
        result.(vertex*7+6):1
        .vertex:vertex+1
    @:result
