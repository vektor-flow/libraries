# Canonical material carrier evaluator: state interpolation + prepared random bridge.
segment:.segment
math:.math
clamp(x:num,lo:num,hi:num)->num:
    x<lo? @:lo
    x>hi? @:hi
    @:x

# Independent Uint16 entropy increments are supplied ONCE as source data.
# Finite uniform-increment random walk pinned to zero at both endpoints.
# This is not an exact Gaussian Wiener process or a fluid solver.
diffusion(index:int,params:[num],values:[num])->[num]:
    count:int(params.(10))
    (index>=0 /\ index<count /\ values.length()=32*count)?! "invalid random bridge storage"
    [num] walk:[0:34]
    i:1
    i<=16?>
        ux:values.(32*index+2*(i-1))
        uy:values.(32*index+2*(i-1)+1)
        (ux>=0 /\ ux<=65535 /\ uy>=0 /\ uy<=65535)?! "invalid native random entropy"
        walk.(2*i):walk.(2*i-2)+(ux/65535-0.5)*0.8660254037844386
        walk.(2*i+1):walk.(2*i-1)+(uy/65535-0.5)*0.8660254037844386
        .i:i+1
    endx:walk.(32)
    endy:walk.(33)
    .i:0
    i<=16?>
        walk.(2*i):walk.(2*i)-num(i)/16*endx
        walk.(2*i+1):walk.(2*i+1)-num(i)/16*endy
        .i:i+1
    @:walk

# params q/release/temperature/spread/lift/footprint/width/unused/unused/front/N/ng/
# exchange/dense/random/bridgeTime/sourceMomentumX/Y/targetMomentumX/Y.
carrier(index:int,params:[num],values:[num],glyph:int,reading:num)->[num]:
    q:params.(0)
    release:params.(1)
    count:int(params.(10))
    width:params.(6)
    lead:1.5*width
    a:clamp((params.(9)-reading)/width,0,1)
    progress:clamp((params.(9)-reading+lead)/lead,0,1)
    q=0?
        .a:0
        .progress:0
    q=1?
        .a:1
        .progress:1
    [num] channels:[0:7]
    j:0
    j<7?>
        start:values.(7*index+j)
        finish:values.(7*count+7*index+j)
        params.(12)=1 /\ j=1? .start:start-0.08*params.(4)
        params.(12)=2 /\ j=1? .finish:finish+0.35+0.1*params.(4)
        channels.(j):segment.value(start,finish,0,0,1,progress)
        .j:j+1
    envelope:release*(1-progress)*params.(2)
    bx:0.0
    by:0.0
    params.length()>=20 /\ params.(14)=1?
        at:clamp(params.(15),0,1)*16
        knot:int(at)
        knot=16? .knot:15
        local:at-num(knot)
        base:14*count+7*int(params.(11))+34*index
        .bx:segment.value(values.(base+2*knot),values.(base+2*knot+2),0,0,1,local)
        .by:segment.value(values.(base+2*knot+1),values.(base+2*knot+3),0,0,1,local)
        channels.(0):channels.(0)+0.20*params.(3)*envelope*bx
        channels.(1):channels.(1)+0.14*params.(4)*envelope*by
    channels.(1):channels.(1)+0.15*params.(4)*envelope
    size:params.(5)
    mass:channels.(5)*size*size
    params.(13)=1?
        start_size:values.(7*index+6)
        finish_size:values.(7*count+7*index+6)
        start_area:start_size*start_size
        finish_area:finish_size*finish_size
        area:segment.value(start_area,finish_area,0,0,1,progress)
        .mass:segment.value(values.(7*index+5)*start_area,values.(7*count+7*index+5)*finish_area,0,0,1,progress)
        .size:math.sqrt(area)
        channels.(5):mass/area
    px:0.0
    py:0.0
    params.length()>=20?
        .px:segment.value(params.(16),params.(18),0,0,1,progress)/num(count)
        .py:segment.value(params.(17),params.(19),0,0,1,progress)/num(count)
    @:[channels.(0),channels.(1),channels.(5)*release*(1-a),size,channels.(2),channels.(3),channels.(4),1/num(count),a,num(glyph),channels.(5),mass,px,py]

dense(index:int,params:[num],values:[num])->[num]:
    count:int(params.(10))
    ng:int(params.(11))
    (index>=0 /\ index<count /\ count<=65536 /\ ng>0 /\ ng<=4096 /\ values.length()=48*count+7*ng)?! "dense native material storage"
    px:values.(7*count+7*index)
    py:values.(7*count+7*index+1)
    nearest:0
    best:10^20
    j:0
    j<ng?>
        dx:px-values.(14*count+7*j)
        dy:py-values.(14*count+7*j+1)
        distance:dx*dx+dy*dy
        distance<best?
            .nearest:j
            .best:distance
        .j:j+1
    @:carrier(index,params,values,nearest,values.(14*count+7*nearest+2))

# Assigned material is captured only by its first-row glyph's moving front.
capture(glyph:int,params:[num],values:[num])->[num]:
    count:int(params.(10))
    ng:int(params.(11))
    (glyph>=0 /\ glyph<ng /\ values.length()=14*count+7*ng)?! "dense native capture storage"
    gas:0.0
    captured:0.0
    assigned:0.0
    optical:0.0
    raw:0.0
    raw_gas:0.0
    raw_captured:0.0
    px:0.0
    py:0.0
    i:0
    i<count?>
        int(values.(14*i+9))=glyph?
            weight:values.(14*i+7)
            a:values.(14*i+8)
            mass:values.(14*i+11)
            .assigned:assigned+weight
            .gas:gas+weight*params.(1)*(1-a)
            .captured:captured+weight*params.(1)*a
            .optical:optical+values.(14*i+2)*values.(14*i+3)^2
            .raw:raw+mass
            .raw_gas:raw_gas+mass*params.(1)*(1-a)
            .raw_captured:raw_captured+mass*params.(1)*a
            .px:px+values.(14*i+12)
            .py:py+values.(14*i+13)
        .i:i+1
    alpha:0.0
    assigned>0? .alpha:captured/assigned*values.(14*count+7*glyph+6)
    @:[alpha,1,values.(14*count+7*glyph+3),values.(14*count+7*glyph+4),values.(14*count+7*glyph+5),gas,captured,assigned,optical,raw,raw_gas,raw_captured,px,py]
