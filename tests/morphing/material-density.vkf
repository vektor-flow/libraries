g:.morphing.dispatch
mesh(index:int,params:[num],values:[num])->[num]:g.carrier_mesh_packet(index,params,values)
area(index:int,params:[num],values:[num])->num:g.carrier_area(index,params,values)
density(index:int,params:[num],values:[num])->num:g.material_density(index,params,values)
