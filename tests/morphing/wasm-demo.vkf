b:.morphing.biological
math:.math
s:.morphing.state
p:.morphing.presentation

Curve:(knots:[num],values:[num],second:[num],count:int,width:int,mode:int)
Plan:(curve:Curve,dimension:int,size:int,cells:int,carriers:int,stride:int,smooth_start:bit,smooth_end:bit,join:num)

cohorts:.morphing.cohorts
make_example(dimension:int,mode:int,smooth_start:bit,smooth_end:bit,example:int)->Plan:
    @:cohorts.prepare(dimension,mode,smooth_start,smooth_end,example)

make(dimension:int,mode:int,smooth_start:bit,smooth_end:bit)->Plan:
    @:make_example(dimension,mode,smooth_start,smooth_end,0)

Frame:(coverage:[num],measure:num,scale:num)
Scene:(plan:Plan,measure:Curve,resolution:int)
demo_prepare(resolution:int,mode:int,smooth_start:bit,smooth_end:bit)->Scene:
    plan:make(2,mode,smooth_start,smooth_end)
    measure:b.measure_curve(plan,resolution,[-2,-2],[2,2])
    @:(plan:plan,measure:measure,resolution:resolution)
demo_sample(scene:Scene,coordinate:num)->Frame:
    @:b.sample_measured(scene.plan,scene.measure,coordinate,scene.resolution,[-2,-2],[2,2],0.0001)
Surface:(plan:Plan,values:[num],scale:num,neck:num)
demo_surface(scene:Scene,coordinate:num,scale:num)->Surface:
    @:p.prepare_surface(scene.plan,coordinate,scale)
demo_row(surface:Surface,row:num)->[num]:
    @:p.surface_row(surface,129,int(row),[-2,-2],[2,2],1024,[0.262745098,0.82745098,0.878431373,1])
demo_entry(coordinate:num)->Frame:
    scene:demo_prepare(24,1,true,true)
    frame:demo_sample(scene,coordinate)
    vertices:demo_row(demo_surface(scene,coordinate,frame.scale),64)
    (vertices.length()%18=0)?! "invalid triangle packet"
    @:frame
::demo_entry(0).measure
