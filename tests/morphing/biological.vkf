b:.morphing.biological
m:.Morphing
math:.math
s:.morphing.state

Curve:(knots:[num],values:[num],second:[num],count:int,width:int,mode:int)
Plan:(curve:Curve,dimension:int,size:int,cells:int,carriers:int,stride:int,smooth_start:bit,smooth_end:bit,join:num)

make(dimension:int)->Plan:
    size:17
    cells:size*size
    dimension=3? .cells:cells*size
    [num] fields:[0:4*cells]
    object:0
    object<4?>
        radius:0.6
        object=1 \/ object=2?
            .radius:0.6/(2^(1/num(dimension)))
        i:0
        i<cells?>
            x:2*num(i%size)/(size-1)-1
            y:2*num((i//size)%size)/(size-1)-1
            z:0.0
            dimension=3? .z:2*num(i//(size*size))/(size-1)-1
            fields.(object*cells+i):radius-math.sqrt(x*x+y*y+z*z)
            .i:i+1
        .object:object+1
    [num] centers:[0:4*dimension]
    centers.(dimension): -0.75
    centers.(2*dimension):0.75
    [num] extents:[1:4*dimension]
    @:m.prepare_geometry([0,1,2],[0,1,3,4],[0,0,0,1,0,0],2,centers,extents,fields,size,dimension,1,true,true,0.12)

run()->bit:
    plan:make(2)
    initial:s.evaluate(plan.curve,0,true,true)
    truth:b.raster(plan,initial.value,48,[-2,-2],[2,2],1,0)
    i:0
    i<=16?>
        frame:b.sample(plan,i/8.0,48,[-2,-2],[2,2],truth.measure,0.00001)
        (|frame.measure-truth.measure|<0.00001)?! "constant geometric area"
        (frame.scale>0)?! "positive geometry scale"
        .i:i+1
    final:b.sample(plan,2,48,[-2,-2],[2,2],truth.measure,0.00001)
    .i:0
    i<truth.coverage.length()?>
        (|final.coverage.(i)-truth.coverage.(i)|<0.00000001)?! "exact reconstructed endpoint"
        .i:i+1
    measures:m.geometry_measure(plan,48,[-2,-2],[2,2])
    key:m.sample_geometry(plan,measures,1,48,[-2,-2],[2,2],0.00001)
    endpoint:s.evaluate(plan.curve,1,true,true)
    endpoint_frame:b.raster(plan,endpoint.value,48,[-2,-2],[2,2],1,0)
    .i:0
    i<key.coverage.length()?>
        (|key.coverage.(i)-endpoint_frame.coverage.(i)|<0.00000001)?! "target geometric state is exact"
        .i:i+1
    # A ring keeps its geometric hole; no image opacity is an input.
    polygon:b.polygon_field([-0.8,-0.8,0.8,-0.8,0.8,0.8,-0.8,0.8,-0.3,-0.3,0.3,-0.3,0.3,0.3,-0.3,0.3],[0,4,8],21)
    (polygon.(10*21+10)<0 /\ polygon.(10*21+16)>0 /\ polygon.(0)<0)?! "polygon hole and material signs"
    solid:make(3)
    start:s.evaluate(solid.curve,0,true,true)
    volume:b.raster(solid,start.value,16,[-2,-2,-2],[2,2,2],1,0)
    divided:b.sample(solid,1,16,[-2,-2,-2],[2,2,2],volume.measure,0.00001)
    (|divided.measure-volume.measure|<0.00001)?! "constant geometric volume"
    @:true
::run()
