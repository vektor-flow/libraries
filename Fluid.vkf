# Candidate native operator port of accepted research/physical-smoke/ns_reference.py.
# First profile: unforced periodic 3D MAC, nu=.0004, Cs=D=forcing=ports=0.
# Not yet an installed/qualified fluid solver. Native glyph coupling is absent.
# Internal GPU controls: nx,ny,nz,hx,hy,hz,nu,projection_dt,axis,inverse,
# reserved,max_dt,cfl,reserved,molecular_diffusivity,reserved.
# Velocity input is SoA x-fast; scalar q follows the three velocity components.
math:.math

minimum(a:num,b:num)->num:
    a<b? @:a
    @:b
count(p:[num])->int:int(p.(0))*int(p.(1))*int(p.(2))
axis_size(p:[num],axis:int)->int:int(p.(axis))
spacing(p:[num],axis:int)->num:p.(3+axis)
wrap(i:int,n:int)->int:((i%n)+n)%n
shift(i:int,axis:int,delta:int,p:[num])->int:
    nx:int(p.(0))
    ny:int(p.(1))
    nz:int(p.(2))
    x:i%nx
    y:(i//nx)%ny
    z:i//(nx*ny)
    axis=0? @:wrap(x+delta,nx)+nx*(y+ny*z)
    axis=1? @:x+nx*(wrap(y+delta,ny)+ny*z)
    @:x+nx*(y+ny*wrap(z+delta,nz))
velocity(v:[num],i:int,axis:int,p:[num])->num:v.(axis*count(p)+i)
scalar(v:[num],i:int,p:[num])->num:v.(3*count(p)+i)

divergence(v:[num],i:int,p:[num])->num:
    result:0.0
    axis:0
    axis<3?>
        .result:result+(velocity(v,shift(i,axis,1,p),axis,p)-velocity(v,i,axis,p))/spacing(p,axis)
        .axis:axis+1
    @:result

# Conservative dual-MAC flux; matches the accepted reference's central momentum.
momentum_flux(v:[num],i:int,a:int,b:int,p:[num])->num:
    next:shift(i,b,1,p)
    transported:(velocity(v,i,a,p)+velocity(v,next,a,p))/2
    carrier:transported
    ~(a=b)? .carrier:(velocity(v,next,b,p)+velocity(v,shift(next,a,-1,p),b,p))/2
    @:transported*carrier
momentum(v:[num],i:int,a:int,p:[num])->num:
    result:0.0
    b:0
    b<3?>
        .result:result-(momentum_flux(v,i,a,b,p)-momentum_flux(v,shift(i,b,-1,p),a,b,p))/spacing(p,b)
        .b:b+1
    @:result

# Full symmetric viscous stress, constant molecular viscosity in this first gate.
# Do not replace it with an unrelated advection/damping or prescribed flow law.
stress(v:[num],i:int,a:int,b:int,p:[num])->num:
    a=b? @:2*p.(6)*(velocity(v,shift(i,a,1,p),a,p)-velocity(v,i,a,p))/spacing(p,a)
    @:p.(6)*((velocity(v,i,a,p)-velocity(v,shift(i,b,-1,p),a,p))/spacing(p,b)+(velocity(v,i,b,p)-velocity(v,shift(i,a,-1,p),b,p))/spacing(p,a))
viscous(v:[num],i:int,a:int,p:[num])->num:
    result:(stress(v,i,a,a,p)-stress(v,shift(i,a,-1,p),a,a,p))/spacing(p,a)
    b:0
    b<3?>
        ~(a=b)? .result:result+(stress(v,shift(i,b,1,p),a,b,p)-stress(v,i,a,b,p))/spacing(p,b)
        .b:b+1
    @:result

# Accepted MINMOD, not the foreign unqualified candidate's MC limiter.
minmod(left:num,right:num)->num:
    left*right<=0? @:0
    |left|<|right|? @:left
    @:right
slope(v:[num],i:int,a:int,p:[num])->num:
    @:minmod(scalar(v,i,p)-scalar(v,shift(i,a,-1,p),p),scalar(v,shift(i,a,1,p),p)-scalar(v,i,p))
scalar_flux(v:[num],i:int,a:int,p:[num])->num:
    next:shift(i,a,1,p)
    speed:velocity(v,next,a,p)
    transported:scalar(v,i,p)+slope(v,i,a,p)/2
    speed<0? .transported:scalar(v,next,p)-slope(v,next,a,p)/2
    @:speed*transported-p.(14)*(scalar(v,next,p)-scalar(v,i,p))/spacing(p,a)
scalar_transport(v:[num],i:int,p:[num])->num:
    result:0.0
    a:0
    a<3?>
        .result:result-(scalar_flux(v,i,a,p)-scalar_flux(v,shift(i,a,-1,p),a,p))/spacing(p,a)
        .a:a+1
    @:result
operator_packet(i:int,p:[num],v:[num])->[num]:
    [num] result:[0:8]
    result.(0):divergence(v,i,p)
    result.(1):momentum(v,i,0,p)
    result.(2):momentum(v,i,1,p)
    result.(3):momentum(v,i,2,p)
    result.(4):viscous(v,i,0,p)
    result.(5):viscous(v,i,1,p)
    result.(6):viscous(v,i,2,p)
    result.(7):scalar_transport(v,i,p)
    @:result

# No version-matched FFT entry was located. This candidate uses separable direct
# DFT of the SAME periodic DG eigenproblem. It is not an FFT performance claim.
coefficient_count(p:[num])->int:
    nx:int(p.(0))
    ny:int(p.(1))
    nz:int(p.(2))
    @:2*(nx*nx+ny*ny+nz*nz)+nx+ny+nz
coefficient_value(index:int,p:[num])->num:
    nx:int(p.(0))
    ny:int(p.(1))
    nz:int(p.(2))
    twiddles:2*(nx*nx+ny*ny+nz*nz)
    index>=twiddles?
        k:index-twiddles
        axis:0
        k>=nx?
            .k:k-nx
            .axis:1
            k>=ny?
                .k:k-ny
                .axis:2
        n:axis_size(p,axis)
        wave:math.sin(3.141592653589793*num(k)/n)
        @:-4*wave*wave/(spacing(p,axis)*spacing(p,axis))
    axis:0
    at:index
    at>=2*nx*nx?
        .at:at-2*nx*nx
        .axis:1
        at>=2*ny*ny?
            .at:at-2*ny*ny
            .axis:2
    n:axis_size(p,axis)
    entry:at//2
    angle:6.283185307179586*num((entry//n)*(entry%n))/n
    at%2=0? @:math.cos(angle)
    @:math.sin(angle)
coefficients(p:[num])->[num]:[..coefficient_count(p)-1 >> coefficient_value(int($),p)]

# Complex pairs are x-fast. The immutable native twiddle/eigen table follows
# those 2*N values in the input binding. No field arithmetic runs in the host.
dft_axis(index:int,p:[num],v:[num])->[num]:
    axis:int(p.(8))
    inverse:p.(9)>0
    n:axis_size(p,axis)
    nx:int(p.(0))
    ny:int(p.(1))
    stride:1
    offset:2*count(p)
    axis>=1?
        .stride:nx
        .offset:offset+2*nx*nx
    axis>=2?
        .stride:nx*ny
        .offset:offset+2*ny*ny
    frequency:(index//stride)%n
    base:index-frequency*stride
    real:0.0
    imaginary:0.0
    j:0
    j<n?>
        at:2*(base+j*stride)
        coefficient:offset+2*(frequency*n+j)
        cosine:v.(coefficient)
        sine:v.(coefficient+1)
        inverse? .sine: -sine
        .real:real+v.(at)*cosine+v.(at+1)*sine
        .imaginary:imaginary+v.(at+1)*cosine-v.(at)*sine
        .j:j+1
    inverse?
        .real:real/n
        .imaginary:imaginary/n
    [num] result:[0:2]
    result.(0):real
    result.(1):imaginary
    @:result
pressure_rhs(index:int,p:[num],v:[num])->[num]:
    (p.(7)>0)?! "positive projection step required"
    [num] result:[0:2]
    result.(0):divergence(v,index,p)/p.(7)
    @:result
pressure_spectrum(index:int,p:[num],v:[num])->[num]:
    [num] result:[0:2]
    index=0? @:result
    nx:int(p.(0))
    ny:int(p.(1))
    nz:int(p.(2))
    at:2*count(p)+2*(nx*nx+ny*ny+nz*nz)
    ix:int(index%nx)
    iy:int((index//nx)%ny)
    iz:int(index//(nx*ny))
    eigen:v.(at+ix)+v.(at+nx+iy)+v.(at+nx+ny+iz)
    (eigen<0)?! "nonzero periodic pressure eigenvalue required"
    result.(0):v.(2*index)/eigen
    result.(1):v.(2*index+1)/eigen
    @:result
# Input: original 3*N face components followed by inverse pressure complex pairs.
project_velocity(index:int,p:[num],v:[num])->num:
    n:count(p)
    axis:index//n
    cell:index%n
    before:shift(cell,axis,-1,p)
    gradient:(v.(3*n+2*cell)-v.(3*n+2*before))/spacing(p,axis)
    @:v.(index)-p.(7)*gradient
