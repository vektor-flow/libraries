# Once-per-transition sparse field preparation for canonical state GPU sampling.
# All paths reuse native topology.arrival/support and state.prepare_jets.
e:.StateEvents
c:.StateControls
t:.morphing.topology
s:.morphing.state
p:.morphing.parallel
Curve:(knots:[num],values:[num],second:[num],count:int,width:int,mode:int)
GeometryPlan:(curve:Curve,dimension:int,size:int,cells:int,carriers:int,stride:int,smooth_start:bit,smooth_end:bit,join:num)
CurveLayout:(knots:[num],count:int,width:int,mode:int)
GeometryLayout:(dimension:int,size:int,stride:int,carriers:int,width:int,join:num)
EventLayout:(source:int,target:int,support:int,grow:int,shrink:int,source_attributes:int,target_attributes:int,weights:int)
Descriptor:(curve:CurveLayout,geometry:GeometryLayout,density:bit,events:[EventLayout])
EventPlan:(embedding:Curve,weights:[num],parent:[int],children:[int],coordinates:[num],first_coordinates:[num],root_coordinate:num,centers:[num])
InputChunk:(offset:int,values:[num])
Prepared:(chunks:[InputChunk],input_width:int,controls:Descriptor,weights:[num],embedding:Curve,events:EventPlan,event_coordinates:[num],direction:int,source_rgba:[num],target_rgba:[num],identity:bit)

# Time reversal preserves the existing cubic representation; endpoint second
# derivatives swap within reversed intervals, with no sign change.
reverse_curve(curve:Curve)->Curve:
    (curve.mode=2)?! "event reversal requires a C1 native curve"
    count:curve.count
    width:curve.width
    [num] knots:[0:count]
    [num] values:[0:count*width]
    [num] second:[0:2*(count-1)*width]
    i:0
    i<count?>
        knots.(i):1-curve.knots.(count-1-i)
        j:0
        j<width?>
            values.(i*width+j):curve.values.((count-1-i)*width+j)
            .j:j+1
        .i:i+1
    .i:0
    i<count-1?>
        j:0
        j<width?>
            second.((2*i)*width+j):curve.second.((2*(count-2-i)+1)*width+j)
            second.((2*i+1)*width+j):curve.second.((2*(count-2-i))*width+j)
            .j:j+1
        .i:i+1
    @:(knots:knots,values:values,second:second,count:count,width:width,mode:2)

prepare(plan:GeometryPlan,source_count:int,target_count:int,given_weights:[num]=[])->Prepared:
    curve:plan.curve
    n:plan.carriers
    size:plan.size
    cells:plan.cells
    stride:plan.stride
    width:curve.width
    (plan.dimension=2 /\ plan.join=0 /\ ~plan.smooth_start /\ ~plan.smooth_end /\ size>=3 /\ size<=257 /\ cells=size*size /\ stride=8+cells /\ n>=1 /\ n<=128 /\ width=n*stride /\ curve.count=2 /\ (curve.mode=0 \/ curve.mode=1) /\ curve.knots.length()=2 /\ curve.knots.(0)=0 /\ curve.knots.(1)=1 /\ curve.values.length()=2*width /\ curve.second.length()=2*width)?! "unsupported bounded sparse state profile"
    ((source_count=n /\ target_count=1) \/ (source_count=1 /\ target_count=n))?! "sparse events require a star ownership cohort"
    (given_weights.length()=0 \/ given_weights.length()=n)?! "sparse event weight count mismatch"
    i:0
    i<curve.second.length()?>
        (curve.second.(i)=0)?! "sparse endpoints require zero existing curvature"
        .i:i+1
    direction:0
    n>1 /\ source_count=n? .direction:1
    n>1 /\ target_count=n? .direction:-1
    distinct:0
    common:width
    direction=-1?
        .distinct:width
        .common:0
    original:curve.values
    # All common-side geometry and RGBA duplicates must refer to the same object.
    carrier:1
    carrier<n?>
        .i:0
        i<stride?>
            (original.(common+carrier*stride+i)=original.(common+i))?! "sparse common-side endpoints differ"
            .i:i+1
        .carrier:carrier+1
    [num] source_rgba:[0:4*n]
    [num] target_rgba:[0:4*n]
    .carrier:0
    carrier<n?>
        base:carrier*stride+4+cells
        .i:0
        i<4?>
            a:original.(base+i)
            b:original.(width+base+i)
            (a>=0 /\ a<=1 /\ b>=0 /\ b<=1)?! "sparse authored RGBA outside range"
            source_rgba.(4*carrier+i):a
            target_rgba.(4*carrier+i):b
            .i:i+1
        (source_rgba.(4*carrier+3)=1 /\ target_rgba.(4*carrier+3)=1)?! "sparse field profile requires opaque authored RGBA"
        .carrier:carrier+1
    # Preflight exact offset range before allocating field tables.
    embedding_width:4*n
    embedding_count:n+1
    prefix:(3*embedding_count-2)*embedding_width
    total:prefix+(6*n+1)*cells+11*n
    (total<16777216)?! "sparse input exceeds exact buffer offset range"
    [num] source_embedding:[0:4*n]
    [num] weights:[0:n]
    .carrier:0
    carrier<n?>
        base:distinct+carrier*stride
        .i:0
        i<4?>
            source_embedding.(4*carrier+i):original.(base+i)
            .i:i+1
        given_weights.length()=n? weights.(carrier):given_weights.(carrier)
        given_weights.length()=0?
            dx:2*original.(base+2)/num(size-1)
            dy:2*original.(base+3)/num(size-1)
            area:0.0
            cell:0
            cell<(size-1)*(size-1)?>
                at:base+4+(cell//(size-1))*size+cell%(size-1)
                fraction:p.cell_fraction(original.(at),original.(at+1),original.(at+size),original.(at+size+1))
                .area:area+fraction*dx*dy
                .cell:cell+1
            (area>0)?! "sparse distinct endpoint has no clipped material"
            weights.(carrier):area
        .carrier:carrier+1
    target_embedding:[..3 >> original.(common+int($))]
    events:e.prepare(source_embedding,weights,target_embedding)
    embedding:events.embedding
    direction=-1? .embedding:reverse_curve(embedding)
    [num] event_coordinates:[0:n-1]
    .i:0
    i<n-1?>
        event_coordinates.(i):events.coordinates.(i)
        direction=-1? event_coordinates.(i):1-events.coordinates.(n-2-i)
        .i:i+1
    [num] grow:[0:n]
    [num] shrink:[0:n]
    .i:0
    i<n?>
        grow.(i):events.first_coordinates.(i)
        shrink.(i):events.root_coordinate
        direction=-1?
            grow.(i):1-events.root_coordinate
            shrink.(i):1-events.first_coordinates.(i)
        .i:i+1
    first_source:[..cells-1 >> original.(4+int($))]
    first_target:[..cells-1 >> original.(width+4+int($))]
    identity:n=1
    .carrier:0
    carrier<n?>
        base:carrier*stride+4
        .i:0
        i<cells?>
            left:original.(base+i)
            right:original.(width+base+i)
            (|left|<100000 /\ |right|<100000)?! "nonfinite or excessive sparse field"
            ~(left=right)? .identity:false
            .i:i+1
        .carrier:carrier+1
    shared_support:first_source
    ~identity?
        .shared_support:t.support(first_source,first_target,size)
        .carrier:1
        carrier<n?>
            base:carrier*stride+4
            source:[..cells-1 >> original.(base+int($))]
            target:[..cells-1 >> original.(width+base+int($))]
            cap:t.support(source,target,size)
            .i:0
            i<cells?>
                shared_support.(i):t.maximum(shared_support.(i),cap.(i))
                .i:i+1
            .carrier:carrier+1
    first_source_arrival:first_source
    first_target_arrival:first_target
    ~identity?
        .first_source_arrival:t.arrival(first_source,size)
        .first_target_arrival:t.arrival(first_target,size)
    source_offset:prefix
    target_offset:source_offset+3*n*cells
    support_offset:target_offset+3*n*cells
    grow_offset:support_offset+cells
    shrink_offset:grow_offset+n
    source_attributes_offset:shrink_offset+n
    target_attributes_offset:source_attributes_offset+4*n
    weights_offset:target_attributes_offset+4*n
    # The common side has identical field AND timing across all lineages.
    # Reuse its exact immutable Curve and the zero-jet vector, rather than
    # repeating large native preparation allocations for each carrier.
    [num] zero_jets:[0:2*cells]
    source_common_curve:s.prepare_jets([0,grow.(0)],first_source_arrival&shared_support,zero_jets,cells)
    target_common_curve:s.prepare_jets([shrink.(0),1],shared_support&first_target_arrival,zero_jets,cells)
    source_common_block:first_source_arrival&source_common_curve.second
    target_common_block:first_target_arrival&target_common_curve.second
    [InputChunk] chunks:[(offset:0,values:embedding.values),(offset:embedding.values.length(),values:embedding.second)]
    .carrier:0
    carrier<n?>
        base:carrier*stride+4
        source:first_source_arrival
        target:first_target_arrival
        carrier>0 /\ source_count>1?
            .source:t.arrival([..cells-1 >> original.(base+int($))],size)
        carrier>0 /\ target_count>1?
            .target:t.arrival([..cells-1 >> original.(width+base+int($))],size)
        source_curve:source_common_curve
        target_curve:target_common_curve
        carrier>0 /\ source_count>1?
            .source_curve:s.prepare_jets([0,grow.(carrier)],source&shared_support,zero_jets,cells)
        carrier>0 /\ target_count>1?
            .target_curve:s.prepare_jets([shrink.(carrier),1],shared_support&target,zero_jets,cells)
        source_block:source_common_block
        target_block:target_common_block
        carrier>0 /\ source_count>1? .source_block:source&source_curve.second
        carrier>0 /\ target_count>1? .target_block:target&target_curve.second
        .chunks:chunks&[(offset:source_offset+3*carrier*cells,values:source_block),(offset:target_offset+3*carrier*cells,values:target_block)]
        .carrier:carrier+1
    .chunks:chunks&[(offset:support_offset,values:shared_support),(offset:grow_offset,values:grow),(offset:shrink_offset,values:shrink),(offset:source_attributes_offset,values:source_rgba),(offset:target_attributes_offset,values:target_rgba),(offset:weights_offset,values:events.weights)]
    layout:(source:source_offset,target:target_offset,support:support_offset,grow:grow_offset,shrink:shrink_offset,source_attributes:source_attributes_offset,target_attributes:target_attributes_offset,weights:weights_offset)
    curve_layout:(knots:embedding.knots,count:embedding.count,width:embedding.width,mode:embedding.mode)
    geometry_layout:(dimension:2,size:size,stride:stride,carriers:n,width:width,join:0)
    @:(chunks:chunks,input_width:total,controls:c.prepare(curve_layout,geometry_layout,true,[layout]),weights:events.weights,embedding:embedding,events:events,event_coordinates:event_coordinates,direction:direction,source_rgba:source_rgba,target_rgba:target_rgba,identity:identity)
