# Public typed state-interpolation settings with optional named mode groups.
u:.morphing.unfold
m:.Morphing
StateSettings:(path:int)
RevealSettings:(k:num,velocity:num,overshoot:num,grow:bit)
VaporSettings:(temperature:num,spread:num,lift:num,seed:int)
# Optional groups contain zero or one NAMED typed record. No positional numeric
# payloads, nullable syntax or implicit field/mode inference.
Interp:(mode:int,state:[StateSettings],reveal:[RevealSettings],vapor:[VaporSettings])
Curve:(knots:[num],values:[num],second:[num],count:int,width:int,mode:int)
Plan:(curve:Curve,smooth_start:bit,smooth_end:bit)

settings(mode:int=0,state:[StateSettings]=[],reveal:[RevealSettings]=[],vapor:[VaporSettings]=[])->Interp:
    value:(mode:mode,state:state,reveal:reveal,vapor:vapor)
    valid(value)?! "invalid Interp settings"
    @:value

valid(value:Interp)->bit:
    (value.mode>=0 /\ value.mode<=2)?! "unsupported Interp mode"
    (value.state.length()<=1 /\ value.reveal.length()<=1 /\ value.vapor.length()<=1)?! "Interp optional group must contain zero or one record"
    value.mode=0?
        (value.reveal.length()=0 /\ value.vapor.length()=0)?! "text settings on state Interp"
        value.state.length()=1?
            (value.state.(0).path>=0 /\ value.state.(0).path<=1)?! "unsupported Interp state path"
    value.mode>0?
        (value.state.length()=0)?! "state settings on text Interp"
        value.reveal.length()=1?
            r:value.reveal.(0)
            (r.velocity>=0 /\ r.velocity<=1)?! "reveal velocity outside 0–1"
            (r.k>=1 /\ r.k<=10)?! "reveal k outside 1–10"
            (r.overshoot>=0 /\ r.overshoot<=0.5)?! "reveal overshoot outside 0–0.5"
    value.mode=1? (value.vapor.length()=0)?! "vapor settings on spectral Interp"
    value.mode=2?
        value.vapor.length()=1?
            v:value.vapor.(0)
            (v.temperature>=0 /\ v.temperature<=1)?! "vapor temperature outside 0–1"
            (v.spread>=0 /\ v.spread<=4 /\ v.lift>=0 /\ v.lift<=4)?! "vapor extent outside 0–4"
            (v.seed>=0 /\ v.seed<=65535)?! "vapor seed must be integer 0–65535"
    @:true

# Independent two-piece quadratic clock, shared by all modes.
time_coordinate(q:num)->num:
    (q>=0 /\ q<=1)?! "Interp coordinate outside 0–1"
    q<0.5? @:2*q*q
    @:1-2*(1-q)*(1-q)

prepare(value:Interp,coordinates:[num],states:[num],width:int)->Plan:
    valid(value)?! "invalid Interp settings"
    (value.mode=0)?! "numeric state preparation requires state Interp"
    path:0
    value.state.length()=1? .path:value.state.(0).path
    @:m.prepare(coordinates,states,width,path,false,false)

# Renderer supplies cached reading coordinates. Returns alpha,growth,r,g,b.
reveal_channel(value:Interp,distance:num,channel:int)->num:
    valid(value)?! "invalid Interp settings"
    (value.mode>0 /\ channel>=0 /\ channel<=4)?! "invalid Interp reveal channel"
    (|distance|<10^10)?! "invalid Interp reading distance"
    k:4.0
    overshoot:0.32
    grow:true
    value.reveal.length()=1?
        .k:value.reveal.(0).k
        .overshoot:value.reveal.(0).overshoot
        .grow:value.reveal.(0).grow
    a:u.alpha(distance,k)
    channel=0? @:a
    channel=1?
        grow=false? @:1
        @:u.growth(a,u.back_coefficient(overshoot))
    @:u.color_channel(a,channel-2)

noise(index:int,seed:int,lane:int)->num:
    n:(index*251+seed*199+lane*101+17)%65521
    .n:(n*251+(n%251)*(n%251)*97+37)%65521
    .n:(n*127+(n%257)*(n%257)*53+19)%65521
    @:num(n)/65520

# Source field alpha; target reveal should receive its own row reading front.
source_alpha(q:num)->num:
    (q>=0 /\ q<=1)?! "Interp coordinate outside 0–1"
    @:(1-q)*(1-q)

# Named factories are the primary public construction API. Only applicable
# parameters exist in each signature; omitted values use native defaults.
state(path:int=0)->Interp:
    @:settings(0,[(path:path,)],[],[])
spectral(k:num=4,velocity:num=0.54,overshoot:num=0.32,grow:bit=true)->Interp:
    @:settings(1,[],[(k:k,velocity:velocity,overshoot:overshoot,grow:grow)],[])
evaporate(temperature:num=1,spread:num=0.35,lift:num=0.65,seed:int=0,k:num=4,velocity:num=0.54,overshoot:num=0.32,grow:bit=true)->Interp:
    @:settings(2,[],[(k:k,velocity:velocity,overshoot:overshoot,grow:grow)],[(temperature:temperature,spread:spread,lift:lift,seed:seed)])
reveal_advance(value:Interp,front:num,elapsed:num)->num:
    valid(value)?! "invalid Interp settings"
    (value.mode>0 /\ |front|<10^10)?! "reveal advance requires finite text coordinate"
    velocity:0.54
    value.reveal.length()=1? .velocity:value.reveal.(0).velocity
    @:u.advance(front,elapsed,velocity)

TextFrame:(source_alpha:num,gas:[num],target:[num])
# One call per requested frame. Input ink triples are local x,y,coverage; target
# reading coordinates are cached native glyph order, not text or glyph bodies.
# Gas output is x,y,alpha,size; target output alpha,growth,r,g,b per glyph.
text_frame(value:Interp,q:num,source_ink:[num],target_reading:[num],front:num)->TextFrame:
    valid(value)?! "invalid Interp settings"
    (value.mode=1 /\ q>=0 /\ q<=1 /\ |front|<10^10)?! "text frame requires spectral mode; vapor needs prepared material transport"
    (source_ink.length()<=196608 /\ source_ink.length()%3=0 /\ target_reading.length()<=65536)?! "Interp text frame exceeds bounded layout"
    (source_ink.length()=0)?! "spectral frames do not accept material carriers"
    [num] gas:[]
    [num] target:[0:5*target_reading.length()]
    k:4.0
    overshoot:0.32
    grow:true
    value.reveal.length()=1?
        .k:value.reveal.(0).k
        .overshoot:value.reveal.(0).overshoot
        .grow:value.reveal.(0).grow
    coefficient:u.back_coefficient(overshoot)
    j:0
    .j:0
    j<target_reading.length()?>
        (|target_reading.(j)|<10^10)?! "invalid native glyph reading coordinate"
        a:u.alpha(front-target_reading.(j),k)
        # Endpoint packets are exact; the caller budgets front travel to avoid
        # an incomplete reading front jumping on the final endpoint.
        q=0? .a:0
        q=1? .a:1
        size:1.0
        grow? .size:u.growth(a,coefficient)
        target.(5*j):a
        target.(5*j+1):size
        target.(5*j+2):u.color_channel(a,0)
        target.(5*j+3):u.color_channel(a,1)
        target.(5*j+4):u.color_channel(a,2)
        .j:j+1
    @:(source_alpha:source_alpha(q),gas:gas,target:target)

# Material-carrying ink transport. The existing Morphing carrier ledger and
# segment evaluator are the ONLY interpolation backend. Noise is a finite
# seeded cubic field, not an integrated Wiener process or thermodynamic solver.
ink_state:.morphing.state
ink_segment:.morphing.segment
ink_math:.math
MaterialPlan:(state:Plan,weights:[num],owners:[int],dimension:int,carriers:int,states:int)
VaporTransport:(material:MaterialPlan,turbulence:Plan,glyphs:[num],glyph_owners:[int],settings:Interp,source_count:int,target_count:int)
VaporFrame:(source_alpha:num,gas:[num],target:[num],ledger:[num])

ink_count(ink:[num])->int:
    (ink.length()>0 /\ ink.length()%7=0 /\ ink.length()<=28672)?! "material vapor needs nonempty bounded ink endpoints"
    count:ink.length()//7
    remaining:count
    remaining>1 /\ remaining%2=0?> .remaining:remaining//2
    (remaining=1)?! "material ink sample counts must be powers of two"
    i:0
    i<count?>
        (|ink.(7*i)|<100 /\ |ink.(7*i+1)|<100)?! "invalid native ink coordinate"
        j:2
        j<6?>
            (ink.(7*i+j)>=0 /\ ink.(7*i+j)<=1)?! "invalid native ink RGB or coverage"
            .j:j+1
        (ink.(7*i+5)>0 /\ ink.(7*i+6)>0 /\ ink.(7*i+6)<1000)?! "native ink needs positive coverage and footprint"
        .i:i+1
    @:count

# Ink rows: x,y,r,g,b,coverage,footprint; glyph rows: x,y,read,r,g,b,alpha.
# Positions use one common CSS-height chart, so nearest-anchor distances are
# actual Euclidean pixel distances up to the same common scale.
prepare_vapor_transport(value:Interp,source:[num],destination:[num],glyphs:[num])->VaporTransport:
    valid(value)?! "invalid Interp settings"
    (value.mode=2)?! "material transport requires vapor Interp"
    n:ink_count(source)
    mcount:ink_count(destination)
    (glyphs.length()>0 /\ glyphs.length()%7=0 /\ glyphs.length()<=28672)?! "material vapor requires target native glyphs"
    ng:glyphs.length()//7
    i:0
    i<ng?>
        (|glyphs.(7*i)|<100 /\ |glyphs.(7*i+1)|<100 /\ |glyphs.(7*i+2)|<10^10)?! "invalid native target glyph anchor/read coordinate"
        j:3
        j<7?>
            (glyphs.(7*i+j)>=0 /\ glyphs.(7*i+j)<=1)?! "invalid native target authored RGBA"
            .j:j+1
        .i:i+1
    [num] weights:[0:n+mcount]
    [num] positions:[0:source.length()+destination.length()]
    .i:0
    i<n?>
        weights.(i):1/num(n)
        j:0
        j<7?>
            positions.(7*i+j):source.(7*i+j)
            .j:j+1
        .i:i+1
    .i:0
    [int] owners:[0:mcount]
    i<mcount?>
        weights.(n+i):1/num(mcount)
        j:0
        j<7?>
            positions.(7*(n+i)+j):destination.(7*i+j)
            .j:j+1
        destination_x:destination.(7*i)
        destination_y:destination.(7*i+1)
        nearest:0
        best:10^100
        .j:0
        j<ng?>
            dx:destination_x-glyphs.(7*j)
            dy:destination_y-glyphs.(7*j+1)
            distance:dx*dx+dy*dy
            distance<best?
                .best:distance
                .nearest:j
            .j:j+1
        owners.(i):nearest
        .i:i+1
    material:m.prepare_material([0,1],[0,n,n+mcount],weights,positions,7,0,false,false)
    count:material.carriers
    (count<=4096)?! "material vapor carrier cap exceeded"
    seed:0
    value.vapor.length()=1? .seed:value.vapor.(0).seed
    [num] knots:[0:13]
    [num] fluctuations:[0:13*2*count]
    tick:0
    tick<13?>
        knots.(tick):num(tick)/12
        .i:0
        i<count?>
            fluctuations.(tick*2*count+2*i):2*noise(i,seed,2*tick)-1
            fluctuations.(tick*2*count+2*i+1):2*noise(i,seed,2*tick+1)-1
            .i:i+1
        .tick:tick+1
    turbulence:m.prepare(knots,fluctuations,2*count,1,false,false)
    @:(material:material,turbulence:turbulence,glyphs:glyphs,glyph_owners:owners,settings:value,source_count:n,target_count:mcount)

# Delayed row front: material first dissolves/lifts, then the front captures it.
# q is already the shared eased coordinate, not another time easing.
vapor_front(value:Interp,q:num,travel:num)->num:
    valid(value)?! "invalid Interp settings"
    (value.mode=2 /\ q>=0 /\ q<=1 /\ travel>=0 /\ travel<10^10)?! "invalid material vapor front"
    k:4.0
    value.reveal.length()=1? .k:value.reveal.(0).k
    lead:1.5*u.ramp_width(k)
    @: -lead+u.clamp((q-0.25)/0.75,0,1)*(travel+lead)

ink_finish(a:num,channel:int,authored:num)->num:
    color:u.color_channel(a,channel)
    a<=0.8? @:color
    @:color+(authored-1)*u.color_channel(a,1)

# Source mass / gas mass / captured mass sum to one. These are normalized
# material weights, not raster coverage or a claim of physical ink-area balance.
# Gas rows: x,y,alpha,footprint,r,g,b,mass,capture.
sample_vapor_transport(plan:VaporTransport,q:num,front:num)->VaporFrame:
    (q>=0 /\ q<=1 /\ |front|<10^10)?! "invalid material transport coordinate"
    value:plan.settings
    valid(value)?! "invalid material transport settings"
    # Project immutable prepared arrays once. Repeating nested record projection
    # inside the carrier loop needlessly traverses/copies the same large plans.
    material:plan.material
    values:material.state.curve.values
    owners:material.owners
    weights:material.weights
    glyphs:plan.glyphs
    glyph_owners:plan.glyph_owners
    turbulence:plan.turbulence.curve
    knots:turbulence.knots
    fluctuations:turbulence.values
    fluctuation_second:turbulence.second
    k:4.0
    overshoot:0.32
    grow:true
    value.reveal.length()=1?
        .k:value.reveal.(0).k
        .overshoot:value.reveal.(0).overshoot
        .grow:value.reveal.(0).grow
    temperature:1.0
    spread:0.35
    lift:0.65
    value.vapor.length()=1?
        .temperature:value.vapor.(0).temperature
        .spread:value.vapor.(0).spread
        .lift:value.vapor.(0).lift
    release:u.clamp(u.alpha(q*1.5707963267948966/(0.22+0.08*(1-temperature)),1),0,1)
    lead:1.5*u.ramp_width(k)
    coefficient:u.back_coefficient(overshoot)
    count:material.carriers
    ng:glyphs.length()//7
    (count>0 /\ count<=4096 /\ ng>0 /\ ng<=4096 /\ weights.length()=count /\ owners.length()=2*count /\ values.length()=14*count /\ glyph_owners.length()=plan.target_count)?! "invalid bounded prepared material layout"
    [num] gas:[0:9*count]
    [num] target:[0:5*ng]
    [num] captures:[0:ng]
    i:0
    i<ng?>
        a:u.clamp(u.alpha(front-glyphs.(7*i+2),k),0,1)
        q=0? .a:0
        q=1? .a:1
        captures.(i):a
        size:1.0
        grow? .size:u.growth(a,coefficient)
        target.(5*i):release*a*glyphs.(7*i+6)
        target.(5*i+1):size
        j:0
        j<3?>
            target.(5*i+2+j):ink_finish(a,j,glyphs.(7*i+3+j))
            .j:j+1
        .i:i+1
    segment:ink_state.interval(knots,q)
    h:knots.(segment+1)-knots.(segment)
    local:(q-knots.(segment))/h
    source_ratio:ink_math.sqrt(num(plan.source_count)/num(count))
    target_ratio:ink_math.sqrt(num(plan.target_count)/num(count))
    gas_mass:0.0
    captured_mass:0.0
    .i:0
    i<count?>
        destination:owners.(count+i)
        glyph:glyph_owners.(destination)
        a:captures.(glyph)
        progress:u.clamp((front-glyphs.(7*glyph+2)+lead)/lead,0,1)
        q=0? .progress:0
        q=1? .progress:1
        # Same prepared state-segment kernel, evaluated at carrier capture phase.
        j:0
        [num] channels:[0:7]
        j<7?>
            index:7*i+j
            start:values.(index)
            finish:values.(7*count+index)
            channels.(j):ink_segment.value(start,finish,0,0,1,progress)
            .j:j+1
        size:target.(5*glyph+1)
        gx:glyphs.(7*glyph)
        gy:glyphs.(7*glyph+1)
        px:values.(7*count+7*i)
        py:values.(7*count+7*i+1)
        # The sink follows the actual native glyph's current growth transform.
        channels.(0):channels.(0)+progress*((gx+(px-gx)*size)-px)
        channels.(1):channels.(1)+progress*((gy+(py-gy)*size)-py)
        q=0?
            channels.(0):values.(7*i)
            channels.(1):values.(7*i+1)
        envelope:release*(1-progress)*temperature
        .j:0
        j<2?>
            component:2*i+j
            offset:segment*2*count+component
            next:offset+2*count
            fluctuation:ink_segment.value(fluctuations.(offset),fluctuations.(next),fluctuation_second.(offset),fluctuation_second.(next),h,local)
            .fluctuation:u.clamp(fluctuation,-1,1)
            j=0? channels.(0):channels.(0)+0.15*spread*envelope*fluctuation
            j=1? channels.(1):channels.(1)+0.15*lift*envelope*(1+0.4*fluctuation)
            .j:j+1
        q=1?
            channels.(0):px
            channels.(1):py
        fraction:release*(1-a)
        mass:weights.(i)
        gas.(9*i):channels.(0)
        gas.(9*i+1):channels.(1)
        gas.(9*i+2):channels.(5)*fraction
        # Splitting a carrier partitions its presentation area, not its ledger.
        gas.(9*i+3):channels.(6)*ink_segment.value(source_ratio,target_ratio,0,0,1,progress)
        gas.(9*i+4):channels.(2)
        gas.(9*i+5):channels.(3)
        gas.(9*i+6):channels.(4)
        gas.(9*i+7):mass
        gas.(9*i+8):a
        .gas_mass:gas_mass+mass*fraction
        .captured_mass:captured_mass+mass*release*a
        .i:i+1
    @:(source_alpha:1-release,gas:gas,target:target,ledger:[1-release,gas_mass,captured_mass])
