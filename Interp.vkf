# Public typed state-interpolation settings with optional named mode groups.
u:.morphing.unfold
m:.Morphing
StateSettings:(path:int)
RevealSettings:(k:num,velocity:num,overshoot:num,grow:bit)
VaporSettings:(temperature:num,spread:num,lift:num,seed:int,footprint:num,boundary:int)
CaptureSettings:(width:num,velocity:num,start_coordinate:num,finish_coordinate:num)
WaveSettings:(k:num,start_coordinate:num,finish_coordinate:num)
# Optional groups contain zero or one NAMED typed record. No positional numeric
# payloads, nullable syntax or implicit field/mode inference.
Interp:(mode:int,state:[StateSettings],reveal:[RevealSettings],vapor:[VaporSettings],capture:[CaptureSettings],wave:[WaveSettings])
Curve:(knots:[num],values:[num],second:[num],count:int,width:int,mode:int)
Plan:(curve:Curve,smooth_start:bit,smooth_end:bit)

settings(mode:int=0,state:[StateSettings]=[],reveal:[RevealSettings]=[],vapor:[VaporSettings]=[],capture:[CaptureSettings]=[],wave:[WaveSettings]=[])->Interp:
    value:(mode:mode,state:state,reveal:reveal,vapor:vapor,capture:capture,wave:wave)
    valid(value)?! "invalid Interp settings"
    @:value

valid(value:Interp)->bit:
    (value.mode>=0 /\ value.mode<=3)?! "unsupported Interp mode"
    (value.state.length()<=1 /\ value.reveal.length()<=1 /\ value.vapor.length()<=1 /\ value.capture.length()<=1 /\ value.wave.length()<=1)?! "Interp optional group must contain zero or one record"
    value.mode<3? (value.wave.length()=0)?! "wave settings on another Interp mode"
    value.mode=3?
        (value.state.length()=0 /\ value.reveal.length()=0 /\ value.vapor.length()=0 /\ value.capture.length()=0)?! "irrelevant settings on plain wave Interp"
        value.wave.length()=1?
            w:value.wave.(0)
            (w.k>=1 /\ w.k<=10 /\ w.start_coordinate>=0 /\ w.start_coordinate<w.finish_coordinate /\ w.finish_coordinate<=1)?! "invalid plain wave settings"
    value.mode=0?
        (value.reveal.length()=0 /\ value.vapor.length()=0 /\ value.capture.length()=0)?! "text settings on state Interp"
        value.state.length()=1?
            (value.state.(0).path>=0 /\ value.state.(0).path<=1)?! "unsupported Interp state path"
    value.mode>0?
        (value.state.length()=0)?! "state settings on text Interp"
        value.mode=1 /\ value.reveal.length()=1?
            r:value.reveal.(0)
            (r.velocity>=0 /\ r.velocity<=1)?! "reveal velocity outside 0–1"
            (r.k>=1 /\ r.k<=10)?! "reveal k outside 1–10"
            (r.overshoot>=0 /\ r.overshoot<=0.5)?! "reveal overshoot outside 0–0.5"
    value.mode=1? (value.vapor.length()=0 /\ value.capture.length()=0)?! "vapor settings on spectral Interp"
    value.mode=2?
        (value.reveal.length()=0)?! "spectral reveal settings on material capture"
        value.capture.length()=1?
            c:value.capture.(0)
            (c.width>0 /\ c.width<=4 /\ c.velocity>=0 /\ c.velocity<=1 /\ c.start_coordinate>=0 /\ c.start_coordinate<c.finish_coordinate /\ c.finish_coordinate<=1)?! "invalid material capture parameters"
        value.vapor.length()=1?
            v:value.vapor.(0)
            (v.temperature>=0 /\ v.temperature<=1)?! "vapor temperature outside 0–1"
            (v.spread>=0 /\ v.spread<=4 /\ v.lift>=0 /\ v.lift<=4)?! "vapor extent outside 0–4"
            (v.footprint>=0.05 /\ v.footprint<=1 /\ v.boundary>=0 /\ v.boundary<=3)?! "invalid material footprint or boundary"
            (v.seed>=0 /\ v.seed<=65535)?! "vapor seed must be integer 0–65535"
    @:true

# Independent two-piece quadratic clock, shared by all modes.
time_coordinate(q:num)->num:
    (q>=0 /\ q<=1)?! "Interp coordinate outside 0–1"
    q<0.5? @:2*q*q
    @:1-2*(1-q)*(1-q)

prepare(value:Interp,coordinates:[num],states:[num],width:int)->Plan:
    valid(value)?! "invalid Interp settings"
    (value.mode=0)?! "numeric state preparation requires state Interp"
    path:0
    value.state.length()=1? .path:value.state.(0).path
    @:m.prepare(coordinates,states,width,path,false,false)

# Renderer supplies cached reading coordinates. Returns alpha,growth,r,g,b.
reveal_channel(value:Interp,distance:num,channel:int)->num:
    valid(value)?! "invalid Interp settings"
    (value.mode=1 /\ channel>=0 /\ channel<=4)?! "invalid Interp reveal channel"
    (|distance|<10^10)?! "invalid Interp reading distance"
    k:4.0
    overshoot:0.32
    grow:true
    value.reveal.length()=1?
        .k:value.reveal.(0).k
        .overshoot:value.reveal.(0).overshoot
        .grow:value.reveal.(0).grow
    a:u.alpha(distance,k)
    channel=0? @:a
    channel=1?
        grow=false? @:1
        @:u.growth(a,u.back_coefficient(overshoot))
    @:u.color_channel(a,channel-2)

noise(index:int,seed:int,lane:int)->num:
    n:(index*251+seed*199+lane*101+17)%65521
    .n:(n*251+(n%251)*(n%251)*97+37)%65521
    .n:(n*127+(n%257)*(n%257)*53+19)%65521
    @:num(n)/65520

# Source field alpha; target reveal should receive its own row reading front.
source_alpha(q:num)->num:
    (q>=0 /\ q<=1)?! "Interp coordinate outside 0–1"
    @:(1-q)*(1-q)

# Named factories are the primary public construction API. Only applicable
# parameters exist in each signature; omitted values use native defaults.
state(path:int=0)->Interp:
    @:settings(0,[(path:path,)],[],[])
spectral(k:num=4,velocity:num=0.54,overshoot:num=0.32,grow:bit=true)->Interp:
    @:settings(1,[],[(k:k,velocity:velocity,overshoot:overshoot,grow:grow)],[])
evaporate(temperature:num=1,spread:num=0.35,lift:num=0.65,seed:int=0,footprint:num=0.45,captureWidth:num=0.45,velocity:num=0.54,boundary:int=3,captureStart:num=0.35,captureEnd:num=0.85)->Interp:
    @:settings(2,[],[],[(temperature:temperature,spread:spread,lift:lift,seed:seed,footprint:footprint,boundary:boundary)],[(width:captureWidth,velocity:velocity,start_coordinate:time_coordinate(captureStart),finish_coordinate:time_coordinate(captureEnd))])

reveal_advance(value:Interp,front:num,elapsed:num)->num:
    valid(value)?! "invalid Interp settings"
    (value.mode>0 /\ |front|<10^10)?! "reveal advance requires finite text coordinate"
    velocity:0.54
    value.reveal.length()=1? .velocity:value.reveal.(0).velocity
    value.capture.length()=1? .velocity:value.capture.(0).velocity
    @:u.advance(front,elapsed,velocity)

TextFrame:(source_alpha:num,gas:[num],target:[num])
# One call per requested frame. Input ink triples are local x,y,coverage; target
# reading coordinates are cached native glyph order, not text or glyph bodies.
# Gas output is x,y,alpha,size; target output alpha,growth,r,g,b per glyph.
text_frame(value:Interp,q:num,source_ink:[num],target_reading:[num],front:num)->TextFrame:
    valid(value)?! "invalid Interp settings"
    (value.mode=1 /\ q>=0 /\ q<=1 /\ |front|<10^10)?! "text frame requires spectral mode; vapor needs prepared material transport"
    (source_ink.length()<=196608 /\ source_ink.length()%3=0 /\ target_reading.length()<=65536)?! "Interp text frame exceeds bounded layout"
    (source_ink.length()=0)?! "spectral frames do not accept material carriers"
    [num] gas:[]
    [num] target:[0:5*target_reading.length()]
    k:4.0
    overshoot:0.32
    grow:true
    value.reveal.length()=1?
        .k:value.reveal.(0).k
        .overshoot:value.reveal.(0).overshoot
        .grow:value.reveal.(0).grow
    coefficient:u.back_coefficient(overshoot)
    j:0
    .j:0
    j<target_reading.length()?>
        (|target_reading.(j)|<10^10)?! "invalid native glyph reading coordinate"
        a:u.alpha(front-target_reading.(j),k)
        # Endpoint packets are exact; the caller budgets front travel to avoid
        # an incomplete reading front jumping on the final endpoint.
        q=0? .a:0
        q=1? .a:1
        size:1.0
        grow? .size:u.growth(a,coefficient)
        target.(5*j):a
        target.(5*j+1):size
        target.(5*j+2):u.color_channel(a,0)
        target.(5*j+3):u.color_channel(a,1)
        target.(5*j+4):u.color_channel(a,2)
        .j:j+1
    @:(source_alpha:source_alpha(q),gas:gas,target:target)

# Material-carrying ink transport. The existing Morphing carrier ledger and
# segment evaluator are the ONLY interpolation backend. Noise is a finite
# seeded cubic field, not an integrated Wiener process or thermodynamic solver.
ink_state:.morphing.state
ink_segment:.morphing.segment
ink_math:.math
ink_transport:.morphing.ink_transport
MaterialPlan:(state:Plan,weights:[num],owners:[int],dimension:int,carriers:int,states:int)
VaporTransport:(material:MaterialPlan,turbulence:Plan,glyphs:[num],glyph_owners:[int],settings:Interp,source_count:int,target_count:int,exchange:int)
MaterialLedger:(source:num,gas:num,target:num,reservoir:num,emitted:num,exited:num)
VaporFrame:(source_alpha:num,gas:[num],target:[num],ledger:MaterialLedger)

ink_count(ink:[num])->int:
    (ink.length()>0 /\ ink.length()%7=0 /\ ink.length()<=458752)?! "material vapor needs nonempty bounded ink endpoints"
    count:ink.length()//7
    remaining:count
    remaining>1 /\ remaining%2=0?> .remaining:remaining//2
    (remaining=1)?! "material ink sample counts must be powers of two"
    i:0
    i<count?>
        (|ink.(7*i)|<100 /\ |ink.(7*i+1)|<100)?! "invalid native ink coordinate"
        j:2
        j<6?>
            (ink.(7*i+j)>=0 /\ ink.(7*i+j)<=1)?! "invalid native ink RGB or coverage"
            .j:j+1
        (ink.(7*i+5)>0 /\ ink.(7*i+6)>0 /\ ink.(7*i+6)<1000)?! "native ink needs positive coverage and footprint"
        .i:i+1
    @:count

# Ink rows: x,y,r,g,b,coverage,footprint; glyph rows: x,y,read,r,g,b,alpha.
# Positions use one common CSS-height chart, so nearest-anchor distances are
# actual Euclidean pixel distances up to the same common scale.
prepare_vapor_transport(value:Interp,source:[num],destination:[num],glyphs:[num])->VaporTransport:
    valid(value)?! "invalid Interp settings"
    (value.mode=2)?! "material transport requires vapor Interp"
    boundary:3
    lift:0.65
    value.vapor.length()=1?
        .boundary:value.vapor.(0).boundary
        .lift:value.vapor.(0).lift
    (source.length()%7=0 /\ destination.length()%7=0)?! "invalid material exchange sample stride"
    actual_source:source.length()//7
    actual_target:destination.length()//7
    (actual_source>0 \/ actual_target>0)?! "empty material exchange"
    exchange:0
    actual_source=0?
        (boundary=1 \/ boundary=3)?! "material emission requires declared boundary"
        .exchange:1
        .source:[0:destination.length()]
        i:0
        i<destination.length()?>
            source.(i):destination.(i)
            .i:i+1
        .i:0
        i<actual_target?>
            source.(7*i+1):source.(7*i+1)-0.08*lift
            .i:i+1
    actual_target=0?
        (boundary=2 \/ boundary=3)?! "material exit requires declared boundary"
        .exchange:2
        .destination:[0:source.length()]
        i:0
        i<source.length()?>
            destination.(i):source.(i)
            .i:i+1
        .i:0
        i<actual_source?>
            destination.(7*i+1):destination.(7*i+1)+0.35+0.1*lift
            .i:i+1
        .glyphs:[0,1.2,0,0,0,0,0]
    n:ink_count(source)
    mcount:ink_count(destination)
    ng:glyphs.length()//7
    i:0
    i<ng?>
        (|glyphs.(7*i)|<100 /\ |glyphs.(7*i+1)|<100 /\ |glyphs.(7*i+2)|<10^10)?! "invalid native target glyph anchor/read coordinate"
        j:3
        j<7?>
            (glyphs.(7*i+j)>=0 /\ glyphs.(7*i+j)<=1)?! "invalid native target authored RGBA"
            .j:j+1
        .i:i+1
    [num] weights:[0:n+mcount]
    [num] positions:[0:source.length()+destination.length()]
    .i:0
    i<n?>
        weights.(i):1/num(n)
        j:0
        j<7?>
            positions.(7*i+j):source.(7*i+j)
            .j:j+1
        .i:i+1
    .i:0
    [int] owners:[0:mcount]
    i<mcount?>
        weights.(n+i):1/num(mcount)
        j:0
        j<7?>
            positions.(7*(n+i)+j):destination.(7*i+j)
            .j:j+1
        destination_x:destination.(7*i)
        destination_y:destination.(7*i+1)
        nearest:0
        best:10^100
        .j:0
        j<ng?>
            dx:destination_x-glyphs.(7*j)
            dy:destination_y-glyphs.(7*j+1)
            distance:dx*dx+dy*dy
            distance<best?
                .best:distance
                .nearest:j
            .j:j+1
        owners.(i):nearest
        .i:i+1
    # Give every glyph capture control a positive assigned carrier when the
    # declared budget permits it. These are timing groups, not semantic IDs.
    (mcount>=ng)?! "material carrier budget below native glyph count"
    [int] assigned:[0:ng]
    .i:0
    i<mcount?>
        assigned.(owners.(i)):assigned.(owners.(i))+1
        .i:i+1
    .i:0
    i<ng?>
        assigned.(i)=0?
            candidate:-1
            best:10^100
            j:0
            j<mcount?>
                assigned.(owners.(j))>1?
                    dx:destination.(7*j)-glyphs.(7*i)
                    dy:destination.(7*j+1)-glyphs.(7*i+1)
                    distance:dx*dx+dy*dy
                    distance<best?
                        .best:distance
                        .candidate:j
                .j:j+1
            (candidate>=0)?! "unassigned native capture control"
            assigned.(owners.(candidate)):assigned.(owners.(candidate))-1
            owners.(candidate):i
            assigned.(i):1
        .i:i+1
    material:m.prepare_material([0,1],[0,n,n+mcount],weights,positions,7,0,false,false)
    count:material.carriers
    (count<=65536)?! "material vapor carrier cap exceeded"
    turbulence:vapor_turbulence(value)
    @:(material:material,turbulence:turbulence,glyphs:glyphs,glyph_owners:owners,settings:value,source_count:actual_source,target_count:actual_target,exchange:exchange)

# Delayed row front: material first dissolves/lifts, then the front captures it.
# q is already the shared eased coordinate, not another time easing.
vapor_front(value:Interp,q:num,travel:num)->num:
    valid(value)?! "invalid Interp settings"
    (value.mode=2 /\ q>=0 /\ q<=1 /\ travel>=0 /\ travel<10^10)?! "invalid material vapor front"
    width:0.45
    start:0.245
    finish:0.955
    value.capture.length()=1?
        .width:value.capture.(0).width
        .start:value.capture.(0).start_coordinate
        .finish:value.capture.(0).finish_coordinate
    lead:1.5*width
    q<start? @: -lead+q/start*lead
    @:u.clamp((q-start)/(finish-start),0,1)*travel

# Source mass / gas mass / captured mass sum to one. These are normalized
# material weights, not raster coverage or a claim of physical ink-area balance.
# Gas rows: x,y,alpha,footprint,r,g,b,mass,capture.
sample_vapor_transport(plan:VaporTransport,q:num,front:num)->VaporFrame:
    (q>=0 /\ q<=1 /\ |front|<10^10)?! "invalid material transport coordinate"
    value:plan.settings
    valid(value)?! "invalid material transport settings"
    # Project immutable prepared arrays once. Repeating nested record projection
    # inside the carrier loop needlessly traverses/copies the same large plans.
    material:plan.material
    values:material.state.curve.values
    owners:material.owners
    weights:material.weights
    glyphs:plan.glyphs
    glyph_owners:plan.glyph_owners
    turbulence:plan.turbulence.curve
    knots:turbulence.knots
    fluctuations:turbulence.values
    fluctuation_second:turbulence.second
    width:0.45
    value.capture.length()=1? .width:value.capture.(0).width
    temperature:1.0
    spread:0.35
    lift:0.65
    footprint:0.45
    value.vapor.length()=1?
        .temperature:value.vapor.(0).temperature
        .spread:value.vapor.(0).spread
        .lift:value.vapor.(0).lift
        .footprint:value.vapor.(0).footprint
    release:u.clamp(q/0.25,0,1)
    lead:1.5*width
    count:material.carriers
    destination_count:plan.target_count
    plan.exchange=2? .destination_count:plan.source_count
    ng:glyphs.length()//7
    (count>0 /\ count<=65536 /\ ng>0 /\ ng<=4096 /\ weights.length()=count /\ owners.length()=2*count /\ values.length()=14*count /\ glyph_owners.length()=destination_count)?! "invalid bounded prepared material layout"
    [num] gas:[0:9*count]
    [num] target:[0:5*ng]
    [num] captures:[0:ng]
    [num] target_mass:[0:ng]
    [num] captured:[0:ng]
    i:0
    i<ng?>
        a:u.clamp((front-glyphs.(7*i+2))/width,0,1)
        q=0? .a:0
        q=1? .a:1
        captures.(i):a
        target.(5*i+1):1
        j:0
        j<3?>
            target.(5*i+2+j):glyphs.(7*i+3+j)
            .j:j+1
        .i:i+1
    segment:ink_state.interval(knots,q)
    h:knots.(segment+1)-knots.(segment)
    local:(q-knots.(segment))/h
    wind_x:ink_segment.value(fluctuations.(segment*2),fluctuations.(segment*2+2),fluctuation_second.(segment*2),fluctuation_second.(segment*2+2),h,local)
    wind_y:ink_segment.value(fluctuations.(segment*2+1),fluctuations.(segment*2+3),fluctuation_second.(segment*2+1),fluctuation_second.(segment*2+3),h,local)
    carrier_params:[q,release,temperature,spread,lift,footprint,width,wind_x,wind_y,front,num(count),num(ng),0,0]
    gas_mass:0.0
    captured_mass:0.0
    .i:0
    i<count?>
        destination:owners.(count+i)
        glyph:glyph_owners.(destination)
        a:captures.(glyph)
        progress:u.clamp((front-glyphs.(7*glyph+2)+lead)/lead,0,1)
        q=0? .progress:0
        q=1? .progress:1
        channels:ink_transport.carrier(i,carrier_params,values,glyph,glyphs.(7*glyph+2))
        fraction:release*(1-a)
        mass:weights.(i)
        j:0
        j<7?>
            gas.(9*i+j):channels.(j)
            .j:j+1
        gas.(9*i+7):mass
        gas.(9*i+8):a
        target_mass.(glyph):target_mass.(glyph)+mass
        captured.(glyph):captured.(glyph)+mass*release*a
        .gas_mass:gas_mass+mass*fraction
        .captured_mass:captured_mass+mass*release*a
        .i:i+1
    .i:0
    i<ng?>
        target_mass.(i)>0? target.(5*i):captured.(i)/target_mass.(i)*glyphs.(7*i+6)
        .i:i+1
    source:1-release
    reservoir:0.0
    emitted:0.0
    exited:0.0
    plan.exchange=1?
        .source:0
        .reservoir:1-release
        .emitted:release
    plan.exchange=2?
        .exited:captured_mass
        .captured_mass:0
    @:(source_alpha:source,gas:gas,target:target,ledger:(source:source,gas:gas_mass,target:captured_mass,reservoir:reservoir,emitted:emitted,exited:exited))

# Related rows explicitly supplied by the author. Identity integers denote exact
# native physical glyph/rule sources, not semantic characters or triangle meshes.
GlyphEndpoint:(identity:[int],matrix:[num],color:[num])
GlyphStatePlan:(state:Plan,source_indices:[int],target_indices:[int],count:int)
prepare_glyph_state(value:Interp,source:GlyphEndpoint,target:GlyphEndpoint)->GlyphStatePlan:
    valid(value)?! "invalid glyph state settings"
    (value.mode=0)?! "glyph pose interpolation requires state mode"
    a:source.identity
    b:target.identity
    n:a.length()
    k:b.length()
    (n<=256 /\ k<=256 /\ source.matrix.length()=6*n /\ source.color.length()=4*n /\ target.matrix.length()=6*k /\ target.color.length()=4*k)?! "bounded native glyph row storage"
    c:0
    c<source.color.length()?>
        (source.color.(c)>=0 /\ source.color.(c)<=1)?! "invalid native source glyph RGBA"
        .c:c+1
    .c:0
    c<target.color.length()?>
        (target.color.(c)>=0 /\ target.color.(c)<=1)?! "invalid native target glyph RGBA"
        .c:c+1
    [int] scores:[0:(n+1)*(k+1)]
    i:n-1
    i>=0?>
        j:k-1
        j>=0?>
            at:i*(k+1)+j
            a.(i)=b.(j)? scores.(at):1+scores.((i+1)*(k+1)+j+1)
            a.(i)!=b.(j)?
                below:scores.((i+1)*(k+1)+j)
                right:scores.(i*(k+1)+j+1)
                scores.(at):below
                right>below? scores.(at):right
            .j:j-1
        .i:i-1
    [int] origins:[-1:k]
    [int] destinations:[-1:n]
    .i:0
    j:0
    i<n /\ j<k?>
        same:a.(i)=b.(j)
        same?
            origins.(j):i
            destinations.(i):j
            .i:i+1
            .j:j+1
        same=false?
            below:scores.((i+1)*(k+1)+j)
            right:scores.(i*(k+1)+j+1)
            below>=right? .i:i+1
            below<right? .j:j+1
    count:k
    .i:0
    i<n?>
        destinations.(i)<0? .count:count+1
        .i:i+1
    [int] from:[-1:count]
    [int] to:[-1:count]
    .j:0
    j<k?>
        from.(j):origins.(j)
        to.(j):j
        .j:j+1
    at:k
    .i:0
    i<n?>
        destinations.(i)<0?
            from.(at):i
            .at:at+1
        .i:i+1
    width:10*count
    width=0? @:(state:m.prepare([0,1],[0,0],1,0,false,false),source_indices:from,target_indices:to,count:0)
    [num] states:[0:2*width]
    .i:0
    i<count?>
        fi:from.(i)
        ti:to.(i)
        .j:0
        j<6?>
            fi>=0? states.(10*i+j):source.matrix.(6*fi+j)
            fi<0? states.(10*i+j):target.matrix.(6*ti+j)
            ti>=0? states.(width+10*i+j):target.matrix.(6*ti+j)
            ti<0? states.(width+10*i+j):source.matrix.(6*fi+j)
            .j:j+1
        .j:0
        j<4?>
            fi>=0? states.(10*i+6+j):source.color.(4*fi+j)
            fi<0? states.(10*i+6+j):target.color.(4*ti+j)
            ti>=0? states.(width+10*i+6+j):target.color.(4*ti+j)
            ti<0? states.(width+10*i+6+j):source.color.(4*fi+j)
            .j:j+1
        fi<0? states.(10*i+9):0
        ti<0? states.(width+10*i+9):0
        .i:i+1
    @:(state:prepare(value,[0,1],states,width),source_indices:from,target_indices:to,count:count)

TextRowPlan:(mode:int,state:[GlyphStatePlan],vapor:[VaporTransport],travel:num)
TextRowFrame:(poses:[num],source_alpha:num,gas:[num],target:[num],ledger:MaterialLedger)
TextBatchFrame:(coordinate:num,rows:[TextRowFrame])
# The shared global clock is applied exactly once for the entire prepared list.
sample_text_rows(rows:[TextRowPlan],q:num,fronts:[num])->TextBatchFrame:
    (rows.length()<=128 /\ (fronts.length()=0 \/ fronts.length()=rows.length()))?! "bounded text row batch"
    coordinate:time_coordinate(q)
    [TextRowFrame] frames:[]
    i:0
    i<rows.length()?>
        row:rows.(i)
        [num] poses:[]
        [num] gas:[]
        [num] target:[]
        source:0.0
        ledger:(source:0.0,gas:0.0,target:0.0,reservoir:0.0,emitted:0.0,exited:0.0)
        row.mode=0?
            (row.state.length()=1 /\ row.vapor.length()=0)?! "invalid prepared state row"
            state_plan:row.state.(0)
            state_plan.count>0? .poses:m.sample(state_plan.state,coordinate).value
        row.mode=2?
            (row.state.length()=0 /\ row.vapor.length()=1)?! "invalid prepared material row"
            vapor_plan:row.vapor.(0)
            front:vapor_front(vapor_plan.settings,coordinate,row.travel)
            fronts.length()>0? .front:fronts.(i)
            sampled:sample_vapor_transport(vapor_plan,coordinate,front)
            .source:sampled.source_alpha
            .gas:sampled.gas
            .target:sampled.target
            .ledger:sampled.ledger
        (row.mode=0 \/ row.mode=2)?! "unsupported prepared text row"
        .frames:frames & [(poses:poses,source_alpha:source,gas:gas,target:target,ledger:ledger)]
        .i:i+1
    @:(coordinate:coordinate,rows:frames)

# Shared seeded field, independent of raster/carrier count.
vapor_turbulence(value:Interp)->Plan:
    seed:0
    value.vapor.length()=1? .seed:value.vapor.(0).seed
    [num] knots:[0:13]
    [num] fluctuations:[0:13*2]
    tick:0
    tick<13?>
        knots.(tick):num(tick)/12
        fluctuations.(tick*2):2*noise(0,seed,2*tick)-1
        fluctuations.(tick*2+1):2*noise(0,seed,2*tick+1)-1
        .tick:tick+1
    @:m.prepare(knots,fluctuations,2,1,false,false)

# Bounded native dense specialization: equal dyadic endpoint partitions have
# owner(i)=i and mass(i)=1/N, exactly the prepare_material equal-weight case.
# Ink remains external renderer data consumed by compiler-owned field dispatch.
MomentumEndpoints:(source:[num],target:[num])
DenseVaporPlan:(settings:Interp,turbulence:Plan,count:int,glyphs:[num],exchange:int,momentum:MomentumEndpoints,unclaimed:bit,raw_count:int,fresh_count:int,height:num)
DenseVaporFrame:(params:[num],source_alpha:num)
prepare_dense_vapor(value:Interp,count:int,source_present:bit,target_present:bit,glyphs:[num])->DenseVaporPlan:
    valid(value)?! "invalid dense Interp settings"
    (value.mode=2 /\ count>0 /\ count<=131072 /\ (source_present \/ target_present) /\ glyphs.length()>0 /\ glyphs.length()%7=0 /\ glyphs.length()<=28672)?! "invalid dense material plan"
    n:count
    n>1 /\ n%2=0?> .n:n//2
    (n=1)?! "dense material requires dyadic count"
    boundary:3
    value.vapor.length()=1? .boundary:value.vapor.(0).boundary
    exchange:0
    ~source_present?
        (boundary=1 \/ boundary=3)?! "material emission requires declared boundary"
        .exchange:1
    ~target_present?
        (boundary=2 \/ boundary=3)?! "material exit requires declared boundary"
        .exchange:2
    @:(settings:value,turbulence:vapor_turbulence(value),count:count,glyphs:glyphs,exchange:exchange,momentum:(source:[0,0],target:[0,0]),unclaimed:false,raw_count:count,fresh_count:count,height:1)

# coordinate has ALREADY passed the single shared text batch clock.
dense_vapor_frame(plan:DenseVaporPlan,coordinate:num,travel:num,front_override:[num])->DenseVaporFrame:
    (coordinate>=0 /\ coordinate<=1 /\ front_override.length()<=1)?! "invalid dense frame coordinate"
    value:plan.settings
    front:vapor_front(value,coordinate,travel)
    front_override.length()=1? .front:front_override.(0)
    width:0.45
    temperature:1.0
    spread:0.35
    lift:0.65
    footprint:0.45
    value.capture.length()=1? .width:value.capture.(0).width
    value.vapor.length()=1?
        .temperature:value.vapor.(0).temperature
        .spread:value.vapor.(0).spread
        .lift:value.vapor.(0).lift
        .footprint:value.vapor.(0).footprint
    wind:m.sample(plan.turbulence,coordinate).value
    release:u.clamp(coordinate/0.25,0,1)
    value.vapor.length()=1 /\ value.vapor.(0).boundary=0 /\ value.capture.length()=1? .release:u.clamp(coordinate/u.maximum(0.000001,value.capture.(0).start_coordinate),0,1)
    source:1-release
    plan.exchange=1? .source:0
    complete:0.0
    ~plan.unclaimed /\ coordinate>=value.capture.(0).finish_coordinate? .complete:1
    role:0.0
    plan.unclaimed? .role:1
    local_time:coordinate
    ~plan.unclaimed? .local_time:u.clamp(coordinate/u.maximum(0.000001,value.capture.(0).finish_coordinate),0,1)
    @:(params:[coordinate,release,temperature,spread,lift,footprint,width,wind.(0),wind.(1),front,num(plan.count),num(plan.glyphs.length()//7),num(plan.exchange),1,1,local_time,plan.momentum.source.(0),plan.momentum.source.(1),plan.momentum.target.(0),plan.momentum.target.(1),complete,role,0,plan.height,num(plan.raw_count),num(plan.fresh_count)],source_alpha:source)

DenseCaptureFrame:(source_alpha:num,gas:[num],target:[num],ledger:MaterialLedger,mass_residual:num,assigned_mass:num,optical_gas_coverage:num,raw_coverage:num,raw_gas_mass:num,raw_captured_mass:num,momentum:[num],raw_source_mass:num)
finish_dense_capture(plan:DenseVaporPlan,controls:DenseVaporFrame,summary:[num])->DenseCaptureFrame:
    ng:plan.glyphs.length()//7
    chunks:(plan.count+65535)//65536
    (summary.length()=16*ng*chunks)?! "invalid material capture summary"
    [num] target:[0:5*ng]
    gas:0.0
    captured:0.0
    assigned:0.0
    optical:0.0
    raw:0.0
    raw_gas:0.0
    raw_captured:0.0
    px:0.0
    py:0.0
    source:0.0
    raw_source:0.0
    i:0
    i<ng?>
        local_assigned:0.0
        local_captured:0.0
        j:0
        j<chunks?>
            at:16*(j*ng+i)
            .gas:gas+summary.(at+5)
            .captured:captured+summary.(at+6)
            .assigned:assigned+summary.(at+7)
            .local_assigned:local_assigned+summary.(at+7)
            .local_captured:local_captured+summary.(at+6)
            .optical:optical+summary.(at+8)
            .raw:raw+summary.(at+9)
            .raw_gas:raw_gas+summary.(at+10)
            .raw_captured:raw_captured+summary.(at+11)
            .px:px+summary.(at+12)
            .py:py+summary.(at+13)
            .source:source+summary.(at+14)
            .raw_source:raw_source+summary.(at+15)
            .j:j+1
        local_assigned>0? target.(5*i):local_captured/local_assigned*plan.glyphs.(7*i+6)
        target.(5*i+1):1
        .j:0
        j<3?>
            target.(5*i+2+j):plan.glyphs.(7*i+3+j)
            .j:j+1
        .i:i+1
    (|assigned-1|<0.001)?! "material pool lineage not assigned"
    residual:source+gas+captured-assigned
    (|residual|<0.001)?! "material stock reduction exceeds real-f32 tolerance"
    .source:u.clamp(source,0,1)
    .captured:u.clamp(captured,0,1-source)
    .gas:1-source-captured
    controls.params.(20)=1 /\ ~plan.unclaimed?
        .source:0
        .gas:0
        .captured:1
    plan.unclaimed?
        .captured:0
        .gas:1-source
    @:(source_alpha:controls.source_alpha,gas:[],target:target,ledger:(source:source,gas:gas,target:captured,reservoir:0,emitted:0,exited:0),mass_residual:residual,assigned_mass:assigned,optical_gas_coverage:optical,raw_coverage:raw,raw_gas_mass:raw_gas,raw_captured_mass:raw_captured,momentum:[px,py],raw_source_mass:raw_source)

# Plain authored-color front. No spectral RGB, growth or overshoot settings.
wave(k:num=4,start:num=0,finish:num=1)->Interp:
    @:settings(3,[],[],[],[],[(k:k,start_coordinate:time_coordinate(start),finish_coordinate:time_coordinate(finish))])
plain_wave_frame(value:Interp,coordinate:num,reading:[num],colors:[num],travel:num)->[num]:
    valid(value)?! "invalid plain wave Interp"
    (value.mode=3 /\ coordinate>=0 /\ coordinate<=1 /\ reading.length()<=4096 /\ colors.length()=4*reading.length() /\ travel>0)?! "invalid plain wave frame"
    k:4.0
    start:0.0
    finish:1.0
    value.wave.length()=1?
        .k:value.wave.(0).k
        .start:value.wave.(0).start_coordinate
        .finish:value.wave.(0).finish_coordinate
    front:u.clamp((coordinate-start)/(finish-start),0,1)*travel
    [num] result:[0:5*reading.length()]
    i:0
    i<reading.length()?>
        result.(5*i):u.alpha(front-reading.(i),k)*colors.(4*i+3)
        result.(5*i+1):1
        j:0
        j<3?>
            result.(5*i+2+j):colors.(4*i+j)
            .j:j+1
        .i:i+1
    @:result

# Generic native removed-ink pool; caller identities are renderer-owned data.
prepare_material_pool(value:Interp,count:int,glyphs:[num],momentum:MomentumEndpoints,unclaimed:bit,raw_count:int,fresh_count:int,height:num)->DenseVaporPlan:
    valid(value)?! "invalid material pool settings"
    (value.mode=2 /\ value.vapor.length()=1 /\ value.vapor.(0).boundary=0 /\ value.capture.length()=1 /\ momentum.source.length()=2 /\ momentum.target.length()=2 /\ raw_count>0 /\ raw_count<=count /\ fresh_count>=0 /\ fresh_count<=raw_count /\ height>0 /\ height<=4096)?! "material pool requires closed native sources"
    i:0
    i<2?>
        (|momentum.source.(i)|<10^10 /\ |momentum.target.(i)|<10^10)?! "invalid native momentum endpoint"
        .i:i+1
    plan:prepare_dense_vapor(value,count,true,true,glyphs)
    @:(settings:plan.settings,turbulence:plan.turbulence,count:plan.count,glyphs:plan.glyphs,exchange:0,momentum:momentum,unclaimed:unclaimed,raw_count:raw_count,fresh_count:fresh_count,height:height)
material_pool_time(previous:num,coordinate:num)->num:
    (previous>=0 /\ previous<10^10 /\ coordinate>=0 /\ coordinate<=1)?! "invalid material pool clock"
    @:previous+coordinate
