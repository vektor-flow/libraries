            .kind:"sizedglyph"
            .diagnostics:repair(diagnostics,"Unmatched right delimiter")
            detailed? .details:issues.add(details,source,token_begin,position,"Unmatched right delimiter",fonts)
        raw="\\end"?
            unmatched_environment:read(source,position)
            .position:unmatched_environment.stop
            .kind:"hole"
            .properties:attributes(kind)
            .diagnostics:raw_diagnostics(diagnostics,unmatched_environment.present,unmatched_environment.closed)
            detailed? .details:issues.raw(details,source,unmatched_environment.start,unmatched_environment.stop,unmatched_environment.present,unmatched_environment.closed)
            .diagnostics:repair(diagnostics,"Unmatched environment end")
            detailed? .details:issues.add(details,source,token_begin,position,"Unmatched environment end",fonts)
        text_family:text_parser.family(raw,"mathrm")
        text_command:text_family~="" \/ raw="\\tag" \/ raw="\\operatorname"
        text_command?
            .kind:"textflow"
            .properties:attributes(kind)
            star:false
            (raw="\\tag" \/ raw="\\operatorname") /\ ~vkf_string_eof(source,position)?
                text.at(source,position)="*"?
                    .star:true
                    .position:position+1
            flag:"false"
            star? .flag:"true"
            raw="\\tag"?
                .kind:"tag"
                .properties:attributes(kind)&",\"star\":"&flag
            raw="\\operatorname"? .properties:properties&",\"class\":\"op\",\"operatorLimits\":"&flag
            text_family=""? .text_family:"mathrm"
            text_group:read(source,position)
            .position:text_group.stop
            .diagnostics:raw_diagnostics(diagnostics,text_group.present,text_group.closed)
            detailed? .details:issues.raw(details,source,text_group.start,text_group.stop,text_group.present,text_group.closed)
            leaves:text_parser.parse(text_group.value,depth,text_family)
            .diagnostics:merge_diagnostics(diagnostics,leaves.diagnostics)
            detailed? .details:issues.merge(details,source,token_begin,position,leaves.diagnostics,fonts)
            count+leaves.count+1>=capacity?>
                .kinds:kinds&chunks.empty(capacity)
                .attrs:attrs&chunks.empty(capacity)
                .first:first&nil(capacity)
                .last:last&nil(capacity)
                .nexts:nexts&nil(capacity)
                .a:a&nil(capacity)
                .b:b&nil(capacity)
                .sup:sup&nil(capacity)
                .sub:sub&nil(capacity)
                .limits:limits&nil(capacity)
                .capacity:capacity*2
            text_list:count
            .count:count+1
            kinds.(text_list):"list"
            a.(target):text_list
            leaf_kinds:leaves.kinds
            leaf_attrs:leaves.attrs
            leaf_index:0
            leaf_index<leaves.count?>
                kinds.(count):leaf_kinds.(leaf_index)
                attrs.(count):leaf_attrs.(leaf_index)
                first.(text_list)<0? first.(text_list):count
                last.(text_list)>=0? nexts.(last.(text_list)):count
                last.(text_list):count
                .count:count+1
                .leaf_index:leaf_index+1
        (raw="\\\\" \/ raw="\\newline")?
            gap:raw_option(source,position)
            gap.present /\ ~gap.closed? .diagnostics:repair(diagnostics,"Inferred a closing option bracket")
            gap.present /\ ~gap.closed? detailed? .details:issues.add(details,source,gap.start,gap.stop,"Inferred a closing option bracket",fonts)
            gap.present? .position:gap.stop
            .kind:"break"
            .properties:attributes(kind)&",\"gap\":"&j.quote(gap.value)
        # Every ordinary glyph is checked against the installed generic font.
        kind="glyph" /\ raw~="\\not" /\ hook.kind~="glyph"?
            ~catalog.find(fonts,"math/display/"&glyph_token).found?
                .kind:"hole"
                .properties:attributes(kind)
                prefix:"Unsupported symbol: "
                text.matches(raw,0,"\\")? .prefix:"Unfinished or unsupported command: "
                .diagnostics:repair(diagnostics,prefix&glyph_token)
                detailed?
                    position=text.byte_length(source) /\ packages.command_prefix(context,raw)?
                        .details:issues.record(details,source,token_begin,position,"INCOMPLETE-COMMAND",true,"This command name is unfinished.","Continue typing the command name.")
                    ~(position=text.byte_length(source) /\ packages.command_prefix(context,raw))? .details:issues.add(details,source,token_begin,position,prefix&glyph_token,fonts)
            kind="glyph" /\ tokens.one_of(glyph_token,["\\ldots","\\cdots","\\ddots"])?
                .properties:properties&",\"class\":\"inner\""
                glyph_token="\\cdots"?
                    dot_after:tokens.peek(source,position)
                    extra:dots.extra(dot_after.raw)
                    context.restricted /\ ~context.amsmath? .extra:"false"
                    .properties:properties&",\"ellipsisExtra\":"&extra
        kinds.(target):kind
        kind="sizedglyph"? kinds.(target):"glyph"
        attrs.(target):properties
        matrix_start?
            rows_root:count
            row_node:count+1
            .count:count+2
            a.(target):rows_root
            b.(target):0
            kinds.(rows_root):"matrix"
            matrix_shorthand? kinds.(rows_root):"matrixBrace"
            attrs.(rows_root):environment_name
            first.(rows_root):row_node
            last.(rows_root):row_node
            kinds.(row_node):"row"
            task_mode.(top):6
            task_node.(top):target
            task_depth.(top):depth
            task_origin.(top):token_begin
            task_stop.(top):"start"
            .top:top+1
            @>
        arity>0?
            body:count
            .count:count+1
            kinds.(body):"list"
            a.(target):body
            kind="arrow"?
                a.(target): -1
                sup.(target):body
            close_stop~=""?
                task_mode.(top):4
                task_node.(top):target
                task_depth.(top):depth
                task_origin.(top):token_begin
                task_stop.(top):close_stop
                .top:top+1
            arity=2?
                denominator:count
                .count:count+1
                kinds.(denominator):"list"
                b.(target):denominator
                stacked?
                    a.(target):denominator
                    b.(target): -1
                    sup.(target):body
                    raw="\\underset"?
                        sup.(target): -1
                        sub.(target):body
                task_mode.(top):2
                task_node.(top):denominator
                task_depth.(top):depth
                task_origin.(top):token_begin
                .top:top+1
            ~strut /\ ~empty_body?
                task_mode.(top):2
                task_node.(top):body
                task_depth.(top):depth
                task_origin.(top):token_begin
                body_stop~=""?
                    task_mode.(top):0
                    task_stop.(top):body_stop
                    task_depth.(top):depth+1
                    task_origin.(top):token_begin
                .top:top+1
            strut?
                kinds.(count):"glyph"
                attrs.(count):glyph("(")
                first.(body):count
                last.(body):count
                .count:count+1
            integral_dots?
                kinds.(count):"space"
                attrs.(count):attributes("space")&",\"mu\":-3"
                kinds.(count+1):"glyph"
                attrs.(count+1):glyph("\\cdots")&",\"class\":\"inner\",\"ellipsisExtra\":false"
                first.(body):count
                last.(body):count+1
                nexts.(count):count+1
                .count:count+2
            unit_command?
                task_mode.(top):8
                task_node.(top):body
                task_depth.(top):0
                task_origin.(top):token_begin
                task_index.(top):1
                task_limit.(top):text.byte_length(import_source)-1
                .top:top+1
            optional_index?
                index_list:count
                .count:count+1
                kinds.(index_list):"list"
                b.(target):index_list
                kind="arrow"?
                    b.(target): -1
                    sub.(target):index_list
                task_mode.(top):4
                task_node.(top):index_list
                task_depth.(top):depth
                task_origin.(top):token_begin
                task_stop.(top):"]"
                task_mode.(top+1):0
                task_node.(top+1):index_list
                task_depth.(top+1):depth+1
                task_origin.(top+1):token_begin
                task_stop.(top+1):"]"
                .top:top+2
    @:(arena:(kinds:kinds,attrs:attrs,first:first,last:last,nexts:nexts,a:a,b:b,sup:sup,sub:sub,limits:limits,count:count,diagnostics:diagnostics,atoms:atoms),issues:details)

node_json(arena:Arena,node:int)->str:
    kind:arena.kinds.(node)
    result:"{"&arena.attrs.(node)
    (kind="frac" \/ kind="quotient")?
        .result:result&",\"num\":"&list_json(arena,arena.a.(node))&",\"den\":"&list_json(arena,arena.b.(node))
    arena.a.(node)>=0 /\ kind~="frac" /\ kind~="quotient" /\ kind~="matrix"? .result:result&",\"children\":"&list_json(arena,arena.a.(node))
    kind="matrix"? .result:result&matrix_json(arena,node)
    kind="radical"?
        index:"null"
        arena.b.(node)>=0? .index:list_json(arena,arena.b.(node))
        .result:result&",\"index\":"&index
    arena.sup.(node)>=0? .result:result&",\"sup\":"&list_json(arena,arena.sup.(node))
    arena.sub.(node)>=0? .result:result&",\"sub\":"&list_json(arena,arena.sub.(node))
    kind="arrow" /\ arena.sub.(node)<0? .result:result&",\"sub\":null"
    arena.limits.(node)>=0?
        flag:"false"
        arena.limits.(node)=1? .flag:"true"
        .result:result&",\"limits\":"&flag
    @:result&"}"

matrix_json(arena:Arena,node:int)->str:
    firsts:arena.first
    nexts:arena.nexts
    arguments:arena.a
    attrs:arena.attrs
    limits:arena.limits
    root:arguments.(node)
    row:firsts.(root)
    capacity:16
    row_parts:chunks.empty(capacity)
    gap_parts:chunks.empty(capacity)
    row_count:0
    gap_count:0
    row>=0?>
        row_count=capacity?
            .row_parts:row_parts&chunks.empty(capacity)
            .gap_parts:gap_parts&chunks.empty(capacity)
            .capacity:capacity*2
        cell:firsts.(row)
        cell_parts:chunks.empty(16)
        cell_capacity:16
        cell_count:0
        cell>=0?>
            cell_count=cell_capacity?
                .cell_parts:cell_parts&chunks.empty(cell_capacity)
                .cell_capacity:cell_capacity*2
            cell_prefix:""
            cell_count>0? .cell_prefix:","
            cell_parts.(cell_count):cell_prefix&list_json(arena,cell)
            .cell_count:cell_count+1
            .cell:nexts.(cell)
        row_prefix:""
        row_count>0? .row_prefix:","
        row_parts.(row_count):row_prefix&"["&chunks.join(cell_parts,0,cell_count)&"]"
        limits.(row)=1?
            gap_prefix:""
            gap_count>0? .gap_prefix:","
            gap_parts.(gap_count):gap_prefix&attrs.(row)
            .gap_count:gap_count+1
        .row_count:row_count+1
        .row:nexts.(row)
    rule:arguments.(root)
    rule_parts:chunks.empty(16)
    rule_capacity:16
    rule_count:0
    rule>=0?>
        rule_count=rule_capacity?
            .rule_parts:rule_parts&chunks.empty(rule_capacity)
            .rule_capacity:rule_capacity*2
        rule_prefix:""
        rule_count>0? .rule_prefix:","
        rule_parts.(rule_count):rule_prefix&attrs.(rule)
        .rule_count:rule_count+1
        .rule:nexts.(rule)
    @:",\"rows\":["&chunks.join(row_parts,0,row_count)&"],\"rowGaps\":["&chunks.join(gap_parts,0,gap_count)&"],\"rules\":["&chunks.join(rule_parts,0,rule_count)&"]"

list_json(arena:Arena,list:int)->str:
    node:arena.first.(list)
    parts:chunks.empty(32)
    capacity:32
    count:0
    node>=0?>
        count=capacity?
            .parts:parts&chunks.empty(capacity)
            .capacity:capacity*2
        prefix:""
        count>0? .prefix:","
        parts.(count):prefix&node_json(arena,node)
        .count:count+1
        .node:arena.nexts.(node)
    @:"["&chunks.join(parts,0,count)&"]"

json(arena:Arena)->str:
    @:"{\"nodes\":"&list_json(arena,0)&",\"diagnostics\":["&arena.diagnostics&"],\"atoms\":"&text.integer(arena.atoms)&"}"

# Structured diagnostics are separate from preview's compatibility messages.
diagnose(source:str,fonts:Catalog,native:bit=true,source_name:str="<math>")->str:
    @:diagnose_with_context(source,fonts,packages.defaults(),native,source_name)

diagnose_with_context(source:str,fonts:Catalog,context:Context,native:bit=true,source_name:str="<math>")->str:
    position:0
    units:0
    ~vkf_string_eof(source,position)?>
        step:text.next(source,position)-position
        .units:units+1
        step=4? .units:units+1
        units>12000?
            detail:issues.record("",source,position,position+step,"LIMIT",false,"The expression exceeds the engine's 12,000 UTF-16-unit limit.","Split this expression into smaller expressions.")
            @:issues.report(detail,"Expression limit",source_name)
        .position:position+step
    result:analyze_with_context(source,fonts,context,native)
    @:issues.report(result.issues,result.arena.diagnostics,source_name)
