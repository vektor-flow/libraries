math_retained_directory:.math_retained_directory
Directory:(source:str,boxes:[str],count:int,prepared:bit)
# Current-source math AST arena. One parser loop owns its arrays; explicit tasks
# handle nesting without returning or copying a growing AST at each operand.
# Unsupported commands produce holes/diagnostics, never old or invented operands.
text:.tex_text
issues:.latex_diagnostics
tokens:.math_tokens
groups:.tex_groups
catalog:.font_catalog
j:.resource_json
chunks:.text_chunks
text_parser:.math_text
environments:.math_environments
dots:.math_dots
colors:.math_colors
unit_syntax:.unit_syntax
unit_numbers:.unit_numbers
unit_factors:.unit_factors
unit_symbols:.unit_symbols
unit_stream:.unit_stream
packages:.math_packages
fragments:.math_package_fragments
arena_import:.math_arena_import
Context:(restricted:bit,amsmath:bit,amsthm:bit,bbm:bit,latexsym:bit,faktor:bit,qed_symbol:str)
Catalog:(source:str,capacity:int,count:int,payload:int,size:int,valid:bit)
Arena:(kinds:[str],attrs:[str],first:[int],last:[int],nexts:[int],a:[int],b:[int],sup:[int],sub:[int],limits:[int],count:int,diagnostics:str,atoms:int)

nil(size:int)->[int]:[-1:size]

attributes(kind:str)->str:"\"type\":"&j.quote(kind)
named(kind:str,name:str)->str:attributes(kind)&",\"name\":"&j.quote(name)
glyph(token:str)->str:attributes("glyph")&",\"token\":"&j.quote(token)

repair(messages:str,message:str)->str:
    # JSON string spelling makes exact-message membership unambiguous.
    quoted:j.quote(message)
    text.find(","&messages&",",","&quoted&",")>=0? @:messages
    messages=""? @:quoted
    prior:j.parse("["&messages&"]")
    prior.count>=25? @:messages
    @:messages&","&quoted

merge_diagnostics(messages:str,additional:str)->str:
    additional=""? @:messages
    tape:j.parse("["&additional&"]")
    result:messages
    index:1
    index<tape.count?>
        .result:repair(result,j.string(tape,index))
        .index:index+1
    @:result

unary_kind(raw:str)->str:
    ~text.matches(raw,0,"\\")? @:""
    dots.capital_accent(raw)? @:"decoration"
    tokens.one_of(raw,["\\mathrm","\\mathbf","\\mathit","\\mathsf","\\mathtt","\\mathfrak","\\mathcal","\\mathscr","\\mathbb","\\mathbbold","\\mathnormal","\\boldsymbol","\\bm"])? @:"font"
    tokens.one_of(raw,["\\mathinner","\\mathord","\\mathbin","\\mathrel","\\mathop","\\mathopen","\\mathclose","\\mathpunct"])? @:"class"
    tokens.one_of(raw,["\\hat","\\widehat","\\tilde","\\widetilde","\\bar","\\vec","\\dot","\\ddot","\\dddot","\\ddddot","\\acute","\\grave","\\breve","\\check","\\mathring","\\overline","\\underline","\\overbrace","\\underbrace","\\overrightarrow","\\overleftarrow","\\overleftrightarrow","\\underrightarrow","\\underleftarrow","\\underleftrightarrow"])? @:"decoration"
    tokens.one_of(raw,["\\boxed","\\fbox","\\phantom","\\hphantom","\\vphantom","\\smash","\\mathstrut"])? @:"box"
    @:""

style(raw:str)->int:
    raw="\\displaystyle"? @:0
    raw="\\textstyle"? @:1
    raw="\\scriptstyle"? @:2
    raw="\\scriptscriptstyle"? @:3
    @: -1

spacing(raw:str)->int:
    raw="\\,"? @:3
    raw="\\:"? @:4
    raw="\\;"? @:5
    raw="\\!"? @: -3
    raw="\\quad"? @:18
    raw="\\qquad"? @:36
    (raw="\\ " \/ raw="~")? @:6
    @: -999

raw_diagnostics(messages:str,present:bit,closed:bit)->str:
    ~present? @:repair(messages,"Finish the braced argument")
    ~closed? @:repair(messages,"Inferred a closing brace")
    @:messages

read(source:str,begin:int,open:str="{",close:str="}")->(value:str,stop:int,present:bit,closed:bit,start:int):
    start:tokens.skip_space(source,begin)
    group:groups.read(source,start,open,close)
    @:(value:group.value,stop:group.stop,present:group.present,closed:group.closed,start:start)

# Raw bracket options stop at the first ] outside braces, as in the existing
# grammar; nested [ does not itself introduce another level.
raw_option(source:str,begin:int)->(value:str,stop:int,present:bit,closed:bit,start:int):
    position:tokens.skip_space(source,begin)
    vkf_string_eof(source,position)? @:(value:"",stop:position,present:false,closed:false,start:position)
    text.at(source,position)~="["? @:(value:"",stop:position,present:false,closed:false,start:position)
    .position:position+1
    start:position
    braces:0
    ~vkf_string_eof(source,position)?>
        c:text.at(source,position)
        .position:text.next(source,position)
        c="{"? .braces:braces+1
        c="}"? .braces:braces-1
        c="]" /\ braces=0? @:(value:text.span(source,start,position-1),stop:position,present:true,closed:true,start:start-1)
    @:(value:text.span(source,start,position),stop:position,present:true,closed:false,start:start-1)

matrix_boundary(raw:str,stop:str)->bit:
    (stop~="matrix" /\ stop~="matrixBrace")? @:false
    tokens.one_of(raw,["&","\\\\","\\end","\\right","\\hline","\\cline"])? @:true
    @:stop="matrixBrace" /\ raw="}"

dimension(source:str,begin:int)->(value:str,stop:int):
    position:tokens.skip_space(source,begin)
    start:position
    token:tokens.peek(source,position)
    (token.raw="+" \/ token.raw="-")? .position:token.stop
    digits:0
    point:false
    ~vkf_string_eof(source,position)?>
        c:text.at(source,position)
        ((c<"0" \/ c>"9") /\ (c~="." \/ point))? @|
        c="."? .point:true
        c~="."? .digits:digits+1
        .position:position+1
    digits=0? @:(value:"",stop:begin)
    .position:tokens.skip_space(source,position)
    unit:""
    ~vkf_string_eof(source,position+1)?
        initial:text.at(source,position)
        initial>="a" /\ initial<="z"?
            following:text.at(source,position+1)
            following>="a" /\ following<="z"? .unit:initial&following
    ~tokens.one_of(unit,["pt","bp","em","ex","mu","mm","cm","in","pc"])? @:(value:"",stop:begin)
    @:(value:text.span(source,start,position+2),stop:position+2)

# Tasks: 0=list, 1=base, 2=argument, 3=scripts, 4=delimiter, 6=matrix,
# 7=unit-produced node, 8=unit-produced list. Imported nodes do not count atoms.
# Only list tasks count atoms, matching the existing draft grammar.
Analysis:(arena:Arena,issues:str)

# Legacy AST/layout consumers keep their existing packet. Detailed validation is
# opt-in and uses the SAME parser decisions, not a second LaTeX grammar.
parse(source:str,fonts:Catalog,native:bit=true)->Arena:
    @:analyze(source,fonts,native,false).arena

parse_with_context(source:str,fonts:Catalog,context:Context,native:bit=true,document_boxes_json:str="{}")->Arena:
    @:analyze_with_context(source,fonts,context,native,false,document_boxes_json).arena

analyze(source:str,fonts:Catalog,native:bit=true,detailed:bit=true)->Analysis:
    @:analyze_with_context(source,fonts,packages.defaults(),native,detailed)

analyze_with_context(source:str,fonts:Catalog,context:Context,native:bit=true,detailed:bit=true,document_boxes_json:str="{}")->Analysis:
    @:analyze_context_depth(source,fonts,context,native,detailed,0,document_boxes_json)

parse_with_retained_context(source:str,fonts:Catalog,context:Context,native:bit,retained:Directory)->Arena:
    @:analyze_retained_depth(source,fonts,context,native,false,0,retained.source,retained).arena
analyze_with_retained_context(source:str,fonts:Catalog,context:Context,native:bit,detailed:bit,retained:Directory)->Analysis:
    @:analyze_retained_depth(source,fonts,context,native,detailed,0,retained.source,retained)
analyze_context_depth(source:str,fonts:Catalog,context:Context,native:bit,detailed:bit,extension_depth:int,document_boxes_json:str="{}")->Analysis:
    @:analyze_retained_depth(source,fonts,context,native,detailed,extension_depth,document_boxes_json,math_retained_directory.unprepared())

analyze_retained_depth(source:str,fonts:Catalog,context:Context,native:bit,detailed:bit,extension_depth:int,document_boxes_json:str,retained:Directory)->Analysis:
    (~packages.extension_limit(extension_depth))?! "Math extension nesting limit: 32"
    size:text.byte_length(source)
    # UTF-8 permits up to four bytes per source scalar. The stricter UTF-16
    # expression limit is checked before allocating the arena.
    scalars:0
    cursor:0
    cursor<size?>
        step:text.next(source,cursor)-cursor
        .scalars:scalars+1
        step=4? .scalars:scalars+1
        .cursor:cursor+step
    (scalars<=12000)?! "Expression limit: 12,000 characters"
    capacity:64
    kinds:chunks.empty(capacity)
    attrs:chunks.empty(capacity)
    first:nil(capacity)
    last:nil(capacity)
    nexts:nil(capacity)
    a:nil(capacity)
    b:nil(capacity)
    sup:nil(capacity)
    sub:nil(capacity)
    limits:nil(capacity)
    kinds.(0):"list"
    count:1
    atoms:0
    diagnostics:""
    details:""
    token_begin:0
    task_mode:[0:512]
    task_node:[0:512]
    task_depth:[0:512]
    task_origin:[0:512]
    task_index:[0:512]
    task_limit:[0:512]
    task_stop:chunks.empty(512)
    import_source:"[]"
    # One call owns a lazily loaded directory; ordinary math never parses it.
    directory:(source:"{}",kinds:nil(0),starts:nil(0),stops:nil(0),ends:nil(0),count:0,valid:false)
    directory_loaded:false
    top:1
    position:0
    top>0?>
        .top:top-1
        mode:task_mode.(top)
        target:task_node.(top)
        depth:task_depth.(top)
        origin:task_origin.(top)
        stop:task_stop.(top)
        detailed /\ (depth>32 \/ top>=500)?
            .diagnostics:repair(diagnostics,"Math parser limit exceeded")
            .details:issues.record(details,source,position,position,"LIMIT",false,"The expression exceeds the engine's nesting or task limit.","Reduce nesting or split the expression.",origin)
            @|
        (depth<=32)?! "Nesting limit: 32"
        (top<500)?! "Math parser task limit"
        # Every step can allocate at most eight nodes, including argument lists.
        count+8>=capacity?
            .kinds:kinds&chunks.empty(capacity)
            .attrs:attrs&chunks.empty(capacity)
            .first:first&nil(capacity)
            .last:last&nil(capacity)
            .nexts:nexts&nil(capacity)
            .a:a&nil(capacity)
            .b:b&nil(capacity)
            .sup:sup&nil(capacity)
            .sub:sub&nil(capacity)
            .limits:limits&nil(capacity)
            .capacity:capacity*2
        mode=8?
            imported_index:task_index.(top)
            imported_limit:task_limit.(top)
            imported_index>=imported_limit? @>
            imported_node:count
            .count:count+1
            first.(target)<0? first.(target):imported_node
            last.(target)>=0? nexts.(last.(target)):imported_node
            last.(target):imported_node
            imported_end:unit_stream.value_stop(import_source,imported_index)
            imported_next:tokens.skip_space(import_source,imported_end)
            imported_next<imported_limit?
                (text.at(import_source,imported_next)=",")?! "Unit AST list comma required"
                .imported_next:tokens.skip_space(import_source,imported_next+1)
            task_mode.(top):8
            task_node.(top):target
            task_depth.(top):0
            task_origin.(top):origin
            task_index.(top):imported_next
            task_limit.(top):imported_limit
            task_mode.(top+1):7
            task_node.(top+1):imported_node
            task_depth.(top+1):0
            task_origin.(top+1):origin
            task_index.(top+1):imported_index
            .top:top+2
            @>
        mode=7?
            object_index:task_index.(top)
            imported_meta:unit_stream.metadata(import_source,object_index)
            kinds.(target):imported_meta.kind
            attrs.(target):imported_meta.attrs
            limits.(target):imported_meta.limits
            role_starts:imported_meta.starts
            role_stops:imported_meta.stops
            role_index:0
            role_index<4?>
                role:role_index
                child_start:role_starts.(role_index)
                child_stop:role_stops.(role_index)
                .role_index:role_index+1
                child_start<0? @>
                child_list:count
                .count:count+1
                kinds.(child_list):"list"
                role=0? a.(target):child_list
                role=1? b.(target):child_list
                role=2? sup.(target):child_list
                role=3? sub.(target):child_list
                task_mode.(top):8
                task_node.(top):child_list
                task_depth.(top):0
                task_origin.(top):origin
                task_index.(top):child_start
                task_limit.(top):child_stop
                .top:top+1
            .position:position
            @>
        before_space:position
        .position:tokens.skip_space(source,position)
        .token_begin:position
        token:tokens.peek(source,position)
        raw:token.raw
        finishing:mode=0 /\ (raw="" \/ (stop~="" /\ raw=stop) \/ (stop="}" /\ tokens.boundary(raw)) \/ matrix_boundary(raw,stop))
        ~native /\ finishing /\ last.(target)>=0 /\ (first.(target)~=last.(target) \/ stop="")?
            final_node:last.(target)
            kinds.(final_node)="glyph"?
                metadata:j.parse("{"&attrs.(final_node)&"}")
                glyph_token:j.string(metadata,j.member(metadata,0,"token"))
                metric_source:catalog.raw(fonts,"math/display/"&glyph_token)
                metric_source~=""?
                    metric:j.parse(metric_source)
                    class_node:j.member(metric,0,"class")
                    class_node>=0?
                        noad_class:j.string(metric,class_node)
                        (noad_class="bin" \/ noad_class="rel")?
                            kinds.(count):"hole"
                            attrs.(count):attributes("hole")
                            nexts.(final_node):count
                            last.(target):count
                            .count:count+1
                            .diagnostics:repair(diagnostics,"Empty operand placeholder")
                            detailed? .details:issues.add(details,source,token_begin,position,"Empty operand placeholder",fonts)
        mode=0 /\ raw="" /\ stop="}"?
            .diagnostics:repair(diagnostics,"Inferred a closing brace")
            detailed? .details:issues.add(details,source,token_begin,position,"Inferred a closing brace",fonts,origin)
            first.(target)<0?
                kinds.(count):"hole"
                attrs.(count):attributes("hole")
                first.(target):count
                last.(target):count
                .count:count+1
        mode=0 /\ raw=""? @>
        mode=0?
            matrix_boundary(raw,stop)? @>
            stop="}" /\ raw="}"?
                .position:token.stop
                @>
            (stop~="" /\ raw=stop)? @>
            stop="}" /\ tokens.boundary(raw)?
                .diagnostics:repair(diagnostics,"Inferred a closing brace")
                detailed? .details:issues.add(details,source,token_begin,position,"Inferred a closing brace",fonts,origin)
                @>
            raw="}"?
                .position:token.stop
                .diagnostics:repair(diagnostics,"Ignored an unmatched closing brace")
                detailed? .details:issues.add(details,source,token_begin,position,"Ignored an unmatched closing brace",fonts)
                # Continue the current list: one stray brace must not discard
                # the rest of the source or hide later diagnostics.
                task_mode.(top):0
                task_node.(top):target
                task_depth.(top):depth
                task_origin.(top):origin
                task_stop.(top):stop
                .top:top+1
                @>
            detailed /\ atoms>=3000?
                .diagnostics:repair(diagnostics,"Atom limit: 3,000")
                .details:issues.record(details,source,token_begin,token.stop,"LIMIT",false,"The expression exceeds the engine's 3,000-atom limit.","Split this expression into smaller expressions.")
                @|
            node:count
            .count:count+1
            first.(target)<0? first.(target):node
            last.(target)>=0? nexts.(last.(target)):node
            last.(target):node
            .atoms:atoms+1
            (atoms<=3000)?! "Atom limit: 3,000"
            task_mode.(top):0
            task_node.(top):target
            task_depth.(top):depth
            task_origin.(top):origin
            task_stop.(top):stop
            task_mode.(top+1):3
            task_node.(top+1):node
            task_depth.(top+1):depth
            task_origin.(top+1):origin
            task_mode.(top+2):1
            task_node.(top+2):node
            task_depth.(top+2):depth
            task_origin.(top+2):token_begin
            .top:top+3
            @>
        mode=2?
            tokens.boundary(raw)?
                kinds.(count):"hole"
                attrs.(count):attributes("hole")
                first.(target):count
                last.(target):count
                .count:count+1
                .diagnostics:repair(diagnostics,"Empty operand placeholder")
                detailed? .details:issues.add(details,source,token_begin,position,"Empty operand placeholder",fonts)
                @>
            raw="{"?
                .position:token.stop
                task_mode.(top):0
                task_node.(top):target
                task_depth.(top):depth+1
                task_origin.(top):token_begin
                task_stop.(top):"}"
                .top:top+1
                @>
            argument_node:count
            .count:count+1
            first.(target):argument_node
            last.(target):argument_node
            .target:argument_node
            .depth:depth+1
            .mode:1
        mode=3?
            ~tokens.script(raw)? @>
            .position:token.stop
            (raw="\\limits" \/ raw="\\nolimits")?
                limits.(target):0
                raw="\\limits"? limits.(target):1
                task_mode.(top):3
                task_node.(top):target
                task_depth.(top):depth
                task_origin.(top):origin
                .top:top+1
                @>
            superscript:raw~="_"
            attachment:target
            existing:sup.(attachment)
            ~superscript? .existing:sub.(attachment)
            raw~="'" /\ existing>=0?
                .diagnostics:repair(diagnostics,"Grouped repeated scripts for preview")
                detailed? .details:issues.add(details,source,token_begin,position,"Grouped repeated scripts for preview",fonts)
                true?>
                    first.(existing)<0? @|
                    .attachment:first.(existing)
                    .existing:sup.(attachment)
                    ~superscript? .existing:sub.(attachment)
                    existing<0? @|
            script_list:count
            .count:count+1
            kinds.(script_list):"list"
            raw="'" /\ sup.(target)>=0?
                .script_list:sup.(target)
                .count:count-1
            superscript? sup.(attachment):script_list
            ~superscript? sub.(attachment):script_list
            task_mode.(top):3
            task_node.(top):target
            task_depth.(top):depth
            task_origin.(top):origin
            .top:top+1
            raw="'"?
                prime:count
                .count:count+1
                kinds.(prime):"glyph"
                attrs.(prime):glyph("\\prime")
                first.(script_list)<0? first.(script_list):prime
                last.(script_list)>=0? nexts.(last.(script_list)):prime
                last.(script_list):prime
                @>
            task_mode.(top):2
            task_node.(top):script_list
            task_depth.(top):depth
            task_origin.(top):origin
            .top:top+1
            @>
        mode=4?
            # The list stops before its right delimiter; ordinary scope closers
            # and \right take their delimiter only after the body is complete.
            right:"."
            raw=stop?
                .position:token.stop
                stop="\\right"?
                    .position:tokens.skip_space(source,position)
                    closing:tokens.peek(source,position)
                    .right:closing.value
                    .position:closing.stop
                    right=""?
                        .right:"."
                        .diagnostics:repair(diagnostics,"Inferred an invisible delimiter")
                        detailed? .details:issues.add(details,source,token_begin,position,"Inferred an invisible delimiter",fonts)
                stop~="\\right"? .right:stop
            raw~=stop /\ kinds.(target)="list"?
                .diagnostics:repair(diagnostics,"Inferred a closing label bracket")
                detailed? .details:issues.add(details,source,token_begin,position,"Inferred a closing label bracket",fonts)
            raw~=stop /\ kinds.(target)~="list"?
                stop="\\right"? .diagnostics:repair(diagnostics,"Inferred \\right.")
                stop="\\right"? detailed? .details:issues.add(details,source,token_begin,position,"Inferred \\right.",fonts,origin)
                stop~="\\right"? .diagnostics:repair(diagnostics,"Inferred an invisible closing scope")
                stop~="\\right"? detailed? .details:issues.add(details,source,token_begin,position,"Inferred an invisible closing scope",fonts)
            kinds.(target)~="list"? attrs.(target):attrs.(target)&",\"right\":"&j.quote(right)
            @>
        mode=6?
            rows:a.(target)
            row:last.(rows)
            matrix_name:attrs.(rows)
            shorthand:kinds.(rows)="matrixBrace"
            raw="\\end"?
                end_group:read(source,token.stop)
                .diagnostics:raw_diagnostics(diagnostics,end_group.present,end_group.closed)
                detailed? .details:issues.raw(details,source,end_group.start,end_group.stop,end_group.present,end_group.closed)
                end_group.value~=matrix_name? .diagnostics:repair(diagnostics,"Matched the unfinished environment")
                end_group.value~=matrix_name? detailed? .details:issues.add(details,source,token_begin,end_group.stop,"Matched the unfinished environment",fonts)
                stop="start" /\ b.(target)>0 /\ first.(row)<0?
                    previous_row:first.(rows)
                    nexts.(previous_row)~=row?> .previous_row:nexts.(previous_row)
                    nexts.(previous_row): -1
                    last.(rows):previous_row
                .position:end_group.stop
                @>
            stop="after"?
                raw="&"?
                    .position:token.stop
                    task_mode.(top):6
                    task_node.(top):target
                    task_depth.(top):depth
                    task_origin.(top):origin
                    task_stop.(top):"start"
                    .top:top+1
                    @>
                raw="\\\\"?
                    row_gap:raw_option(source,token.stop)
                    row_gap.present /\ ~row_gap.closed? .diagnostics:repair(diagnostics,"Inferred a closing option bracket")
                    row_gap.present /\ ~row_gap.closed? detailed? .details:issues.add(details,source,row_gap.start,row_gap.stop,"Inferred a closing option bracket",fonts)
                    attrs.(row):j.quote(row_gap.value)
                    limits.(row):1
                    new_row:count
                    .count:count+1
                    kinds.(new_row):"row"
                    nexts.(row):new_row
                    last.(rows):new_row
                    b.(target):b.(target)+1
                    .position:row_gap.stop
                    task_mode.(top):6
                    task_node.(top):target
                    task_depth.(top):depth
                    task_origin.(top):origin
                    task_stop.(top):"start"
                    .top:top+1
                    @>
                shorthand /\ raw="}"?
                    .position:token.stop
                    @>
                attrs.(target):attrs.(target)&",\"incomplete\":true"
                .diagnostics:repair(diagnostics,"Inferred \\end{"&matrix_name&"}")
                detailed? .details:issues.add(details,source,token_begin,position,"Inferred \\end{"&matrix_name&"}",fonts,origin)
                @>
            # The JavaScript loop checks end-of-source before skipping space.
            # Retain that distinction for a trailing empty row/cell in preview.
            before_space>=size?
                attrs.(target):attrs.(target)&",\"incomplete\":true"
                .diagnostics:repair(diagnostics,"Inferred \\end{"&matrix_name&"}")
                detailed? .details:issues.add(details,source,token_begin,position,"Inferred \\end{"&matrix_name&"}",fonts,origin)
                @>
            (raw="\\hline" \/ raw="\\cline")?
                .position:token.stop
                columns:"null"
                raw="\\cline"?
                    column_group:read(source,position)
                    .diagnostics:raw_diagnostics(diagnostics,column_group.present,column_group.closed)
                    detailed? .details:issues.raw(details,source,column_group.start,column_group.stop,column_group.present,column_group.closed)
                    .columns:j.quote(column_group.value)
                    .position:column_group.stop
                rule:count
                .count:count+1
                kinds.(rule):"row-rule"
                attrs.(rule):"{\"row\":"&text.integer(b.(target))&",\"columns\":"&columns&"}"
                a.(rows)<0? a.(rows):rule
                b.(rows)>=0? nexts.(b.(rows)):rule
                b.(rows):rule
                task_mode.(top):6
                task_node.(top):target
                task_depth.(top):depth
                task_origin.(top):origin
                task_stop.(top):"start"
                .top:top+1
                @>
            cell:count
            .count:count+1
            kinds.(cell):"list"
            first.(row)<0? first.(row):cell
            last.(row)>=0? nexts.(last.(row)):cell
            last.(row):cell
            task_mode.(top):6
            task_node.(top):target
            task_depth.(top):depth
            task_origin.(top):origin
            task_stop.(top):"after"
