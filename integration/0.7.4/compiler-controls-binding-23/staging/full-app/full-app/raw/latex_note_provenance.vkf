Packet:(keys:[str],xs:[num],ys:[num],flow_lines:[int],glyph_operations:[int],scenes:Store,scene_xs:[num],scene_ys:[num],scene_lines:[int],scene_operations:[int],scene_count:int,pending:[int],pending_count:int,complete:bit,lowering_complete:bit,glyph_count:int,line_heights:[num],line_depths:[num],line_widths:[num],line_baselines:[num],line_ratios:[num],line_indents:[num],line_flagged:[bit],line_count:int,width:num,height:num,depth:num,measurement_work:int,diagnostics:str,solved:bit,pass:int,a260_text:str,a260_starts:[int],a260_stops:[int],a272_anchor_operations:[int],a272_anchor_ids:[str],a277_anchor_scenes:[int],a280_anchor_leaves:[int],a280_anchor_slots:[int],a282_anchor_points:[int])
A267Origins:(scopes:[str],texts:[str],operations:[int],starts:[int],stops:[int],parts:[int],count:int)

# Capture at the parser producer, before note serialization and translation.
capture(q:Packet,scope:str)->A267Origins:
    scene:a267_linear.from_paragraph(q)
    arena:scene.arena
    scopes:arena.a260_scopes
    i:0
    i<arena.count?>
        scopes.(i):scope
        .i:i+1
    arena.a260_scopes:scopes
    scene.arena:arena
    a:scene.arena
    @:(scopes:a.a260_scopes,texts:a.a260_texts,operations:a.a260_operations,starts:a.a260_starts,stops:a.a260_stops,parts:a.a260_parts,count:a.count)
append(body:A267Origins,marker:A267Origins)->A267Origins:
    @:(scopes:body.scopes&marker.scopes,texts:body.texts&marker.texts,operations:body.operations&marker.operations,starts:body.starts&marker.starts,stops:body.stops&marker.stops,parts:body.parts&marker.parts,count:body.count+marker.count)
valid(p:A267Origins,count:int)->bit:
    @:count>=0 /\ p.count=count /\ p.scopes.length()=count /\ p.texts.length()=count /\ p.operations.length()=count /\ p.starts.length()=count /\ p.stops.length()=count /\ p.parts.length()=count
attach(input:Arena,p:A267Origins)->Arena:
    valid(p,input.count)?! "Note emission/provenance cardinality mismatch"
    out:input
    out.a260_scopes:p.scopes
    out.a260_texts:p.texts
    out.a260_operations:p.operations
    out.a260_starts:p.starts
    out.a260_stops:p.stops
    out.a260_parts:p.parts
    @:out
