number(tape:Tape,node:int,key:str,fallback:num=0)->num:document_materialize_config.number(tape,node,key,fallback)
flag(tape:Tape,node:int,key:str)->bit:document_present.flag(tape,node,key)
raw(tape:Tape,node:int)->str:document_materialize_config.raw(tape,node)
string(tape:Tape,node:int,key:str)->str:document_present.string(tape,node,key)
array_count(tape:Tape,node:int)->int:
    node<0? @:0
    ends:tape.ends
    count:0
    at:node+1
    at<ends.(node)?>
        .count:count+1
        .at:ends.(at)
    @:count
measure_block_core(plan:Plan,index:int,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,document_boxes_json:str,citation_labels_json:str,citation_separator:str,config:Tape,unit:num,global_links_json:str,tables:Tables,prepared:bit,legacy_output:bit=false):
    @:measure_block_retained_core(plan,index,fonts,roles,language,c,page_values,math_retained_directory.unprepared(document_boxes_json),citation_labels_json,citation_separator,config,unit,global_links_json,tables,prepared,legacy_output)
measure_block_retained_core(plan:Plan,index:int,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,retained:Directory,citation_labels_json:str,citation_separator:str,config:Tape,unit:num,global_links_json:str,tables:Tables,prepared:bit,legacy_output:bit=false,a261_blocks:[int]=[],a261_scopes:[str]=[],a261_texts:[str]=[],a263_kinds:[str]=[]):
    collected:collect_block_request(text_prepared_runs.empty_collection(),"",false,plan,index,fonts,roles,language,c,page_values,citation_labels_json,citation_separator,config,unit,global_links_json)
    request:text_prepared_runs.seal(fonts,collected.collection)
    @:measure_block_request_core(request,plan,index,fonts,roles,language,c,page_values,retained,citation_labels_json,citation_separator,config,unit,global_links_json,tables,prepared,legacy_output,a261_blocks,a261_scopes,a261_texts,a263_kinds)

measure_block_request_core(request:Prepared,plan:Plan,index:int,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,retained:Directory,citation_labels_json:str,citation_separator:str,config:Tape,unit:num,global_links_json:str,tables:Tables,prepared:bit,legacy_output:bit=false,a261_blocks:[int]=[],a261_scopes:[str]=[],a261_texts:[str]=[],a263_kinds:[str]=[]):
    kinds:plan.kinds
    sources:plan.sources
    contexts:plan.contexts
    attrs:plan.attrs
    ams:c.class_name="amsart"
    pt:tex_numeric.pt()
    first_paragraph:false
    index>0?
        previous:kinds.(index-1)
        .first_paragraph:previous="math" \/ (~ams /\ (previous="section" \/ previous="subsection"))
    diagnostics:""
    unresolved:""
    pending_pages:false
    kind:kinds.(index)
    context:document_present_context.parse(contexts.(index))
    document_links_json:global_links_json
    context.link_appearance~=""? .document_links_json:context.link_appearance
    properties:resource_json.parse("{"&attrs.(index)&"}")
    heading_config:resource_json.member(config,0,kind)
    titlepart:string(properties,0,"titlePart")
    heading:kind="section" \/ kind="subsection" \/ kind="title" \/ kind="author"
    paragraph:kind="paragraph"
    caption:kind="caption"
    verbatim:kind="verbatim"
    width:number(config,0,"textWidth")-context.left-context.right
    resolved:document_resolve.resolve(sources.(index),plan.references,page_values,citation_labels_json,citation_separator,document_materialize_config.has(c.packages,"biblatex"),c.hyperref,flag(config,0,"legacyEquationAnchor"),verbatim)
    .diagnostics:document_materialize_config.merge(diagnostics,resolved.diagnostics)
    resolved.pending_pages? .pending_pages:true
    role:context.font
    heading? .role:kind
    kind="abstractHeading"? .role:"smallbold"
    verbatim?
        .role:"mono"
        context.font="footnote"? .role:"footnotemono"
    legacy_scene:"{\"items\":[],\"lines\":[],\"width\":0,\"height\":0,\"depth\":0}"
    typed_scene:document_scene_json.empty()
    typed_label:document_scene_json.empty()
    legacy_label:""
    legacy_output? .legacy_label:"{}"
    columns:document_paragraph_metrics.empty()
    typed_paragraph:false
    kind="math"?
        measured:document_present.display_retained_core(resolved.source,fonts,c,context.font,width/unit,int(number(properties,0,"equationStart",1)),retained,tables,prepared)
        .legacy_scene:measured.json
        .diagnostics:document_materialize_config.merge(diagnostics,measured.diagnostics)
    kind="proofend"?
        .legacy_scene:math_qed_output.box_json(document_present.quad(fonts,"roman"))
        ams?
            glyph:font_catalog.math_symbol(fonts,"text","\\square")
            .legacy_scene:"{\"width\":"&json_numbers.roundtrip(number(glyph,0,"width"))&",\"height\":"&json_numbers.roundtrip(number(glyph,0,"height"))&",\"depth\":"&json_numbers.roundtrip(number(glyph,0,"depth"))&",\"items\":[{\"kind\":\"glyph\",\"key\":\"text/\\\\square\",\"x\":0,\"y\":0}]}"
    (paragraph \/ heading \/ verbatim \/ caption \/ kind="abstractHeading" \/ kind="subsubsection")?
        text_context:text_parser.context(role,roles,c.optical,c.hyperref)
        text_context.legacy_symbols:flag(config,0,"legacyTextSymbols")
        text_context.literal:verbatim
        text_context.literal_input:flag(properties,0,"fileInput")
        bibliography_text:string(config,0,"bibliographyStyle")~="" /\ context.kind="bibliography"
        text_context.bib_url:bibliography_text
        options:paragraph_breaking.options(width/unit)
        options.justify:paragraph
        options.tolerance:context.tolerance
        options.emergency:context.emergency
        paragraph?
            first_indent:0.0
            ((~first_paragraph \/ context.paragraph_after_display) /\ ~context.no_indent_after_list) \/ context.kind="description"? .first_indent:context.indent
            options.first_indent:first_indent/unit
            context.kind="verse"? options.forced_indent: -15*pt/unit
        text_options:paragraph_nodes.text_options()
        text_options.sentence_spacing:context.sentence
        text_options.french_spacing:bibliography_text
        text_options.space_scale:number(config,heading_config,"spaceScale",1)
        a261_scope:a261_routes.select(index,resolved.source,a261_blocks,a261_scopes,a261_texts,a263_kinds)
        q:text_source_paragraph.with_providers_request_core(request,resolved.source,fonts,text_context,c.math,language,c.overrides,options,text_options,text_inline_boxes.empty(),tables,prepared,retained.source,document_links_json)
        a261_scope=""? .typed_scene:document_scene_paragraph_linear.from_paragraph(q)
        a261_scope~=""? .typed_scene:document_scene_paragraph_linear.from_paragraph_owned(q,a261_scope)
        .columns:document_paragraph_metrics.paragraph(q.line_heights,q.line_depths,q.line_widths,q.line_baselines,q.line_indents,q.line_flagged,q.line_count,q.width,q.height,q.depth,typed_scene.tag_width)
        .typed_paragraph:true
        legacy_output? .legacy_scene:text_source_paragraph_output.scene(q)
        .diagnostics:document_materialize_config.merge(diagnostics,q.diagnostics)
        ~q.lowering_complete?
            unresolved~=""? .unresolved:unresolved&","
            .unresolved:unresolved&"{\"block\":"&tex_text.integer(index)&",\"reason\":\"Unresolved source paragraph operations\",\"source\":"&resource_json.quote(resolved.source)&"}"
    context.label~=""?
        label_role:"roman"
        ams /\ document_materialize_config.has(c.packages,"enumitem")? .label_role:context.font
        label_metrics:document_materialize_label_measure.measure(context.label,label_role,fonts,roles,language,c,tables,prepared,retained.source)
        a263_label_scope:a261_routes.select(index,context.label,a261_blocks,a261_scopes,a261_texts,a263_kinds,"label")
        a263_label_scope=""? .typed_label:document_scene_paragraph_linear.from_paragraph(label_metrics)
        a263_label_scope~=""? .typed_label:document_scene_paragraph_linear.from_paragraph_owned(label_metrics,a263_label_scope)
        legacy_output? .legacy_label:text_source_paragraph_output.scene(label_metrics)
        .diagnostics:document_materialize_config.merge(diagnostics,label_metrics.diagnostics)
    context.pending_outer_labels~="" /\ context.pending_outer_labels~="[]"?
        combined_labels:document_materialize_labels.compose(typed_label,context.pending_outer_labels,context.left,context.label_sep,fonts,roles,language,c,retained.source,index,a261_blocks,a261_scopes,a261_texts,a263_kinds)
        .typed_label:combined_labels.scene
        .diagnostics:document_materialize_config.merge(diagnostics,combined_labels.diagnostics)
    ~typed_paragraph /\ (kind="math" \/ kind="proofend")?
        .typed_scene:document_scene_json.decode(legacy_scene)
        .columns:document_paragraph_metrics.legacy(legacy_scene)
    ~legacy_output? .legacy_scene:""
    @:(scene:typed_scene,columns:columns,label:typed_label,legacy_scene:legacy_scene,legacy_label:legacy_label,diagnostics:diagnostics,unresolved:unresolved,pending_pages:pending_pages)

scene_at(values:[Measured],index:int):@:values.(index).scene
label_at(values:[Measured],index:int):@:values.(index).label

measure_block(plan:Plan,index:int,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,document_boxes_json:str,citation_labels_json:str,citation_separator:str,config:Tape,unit:num,global_links_json:str,legacy_output:bit=false):
    tables:text_source_paragraph.empty_tables()
    @:measure_block_core(plan,index,fonts,roles,language,c,page_values,document_boxes_json,citation_labels_json,citation_separator,config,unit,global_links_json,tables,false,legacy_output)
measure_block_prepared(plan:Plan,index:int,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,document_boxes_json:str,citation_labels_json:str,citation_separator:str,config:Tape,unit:num,global_links_json:str,tables:Tables,legacy_output:bit=false):
    @:measure_block_core(plan,index,fonts,roles,language,c,page_values,document_boxes_json,citation_labels_json,citation_separator,config,unit,global_links_json,tables,true,legacy_output)

collect_block_request(collection:Collection,previous_source:str,known:bit,plan:Plan,index:int,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,citation_labels_json:str,citation_separator:str,config:Tape,unit:num,global_links_json:str):
    kinds:plan.kinds
    sources:plan.sources
    contexts:plan.contexts
    attrs:plan.attrs
    ams:c.class_name="amsart"
    pt:tex_numeric.pt()
    first_paragraph:false
    index>0?
        previous:kinds.(index-1)
        .first_paragraph:previous="math" \/ (~ams /\ (previous="section" \/ previous="subsection"))
    diagnostics:""
    unresolved:""
    pending_pages:false
    kind:kinds.(index)
    context:document_present_context.parse(contexts.(index))
    document_links_json:global_links_json
    context.link_appearance~=""? .document_links_json:context.link_appearance
    properties:resource_json.parse("{"&attrs.(index)&"}")
    heading_config:resource_json.member(config,0,kind)
    titlepart:string(properties,0,"titlePart")
    heading:kind="section" \/ kind="subsection" \/ kind="title" \/ kind="author"
    paragraph:kind="paragraph"
    caption:kind="caption"
    verbatim:kind="verbatim"
    width:number(config,0,"textWidth")-context.left-context.right
    resolved:document_resolve.resolve(sources.(index),plan.references,page_values,citation_labels_json,citation_separator,document_materialize_config.has(c.packages,"biblatex"),c.hyperref,flag(config,0,"legacyEquationAnchor"),verbatim)
    known /\ previous_source=resolved.source? @:(collection:collection,source:resolved.source,changed:false)
    role:context.font
    heading? .role:kind
    kind="abstractHeading"? .role:"smallbold"
    verbatim?
        .role:"mono"
        context.font="footnote"? .role:"footnotemono"
    (paragraph \/ heading \/ verbatim \/ caption \/ kind="abstractHeading" \/ kind="subsubsection")?
        text_context:text_parser.context(role,roles,c.optical,c.hyperref)
        text_context.legacy_symbols:flag(config,0,"legacyTextSymbols")
        text_context.literal:verbatim
        text_context.literal_input:flag(properties,0,"fileInput")
        bibliography_text:string(config,0,"bibliographyStyle")~="" /\ context.kind="bibliography"
        text_context.bib_url:bibliography_text
        options:paragraph_breaking.options(width/unit)
        options.justify:paragraph
        options.tolerance:context.tolerance
        options.emergency:context.emergency
        paragraph?
            first_indent:0.0
            ((~first_paragraph \/ context.paragraph_after_display) /\ ~context.no_indent_after_list) \/ context.kind="description"? .first_indent:context.indent
            options.first_indent:first_indent/unit
            context.kind="verse"? options.forced_indent: -15*pt/unit
        text_options:paragraph_nodes.text_options()
        text_options.sentence_spacing:context.sentence
        text_options.french_spacing:bibliography_text
        text_options.space_scale:number(config,heading_config,"spaceScale",1)
        collected:text_source_paragraph.collect_source_request(collection,resolved.source,fonts,text_context,language,c.overrides,options.hyphens,text_inline_boxes.empty())
        @:(collection:collected,source:resolved.source,changed:true)
    @:(collection:collection,source:resolved.source,changed:true)
