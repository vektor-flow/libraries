mutation_between_reads()->bit:
    source:table("@\\a@b %x")
    trace:origins()
    state:m.open(source,trace,0)
    cats:m.categories()
    first:m.next(source,trace,state,cats)
    (first.token.category=12)?! "default @ other"
    .cats:m.assign(cats,64,11)
    word:m.next(source,first.origins,first.state,cats)
    (word.token.value="a@b" /\ first.token.category=12)?! "new scan and old token identity"
    .cats:m.assign(cats,37,12)
    percent:m.next(source,word.origins,word.state,cats)
    (percent.token.value="%" /\ percent.token.category=12)?! "comment category changed between reads"
    (percent.token.origin=2 /\ percent.origins.start.(0)=0 /\ percent.origins.start.(1)=1)?! "stable origin IDs"
    (~m.reusable(state,state,m.categories(),cats,trace,trace))?! "category invalidates checkpoint"
    m.reusable(state,state,cats,cats,trace,trace)?! "exact unchanged checkpoint"
    @:true

reject_endline_assignment():m.assign(m.categories(),13,12)
reject_category5_assignment():m.assign(m.categories(),64,5)
reject_preview()->bit:m.strict_token((kind:1,category:2,value:"}",source: -1,occurrence: -1,start:0,stop:0,origin: -1,provenance:2))

renderer_tests()->bit:
    case_empty()?! "case_empty"
    case_letter_eof()?! "case_letter_eof"
    case_control_word()?! "case_control_word"
    case_control_symbol()?! "case_control_symbol"
    case_control_space()?! "case_control_space"
    case_control_tab_name_retained()?! "case_control_tab_name_retained"
    case_default_at_other()?! "case_default_at_other"
    case_assigned_at_letter()?! "case_assigned_at_letter"
    case_blank_line()?! "case_blank_line"
    case_paragraph()?! "case_paragraph"
    case_collapse_spaces_tabs()?! "case_collapse_spaces_tabs"
    case_comment_line()?! "case_comment_line"
    case_comment_unicode_and_caret()?! "case_comment_unicode_and_caret"
    case_only_comment_eof()?! "case_only_comment_eof"
    case_crlf()?! "case_crlf"
    case_bare_cr()?! "case_bare_cr"
    case_escaped_endline()?! "case_escaped_endline"
    case_escape_eof()?! "case_escape_eof"
    case_word_newline()?! "case_word_newline"
    case_all_character_categories()?! "case_all_character_categories"
    case_ignore_nul()?! "case_ignore_nul"
    case_custom_escape()?! "case_custom_escape"
    case_comment_other()?! "case_comment_other"
    case_trailing_raw_space_even_if_letter()?! "case_trailing_raw_space_even_if_letter"
    case_superscript_other()?! "case_superscript_other"
    case_unsupported_translation()?! "case_unsupported_translation"
    case_unsupported_translation_in_name()?! "case_unsupported_translation_in_name"
    case_unsupported_unicode()?! "case_unsupported_unicode"
    case_unsupported_bom()?! "case_unsupported_bom"
    case_unsupported_unicode_name()?! "case_unsupported_unicode_name"
    case_invalid_char()?! "case_invalid_char"
    mutation_between_reads()?! "mutation_between_reads"
    @:true

Sources:(schema:int,revision:str,ids:[str],versions:[int],texts:[str],hashes:[str])
Origins:(revision:str,occurrence_sources:[int],occurrence_via:[int],source:[int],occurrence:[int],start:[int],stop:[int],role:[str],definition:[int],invocation:[int])
installed_first_boundary(table:Sources,trace:Origins,occurrence:int,expected:str,start:int,stop:int)->bit:
    state:m.open(table,trace,occurrence)
    cats:m.categories()
    step:m.next(table,trace,state,cats)
    true?>
        (step.diagnostic=0 /\ step.token.kind~=0)?! "installed lexical boundary unavailable"
        (step.token.kind=2 /\ step.token.value~= "par")? @|
        .step:m.next(table,step.origins,step.state,cats)
    (step.token.value=expected /\ step.token.start=start /\ step.token.stop=stop)?! "installed exact first control"
    @:true

reject_stale_source():
    a:table("x")
    before:origins()
    state:m.open(a,before,0)
    b:table("x","sha256:changed")
    after:origins("sha256:changed")
    @:m.next(b,after,state,m.categories())

renderer_tests()
