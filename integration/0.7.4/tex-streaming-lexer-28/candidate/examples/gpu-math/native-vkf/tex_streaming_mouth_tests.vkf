    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=12 /\ step.token.value="^")?! "superscript-other token 0"
    .step:m.next(source,step.origins,step.state,cats)
    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=12 /\ step.token.value="^")?! "superscript-other token 1"
    .step:m.next(source,step.origins,step.state,cats)
    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=11 /\ step.token.value="A")?! "superscript-other token 2"
    .step:m.next(source,step.origins,step.state,cats)
    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=10 /\ step.token.value=" ")?! "superscript-other token 3"
    .step:m.next(source,step.origins,step.state,cats)
    (step.diagnostic=0 /\ step.token.kind=0)?! "true EOF"
    @:true

case_unsupported_translation()->bit:
    source:table("^^A")
    trace:origins()
    state:m.open(source,trace,0)
    cats:m.categories()
    step:m.next(source,trace,state,cats)
    (step.diagnostic=2)?! "explicit unsupported diagnostic"
    (step.origins.source.length()=0 /\ step.state.position=0)?! "diagnostic is transactional"
    @:true

