+# Future real native fixtures. UNCOMPILED/UNEXECUTED; handwritten oracle.
+m:.tex_streaming_mouth
+
+table(raw:str,revision:str="sha256:fixture"):
+    @:(schema:1,revision:revision,ids:["fixture"],versions:[0],texts:[raw],hashes:["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"])
+
+origins(revision:str="sha256:fixture"):
+    @:(revision:revision,occurrence_sources:[0],occurrence_via:[-1],source:[0:0],occurrence:[0:0],start:[0:0],stop:[0:0],role:["":0],definition:[0:0],invocation:[0:0])
+
+case_empty()->bit:
+    source:table("")
+    trace:origins()
+    state:m.open(source,trace,0)
+    cats:m.categories()
+    step:m.next(source,trace,state,cats)
+    (step.diagnostic=0 /\ step.token.kind=0)?! "true EOF"
+    @:true
+
+case_letter_eof()->bit:
+    source:table("a")
+    trace:origins()
+    state:m.open(source,trace,0)
+    cats:m.categories()
+    step:m.next(source,trace,state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=11 /\ step.token.value="a")?! "letter-eof token 0"
+    (step.token.start=0 /\ step.token.stop=1 /\ step.token.provenance=0)?! "exact byte span/provenance"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=10 /\ step.token.value=" ")?! "letter-eof token 1"
+    (step.token.start=1 /\ step.token.stop=1 /\ step.token.provenance=1)?! "exact byte span/provenance"
+    (step.token.origin= -1)?! "virtual EOF has no authored origin"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=0)?! "true EOF"
+    @:true
+
+case_control_word()->bit:
+    source:table("\\foo   x")
+    trace:origins()
+    state:m.open(source,trace,0)
+    cats:m.categories()
+    step:m.next(source,trace,state,cats)
+    (step.diagnostic=0 /\ step.token.kind=2 /\ step.token.category=-1 /\ step.token.value="foo")?! "control-word token 0"
+    (step.token.start=0 /\ step.token.stop=4 /\ step.token.provenance=0)?! "exact byte span/provenance"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=11 /\ step.token.value="x")?! "control-word token 1"
+    (step.token.start=7 /\ step.token.stop=8 /\ step.token.provenance=0)?! "exact byte span/provenance"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=10 /\ step.token.value=" ")?! "control-word token 2"
+    (step.token.start=8 /\ step.token.stop=8 /\ step.token.provenance=1)?! "exact byte span/provenance"
+    (step.token.origin= -1)?! "virtual EOF has no authored origin"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=0)?! "true EOF"
+    @:true
+
+case_control_symbol()->bit:
+    source:table("\\% x")
+    trace:origins()
+    state:m.open(source,trace,0)
+    cats:m.categories()
+    step:m.next(source,trace,state,cats)
+    (step.diagnostic=0 /\ step.token.kind=2 /\ step.token.category=-1 /\ step.token.value="%")?! "control-symbol token 0"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=10 /\ step.token.value=" ")?! "control-symbol token 1"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=11 /\ step.token.value="x")?! "control-symbol token 2"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=10 /\ step.token.value=" ")?! "control-symbol token 3"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=0)?! "true EOF"
+    @:true
+
+case_control_space()->bit:
+    source:table("\\  x")
+    trace:origins()
+    state:m.open(source,trace,0)
+    cats:m.categories()
+    step:m.next(source,trace,state,cats)
+    (step.diagnostic=0 /\ step.token.kind=2 /\ step.token.category=-1 /\ step.token.value=" ")?! "control-space token 0"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=11 /\ step.token.value="x")?! "control-space token 1"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=1 /\ step.token.category=10 /\ step.token.value=" ")?! "control-space token 2"
+    .step:m.next(source,step.origins,step.state,cats)
+    (step.diagnostic=0 /\ step.token.kind=0)?! "true EOF"
+    @:true
+
+case_control_tab_name_retained()->bit:
+    source:table("\\\t x")
+    trace:origins()
+    state:m.open(source,trace,0)
+    cats:m.categories()
+    step:m.next(source,trace,state,cats)
