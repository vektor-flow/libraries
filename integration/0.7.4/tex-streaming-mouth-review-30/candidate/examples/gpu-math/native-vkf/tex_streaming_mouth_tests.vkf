    failed:m.next(source,first.origins,first.state,cats)
    (failed.diagnostic=3 /\ failed.token.start=6 /\ failed.token.stop=7)?! "offending scalar, not saved cursor"
    m.reusable(first.state,failed.state,cats,cats,first.origins,failed.origins)?! "all cursor/prefix columns rollback"
    changed:m.assign(cats,127,12)
    retried:m.next(source,failed.origins,failed.state,changed)
    (retried.diagnostic=0 /\ retried.token.start=6 /\ retried.token.category=12 /\ retried.token.origin=1)?! "retry replays skipped comment without duplicate origins"
    (first.origins.source.length()=1 /\ first.token.category=11)?! "retained value ownership"
    @:true

