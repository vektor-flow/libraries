review30_lookahead_category_feedback()->bit:
    source:table("\\a@ b")
    trace:origins()
    cats:m.categories()
    word:m.next(source,trace,m.open(source,trace,0),cats)
    changed:m.assign(cats,64,13)
    next:m.next(source,word.origins,word.state,changed)
    (word.token.value="a" /\ next.token.kind=3 /\ next.token.category=13)?! "lookahead category not retained"
    (cats.values.(64)=12 /\ changed.values.(64)=13)?! "old category checkpoint remains immutable"
    (~m.reusable(word.state,word.state,cats,changed,word.origins,word.origins))?! "category invalidation"
    same:m.assign(cats,64,12)
    (~m.reusable(word.state,word.state,cats,same,word.origins,word.origins))?! "same value assignment invalidates generation"
    @:true

