--- a/examples/gpu-math/native-vkf/tex_streaming_mouth.vkf
+++ b/examples/gpu-math/native-vkf/tex_streaming_mouth.vkf
@@ -105,8 +105,10 @@
             text.at(raw,following)="\n"? .following:text.next(raw,following)
     @:(revision:state.revision,source:state.source,occurrence:state.occurrence,position:state.position,line_end:trimmed,line_next:following,ready:true,mouth:0)
 
-# Unit spans retain physical terminator/trailing bytes. At unterminated EOF
-# virtual CR has a zero-width anchor and can NEVER acquire an authored origin.
+# Unit spans retain physical terminator/trailing bytes, even at unterminated EOF.
+# A virtual CR unit is zero-width ONLY when no trailing bytes remain. Escaping
+# it still produces a nonempty composite token span. All these tokens retain
+# provenance=1: an origin anchor is never proof of authored token spelling.
 unit(raw:str,state:State):
     state.position>=state.line_end? @:(value:"\r",stop:state.line_next,line:true)
     @:(value:text.at(raw,state.position),stop:text.next(raw,state.position),line:false)
