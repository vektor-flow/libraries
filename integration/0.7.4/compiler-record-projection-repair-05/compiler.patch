 namespace vkf::machine_ir::detail {
+namespace {
+using ProjectionRecordFields = std::vector<std::pair<std::string, ValueLayout>>;
+
+ValueLayout projection_record_layout(const ProjectionRecordFields& fields) {
+    std::vector<ValueLayout> elements;
+    for (const auto& [name, field] : fields) elements.push_back(field);
+    const auto indexed = indexed_layout(elements);
+    ValueLayout record{indexed.width, ValueKind::Aggregate, {}};
+    for (std::size_t index = 0; index < fields.size(); ++index) {
+        const auto key = std::to_string(index);
+        const auto& name = fields[index].first;
+        record.selectors[name] = indexed.selectors.at(key);
+        const auto prefix = key + ".";
+        for (auto child = indexed.selectors.lower_bound(prefix);
+             child != indexed.selectors.end() && child->first.rfind(prefix, 0) == 0; ++child)
+            record.selectors[qualified_name(name, child->first.substr(prefix.size()))] = child->second;
+    }
+    return record;
+}
+
+std::optional<ProjectionRecordFields> canonical_projection_record_fields(
+    const ValueLayout& layout
+) {
+    if (!is_record_layout(layout)) return std::nullopt;
+    ProjectionRecordFields fields;
+    for (const auto& [name, slice] : layout.selectors) {
+        if (name.find('.') == std::string::npos)
+            fields.push_back({name, record_field_layout(layout, name, slice)});
+    }
+    std::stable_sort(fields.begin(), fields.end(), [&](const auto& left, const auto& right) {
+        const auto& a = layout.selectors.at(left.first);
+        const auto& b = layout.selectors.at(right.first);
+        if (a.offset != b.offset) return a.offset < b.offset;
+        // An empty field at a boundary precedes the nonempty field starting
+        // there. Repeated assign_record_field_layout would lose this ordering.
+        return a.width == 0 && b.width != 0;
+    });
+    const auto rebuilt = projection_record_layout(fields);
+    // Also checks root tags, orphan selectors, total width and field offsets.
+    if (!same_inference_layout(layout, rebuilt)) return std::nullopt;
+    return fields;
+}
+
+// Overlay only proven counted primitive children on the exact replacement.
+// Do not merge unrelated fixed children: full demand must retain their actual
+// extents. Unsupported leaves keep the old replacement behavior. A malformed
+// or structurally different record aborts the entire overlay before publication.
+std::optional<ValueLayout> counted_record_projection(
+    const ValueLayout& current, const ValueLayout& candidate
+) {
+    if (preserves_counted_primitive_storage(current, candidate)) return current;
+    if (!is_record_layout(current) && !is_record_layout(candidate)) return candidate;
+    const auto required = canonical_projection_record_fields(current);
+    const auto supplied = canonical_projection_record_fields(candidate);
+    if (!required || !supplied || required->size() != supplied->size()) return std::nullopt;
+    ProjectionRecordFields fields;
+    bool changed = false;
+    for (const auto& [name, field] : *required) {
+        const auto existing = candidate.selectors.find(name);
+        if (existing == candidate.selectors.end()) return std::nullopt;
+        const auto supplied_field = record_field_layout(candidate, name, existing->second);
+        const auto child = counted_record_projection(field, supplied_field);
+        if (!child) return std::nullopt;
+        changed = changed || !same_inference_layout(*child, supplied_field);
+        fields.push_back({name, *child});
+    }
+    if (!changed) return candidate;
+    auto projected = projection_record_layout(fields);
+    projected.display_shape = candidate.display_shape;
+    // No input selector table or shared dynamic element is ever mutated.
+    return same_inference_layout(projected, candidate) ? candidate : projected;
+}
