compare(q:Packet)->bit:
    before:document_scene_paragraph.from_paragraph(q)
    after:document_scene_paragraph_linear.from_paragraph(packet_adapter.from_legacy(q))
    (before.width=after.width /\ before.height=after.height /\ before.depth=after.depth /\ before.tag_width=after.tag_width /\ before.anchor_count=after.anchor_count)?! "scene metrics exact"
    a:before.arena
    b:after.arena
    (a.count=b.count /\ a.paint_count=b.paint_count /\ a.payload_count=b.payload_count /\ a.destination_ids.length()=b.destination_ids.length())?! "typed column sizes exact"
    i:0
    i<a.count?>
        (a.kinds.(i)=b.kinds.(i))?! "column kinds exact"
        (a.keys.(i)=b.keys.(i))?! "column keys exact"
        (a.xs.(i)=b.xs.(i))?! "column xs exact"
        (a.ys.(i)=b.ys.(i))?! "column ys exact"
        (a.sxs.(i)=b.sxs.(i))?! "column sxs exact"
        (a.sys.(i)=b.sys.(i))?! "column sys exact"
        (a.widths.(i)=b.widths.(i))?! "column widths exact"
        (a.heights.(i)=b.heights.(i))?! "column heights exact"
        (a.lines.(i)=b.lines.(i))?! "column lines exact"
        (a.equation_tags.(i)=b.equation_tags.(i))?! "column equation_tags exact"
        (a.tag_widths.(i)=b.tag_widths.(i))?! "column tag_widths exact"
        (a.draws.(i)=b.draws.(i))?! "column draws exact"
        ordered_json.metadata_matches(a.extras.(i),b.metadata,b.metadata_roots.(i))?! "column extras exact"
        (a.flow_xs.(i)=b.flow_xs.(i))?! "column flow_xs exact"
        (a.flow_widths.(i)=b.flow_widths.(i))?! "column flow_widths exact"
        (a.has_flows.(i)=b.has_flows.(i))?! "column has_flows exact"
        (a.vertical_shrinks.(i)=b.vertical_shrinks.(i))?! "column vertical_shrinks exact"
        (a.vertical_stretches.(i)=b.vertical_stretches.(i))?! "column vertical_stretches exact"
        (a.paints.(i)=b.paints.(i))?! "column paints exact"
        (a.payloads.(i)=b.payloads.(i))?! "column payloads exact"
        (a.destination_firsts.(i)=b.destination_firsts.(i))?! "column destination_firsts exact"
        (a.destination_counts.(i)=b.destination_counts.(i))?! "column destination_counts exact"
        (a.footnote_numbers.(i)=b.footnote_numbers.(i))?! "column footnote_numbers exact"
        old_json:reference_export.leaf(a,i,1,1)
        new_json:document_scene_export.leaf(b,i,1,1)
        ordered_json.json_matches(old_json,new_json)?! "debug leaf export exact"
        .i:i+1
    .i:0
