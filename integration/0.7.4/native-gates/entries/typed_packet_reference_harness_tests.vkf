# Test-only comparison across the old extras/new typed-metadata boundary.
# Empty legacy text is absence, not JSON. Do not encode it as an empty object.
# Present values still require exact bytes; raw/typed spelling differences remain
# visible failures until their separate compatibility contract is resolved.
extra_matches(original:str,metadata:Metadata,root:int)->bit:
    root<0? @:original=""
    original=""? @:false
    @:original=metadata_json.encode(metadata,root)
extra_contract_tests()->bit:
    absent:(kinds:[0:0],ends:[0:0],texts:document_scene.strings(0),numbers:[0.0:0],count:0)
    object:(kinds:[1],ends:[1],texts:[""],numbers:[0.0],count:1)
    null_value:(kinds:[7],ends:[1],texts:[""],numbers:[0.0],count:1)
    number:(kinds:[4],ends:[1],texts:[""],numbers:[2.0],count:1)
    # A missing root may belong to a shared nonempty arena. Presence is root-based.
    offset:(kinds:[7,1],ends:[1,2],texts:["",""],numbers:[0.0,0.0],count:2)
    extra_matches("",absent,-1)?! "Absent extra matches absent root"
    extra_matches("",offset,-1)?! "Absent extra in nonempty metadata arena"
    (~extra_matches("{}",absent,-1))?! "Empty object is not absent extra"
    (~extra_matches("null",absent,-1))?! "Null is not absent extra"
    (~extra_matches(" ",absent,-1))?! "Whitespace is not absent extra"
    (~extra_matches("",object,0))?! "Absent extra is not present object"
    (~extra_matches("",null_value,0))?! "Absent extra is not present null"
    extra_matches("{}",object,0)?! "Explicit empty object matches"
    extra_matches("null",null_value,0)?! "Explicit null matches"
    extra_matches("{}",offset,1)?! "Nonzero metadata root matches"
    (~extra_matches("null",object,0))?! "Null is not an empty object"
    (~extra_matches("{}",null_value,0))?! "Empty object is not null"
    (metadata_json.encode(absent,-1)="{}")?! "General encoder still returns valid JSON"
    extra_matches("2e0",number,0)?! "Present metadata retains exact encoded bytes"
    (~extra_matches("2",number,0))?! "Equivalent numeric spelling stays a visible mismatch"
    (~extra_matches("3e0",number,0))?! "Changed metadata value is rejected"
    @:true
