# Test-only recursive-descent JSON reader, independent of live and F303 readers.
# Preorder nodes retain container subtree ends, decoded key/string nodes, raw
# number tokens, all duplicate keys and source order. No object-map conversion.
n:.test_json_binary64
Metadata:(kinds:[int],ends:[int],texts:[str],numbers:[num],count:int)
Tree:(source:str,position:int,valid:bit,kinds:[int],ends:[int],texts:[str],count:int)
StringResult:(value:str,stop:int,valid:bit)
strings(count:int)->[str]:
    [str] out:["":count]
    @:out
at(s:str,i:int)->str:
    vkf_string_eof(s,i)? @:""
    @:vkf_string_peek_scalar(s,i)
white(c:str)->bit:c=" " \/ c="\t" \/ c="\r" \/ c="\n"
digit(c:str)->bit:c>="0" /\ c<="9"
skip(s:str,i:int)->int:
    p:i
    white(at(s,p))?> .p:p+1
    @:p
hex(c:str)->int:
    digit(c)? @:n.code(c)-48
    c>="a" /\ c<="f"? @:n.code(c)-87
    c>="A" /\ c<="F"? @:n.code(c)-55
    @: -1
quad(s:str,p:int)->int:
    value:0
    i:0
    i<4?>
        d:hex(at(s,p+i))
        d<0? @: -1
        .value:value*16+d
        .i:i+1
    @:value
string(s:str,start:int)->StringResult:
    p:start+1
    out:""
    ~vkf_string_eof(s,p)?>
        c:at(s,p)
        c="\""? @:(value:out,stop:p+1,valid:true)
        c<" "? @:(value:out,stop:p,valid:false)
        c~="\\"?
            .out:out&c
            .p:int(vkf_utf8_advance(s,p))
            @>
        .p:p+1
        escape:at(s,p)
        .p:p+1
        (escape="\"" \/ escape="\\" \/ escape="/")?
            .out:out&escape
            @>
        escape="b"?
            .out:out&str(chr(8))
            @>
        escape="f"?
            .out:out&str(chr(12))
            @>
        escape="n"?
            .out:out&"\n"
            @>
        escape="r"?
            .out:out&"\r"
            @>
        escape="t"?
            .out:out&"\t"
            @>
        escape~="u"? @:(value:out,stop:p,valid:false)
        scalar:quad(s,p)
        (scalar<0 \/ (scalar>=56320 /\ scalar<=57343))? @:(value:out,stop:p,valid:false)
        .p:p+4
        scalar>=55296 /\ scalar<=56319?
            (at(s,p)~="\\" \/ at(s,p+1)~="u")? @:(value:out,stop:p,valid:false)
            low:quad(s,p+2)
            (low<56320 \/ low>57343)? @:(value:out,stop:p,valid:false)
            .scalar:65536+(scalar-55296)*1024+low-56320
            .p:p+6
        .out:out&str(chr(scalar))
    @:(value:out,stop:p,valid:false)
number_stop(s:str,start:int)->int:
    p:start
    at(s,p)="-"? .p:p+1
    ~digit(at(s,p))? @: -1
    at(s,p)="0"? .p:p+1
    at(s,start)="-"? .start:start+1
    at(s,start)~="0"?
        digit(at(s,p))?> .p:p+1
    at(s,p)="."?
        .p:p+1
        ~digit(at(s,p))? @: -1
        digit(at(s,p))?> .p:p+1
    (at(s,p)="e" \/ at(s,p)="E")?
        .p:p+1
        (at(s,p)="+" \/ at(s,p)="-")? .p:p+1
        ~digit(at(s,p))? @: -1
        digit(at(s,p))?> .p:p+1
    @:p
literal(s:str,p:int,word:str)->bit:
    i:0
    ~vkf_string_eof(word,i)?>
        at(s,p+i)~=at(word,i)? @:false
        .i:i+1
    @:true
value(q:Tree,depth:int)->Tree:
    ~q.valid? @:q
    depth>256?
        q.valid:false
        @:q
    q.position:skip(q.source,q.position)
    c:at(q.source,q.position)
    root:q.count
    root>=q.kinds.length()?
        q.valid:false
        @:q
    q.count:root+1
    q.ends.(root):q.count
    c="\""?
        parsed:string(q.source,q.position)
        q.kinds.(root):3
        q.texts.(root):parsed.value
        q.position:parsed.stop
        q.valid:parsed.valid
        @:q
    (c="-" \/ digit(c))?
        stop:number_stop(q.source,q.position)
        stop<0?
            q.valid:false
            @:q
        q.kinds.(root):4
        token:""
        q.position<stop?>
            .token:token&at(q.source,q.position)
            q.position:q.position+1
        q.texts.(root):token
        @:q
    (c="{" \/ c="[")?
        object:c="{"
        close:"]"
        q.kinds.(root):2
        object?
            .close:"}"
            q.kinds.(root):1
        q.position:skip(q.source,q.position+1)
        at(q.source,q.position)=close?
            q.position:q.position+1
            @:q
        q.valid?>
            object?
                at(q.source,q.position)~="\""?
                    q.valid:false
                    @:q
                .q:value(q,depth+1)
                q.position:skip(q.source,q.position)
                (~q.valid \/ at(q.source,q.position)~=":")?
                    q.valid:false
                    @:q
                q.position:q.position+1
            .q:value(q,depth+1)
            ~q.valid? @:q
            q.position:skip(q.source,q.position)
            .c:at(q.source,q.position)
            c=close?
                q.position:q.position+1
                q.ends.(root):q.count
                @:q
            c~=","?
                q.valid:false
                @:q
            q.position:skip(q.source,q.position+1)
        @:q
    literal(q.source,q.position,"true")?
        q.kinds.(root):5
        q.position:q.position+4
        @:q
    literal(q.source,q.position,"false")?
        q.kinds.(root):6
        q.position:q.position+5
        @:q
    literal(q.source,q.position,"null")?
        q.kinds.(root):7
        q.position:q.position+4
        @:q
    q.valid:false
    @:q
parse(source:str)->Tree:
    capacity:n.size(source)+1
    q:(source:source,position:0,valid:true,kinds:[0:capacity],ends:[0:capacity],texts:strings(capacity),count:0)
    .q:value(q,0)
    q.position:skip(source,q.position)
    q.valid:q.valid /\ vkf_string_eof(source,q.position)
    @:q
# The flat representation is an ordered tree, not a bag of nodes: ends must
# match relative to each root as well as kinds, strings/keys and exact numbers.
metadata_matches(original:str,a:Metadata,root:int)->bit:
    root<0? @:original=""
    original=""? @:false
    (root>=a.count \/ a.count>a.kinds.length() \/ a.count>a.ends.length() \/ a.count>a.texts.length() \/ a.count>a.numbers.length())? @:false
    stop:a.ends.(root)
    (stop<=root \/ stop>a.count)? @:false
    q:parse(original)
    (~q.valid \/ q.count~=stop-root)? @:false
    i:0
    i<q.count?>
        at:root+i
        kind:q.kinds.(i)
        (kind~=a.kinds.(at) \/ q.ends.(i)~=a.ends.(at)-root)? @:false
        kind=3 /\ q.texts.(i)~=a.texts.(at)? @:false
        kind=4?
            (~n.equal(n.from_token(q.texts.(i)),n.from_number(a.numbers.(at))))? @:false
        .i:i+1
    @:true
json_matches(left:str,right:str)->bit:
    a:parse(left)
    b:parse(right)
    (~a.valid \/ ~b.valid \/ a.count~=b.count)? @:false
    i:0
    i<a.count?>
        kind:a.kinds.(i)
        (kind~=b.kinds.(i) \/ a.ends.(i)~=b.ends.(i))? @:false
        kind=3 /\ a.texts.(i)~=b.texts.(i)? @:false
        kind=4?
            (~n.equal(n.from_token(a.texts.(i)),n.from_token(b.texts.(i))))? @:false
        .i:i+1
    @:true
contract_tests()->bit:
    # Same binary64, different spelling; decoded strings and keys, not lexemes.
    json_matches("{\"x\":2,\"s\":\"a\\/b\"}"," { \"\\u0078\" : 2e0, \"s\":\"a/b\" } ")?! "Ordered equivalent spellings"
    json_matches("0.1","0.10000000000000001")?! "Same binary64 rounding cell"
    json_matches("-0","0e9")?! "Documented signed zero canonicalization"
    json_matches("\"\\ud83d\\ude00\"","\"😀\"")?! "Decoded surrogate pair"
    (~json_matches("1","1.0000000000000002"))?! "Adjacent doubles differ"
    (~json_matches("0.1","0.10000000000000002"))?! "Adjacent inexact decimal doubles differ"
    (~json_matches("{\"s\":\"a\"}","{\"s\":\"b\"}"))?! "Changed text rejected"
    (~json_matches("{\"a\":1}","{\"b\":1}"))?! "Changed key rejected"
    (~json_matches("[1,2]","[2,1]"))?! "Array order retained"
    (~json_matches("{\"a\":1,\"b\":2}","{\"b\":2,\"a\":1}"))?! "Object order retained"
    (~json_matches("{\"a\":1,\"a\":2}","{\"a\":2}"))?! "Duplicate key multiplicity retained"
    (~json_matches("{\"a\":1,\"a\":2}","{\"a\":2,\"a\":1}"))?! "Duplicate key order retained"
    (~json_matches("[[],[null]]","[[null],[]]"))?! "Subtree boundaries retained"
    (~json_matches("true","1"))?! "Kinds retained"
    (~json_matches("{}","{\"a\":null}"))?! "Missing member differs from null"
    (~json_matches("null","{}"))?! "Null differs from empty object"
    (~json_matches("{}","[]"))?! "Empty object differs from empty array"
    (~json_matches("[]","\"\""))?! "Empty array differs from empty string"
    (~json_matches("","null"))?! "Missing JSON differs from null"
    (~json_matches("[1,]","[1]"))?! "Trailing comma rejected"
    (~json_matches("01","1"))?! "Leading zero rejected"
    (~json_matches("\"\\ud800\"","\"x\""))?! "Lone surrogate rejected"
    absent:(kinds:[0:0],ends:[0:0],texts:strings(0),numbers:[0.0:0],count:0)
    object:(kinds:[1],ends:[1],texts:[""],numbers:[0.0],count:1)
    null_value:(kinds:[7],ends:[1],texts:[""],numbers:[0.0],count:1)
    number:(kinds:[4],ends:[1],texts:[""],numbers:[1.0],count:1)
    next_number:(kinds:[4],ends:[1],texts:[""],numbers:[num(4503599627370497)/4503599627370496],count:1)
    offset:(kinds:[7,1],ends:[1,2],texts:["",""],numbers:[0.0,0.0],count:2)
    metadata_matches("",absent,-1)?! "Absent metadata remains absent"
    metadata_matches("",offset,-1)?! "Absent root in shared arena"
    metadata_matches("{}",offset,1)?! "Relative subtree ends at nonzero root"
    metadata_matches("{}",object,0)?! "Present empty object"
    metadata_matches("null",null_value,0)?! "Present null"
    (~metadata_matches("{}",absent,-1))?! "Empty object is not absent metadata"
    (~metadata_matches("null",absent,-1))?! "Null is not absent metadata"
    (~metadata_matches("",object,0))?! "Missing is not present object"
    (~metadata_matches("null",object,0))?! "Typed null/object distinction"
    metadata_matches("1e0",number,0)?! "Typed numeric spelling discarded"
    (~metadata_matches("1.0000000000000002",number,0))?! "Raw adjacent value rejected"
    (~metadata_matches("1",next_number,0))?! "Typed adjacent value rejected"
    metadata_matches("1.0000000000000002",next_number,0)?! "Exact adjacent value accepted"
    duplicates:(kinds:[1,3,4,3,4],ends:[5,2,3,4,5],texts:["","a","","a",""],numbers:[0.0,0.0,1.0,0.0,2.0],count:5)
    text_value:(kinds:[1,3,3],ends:[3,2,3],texts:["","key","value"],numbers:[0.0,0.0,0.0],count:3)
    array:(kinds:[2,4,4],ends:[3,2,3],texts:["","",""],numbers:[0.0,1.0,2.0],count:3)
    metadata_matches("{\"a\":1,\"a\":2}",duplicates,0)?! "Typed duplicates match in order"
    (~metadata_matches("{\"a\":2}",duplicates,0))?! "Typed duplicate loss rejected"
    (~metadata_matches("{\"a\":2,\"a\":1}",duplicates,0))?! "Typed duplicate order rejected"
    metadata_matches("{\"key\":\"value\"}",text_value,0)?! "Typed text matches"
    (~metadata_matches("{\"key\":\"changed\"}",text_value,0))?! "Typed changed text rejected"
    (~metadata_matches("{\"changed\":\"value\"}",text_value,0))?! "Typed changed key rejected"
    metadata_matches("[1,2]",array,0)?! "Typed array matches"
    (~metadata_matches("[2,1]",array,0))?! "Typed array order rejected"
    @:true
