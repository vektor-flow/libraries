diff --git a/examples/gpu-math/native-vkf/host/latex_package_sources.mjs b/examples/gpu-math/native-vkf/host/latex_package_sources.mjs
new file mode 100644
--- /dev/null
+++ b/examples/gpu-math/native-vkf/host/latex_package_sources.mjs
@@ -0,0 +1,125 @@
+import {createHash} from 'node:crypto';
+import {createSourceSnapshot} from './latex_source_revision.mjs';
+
+// Source preparation only. No TeX evaluation, filesystem search, format fallback,
+// or PDF binding is performed here. All positions are original UTF-8 byte offsets.
+export const PACKAGE_SOURCE_ABI = 'vkf.tex.package-sources/1';
+const hash = bytes => createHash('sha256').update(bytes).digest('hex');
+const check = (ok, message) => { if (!ok) throw Error(message); };
+const integer = x => Number.isSafeInteger(x) && x >= 0;
+const nonempty = x => typeof x === 'string' && x.length > 0;
+const digest = x => typeof x === 'string' && /^[0-9a-f]{64}$/.test(x);
+const freeze = x => Object.freeze(x);
+const strings = xs => {
+  check(Array.isArray(xs) && Array.from(xs).every(x => typeof x === 'string'), 'Invalid ordered options');
+  return freeze([...xs]);
+};
+
+/** Host supplies exact bytes and trusted expected hashes; hash equality verifies
+ * those bytes, not the authority of that expectation. No implicit paths/search.
+ * The complete supplied source universe is hashed, including currently unused
+ * files: changing any candidate invalidates the preparation conservatively.
+ */
+export function createPackageSourceBundle({files, engineIdentity, initialStateIdentity, requests = []}) {
+  check(nonempty(engineIdentity) && nonempty(initialStateIdentity), 'Missing engine/state identity');
+  check(Array.isArray(files) && files.length > 0 && files.length <= 4096, 'Invalid source universe');
+  let total = 0;
+  const rows = files.map(file => {
+    const {id, version, kind, bytes, sha256} = file;
+    check(nonempty(id) && integer(version) && ['document', 'kernel', 'package', 'include'].includes(kind), 'Invalid source identity');
+    check(bytes instanceof Uint8Array && digest(sha256), 'Expected pinned source bytes');
+    total += bytes.byteLength;
+    check(total <= 16 * 1024 * 1024, 'Package source universe exceeds 16 MiB');
+    const retained = Buffer.from(bytes);
+    check(hash(retained) === sha256, `Source digest mismatch: ${id}`);
+    // Preserve the BOM as a scalar, CRLF, comments, and all original bytes.
+    const text = new TextDecoder('utf-8', {fatal: true, ignoreBOM: true}).decode(retained);
+    check(Buffer.from(text, 'utf8').equals(retained), 'Noncanonical UTF-8 source');
+    return {id, version, kind, sha256, text, bytes: retained};
+  }).sort((a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
+  check(new Set(rows.map(r => r.id)).size === rows.length, 'Duplicate source ID');
+  const indices = new Map(rows.map((r, i) => [r.id, i]));
+  check(Array.isArray(requests), 'Invalid package requests');
+  const ordered = freeze(requests.map(request => {
+    check(indices.has(request.sourceId), 'Missing requested source');
+    check(['kernel', 'package'].includes(rows[indices.get(request.sourceId)].kind), 'Invalid package request kind');
+    return freeze({sourceId: request.sourceId, options: strings(request.options ?? [])});
+  }));
+  const snapshot = createSourceSnapshot(rows.map(({id, version, text}) => ({id, version, text})));
+  const encodedKey = JSON.stringify([PACKAGE_SOURCE_ABI, engineIdentity, initialStateIdentity,
+    rows.map(r => [r.id, r.version, r.kind, r.sha256]), ordered.map(r => [r.sourceId, r.options])]);
+  const cacheKey = 'sha256:' + hash(encodedKey);
+  const sourceTable = freeze({schema: 1, revision: snapshot.revision,
+    ids: freeze(rows.map(r => r.id)), versions: freeze(rows.map(r => r.version)),
+    texts: freeze(rows.map(r => r.text)), hashes: freeze(rows.map(r => r.sha256))});
+
+  function context() {
+    const occurrences = [], occurrenceIds = new WeakMap();
+    const origins = [], originIds = new WeakMap();
+    const occurrenceIndex = value => {
+      check(occurrenceIds.has(value), 'Foreign source occurrence'); return occurrenceIds.get(value);
+    };
+    const originIndex = (value, role) => {
+      check(originIds.has(value) && (!role || value.role === role), 'Foreign or wrong-role origin');
+      return originIds.get(value);
+    };
+    function enter(sourceId, includeOrigin = null) {
+      check(indices.has(sourceId), `Missing explicit source: ${sourceId}`);
+      const source = indices.get(sourceId);
+      const via = includeOrigin === null ? -1 : originIndex(includeOrigin, 'include');
+      let ancestor = via < 0 ? -1 : includeOrigin.occurrence;
+      let depth = 0;
+      while (ancestor >= 0) {
+        check(occurrences[ancestor].source !== source, 'Cyclic source include');
+        check(++depth < 32, 'Source include nesting limit');
+        const previous = occurrences[ancestor].via;
+        ancestor = previous < 0 ? -1 : origins[previous].occurrence;
+      }
+      const result = freeze({source, via});
+      occurrenceIds.set(result, occurrences.length); occurrences.push(result); return result;
+    }
+    /** These are declared preparation origins, NOT authenticated producer output.
+     * Include = caller's directive span; definition = original replacement source;
+     * invocation = authored call; argument = actual argument, linked to that call.
+     * Definition and invocation must never be collapsed into the same source span.
+     */
+    function origin(occurrence, start, stop, role = 'literal', links = {}) {
+      const occurrenceId = occurrenceIndex(occurrence), row = rows[occurrence.source];
+      check(['literal', 'include', 'definition', 'invocation', 'argument'].includes(role), 'Invalid origin role');
+      check(integer(start) && integer(stop) && start < stop && stop <= row.bytes.length, 'Invalid original byte span');
+      const boundary = n => n === row.bytes.length || (row.bytes[n] & 0xc0) !== 0x80;
+      check(boundary(start) && boundary(stop), 'Split UTF-8 scalar');
+      const definition = links.definition === undefined ? -1 : originIndex(links.definition, 'definition');
+      const invocation = links.invocation === undefined ? -1 : originIndex(links.invocation, 'invocation');
+      check(role === 'invocation' ? definition >= 0 : definition < 0, 'Definition link required only on invocation');
+      check(role === 'argument' ? invocation >= 0 : true, 'Argument needs invocation');
+      check(role === 'argument' || role === 'invocation' || invocation < 0, 'Unexpected invocation link');
+      if (role === 'argument') check(origins[invocation].occurrence === occurrenceId, 'Argument occurrence differs from invocation');
+      const result = freeze({source: occurrence.source, occurrence: occurrenceId, start, stop, role, definition, invocation});
+      originIds.set(result, origins.length); origins.push(result); return result;
+    }
+    function textAt(value) {
+      originIndex(value); return rows[value.source].bytes.subarray(value.start, value.stop).toString('utf8');
+    }
+    function unsupported(value, primitive, requirement) {
+      originIndex(value);
+      check(nonempty(primitive) && nonempty(requirement), 'Missing unsupported primitive detail');
+      check(textAt(value) === '\\' + primitive, 'Diagnostic primitive differs from source span');
+      const source = rows[value.source];
+      return freeze({code: 'TEX_PACKAGE_PRIMITIVE_UNSUPPORTED', primitive, requirement,
+        sourceId: source.id, sha256: source.sha256, startByte: value.start, stopByte: value.stop,
+        occurrence: value.occurrence, sourceRevision: snapshot.revision});
+    }
+    function interpret() {
+      const error = new Error('Package execution requires a stateful token/namespace/scoping ABI; source preparation cannot execute packages');
+      error.code = 'TEX_PACKAGE_INTERPRETER_UNAVAILABLE'; throw error;
+    }
+    return freeze({enter, origin, textAt, unsupported, interpret,
+      exportOrigins: () => freeze({schema: 1, revision: snapshot.revision,
+        occurrences: freeze([...occurrences]), origins: freeze([...origins])})});
+  }
+  return freeze({abi: PACKAGE_SOURCE_ABI, snapshot, cacheKey, requests: ordered, sourceTable,
+    // Copies only: callers cannot mutate the retained hash-bound source buffers.
+    bytes: id => { check(indices.has(id), 'Unknown source ID'); return Buffer.from(rows[indices.get(id)].bytes); },
+    context});
+}
diff --git a/examples/gpu-math/native-vkf/host/tests/package-sources.mjs b/examples/gpu-math/native-vkf/host/tests/package-sources.mjs
new file mode 100644
--- /dev/null
+++ b/examples/gpu-math/native-vkf/host/tests/package-sources.mjs
@@ -0,0 +1,133 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {readFileSync} from 'node:fs';
+import {createPackageSourceBundle} from '../latex_package_sources.mjs';
+import {createSourceSnapshot} from '../latex_source_revision.mjs';
+const hash = b => createHash('sha256').update(b).digest('hex');
+const file = (id, text, kind = 'document', version = 1) => {
+  const bytes = Buffer.from(text); return {id, version, kind, bytes, sha256: hash(bytes)};
+};
+const make = (files = [file('main', 'α😀\r\n\\input{defs}\\foo{x}'), file('defs', '\\newcommand{\\foo}[1]{#1}', 'package')], extra = {}) =>
+  createPackageSourceBundle({files, engineIdentity: 'test-engine', initialStateIdentity: 'explicit-init-state', ...extra});
+
+test('exact bytes and existing source revision, including BOM/CRLF/comments', () => {
+  const row = file('main', '\ufeff%comment\r\nα😀\r\n'); const b = make([row]);
+  assert.deepEqual(b.bytes('main'), row.bytes);
+  assert.equal(b.sourceTable.texts[0], row.bytes.toString());
+  assert.equal(b.snapshot.revision, createSourceSnapshot([{id: row.id, version: row.version, text: row.bytes.toString()}]).revision);
+  row.bytes.fill(0); const bytes = b.bytes('main'); bytes.fill(0);
+  assert.equal(b.sourceTable.texts[0], '\ufeff%comment\r\nα😀\r\n');
+  assert.equal(b.bytes('main').toString(), '\ufeff%comment\r\nα😀\r\n');
+  assert.throws(() => b.sourceTable.ids.push('other'), TypeError);
+});
+test('reject changed pins, malformed UTF-8, duplicate IDs, missing identities', () => {
+  const row = file('a', 'a'); assert.throws(() => make([{...row, sha256: '0'.repeat(64)}]), /digest mismatch/);
+  const bad = Buffer.from([0xc0, 0xaf]); assert.throws(() => make([{...row, bytes: bad, sha256: hash(bad)}]), /encoded data/);
+  assert.throws(() => make([row, row]), /Duplicate/);
+  assert.throws(() => make([row], {initialStateIdentity: ''}), /identity/);
+  assert.throws(() => make([row], {requests: [{sourceId: 'absent'}]}), /Missing requested/);
+  assert.throws(() => make([file('p', '', 'package')], {requests: [{sourceId: 'p', options: Array(1)}]}), /ordered options/);
+});
+test('strict original UTF-8 offsets, never UTF-16 or flattened-source positions', () => {
+  const b = make(), c = b.context(), root = c.enter('main');
+  assert.equal(c.textAt(c.origin(root, 2, 6)), '😀');
+  assert.throws(() => c.origin(root, 2, 3), /scalar/);
+  assert.throws(() => c.origin(root, 3, 6), /scalar/);
+  assert.throws(() => c.origin(root, 0, 999), /span/);
+  assert.throws(() => c.origin(root, 0, 0), /span/);
+});
+test('include occurrences retain caller directive; repeated includes stay distinct', () => {
+  const b = make(), c = b.context(), root = c.enter('main');
+  const directive = c.origin(root, 8, 20, 'include');
+  assert.equal(c.textAt(directive), '\\input{defs}');
+  const a = c.enter('defs', directive), other = c.enter('defs', directive);
+  assert.notEqual(a, other); assert.equal(a.via, other.via);
+  const da = c.origin(a, 0, 24, 'definition'), db = c.origin(other, 0, 24, 'definition');
+  assert.notEqual(da.occurrence, db.occurrence);
+  assert.equal(c.textAt(da), '\\newcommand{\\foo}[1]{#1}');
+  assert.equal(c.textAt(db), c.textAt(da));
+});
+test('definition, invocation and argument origins remain distinct with nested calls', () => {
+  const b = make(), c = b.context(), main = c.enter('main'), defs = c.enter('defs');
+  const definition = c.origin(defs, 0, 24, 'definition');
+  const invocation = c.origin(main, 20, 24, 'invocation', {definition});
+  const argument = c.origin(main, 25, 26, 'argument', {invocation});
+  assert.equal(c.textAt(invocation), '\\foo'); assert.equal(c.textAt(argument), 'x');
+  const nested = c.origin(defs, 12, 16, 'invocation', {definition, invocation});
+  assert.notEqual(nested.source, invocation.source);
+  assert.equal(nested.invocation, argument.invocation);
+  assert.throws(() => c.origin(main, 20, 24, 'invocation'), /Definition link/);
+  assert.throws(() => c.origin(main, 25, 26, 'argument'), /needs invocation/);
+  assert.throws(() => c.origin(defs, 0, 1, 'argument', {invocation}), /occurrence/);
+});
+test('cross-context and cloned provenance cannot be reused; missing sources never fall back', () => {
+  const b = make(), a = b.context(), c = b.context(), root = a.enter('main');
+  assert.throws(() => c.origin(root, 0, 2), /Foreign/);
+  const span = a.origin(root, 0, 2); assert.throws(() => a.textAt({...span}), /Foreign/);
+  assert.throws(() => a.enter('missing'), /Missing explicit/);
+  assert.throws(() => a.enter('defs', span), /wrong-role/);
+  assert.deepEqual(c.exportOrigins().origins, []);
+});
+test('cycle rejection follows include ancestry, not global already-seen file names', () => {
+  const c = make().context(), root = c.enter('main');
+  const directive = c.origin(root, 8, 20, 'include'), child = c.enter('defs', directive);
+  const back = c.origin(child, 0, 1, 'include');
+  assert.throws(() => c.enter('main', back), /Cyclic/);
+  assert.doesNotThrow(() => c.enter('defs', directive));
+});
+test('cache preparation key covers exact source universe and versions, engine/state, ordered requests/options', () => {
+  const a = file('a', 'a', 'package'), b = file('b', 'b', 'package');
+  const base = {requests: [{sourceId: 'a', options: ['red', 'blue']}, {sourceId: 'b', options: []}]};
+  const key = make([a, b], base).cacheKey;
+  assert.equal(make([b, a], base).cacheKey, key);
+  for (const [files, change] of [
+    [[a, file('b', 'changed', 'package')], base], [[a, {...b, version: 2}], base],
+    [[a, b], {...base, engineIdentity: 'other'}], [[a, b], {...base, initialStateIdentity: 'other'}],
+    [[a, b], {requests: [...base.requests].reverse()}],
+    [[a, b], {requests: [{sourceId: 'a', options: ['blue', 'red']}, base.requests[1]]}],
+    [[a, b, file('unused', 'unused', 'include')], base]
+  ]) assert.notEqual(make(files, change).cacheKey, key);
+  const options = ['x'], mutable = make([a], {requests: [{sourceId: 'a', options}]}); options[0] = 'y';
+  assert.deepEqual(mutable.requests[0].options, ['x']);
+});
+test('diagnostics name exact primitive at exact pinned byte span; interpretation always refuses', () => {
+  const c = make([file('k', '\\catcode64=11', 'kernel')]).context(), k = c.enter('k');
+  const span = c.origin(k, 0, 8), d = c.unsupported(span, 'catcode', 'Mutable category-code table and numeric scanner');
+  assert.deepEqual([d.code, d.sourceId, d.startByte, d.stopByte], ['TEX_PACKAGE_PRIMITIVE_UNSUPPORTED', 'k', 0, 8]);
+  assert.throws(() => c.unsupported(span, 'edef', 'expansion'), /differs/);
+  assert.throws(() => c.interpret(), {code: 'TEX_PACKAGE_INTERPRETER_UNAVAILABLE'});
+  const empty = make([file('empty', '', 'package')]).context();
+  assert.throws(() => empty.interpret(), {code: 'TEX_PACKAGE_INTERPRETER_UNAVAILABLE'});
+});
+test('native transport is aligned, detached immutable original source data', () => {
+  const b = make(); assert.deepEqual(b.sourceTable.ids, ['defs', 'main']);
+  for (let i = 0; i < b.sourceTable.ids.length; ++i) {
+    assert.equal(hash(Buffer.from(b.sourceTable.texts[i])), b.sourceTable.hashes[i]);
+    assert.equal(b.sourceTable.versions[i], 1);
+  }
+  const c = b.context(), root = c.enter('main'); c.origin(root, 0, 2);
+  const before = c.exportOrigins(); c.origin(root, 2, 6);
+  assert.equal(before.origins.length, 1); assert.equal(c.exportOrigins().origins.length, 2);
+});
+// These installed sources are read-only pinned inputs. Passing this test proves
+// exact loading and identified boundaries, never successful package evaluation.
+if (process.env.PACKAGE_SOURCE_MANIFEST) test('load actual installed kernel/amsmath/xcolor bytes, retain headers and exact first boundary', () => {
+  const manifest = JSON.parse(readFileSync(process.env.PACKAGE_SOURCE_MANIFEST));
+  const files = manifest.files.map((p, i) => ({id: p.id, version: 0, kind: i ? 'package' : 'kernel', bytes: readFileSync(p.path), sha256: p.sha256}));
+  const b = make(files, {requests: files.map(f => ({sourceId: f.id, options: []}))}), c = b.context();
+  for (const p of manifest.files) {
+    assert.equal(b.bytes(p.id).length, p.bytes);
+    assert.equal(hash(b.bytes(p.id)), p.sha256);
+    const occurrence = c.enter(p.id), boundary = p.first_boundary;
+    const span = c.origin(occurrence, boundary.startByte, boundary.stopByte);
+    assert.equal(c.textAt(span), boundary.text);
+    const primitive = boundary.text.match(/^\\([A-Za-z]+)/)[1];
+    const token = c.origin(occurrence, boundary.startByte, boundary.startByte + primitive.length + 1);
+    const d = c.unsupported(token, primitive, boundary.reason);
+    assert.equal(d.sourceId, p.id); assert.equal(d.sha256, p.sha256);
+    const state = p.state_boundary;
+    assert.equal(c.textAt(c.origin(occurrence, state.startByte, state.stopByte)), state.text);
+  }
+  assert.throws(() => c.interpret(), {code: 'TEX_PACKAGE_INTERPRETER_UNAVAILABLE'});
+});
diff --git a/examples/gpu-math/native-vkf/tex_package_sources.vkf b/examples/gpu-math/native-vkf/tex_package_sources.vkf
new file mode 100644
--- /dev/null
+++ b/examples/gpu-math/native-vkf/tex_package_sources.vkf
@@ -0,0 +1,43 @@
+# Exact host-supplied source universe. This does not execute or flatten packages.
+# Host verifies SHA-256/UTF-8 before transport; native guards are structural only.
+# Existing tex_frontend.prepare is deliberately unchanged until token-state ABI.
+text:.tex_text
+Sources:(schema:int,revision:str,ids:[str],versions:[int],texts:[str],hashes:[str])
+Span:(source:int,start:int,stop:int)
+
+validate(sources:Sources)->bit:
+    (sources.schema=1 /\ sources.revision~="")?! "Package source schema/revision"
+    count:sources.ids.length()
+    (count>0 /\ sources.versions.length()=count /\ sources.texts.length()=count /\ sources.hashes.length()=count)?! "Package source column lengths"
+    index:0
+    index<count?>
+        (sources.ids.(index)~="" /\ sources.versions.(index)>=0 /\ text.byte_length(sources.hashes.(index))=64)?! "Package source identity"
+        previous:0
+        previous<index?>
+            (sources.ids.(previous)~=sources.ids.(index))?! "Duplicate package source identity"
+            .previous:previous+1
+        .index:index+1
+    @:true
+
+boundary(source:str,offset:int)->bit:
+    offset<0? @:false
+    position:0
+    position<offset?>
+        vkf_string_eof(source,position)? @:false
+        .position:text.next(source,position)
+    @:position=offset
+
+read(sources:Sources,span:Span)->str:
+    validate(sources)?! "Invalid package sources"
+    (span.source>=0 /\ span.source<sources.ids.length())?! "Package source index"
+    value:sources.texts.(span.source)
+    (span.start>=0 /\ span.stop>span.start /\ span.stop<=text.byte_length(value))?! "Package source span"
+    (boundary(value,span.start) /\ boundary(value,span.stop))?! "Package source split UTF-8 scalar"
+    @:text.span(value,span.start,span.stop)
+
+# Explicit boundary for any attempted execution, including an empty package.
+# No route to legacy string macro expansion, unknown-command passthrough or PDF.
+interpret(sources:Sources)->str:
+    validate(sources)?! "Invalid package sources"
+    false?! "TEX_PACKAGE_INTERPRETER_UNAVAILABLE: stateful token/namespace/scoping ABI required"
+    @:""
diff --git a/examples/gpu-math/native-vkf/tex_package_sources_tests.vkf b/examples/gpu-math/native-vkf/tex_package_sources_tests.vkf
new file mode 100644
--- /dev/null
+++ b/examples/gpu-math/native-vkf/tex_package_sources_tests.vkf
@@ -0,0 +1,20 @@
+p:.tex_package_sources
+
+sources():
+    @:(schema:1,revision:"sha256:fixture",ids:["main","defs"],versions:[1,2],texts:["α😀\r\n\\foo","\\newcommand{\\foo}{x}"],hashes:["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"])
+
+renderer_tests()->bit:
+    table:sources()
+    p.validate(table)?! "aligned source table"
+    (p.read(table,(source:0,start:2,stop:6))="😀")?! "original UTF-8 scalar"
+    (p.read(table,(source:0,start:6,stop:8))="\r\n")?! "CRLF unchanged"
+    (p.read(table,(source:0,start:8,stop:12))="\\foo")?! "invocation source retained"
+    (p.read(table,(source:1,start:0,stop:11))="\\newcommand")?! "definition source separate"
+    (~p.boundary("α😀",3))?! "split scalar rejected"
+    (~p.boundary("α😀",7))?! "past EOF rejected"
+    @:true
+
+reject_split()->str:p.read(sources(),(source:0,start:2,stop:3))
+reject_index()->str:p.read(sources(),(source:2,start:0,stop:1))
+reject_interpret()->str:p.interpret(sources())
+renderer_tests()
