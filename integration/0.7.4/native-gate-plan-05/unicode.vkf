# Unexecuted independent primitive qualification; offsets are UTF-8 byte offsets.
n:.test_json_binary64
s:"Aé😀"
(n.size(s)=7)?! "UTF8 byte extent"
(n.at(s,0)="A")?! "ASCII scalar"
(n.at(s,1)="é")?! "two byte scalar"
(n.at(s,3)="😀")?! "four byte scalar"
(n.at(s,7)="")?! "EOF scalar"
(vkf_utf8_advance(s,0)=1)?! "ASCII cursor advance"
(vkf_utf8_advance(s,1)=3)?! "two byte cursor advance"
(vkf_utf8_advance(s,3)=7)?! "four byte cursor advance"
(~vkf_string_eof(s,3))?! "not EOF at final scalar"
(vkf_string_eof(s,7))?! "EOF at byte extent"
(n.code("é")=233)?! "BMP scalar to int"
(n.code("😀")=128512)?! "supplementary scalar to int"
(str(chr(233))="é")?! "BMP chr equality"
(str(chr(128512))="😀")?! "supplementary chr equality"
("é"~="é")?! "scalar equality does not normalize"
(n.char(9)="9")?! "decimal digit chr"
