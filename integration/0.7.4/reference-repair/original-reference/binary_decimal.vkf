            .position:position+1
            @>
        digit:int(vkf_decimal_parse(c))
        (count>0 \/ digit>0)? .count:count+1
        decimal? .fraction:fraction+1
        small?
            (coefficient>900719925474099 \/ (coefficient=900719925474099 /\ digit>2))? .small:false
