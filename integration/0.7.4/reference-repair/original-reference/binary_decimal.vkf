# Correctly rounded finite decimal -> binary64. The caller validates JSON
# grammar and supplies token byte boundaries. No host number parser is used.
shared_module_tex_text_09640ead:.tex_text
Result:(value:num,valid:bit)
zeros(size:int)->[int]:[0:size]

signed(value:num,negative:bit)->Result:
    result:value
    negative? .result:num(-1)*value
    @:(value:result,valid:value-value=0)

decode(source:str,begin:int,stop:int)->Result:
