    coefficient_stop:position
    exponent:0
    exponent_sign:1
    position<stop?
        .position:position+1
        c:shared_module_tex_text_09640ead.at(source,position)
        c="-"? .exponent_sign: -1
        (c="+" \/ c="-")? .position:position+1
        position<stop?>
            exponent<stop-begin+2000? .exponent:exponent*10+int(vkf_decimal_parse(shared_module_tex_text_09640ead.at(source,position)))
            .position:position+1
    count=0? @:signed(0,negative)
    scale:fraction-exponent_sign*exponent
    order:count-scale-1
    order>308? @:(value:0,valid:false)
    order< -324? @:signed(0,negative)
    # Both operands are exact integers here, so one hardware multiply/divide
    # performs the only rounding. All powers10 through22 are exact binary64.
    small /\ scale>= -22 /\ scale<=22?
        power:1.0
        i:0
        i<|scale|?>
            .power:power*10
            .i:i+1
        value:num(coefficient)
        scale>0? .value:value/power
        scale<0? .value:value*power
        @:signed(value,negative)
    capacity:stop-begin+1100
    digits:zeros(capacity)
    .position:coefficient_start
    .count:0
    position<coefficient_stop?>
        c:shared_module_tex_text_09640ead.at(source,position)
        c~="."?
            digit:int(vkf_decimal_parse(c))
            (count>0 \/ digit>0)?
                digits.(count):digit
                .count:count+1
        .position:position+1
    count>0 /\ digits.(count-1)=0?>
        .count:count-1
        .scale:scale-1
    index:0
    index<count//2?>
        saved:digits.(index)
        digits.(index):digits.(count-index-1)
        digits.(count-index-1):saved
        .index:index+1
    scale<0?
        shift: -scale
        .index:count-1
        index>=0?>
            digits.(index+shift):digits.(index)
            .index:index-1
        .index:0
        index<shift?>
            digits.(index):0
            .index:index+1
        .count:count+shift
        .scale:0
    whole_count:count-scale
    whole_count<0? .whole_count:0
    significand:0
    bits:0
    binary_exponent:0
    whole_count<=15?
        .index:count-1
        index>=scale?>
            .significand:significand*10+digits.(index)
            .index:index-1
        magnitude:significand
        magnitude>0?>
            .bits:bits+1
            .magnitude:magnitude//2
        bits>0? .binary_exponent:bits-1
    whole_count>15?
        whole:zeros(whole_count)
        binary:zeros(whole_count*4)
        .index:0
        index<whole_count?>
            whole.(index):digits.(index+scale)
            .index:index+1
        remaining:whole_count
        remaining>0?>
            carry:0
            .index:remaining-1
            index>=0?>
                value:carry*10+whole.(index)
                whole.(index):value//2
                .carry:value%2
                .index:index-1
            binary.(bits):carry
            .bits:bits+1
            remaining>0 /\ whole.(remaining-1)=0?> .remaining:remaining-1
        .binary_exponent:bits-1
        take:bits
        take>53? .take:53
        .index:bits-1
        index>=bits-take?>
