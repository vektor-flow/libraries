            guard=1 /\ (sticky \/ significand%2=1)? .significand:significand+1
            @:signed(num(significand)*2.0^(bits-53),negative)
    count>scale? .count:scale
    count>0 /\ digits.(count-1)=0?> .count:count-1
    # Extract fractional bits directly from an exact decimal remainder. The
