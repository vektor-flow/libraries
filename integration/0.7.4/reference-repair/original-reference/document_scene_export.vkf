leaf(arena:Arena,index:int,mode:int,has_line:int= -1)->str:
    original:arena.extras.(index)
    blank:original=""
    blank? .original:"{}"
    tape:shared_module_resource_json_7fb5f9ee.parse(original)
    tape.valid?! "Invalid debug-only original leaf metadata"
    kind:arena.kinds.(index)
    line:has_line=1
    has_line<0?
        .line:shared_module_resource_json_7fb5f9ee.member(tape,0,"flowLine")>=0
        blank /\ (kind=0 \/ kind=1) /\ mode~=7? .line:true
    destination_present:shared_module_resource_json_7fb5f9ee.member(tape,0,"destinationIds")>=0
    color_present:shared_module_resource_json_7fb5f9ee.member(tape,0,"color")>=0
    parts:shared_module_text_chunks_3b4ac16d.empty(tape.count+20)
    count:0
    at:1
    at<tape.ends.(0)?>
        key:shared_module_resource_json_7fb5f9ee.string(tape,at)
        keep:key~="x" /\ key~="y" /\ key~="destinationIds"
        line /\ key="flowLine"? .keep:false
        (mode=1 \/ mode=2 \/ mode=9) /\ (key="verticalShrink" \/ key="verticalStretch")? .keep:false
        mode=1 /\ kind~=3 /\ (key="sx" \/ key="sy")? .keep:false
        mode=1 /\ (kind=2 \/ kind=3 \/ kind=9) /\ (key="width" \/ key="height")? .keep:false
        (mode=4 \/ mode=5 \/ mode=6) /\ key="floatPlacement"? .keep:false
        keep?
            parts.(count):raw(tape,at)&":"&raw(tape,at+1)
            .count:count+1
        .at:tape.ends.(at+1)
    blank?
        parts.(count):"\"kind\":"&shared_module_resource_json_7fb5f9ee.quote(shared_module_document_scene_b31fd35b.kind_name(kind))
        .count:count+1
        kind=0 \/ kind=1?
            parts.(count):"\"key\":"&shared_module_resource_json_7fb5f9ee.quote(arena.keys.(index))
            .count:count+1
        mode=7 \/ (mode~=1 /\ (kind=2 \/ kind=3 \/ kind=4 \/ kind=7 \/ kind=8 \/ kind=9))?
            parts.(count):number_field("width",arena.widths.(index))
            .count:count+1
            parts.(count):number_field("height",arena.heights.(index))
            .count:count+1
    parts.(count):number_field("x",arena.xs.(index))
    .count:count+1
    parts.(count):number_field("y",arena.ys.(index))
    .count:count+1
    line?
        parts.(count):"\"flowLine\":"&shared_module_tex_text_09640ead.integer(arena.lines.(index))
        .count:count+1
    mode=1 \/ mode=2 \/ mode=9?
        parts.(count):number_field("verticalShrink",arena.vertical_shrinks.(index))
        .count:count+1
        parts.(count):number_field("verticalStretch",arena.vertical_stretches.(index))
        .count:count+1
    mode=1?
        kind~=3?
