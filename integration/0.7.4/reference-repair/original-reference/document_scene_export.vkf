            .count:count+1
            parts.(count):number_field("sy",arena.sys.(index))
            .count:count+1
        kind=2 \/ kind=3 \/ kind=9?
            parts.(count):number_field("width",arena.widths.(index))
            .count:count+1
            parts.(count):number_field("height",arena.heights.(index))
            .count:count+1
    mode=4 \/ mode=5 \/ mode=6?
        placement:"top"
        mode=5? .placement:"bottom"
        mode=6? .placement:"page"
        parts.(count):"\"floatPlacement\":"&shared_module_resource_json_7fb5f9ee.quote(placement)
        .count:count+1
    arena.destination_counts.(index)>0 \/ destination_present?
        parts.(count):"\"destinationIds\":"&ids(arena,index)
        .count:count+1
    paint:arena.paints.(index)
    paint>=0 /\ ~color_present?
        color:arena.paint_table.(paint)
        parts.(count):"\"color\":["&shared_module_json_numbers_417d7020.roundtrip(color.red)&","&shared_module_json_numbers_417d7020.roundtrip(color.green)&","&shared_module_json_numbers_417d7020.roundtrip(color.blue)&","&shared_module_json_numbers_417d7020.roundtrip(color.alpha)&"]"
        .count:count+1
    i:1
    i<count?>
        parts.(i):","&parts.(i)
        .i:i+1
    @:"{"&shared_module_text_chunks_3b4ac16d.join(parts,0,count)&"}"
encode(doc:PageDocument,debug_modes:[int],flow_line_presence:[bit]=[false:0])->str:
    # Project the nested Arena once; doing this in each leaf call clones it
    # on the published compiler even though the callee only reads its columns.
    arena:doc.arena
    leaf_count:arena.count
    (debug_modes.length()=leaf_count)?! "Debug leaf modes do not match typed document"
    pages:shared_module_text_chunks_3b4ac16d.empty(doc.page_count)
    page:0
    page<doc.page_count?>
        values:shared_module_text_chunks_3b4ac16d.empty(doc.counts.(page))
        i:0
        i<doc.counts.(page)?>
            index:doc.firsts.(page)+i
            line: -1
            flow_line_presence.length()=leaf_count?
                .line:0
                flow_line_presence.(index)? .line:1
            prefix:""
            i>0? .prefix:","
            debug_mode:debug_modes.(index)
            values.(i):prefix&leaf(arena,index,debug_mode,line)
            .i:i+1
        prefix:""
        page>0? .prefix:","
        pages.(page):prefix&"{\"width\":"&shared_module_json_numbers_417d7020.roundtrip(doc.widths.(page))&",\"height\":"&shared_module_json_numbers_417d7020.roundtrip(doc.heights.(page))&",\"number\":"&shared_module_tex_text_09640ead.integer(page+1)&",\"items\":["&shared_module_text_chunks_3b4ac16d.join(values,0,doc.counts.(page))&"]}"
        .page:page+1
    destinations:shared_module_text_chunks_3b4ac16d.empty(doc.destination_count)
    i:0
    i<doc.destination_count?>
        prefix:""
        i>0? .prefix:","
        destinations.(i):prefix&shared_module_resource_json_7fb5f9ee.quote(doc.destination_names.(i))&":{\"page\":"&shared_module_tex_text_09640ead.integer(doc.destination_pages.(i))&",\"x\":"&shared_module_json_numbers_417d7020.roundtrip(doc.destination_xs.(i))&",\"y\":"&shared_module_json_numbers_417d7020.roundtrip(doc.destination_ys.(i))&"}"
        .i:i+1
    @:"{\"pages\":["&shared_module_text_chunks_3b4ac16d.join(pages,0,doc.page_count)&"],\"destinations\":{"&shared_module_text_chunks_3b4ac16d.join(destinations,0,doc.destination_count)&"}}"
