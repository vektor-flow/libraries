number_field(key:str,value:num)->str:@:shared_module_resource_json_7fb5f9ee.quote(key)&":"&shared_module_json_numbers_417d7020.roundtrip(value)
ids(arena:Arena,index:int)->str:
    count:arena.destination_counts.(index)
    values:shared_module_text_chunks_3b4ac16d.empty(count)
    i:0
    i<count?>
