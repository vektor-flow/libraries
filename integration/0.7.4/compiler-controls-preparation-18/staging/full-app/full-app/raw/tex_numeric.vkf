# TeX WEB section 108. Coordinates use bp; integer glue decisions use sp.
pt()->num:72/72.27
sp()->num:pt()/65536

minimum(a:num,b:num)->num:
    a<b? @:a
    @:b
maximum(a:num,b:num)->num:
    a>b? @:a
    @:b

badness(amount:num,elastic:num)->int:
    t:int((|amount|*65536/pt()+0.5)//1)
    t=0? @:0
    s:int((elastic*65536/pt()+0.5)//1)
    s<=0? @:10000
    r:t
    t<=7230584? .r:(t*297)//s
    t>7230584 /\ s>=1663497? .r:t//(s//297)
    r>1290? @:10000
    @:(r*r*r+131072)//262144

fitness(ratio:num,glue_badness:int)->int:
    glue_badness<=12? @:1
    ratio<0? @:0
    glue_badness<=99? @:2
    @:3

line_demerits(prior:num,glue_badness:int,penalty:int,previous_fitness:int,current_fitness:int,
              previous_flagged:bit,flagged:bit,last:bit)->num:
    cost:prior+(10+glue_badness)^2
    penalty>0? .cost:cost+penalty^2
    penalty<0 /\ penalty > -10000? .cost:cost-penalty^2
    previous_flagged /\ flagged? .cost:cost+10000
    last /\ previous_flagged? .cost:cost+5000
    |current_fitness-previous_fitness|>1? .cost:cost+10000
    @:cost

# Noad classes: ord, op, bin, rel, open, close, punct, inner.

math_space(previous:int,current:int,style:int)->int:
    (previous>=0 /\ previous<8 /\ current>=0 /\ current<8)?!
    spacing:[
        0,3,4,5,0,0,0,3,
        3,3,0,5,0,0,0,3,
        4,4,4,0,4,0,0,4,
        5,5,0,0,5,0,0,5,
        0,0,0,0,0,0,0,0,
        0,3,4,5,0,0,0,3,
        3,3,0,3,3,3,3,3,
        3,3,4,5,3,0,3,3
    ]
    mu:spacing.(previous*8+current)
    style>=2 /\ ~(mu=3 /\ (previous=1 \/ current=1))? @:0
    @:mu

mu_unit(quad:num)->num:num(int((quad/sp()/18)//1))*sp()

space_factor(c:str)->int:
    c>="A" /\ c<="Z"? @:999
    c="." \/ c="!" \/ c="?"? @:3000
    c=":"? @:2000
    c=";"? @:1500
    c=","? @:1250
    c="\"" \/ c="'" \/ c="’" \/ c="”" \/ c=")" \/ c="]"? @:0
    @:1000
