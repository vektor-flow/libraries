# Exact document-links.mjs option policy. Unknown initial JSON members survive;
# only explicit setup options mutate the matching appearance field.
link_policy_text:.tex_text
link_policy_tokens:.math_tokens
link_policy_numbers:.document_link_numbers
link_policy_color:.math_colors
link_policy_json:.resource_json
link_policy_decimal:.json_numbers
link_policy_chunks:.text_chunks
Configured:(appearance:str,diagnostics:str)
Result:(value:num,valid:bit)
raw(tape:(source:str,kinds:[int],starts:[int],stops:[int],ends:[int],count:int,valid:bit),node:int)->str:
    starts:tape.starts
    stops:tape.stops
    @:link_policy_text.span(tape.source,starts.(node),stops.(node))
border(value:str)->Result:
    at:0
    count:0
    last:0.0
    size:link_policy_text.byte_length(value)
    # value has already been trimmed, exactly before value.split(/\s+/).
    true?>
        start:at
        ~vkf_string_eof(value,at) /\ ~link_policy_tokens.space(link_policy_text.at(value,at))?> .at:link_policy_text.next(value,at)
        parsed:link_policy_numbers.parse(link_policy_text.span(value,start,at))
        ~parsed.valid? @:(value:0,valid:false)
        .last:parsed.value
        .count:count+1
        at>=size? @|
        .at:link_policy_tokens.skip_space(value,at)
    @:(value:last,valid:count=3 /\ last>=0)
configure(options:[str],initial_json:str="")->Configured:
    defaults:["true","1","false","[1,0,0,1]","[0,1,0,1]","[0,1,1,1]"]
    values:link_policy_chunks.empty(6)
    default_index:0
    default_index<6?>
        values.(default_index):defaults.(default_index)
        .default_index:default_index+1
    keys:["enabled","borderWidth","colorlinks","ref","cite","url"]
    extra:""
    initial_json~="" /\ initial_json~="null"?
        tape:link_policy_json.parse(initial_json)
        ends:tape.ends
        at:1
        at<ends.(0)?>
            name:link_policy_json.string(tape,at)
            found:false
            i:0
            i<6?>
                name=keys.(i)?
                    values.(i):raw(tape,at+1)
                    .found:true
                .i:i+1
            ~found? .extra:extra&","&link_policy_json.quote(name)&":"&raw(tape,at+1)
            .at:ends.(at+1)
    diagnostics:""
    index:0
    index<options.length()?>
        option:options.(index)
        equal:link_policy_text.find(option,"=")
        key:link_policy_numbers.trim(option)
        value:""
        equal>=0?
            .key:link_policy_numbers.trim(link_policy_text.span(option,0,equal))
            .value:link_policy_numbers.trim(link_policy_text.span(option,equal+1,link_policy_text.byte_length(option)))
        size:link_policy_text.byte_length(value)
        size>=2 /\ link_policy_text.matches(value,0,"{") /\ link_policy_text.matches(value,size-1,"}")?
            dot:true
            cursor:0
            cursor<size?>
                c:link_policy_text.at(value,cursor)
                (c="\n" \/ c="\r" \/ c=" " \/ c=" ")? .dot:false
                .cursor:link_policy_text.next(value,cursor)
            dot? .value:link_policy_text.span(value,1,size-1)
        diagnostic:""
        handled:false
        key="hidelinks" /\ value~="false"?
            values.(1):"0"
            values.(2):"false"
            .handled:true
        key="colorlinks"?
            values.(2):"true"
            values.(1):"0"
            value="false"?
                values.(2):"false"
                values.(1):"1"
            .handled:true
        key="pdfborder"?
            parsed:border(value)
            parsed.valid? values.(1):link_policy_decimal.roundtrip(parsed.value)
            ~parsed.valid? .diagnostic:"Unsupported hyperref pdfborder: "&value
            .handled:true
        (key="linkcolor" \/ key="citecolor" \/ key="urlcolor" \/ key="allcolors")?
            color:link_policy_color.parse(value)
            color="null"? .diagnostic:"Unsupported hyperref color: "&value
            color~="null"?
                (key="linkcolor" \/ key="allcolors")? values.(3):color
                (key="citecolor" \/ key="allcolors")? values.(4):color
                (key="urlcolor" \/ key="allcolors")? values.(5):color
            .handled:true
        ~handled /\ key~="" /\ ~link_policy_tokens.one_of(key,["hidelinks","unicode","pdfencoding","bookmarks","bookmarksopen","bookmarksnumbered","pdfusetitle","breaklinks"])? .diagnostic:"Unsupported hyperref setup: "&key
        diagnostic~=""?
            diagnostics~=""? .diagnostics:diagnostics&","
            .diagnostics:diagnostics&link_policy_json.quote(diagnostic)
        .index:index+1
    parts:link_policy_chunks.empty(6)
    i:0
    i<6?>
        prefix:""
        i>0? .prefix:","
        parts.(i):prefix&link_policy_json.quote(keys.(i))&":"&values.(i)
        .i:i+1
    @:(appearance:"{"&link_policy_chunks.join(parts,0,6)&extra&"}",diagnostics:diagnostics)
