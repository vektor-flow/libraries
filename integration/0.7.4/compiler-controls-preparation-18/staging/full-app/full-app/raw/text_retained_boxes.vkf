Metadata:(kinds:[int],ends:[int],texts:[str],numbers:[num],count:int)
Paint:(red:num,green:num,blue:num,alpha:num)
Payload:(crop_x:bit,crop_y:bit,crop_left:bit,crop_right:bit,crop_top:bit,crop_bottom:bit,left:num,right:num,top:num,bottom:num,dx:num,dy:num,c1x:num,c1y:num,c2x:num,c2y:num,line_width:num,fill:bit,fill_paint:int,stroke_paint:int,dash:int,target_type:int,target:str,border_width:num,asset:str)
Leaf:(kind:int,key:str,x:num,y:num,sx:num,sy:num,width:num,height:num,line:int,equation_tag:bit,tag_width:num,draw:bit,metadata:Metadata,glyph_parts:int,flow_x:num,flow_width:num,has_flow:bit,vertical_shrink:num,vertical_stretch:num,paint:Paint,has_paint:bit,payload:Payload,has_payload:bit,fill_paint:Paint,has_fill_paint:bit,stroke_paint:Paint,has_stroke_paint:bit,destination_ids:[str],footnote_number:int,a260_scope:str,a260_text:str,a260_operation:int,a260_start:int,a260_stop:int,a260_part:int)
Arena:(kinds:[int],keys:[str],xs:[num],ys:[num],sxs:[num],sys:[num],widths:[num],heights:[num],lines:[int],equation_tags:[bit],tag_widths:[num],draws:[bit],metadata:Metadata,metadata_roots:[int],glyph_parts:[int],flow_xs:[num],flow_widths:[num],has_flows:[bit],vertical_shrinks:[num],vertical_stretches:[num],paints:[int],payloads:[int],destination_firsts:[int],destination_counts:[int],destination_ids:[str],count:int,paint_table:[Paint],paint_count:int,payload_table:[Payload],payload_count:int,footnote_numbers:[int],a260_scopes:[str],a260_texts:[str],a260_operations:[int],a260_starts:[int],a260_stops:[int],a260_parts:[int])
Scene:(arena:Arena,anchor_ids:[str],anchor_xs:[num],anchor_ys:[num],anchor_lines:[int],anchor_metadata:Metadata,anchor_roots:[int],anchor_count:int,width:num,height:num,depth:num,tag_width:num,inline_destinations:bit)
Store:(arena:Arena,firsts:[int],counts:[int],anchor_firsts:[int],anchor_counts:[int],anchor_ids:[str],anchor_xs:[num],anchor_ys:[num],anchor_lines:[int],anchor_metadata:Metadata,anchor_roots:[int],anchor_scenes:[int],anchor_count:int,widths:[num],heights:[num],depths:[num],tag_widths:[num],inline_destinations:[bit],count:int)
# Generic retained vector scenes, shared by every recursive inline box scope.
text_inline_arguments:.text_inline_arguments
text_parser_stream:.text_parser_stream
text_inline_boxes:.text_inline_boxes
resource_json:.resource_json
tex_text:.tex_text
Pool:(values:[str],slots:[int],hashes:[int],count:int)
Stream:(texts:[str],numbers:[[int]],starts:[[int]],stops:[[int]],parents:[[int]],count:int,diagnostics:str)
Provider:(operation_ids:[int],kinds:[int],widths:[num],stretches:[num],shrinks:[num],heights:[num],depths:[num],italics:[num],breakable:[bit],flagged:[bit],penalties:[int],scenes:Store,scene_ids:[int],scene_metadata:Metadata,scene_roots:[int],diagnostics:[str],count:int)
provide(stream:Stream,scenes_json:str="{}")->Provider:
    scenes:resource_json.parse("{}")
    loaded:false
    directory:text_inline_arguments.build(stream)
    first:directory.first
    hidden:directory.hidden
    out:text_inline_boxes.empty()
    index:0
    index<stream.count?>
        operation:index
        .index:index+1
        hidden.(operation)? @>
        text_parser_stream.value(stream,operation,"kind")~="command"? @>
        text_parser_stream.value(stream,operation,"value")~="vkftikzbox"? @>
        ~loaded?
            .scenes:resource_json.parse(scenes_json)
            .loaded:true
        argument:first.(operation)
        key:""
        argument>=0? .key:text_parser_stream.value(stream,argument,"value")
        scene:resource_json.member(scenes,0,key)
        scene<0?
            .out:text_inline_boxes.append(out,operation,5,diagnostics:resource_json.quote("Missing native TikZ box: "&key))
            @>
        starts:scenes.starts
        stops:scenes.stops
        retained:tex_text.span(scenes.source,starts.(scene),stops.(scene))
        width:resource_json.number(scenes,resource_json.member(scenes,scene,"width"))
        height:resource_json.number(scenes,resource_json.member(scenes,scene,"height"))
        depth:resource_json.number(scenes,resource_json.member(scenes,scene,"depth"))
        .out:text_inline_boxes.append(out,operation,0,width,height,depth,scene:retained)
    @:out
