# Root math noads remain separate paragraph boxes, glue, kerns and penalties.
# Retained child drawings are flattened only when a paragraph packet is emitted.
draw:.math_draw
chunks:.text_chunks
numbers:.json_numbers
text:.tex_text
ParagraphNodes:(kinds:[int],owners:[int],widths:[num],heights:[num],depths:[num],stretches:[num],shrinks:[num],penalties:[int],count:int)
Scene:(width:num,height:num,depth:num,heads:[[int]],box_count:int,nexts:[[int]],children:[[int]],payload:[str],payload_ids:[[int]],payload_count:int,xs:[[num]],ys:[[num]],flow:[[bit]],flow_x:[[num]],flow_width:[[num]],count:int,diagnostics:str,atoms:int,next_equation_number:int,equation_references:str,has_last_row:bit,last_row_baseline:num,last_row_depth:num,paragraph:ParagraphNodes,has_paragraph:bit)
Nodes:(kinds:[int],owners:[int],widths:[num],heights:[num],depths:[num],stretches:[num],shrinks:[num],penalties:[int],count:int)
empty(capacity:int)->Nodes:
    @:(kinds:draw.ints(capacity),owners:draw.ints(capacity),widths:draw.zeros(capacity),heights:draw.zeros(capacity),depths:draw.zeros(capacity),stretches:draw.zeros(capacity),shrinks:draw.zeros(capacity),penalties:draw.ints(capacity),count:0)
append(input:Nodes,kind:int,width:num=0,owner:int= -1,height:num=0,depth:num=0,stretch:num=0,shrink:num=0,penalty:int=0)->Nodes:
    kinds:input.kinds
    owners:input.owners
    widths:input.widths
    heights:input.heights
    depths:input.depths
    stretches:input.stretches
    shrinks:input.shrinks
    penalties:input.penalties
    count:input.count
    count<kinds.length()?! "Math paragraph node capacity"
    kinds.(count):kind
    owners.(count):owner
    widths.(count):width
    heights.(count):height
    depths.(count):depth
    stretches.(count):stretch
    shrinks.(count):shrink
    penalties.(count):penalty
    @:(kinds:kinds,owners:owners,widths:widths,heights:heights,depths:depths,stretches:stretches,shrinks:shrinks,penalties:penalties,count:count+1)
json(input:Nodes,scene:Scene)->str:
    kinds:input.kinds
    owners:input.owners
    widths:input.widths
    heights:input.heights
    depths:input.depths
    stretches:input.stretches
    shrinks:input.shrinks
    penalties:input.penalties
    parts:chunks.empty(input.count)
    index:0
    index<input.count?>
        value:""
        kind:kinds.(index)
        kind=0?
            items:draw.json_items(draw.flatten_from(scene,owners.(index)))
            .value:"{\"type\":\"box\",\"box\":{\"items\":"&items&",\"width\":"&numbers.roundtrip(widths.(index))&",\"height\":"&numbers.roundtrip(heights.(index))&",\"depth\":"&numbers.roundtrip(depths.(index))&"}}"
        kind=1?
            .value:"{\"type\":\"glue\",\"width\":"&numbers.roundtrip(widths.(index))&",\"stretch\":"&numbers.roundtrip(stretches.(index))&",\"shrink\":"&numbers.roundtrip(shrinks.(index))&",\"breakable\":false}"
        kind=2? .value:"{\"type\":\"kern\",\"width\":"&numbers.roundtrip(widths.(index))&"}"
        kind=3? .value:"{\"type\":\"penalty\",\"penalty\":"&text.integer(penalties.(index))&"}"
        index>0? .value:","&value
        parts.(index):value
        .index:index+1
    @:"["&chunks.join(parts,0,index)&"]"

# Borrowed scalar readers keep the immutable node columns in their owner.
count(nodes:Nodes)->int:nodes.count
kind(nodes:Nodes,index:int)->int:nodes.kinds.(index)
width(nodes:Nodes,index:int)->num:nodes.widths.(index)
height(nodes:Nodes,index:int)->num:nodes.heights.(index)
depth(nodes:Nodes,index:int)->num:nodes.depths.(index)
stretch(nodes:Nodes,index:int)->num:nodes.stretches.(index)
shrink(nodes:Nodes,index:int)->num:nodes.shrinks.(index)
penalty(nodes:Nodes,index:int)->int:nodes.penalties.(index)
box_json(nodes:Nodes,scene:Scene,index:int)->str:
    items:draw.json_items(draw.flatten_from(scene,nodes.owners.(index)))
    @:"{\"items\":"&items&",\"width\":"&numbers.roundtrip(nodes.widths.(index))&",\"height\":"&numbers.roundtrip(nodes.heights.(index))&",\"depth\":"&numbers.roundtrip(nodes.depths.(index))&"}"
