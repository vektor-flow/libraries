string(tape:Tape,node:int,key:str)->str:document_present.string(tape,node,key)
array_count(tape:Tape,node:int)->int:
    node<0? @:0
    ends:tape.ends
    count:0
    at:node+1
    at<ends.(node)?>
        .count:count+1
        .at:ends.(at)
    @:count
shape_core(plan:Plan,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,tables:Tables,prepared:bit,document_boxes_json:str="{}",citation_labels_json:str="{}",citation_separator:str=",~",legacy_output:bit=false):
    @:shape_retained_core(plan,fonts,roles,language,c,page_values,tables,prepared,math_retained_directory.unprepared(document_boxes_json),citation_labels_json,citation_separator,legacy_output)
shape_retained_core(plan:Plan,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,tables:Tables,prepared:bit,retained_directory:Directory,citation_labels_json:str="{}",citation_separator:str=",~",legacy_output:bit=false,a261_blocks:[int]=[],a261_scopes:[str]=[],a261_texts:[str]=[],a263_kinds:[str]=[]):
    seed:text_prepared_runs.seal(fonts,text_prepared_runs.empty_collection())
    generation:prepare_main_request(seed,text_chunks.empty(0),plan,fonts,roles,language,c,page_values,citation_labels_json,citation_separator)
    @:shape_request_core(generation.request,plan,fonts,roles,language,c,page_values,tables,prepared,retained_directory,citation_labels_json,citation_separator,legacy_output,a261_blocks,a261_scopes,a261_texts,a263_kinds)

shape_request_core(request:Prepared,plan:Plan,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,tables:Tables,prepared:bit,retained_directory:Directory,citation_labels_json:str="{}",citation_separator:str=",~",legacy_output:bit=false,a261_blocks:[int]=[],a261_scopes:[str]=[],a261_texts:[str]=[],a263_kinds:[str]=[]):
    block_count:plan.count
    config:resource_json.parse(c.config)
    global_links_json:document_materialize_config.raw_member(config,0,"linkAppearance","{}")
    ams:c.class_name="amsart"
    display_font:font_catalog.style(fonts,"display")
    unit:number(config,0,"fontSize")/number(display_font,0,"em")
    |unit-1|<0.000000000001? .unit:1
    pt:tex_numeric.pt()
    modes:(prepared:prepared,legacy_output:legacy_output)
    measured:document_materialize_groups.measure_range_request(request,plan,fonts,roles,language,c,page_values,retained_directory,citation_labels_json,citation_separator,config,unit,global_links_json,tables,modes,0,block_count,a261_blocks,a261_scopes,a261_texts,a263_kinds)
    typed_scenes:document_materialize_groups.scenes_range(measured,0,block_count)
    typed_labels:document_materialize_groups.labels_range(measured,0,block_count)
    scenes:text_chunks.empty(block_count)
    labels:text_chunks.empty(block_count)
    lines:document_pages.empty_lines(block_count+1)
    ids:lines.scenes
    source_lines:lines.source_lines
    heights:lines.heights
    depths:lines.depths
    natural:lines.natural_depths
    widths:lines.widths
    indents:lines.indents
    baselines:lines.baselines
    flagged:lines.flagged
    offset:0
    label_init:0
    label_init<block_count?>
        labels.(label_init):"{}"
        .label_init:label_init+1
    kinds:plan.kinds
    sources:plan.sources
    contexts:plan.contexts
    attrs:plan.attrs
    retained:plan.scenes
    diagnostics:plan.diagnostics
    unresolved:plan.unresolved
    initial_blocks:document_pages.empty_blocks(block_count)
    block_texts:initial_blocks.texts
    block_index_values:initial_blocks.indices
    block_numbers:initial_blocks.numbers
    block_booleans:initial_blocks.booleans
    total_lines:0
    pending_pages:false
    index:0
    index<block_count?>
        kind:kinds.(index)
        context:document_present_context.parse(contexts.(index))
        properties:resource_json.parse("{"&attrs.(index)&"}")
        heading_config:resource_json.member(config,0,kind)
        titlepart:string(properties,0,"titlePart")
        heading:kind="section" \/ kind="subsection" \/ kind="title" \/ kind="author"
        paragraph:kind="paragraph"
        caption:kind="caption"
        verbatim:kind="verbatim"
        block:measured.(index)
        columns:block.columns
        .diagnostics:document_materialize_config.merge(diagnostics,block.diagnostics)
        block.pending_pages? .pending_pages:true
        block.unresolved~=""?
            unresolved~=""? .unresolved:unresolved&","
            .unresolved:unresolved&block.unresolved
        scenes.(index):block.legacy_scene
        labels.(index):block.legacy_label
        label_width:block.label.width
        label_height:block.label.height
        label_depth:block.label.depth
        count:columns.count
        count=0 /\ ~(kind="pagebreak" \/ kind="vspace" \/ kind="bibliographysetup")? .count:1
        block_texts.(0*block_count+index):kind
        block_texts.(1*block_count+index):context.kind
        block_index_values.(0*block_count+index):total_lines
        block_index_values.(1*block_count+index):count
        block_numbers.(1*block_count+index):unit
        block_numbers.(0*block_count+index):columns.width
        block_numbers.(2*block_count+index):context.left
        block_numbers.(3*block_count+index):context.right
        block_numbers.(4*block_count+index):context.indent
        .total_lines:total_lines+count
        before:context.before
        heading? .before:number(config,heading_config,"before",12*pt)
        kind="math"? .before:number(config,0,"displaySkip",10*pt)
        caption? .before:0
        verbatim? .before:number(properties,0,"before",12*pt)
        titlepart~=""? .before:0
        kind="vspace"? .before:document_materialize_config.length(sources.(index),c.config,0)
        block_numbers.(5*block_count+index):before
        block_numbers.(6*block_count+index):number(properties,0,"beforeShrink",context.before_shrink)
        block_numbers.(7*block_count+index):number(properties,0,"beforeStretch",context.before_stretch)
        after:0.0
        heading? .after:number(config,heading_config,"after",8*pt)
        kind="title"? .after:15*pt
        titlepart="author"? .after:10*pt
        titlepart="date"? .after:25*pt
        ams /\ titlepart="title"? .after:18*pt
        ams /\ titlepart="author"? .after:18*pt
        kind="abstractHeading"? .after:10*pt-0.5*document_present.quad(fonts,"smallbold")
        titlepart="abstract"?
            last_depth:document_paragraph_metrics.last_depth(columns)
            abstract_config:resource_json.member(config,0,"abstract")
            .after:34*pt-number(config,0,"lineHeight")+last_depth*unit+0.175*number(config,abstract_config,"lineHeight")
        caption? .after:12*pt
        verbatim? .after:8*pt
        kind="vspace"? .after:0
        block_numbers.(8*block_count+index):after
        block_numbers.(11*block_count+index):context.leading
        baseline_leading:number(config,heading_config,"lineHeight",context.leading)
        kind="section" /\ resource_json.member(config,heading_config,"lineHeight")<0? .baseline_leading:18*pt
        kind="subsection" /\ resource_json.member(config,heading_config,"lineHeight")<0? .baseline_leading:14*pt
        kind="title" /\ resource_json.member(config,heading_config,"lineHeight")<0? .baseline_leading:22*pt
        titlepart="author" /\ ~ams? .baseline_leading:14*pt
        block_numbers.(18*block_count+index):baseline_leading
        centered:context.align="center" \/ string(config,heading_config,"align")="center" \/ kind="math" \/ kind="abstractHeading" \/ kind="title" \/ kind="author" \/ caption
        block_booleans.(0*block_count+index):centered
        block_booleans.(3*block_count+index):context.paragraph_after_display
        block_booleans.(4*block_count+index):context.no_indent_after_list
        block_booleans.(7*block_count+index):context.after_display
        block_booleans.(8*block_count+index):context.center_awaiting
        block_booleans.(9*block_count+index):context.list_end_display
        block_numbers.(20*block_count+index):context.list_top
        block_numbers.(23*block_count+index):context.list_top_shrink
        block_numbers.(24*block_count+index):context.list_top_stretch
        block_numbers.(19*block_count+index):context.list_parsep
        block_numbers.(21*block_count+index):context.list_parsep_shrink
        block_numbers.(22*block_count+index):context.list_parsep_stretch
        block_booleans.(1*block_count+index):flag(properties,0,"singleDisplay")
        block_booleans.(2*block_count+index):flag(properties,0,"fromParagraph")
        block_booleans.(5*block_count+index):flag(properties,0,"verticalBracket")
        titlepart="title"?
            block_index_values.(2*block_count+index):1
            title_config:resource_json.member(config,0,"title")
            block_numbers.(15*block_count+index):number(config,title_config,"firstBaseline",52*pt)
        titlepart="abstract"?
            block_index_values.(2*block_count+index):2
            abstract_config:resource_json.member(config,0,"abstract")
            block_numbers.(15*block_count+index):20*pt+0.175*number(config,abstract_config,"lineHeight")
        columns.has_last_row?
            block_booleans.(6*block_count+index):true
            block_numbers.(13*block_count+index):columns.last_row_baseline
            block_numbers.(14*block_count+index):columns.last_row_depth
        block_numbers.(12*block_count+index):columns.tag_width
        total_lines>ids.length()?>
            capacity:ids.length()
            .ids:ids&[-1:capacity]
            .source_lines:source_lines&[0:capacity]
            .heights:heights&[0.0:capacity]
            .depths:depths&[0.0:capacity]
            .natural:natural&[0.0:capacity]
            .widths:widths&[0.0:capacity]
            .indents:indents&[0.0:capacity]
            .baselines:baselines&[0.0:capacity]
            .flagged:flagged&[false:capacity]
        line:0
        line<count?>
            ids.(offset):index
            source_lines.(offset):line
            heights.(offset):columns.height
            depths.(offset):columns.depth
            widths.(offset):columns.width
            line<columns.count?
                heights.(offset):columns.heights.(line)
                depths.(offset):columns.depths.(line)
                widths.(offset):columns.widths.(line)
                indents.(offset):columns.indents.(line)
                baselines.(offset):columns.baselines.(line)
                flagged.(offset):columns.flagged.(line)
            natural.(offset):document_paragraph_metrics.line_natural_depth(columns,line)
            ams /\ line=0 /\ label_width>0?
                heights.(offset):document_present.maximum(heights.(offset),label_height/unit)
                depths.(offset):document_present.maximum(depths.(offset),label_depth/unit)
                natural.(offset):document_paragraph_metrics.label_natural_depth(natural.(offset),label_depth,unit)
            ~ams /\ titlepart="author"?
                heights.(offset):document_present.maximum(heights.(offset),9.8*pt)
                depths.(offset):document_present.maximum(depths.(offset),4.2*pt)
                natural.(offset):depths.(offset)
            .offset:offset+1
            .line:line+1
        .index:index+1
    lines.count:total_lines
    lines.marker_firsts:[0:total_lines]
    lines.marker_counts:[0:total_lines]
    lines.scenes:document_pages.prefix_ints(ids,total_lines)
    lines.source_lines:document_pages.prefix_ints(source_lines,total_lines)
    lines.heights:document_pages.prefix_numbers(heights,total_lines)
    lines.depths:document_pages.prefix_numbers(depths,total_lines)
    lines.natural_depths:document_pages.prefix_numbers(natural,total_lines)
    lines.widths:document_pages.prefix_numbers(widths,total_lines)
    lines.indents:document_pages.prefix_numbers(indents,total_lines)
    lines.baselines:document_pages.prefix_numbers(baselines,total_lines)
    lines.flagged:document_pages.prefix_flags(flagged,total_lines)
    blocks:document_pages.blocks_from_columns(block_texts,block_index_values,block_numbers,block_booleans,block_count)
    @:(blocks:blocks,lines:lines,scenes:scenes,labels:labels,diagnostics:diagnostics,unresolved:unresolved,pending_pages:pending_pages,typed_scenes:typed_scenes,typed_labels:typed_labels)

shape(plan:Plan,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,document_boxes_json:str="{}",citation_labels_json:str="{}",citation_separator:str=",~",legacy_output:bit=false):
    tables:text_source_paragraph.empty_tables()
    @:shape_core(plan,fonts,roles,language,c,page_values,tables,false,document_boxes_json,citation_labels_json,citation_separator,legacy_output)
shape_prepared(plan:Plan,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,tables:Tables,document_boxes_json:str="{}",citation_labels_json:str="{}",citation_separator:str=",~",legacy_output:bit=false):
    @:shape_core(plan,fonts,roles,language,c,page_values,tables,true,document_boxes_json,citation_labels_json,citation_separator,legacy_output)

shape_prepared_retained(plan:Plan,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,tables:Tables,retained:Directory,citation_labels_json:str="{}",citation_separator:str=",~",legacy_output:bit=false,a261_blocks:[int]=[],a261_scopes:[str]=[],a261_texts:[str]=[],a263_kinds:[str]=[]):
    @:shape_retained_core(plan,fonts,roles,language,c,page_values,tables,true,retained,citation_labels_json,citation_separator,legacy_output,a261_blocks,a261_scopes,a261_texts,a263_kinds)

# Each reference pass resolves the current sources before assigning run IDs.
# Stable content/role lookup reuses unchanged runs; changed resolved text adds demands.
prepare_main_request(seed:Prepared,previous_sources:[str],plan:Plan,fonts:Catalog,roles:[str],language:Language,c:Configuration,page_values:Map,citation_labels_json:str,citation_separator:str,reuse_fixed_context:bit=false):
    # Opt in only within the same immutable Plan/catalog/config/roles/language.
    # Style, overrides, block order or any context change invalidates BOTH caches.
    request_seed:seed
    ~reuse_fixed_context? .request_seed:text_prepared_runs.seal(fonts,text_prepared_runs.empty_collection())
    config:resource_json.parse(c.config)
    global_links_json:document_materialize_config.raw_member(config,0,"linkAppearance","{}")
    display_font:font_catalog.style(fonts,"display")
    unit:number(config,0,"fontSize")/number(display_font,0,"em")
    |unit-1|<0.000000000001? .unit:1
    collection:text_prepared_runs.empty_collection()
    sources:text_chunks.empty(plan.count)
    changed:[false:plan.count]
    index:0
    index<plan.count?>
        prior:""
        known:reuse_fixed_context /\ index<previous_sources.length()
        known? .prior:previous_sources.(index)
        block:document_materialize_measure.collect_block_request(collection,prior,known,plan,index,fonts,roles,language,c,page_values,citation_labels_json,citation_separator,config,unit,global_links_json)
        .collection:block.collection
        sources.(index):block.source
        changed.(index):block.changed
        .index:index+1
    @:(request:document_shaping_request.extend(request_seed,fonts,collection),sources:sources,changed:changed)
