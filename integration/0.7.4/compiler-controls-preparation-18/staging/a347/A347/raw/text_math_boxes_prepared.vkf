Metadata:(kinds:[int],ends:[int],texts:[str],numbers:[num],count:int)
Paint:(red:num,green:num,blue:num,alpha:num)
Payload:(crop_x:bit,crop_y:bit,crop_left:bit,crop_right:bit,crop_top:bit,crop_bottom:bit,left:num,right:num,top:num,bottom:num,dx:num,dy:num,c1x:num,c1y:num,c2x:num,c2y:num,line_width:num,fill:bit,fill_paint:int,stroke_paint:int,dash:int,target_type:int,target:str,border_width:num,asset:str)
Leaf:(kind:int,key:str,x:num,y:num,sx:num,sy:num,width:num,height:num,line:int,equation_tag:bit,tag_width:num,draw:bit,metadata:Metadata,glyph_parts:int,flow_x:num,flow_width:num,has_flow:bit,vertical_shrink:num,vertical_stretch:num,paint:Paint,has_paint:bit,payload:Payload,has_payload:bit,fill_paint:Paint,has_fill_paint:bit,stroke_paint:Paint,has_stroke_paint:bit,destination_ids:[str],footnote_number:int,a260_scope:str,a260_text:str,a260_operation:int,a260_start:int,a260_stop:int,a260_part:int)
Arena:(kinds:[int],keys:[str],xs:[num],ys:[num],sxs:[num],sys:[num],widths:[num],heights:[num],lines:[int],equation_tags:[bit],tag_widths:[num],draws:[bit],metadata:Metadata,metadata_roots:[int],glyph_parts:[int],flow_xs:[num],flow_widths:[num],has_flows:[bit],vertical_shrinks:[num],vertical_stretches:[num],paints:[int],payloads:[int],destination_firsts:[int],destination_counts:[int],destination_ids:[str],count:int,paint_table:[Paint],paint_count:int,payload_table:[Payload],payload_count:int,footnote_numbers:[int],a260_scopes:[str],a260_texts:[str],a260_operations:[int],a260_starts:[int],a260_stops:[int],a260_parts:[int])
Scene:(arena:Arena,anchor_ids:[str],anchor_xs:[num],anchor_ys:[num],anchor_lines:[int],anchor_metadata:Metadata,anchor_roots:[int],anchor_count:int,width:num,height:num,depth:num,tag_width:num,inline_destinations:bit)
Store:(arena:Arena,firsts:[int],counts:[int],anchor_firsts:[int],anchor_counts:[int],anchor_ids:[str],anchor_xs:[num],anchor_ys:[num],anchor_lines:[int],anchor_metadata:Metadata,anchor_roots:[int],anchor_scenes:[int],anchor_count:int,widths:[num],heights:[num],depths:[num],tag_widths:[num],inline_destinations:[bit],count:int)
paragraphs:.math_paragraph_nodes
# Request-owned prepared math profiles; no retained cross-request state.
# A box retains all its leaves (glyphs/rules/links), while glue/kern/penalty
# nodes stay visible to paragraph breaking instead of becoming an opaque hbox.
layout:.math_layout
parser:.math_parser
profiles:.math_profiles
boxes:.text_inline_boxes
ops:.text_parser_stream
catalog:.font_catalog
inline_index:.text_inline_arguments
j:.resource_json
text:.tex_text
Catalog:(source:str,capacity:int,count:int,payload:int,size:int,valid:bit)
Tables:(values:[num],ems:[num],delim1:[num],delim2:[num],mus:[num])
Context:(restricted:bit,amsmath:bit,amsthm:bit,bbm:bit,latexsym:bit,faktor:bit,qed_symbol:str)
Tape:(source:str,kinds:[int],starts:[int],stops:[int],ends:[int],count:int,valid:bit)
Pool:(values:[str],slots:[int],hashes:[int],count:int)
Stream:(texts:[str],numbers:[[int]],starts:[[int]],stops:[[int]],parents:[[int]],count:int,diagnostics:str)
Provider:(operation_ids:[int],kinds:[int],widths:[num],stretches:[num],shrinks:[num],heights:[num],depths:[num],italics:[num],breakable:[bit],flagged:[bit],penalties:[int],scenes:Store,scene_ids:[int],scene_metadata:Metadata,scene_roots:[int],diagnostics:[str],count:int)

number(tape:Tape,node:int,key:str)->num:
    value:j.member(tape,node,key)
    value<0? @:0.0
    @:j.number(tape,value)

raw(tape:Tape,node:int)->str:
    starts:tape.starts
    stops:tape.stops
    @:text.span(tape.source,starts.(node),stops.(node))

evaluate_prepared(operation:int,source:str,fonts:Catalog,context:Context,tables:Tables,text_spacing:str="",equation_start:int=1,document_boxes_json:str="{}"):
    arena:parser.parse_with_context(source,fonts,context,true,document_boxes_json)
    scene:layout.layout_with_profiles(arena,fonts,tables,true,true,layout.display_context(source),equation_start,text.trim(source)~="",text_spacing,qed_symbol:context.qed_symbol)
    out:boxes.empty()
    ~scene.has_paragraph?
        .out:boxes.append(out,operation,5,diagnostics:scene.diagnostics)
        @:(provider:out,next_equation_number:scene.next_equation_number,equation_references:scene.equation_references,complete:scene.diagnostics="")
    index:0
    index<paragraphs.count(scene.paragraph)?>
        kind:paragraphs.kind(scene.paragraph,index)
        diagnostic:""
        index=0? .diagnostic:scene.diagnostics
        kind=0?
            value:paragraphs.box_json(scene.paragraph,scene,index)
            .out:boxes.append(out,operation,0,paragraphs.width(scene.paragraph,index),paragraphs.height(scene.paragraph,index),paragraphs.depth(scene.paragraph,index),scene:value,diagnostics:diagnostic)
        kind=1? .out:boxes.append(out,operation,1,paragraphs.width(scene.paragraph,index),stretch:paragraphs.stretch(scene.paragraph,index),shrink:paragraphs.shrink(scene.paragraph,index),diagnostics:diagnostic)
        kind=2? .out:boxes.append(out,operation,2,paragraphs.width(scene.paragraph,index),diagnostics:diagnostic,breakable:true)
        kind=3? .out:boxes.append(out,operation,3,penalty:paragraphs.penalty(scene.paragraph,index),diagnostics:diagnostic)
        .index:index+1
    out.count=0? .out:boxes.append(out,operation,5,diagnostics:scene.diagnostics)
    @:(provider:out,next_equation_number:scene.next_equation_number,equation_references:scene.equation_references,complete:scene.diagnostics="")

append_provider(destination:Provider,source:Provider)->Provider:
    out:destination
    ids:source.operation_ids
    kinds:source.kinds
    widths:source.widths
    heights:source.heights
    depths:source.depths
    italics:source.italics
    scenes:source.scenes
    messages:source.diagnostics
    stretches:source.stretches
    shrinks:source.shrinks
    breaks:source.breakable
    flags:source.flagged
    penalties:source.penalties
    index:0
    index<source.count?>
        .out:boxes.append_typed(out,ids.(index),kinds.(index),boxes.scene_at(source,index),widths.(index),heights.(index),depths.(index),italics.(index),messages.(index),stretches.(index),shrinks.(index),breaks.(index),penalties.(index),flags.(index),source.scene_ids.(index)>=0,boxes.metadata_at(source,index))
        .index:index+1
    @:out

field(stream:Stream,index:int,key:str)->str:ops.value(stream,index,key)

# document-text evaluates each inline operation independently. Font spacing is
# selected from that operation's actual role; no scaled substitute is used.
provide_core(stream:Stream,fonts:Catalog,context:Context,tables:Tables,prepared:bit,equation_start:int=1,document_boxes_json:str="{}")->Provider:
    out:boxes.empty()
    active_tables:tables
    ready:prepared
    directory:inline_index.build(stream)
    hidden:directory.hidden
    index:0
    index<stream.count?>
        kind:field(stream,index,"kind")
        kind="math" /\ ~hidden.(index)?
            role:field(stream,index,"role")
            font_source:catalog.raw(fonts,"font/"&role)
            font_source~=""?
                font:j.parse(font_source)
                spacing_node:j.member(font,0,"spaces")
                spacing:""
                spacing_node>=0? .spacing:raw(font,spacing_node)
                source:field(stream,index,"value")
                ~ready?
                    .active_tables:profiles.load(fonts)
                    .ready:true
                rendered:evaluate_prepared(index,source,fonts,context,active_tables,spacing,equation_start,document_boxes_json)
                .out:append_provider(out,rendered.provider)
        .index:index+1
    @:out

evaluate(operation:int,source:str,fonts:Catalog,context:Context,text_spacing:str="",equation_start:int=1,document_boxes_json:str="{}"):
    tables:profiles.load(fonts)
    @:evaluate_prepared(operation,source,fonts,context,tables,text_spacing,equation_start,document_boxes_json)

provide_prepared(stream:Stream,fonts:Catalog,context:Context,tables:Tables,equation_start:int=1,document_boxes_json:str="{}")->Provider:
    @:provide_core(stream,fonts,context,tables,true,equation_start,document_boxes_json)

provide(stream:Stream,fonts:Catalog,context:Context,equation_start:int=1,document_boxes_json:str="{}")->Provider:
    empty_tables:(values:profiles.zeros(0),ems:profiles.zeros(0),delim1:profiles.zeros(0),delim2:profiles.zeros(0),mus:profiles.zeros(0))
    @:provide_core(stream,fonts,context,empty_tables,false,equation_start,document_boxes_json)
