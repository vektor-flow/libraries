# Literal decoded words -> native document paragraph boxes/glue/discretionaries.
# No TeX command, group or math parsing occurs here.
shape:.text_shaping
font_metrics:.text_font_metrics
FontState:(slots:[int],keys:[str],raws:[str],names:[str],advances:[num],heights:[num],depths:[num],italics:[num],kern_starts:[int],kern_stops:[int],kern_codes:[str],kern_values:[num],kern_count:int,count:int,role_names:[str],role_ready:[int],role_sizes:[num],role_quads:[num],role_sources:[str],role_spaces:[num],role_stretches:[num],role_shrinks:[num],role_extras:[num],role_slants:[num],role_starts:[int],role_stops:[int],role_count:int,lig_first:[int],lig_second:[int],lig_result:[int],lig_count:int)
Run:(keys:[str],xs:[num],metrics:[str],codes:[int],starts:[int],stops:[int],count:int,width:num,height:num,depth:num,italic:num,atoms:int,diagnostics:str)
RunStore:(keys:[str],xs:[num],metrics:[str],codes:[int],starts:[int],stops:[int],offsets:[int],counts:[int],widths:[num],heights:[num],depths:[num],italics:[num],atoms:[int],diagnostics:[str],count:int,glyph_count:int)
h:.hyphenation
p:.paragraph_breaking
text:.tex_text
catalog:.font_catalog
glyphs:.math_glyphs
j:.resource_json
tex:.tex_numeric
chunks:.text_chunks
Catalog:(source:str,capacity:int,count:int,payload:int,size:int,valid:bit)
Context:(role:str,space:num,ligatures:str)
Language:(source:str,nodes:int,edges:int,weights:int,exceptions:int,node_start:int,edge_start:int,weight_start:int,exception_start:int,size:int)
TextOptions:(sentence_spacing:bit,french_spacing:bit,space_scale:num)
Cache:(words:[int],starts:[int],ends:[int],widths:[num],heights:[num],depths:[num],count:int,atoms:int,diagnostics:str,fonts:FontState,runs:RunStore)
with_fonts(cache:Cache,fonts:FontState)->Cache:
    @:(words:cache.words,starts:cache.starts,ends:cache.ends,widths:cache.widths,heights:cache.heights,depths:cache.depths,count:cache.count,atoms:cache.atoms,diagnostics:cache.diagnostics,fonts:fonts,runs:cache.runs)
context(cache:Cache,fonts:Catalog,role:str)->Context:
    index:font_metrics.context_index(cache.fonts,role)
    index>=0? @:font_metrics.context_value(cache.fonts,index)
    prepared:font_metrics.context(cache.fonts,fonts,role)
    @:prepared.context
shaped(cache:Cache,index:int)->Run:
    @:shape.restore(cache.runs,index)
text_options()->TextOptions:@:(sentence_spacing:true,french_spacing:false,space_scale:1)
empty_cache()->Cache:
    @:(words:p.ints(32),starts:p.ints(32),ends:p.ints(32),widths:p.nums(32),heights:p.nums(32),depths:p.nums(32),count:0,atoms:0,diagnostics:"",fonts:font_metrics.empty(),runs:shape.empty_store())
merge_diagnostics(current:str,extra:str)->str:
    extra=""? @:current
    out:current
    at:0
    ~vkf_string_eof(extra,at)?>
        text.at(extra,at)=","?
            .at:at+1
            @>
        (text.at(extra,at)="\"")?! "Invalid quoted text diagnostic"
        begin:at
        .at:at+1
        ~vkf_string_eof(extra,at)?>
            c:text.at(extra,at)
            c="\\"?
                .at:at+2
                @>
            .at:text.next(extra,at)
            c="\""? @|
        value:text.span(extra,begin,at)
        text.find(","&out&",",","&value&",")<0?
            out~=""? .out:out&","&value
            out=""? .out:value
    @:out
find_measure(cache:Cache,id:int,start:int,end:int)->int:
    i:0
    i<cache.count?>
        cache.words.(i)=id /\ cache.starts.(i)=start /\ cache.ends.(i)=end? @:i
        .i:i+1
    @: -1
measure(cache:Cache,id:int,word:str,start:int,end:int,fonts:Catalog,ctx:Context):
    i:0
    i<cache.count?>
        cache.words.(i)=id /\ cache.starts.(i)=start /\ cache.ends.(i)=end?
            @:(cache:cache,width:cache.widths.(i),height:cache.heights.(i),depth:cache.depths.(i),run_index:i)
        .i:i+1
    prepared:shape.range_prepared(word,start,end,fonts,ctx,cache.fonts)
    run:prepared.run
    words:cache.words
    starts:cache.starts
    ends:cache.ends
    widths:cache.widths
    heights:cache.heights
    depths:cache.depths
    at:cache.count
    at>=words.length()?
        .words:words&p.ints(words.length())
        .starts:starts&p.ints(starts.length())
        .ends:ends&p.ints(ends.length())
        .widths:widths&p.nums(widths.length())
        .heights:heights&p.nums(heights.length())
        .depths:depths&p.nums(depths.length())
    words.(at):id
    starts.(at):start
    ends.(at):end
    widths.(at):run.width
    heights.(at):run.height
    depths.(at):run.depth
    updated:(words:words,starts:starts,ends:ends,widths:widths,heights:heights,depths:depths,count:at+1,atoms:cache.atoms+run.atoms,diagnostics:merge_diagnostics(cache.diagnostics,run.diagnostics),fonts:prepared.state,runs:shape.retain(cache.runs,run))
    @:(cache:updated,width:run.width,height:run.height,depth:run.depth,run_index:at)

whitespace(c:str)->bit:
    @:c=" " \/ c="\t" \/ c="\n" \/ c="\r" \/ c=str(chr(11)) \/ c=str(chr(12)) \/ c=" " \/ c=" " \/ (c>=" " /\ c<=" ") \/ c=" " \/ c=" " \/ c=" " \/ c=" " \/ c="　" \/ c="﻿"

build(source:str,fonts:Catalog,ctx:Context,language:Language,overrides:[str],automatic:bit,o:TextOptions):
    capacity:2*text.byte_length(source)+6
    kinds:p.ints(capacity)
    widths:p.nums(capacity)
    stretches:p.nums(capacity)
    shrinks:p.nums(capacity)
    breakable:p.bits(capacity)
    penalties:p.ints(capacity)
    flagged:p.bits(capacity)
    autos:p.bits(capacity)
    hyphens:p.nums(capacity)
    word_ids:h.ints(capacity)
    word_starts:p.ints(capacity)
    word_ends:p.ints(capacity)
    prefix_starts:p.nums(capacity)
    prefix_ends:p.nums(capacity)
    words:chunks.empty(capacity)
    lengths:p.ints(capacity)
    count:0
    word_count:0
    cache:empty_cache()
    table:catalog.text_font(fonts,ctx.role)
    spaces:j.member(table,0,"spaces")
    space:glyphs.numeric(table,spaces,"space")
    stretch:glyphs.numeric(table,spaces,"stretch")
    shrink:glyphs.numeric(table,spaces,"shrink")
    extra:glyphs.numeric(table,spaces,"extraspace")
    sf:1000
    at:0
    ~vkf_string_eof(source,at)?>
        c:text.at(source,at)
        whitespace(c)?
            ~vkf_string_eof(source,at)?>
                ~whitespace(text.at(source,at))? @|
                .at:text.next(source,at)
            factor:sf
            o.french_spacing? .factor:1000
            natural:space
            factor>=2000? .natural:natural+extra
            kinds.(count):1
            widths.(count):o.space_scale*natural
            stretches.(count):o.space_scale*stretch*factor/1000
            shrinks.(count):o.space_scale*shrink*1000/factor
            breakable.(count):true
            word_ids.(count): -1
            .count:count+1
            @>
        begin:at
        ~vkf_string_eof(source,at)?>
            c2:text.at(source,at)
            whitespace(c2)? @|
            code:tex.space_factor(c2)
            c2="." /\ ~o.sentence_spacing? .code:1000
            code~=0?
                prior_sf:sf
                .sf:code
                code>1000 /\ prior_sf<1000? .sf:1000
            .at:text.next(source,at)
        word:text.span(source,begin,at)
        input:shape.units(word)
        codes:input.codes
        size:input.count
        id:word_count
        words.(id):word
        lengths.(id):size
        .word_count:word_count+1
        marks:p.bits(size+1)
        eligible:ctx.role~="mono" /\ ctx.role~="footnotemono"
        automatic /\ eligible?
            points:h.opportunities(word,language,overrides)
            values:points.values
            k:0
            k<points.count?>
                marks.(values.(k)):true
                .k:k+1
        eligible?
            k:0
            k<size?>
                code:codes.(k)
                code=45?
                    .k:k+1
                    k<size?>
                        codes.(k)~=45? @|
                        .k:k+1
                    k<size? marks.(k):true
                    @>
                code=8211 \/ code=8212?
                    k+1<size? marks.(k+1):true
                .k:k+1
        segment:0
        end:0
        prefix:0.0
        end<=size?>
            final:end=size
            chosen:final \/ marks.(end)
            chosen?
                part_index:find_measure(cache,id,segment,end)
                part_index<0?
                    part:measure(cache,id,word,segment,end,fonts,ctx)
                    .cache:part.cache
                    .part_index:part.run_index
                full_index:find_measure(cache,id,0,end)
                full_index<0?
                    full:measure(cache,id,word,0,end,fonts,ctx)
                    .cache:full.cache
                    .full_index:full.run_index
                kinds.(count):0
                widths.(count):cache.widths.(full_index)-prefix
                word_ids.(count):id
                word_starts.(count):segment
                word_ends.(count):end
                prefix_starts.(count):prefix
                prefix_ends.(count):cache.widths.(full_index)
                .count:count+1
                end<size?
                    explicit:false
                    end>0?
                        prior:codes.(end-1)
                        .explicit:prior=45 \/ prior=8211 \/ prior=8212
                    kinds.(count):3
                    penalties.(count):50
                    flagged.(count):true
                    autos.(count): ~explicit
                    word_ids.(count):id
                    word_starts.(count):end
                    word_ends.(count):end
                    ~explicit?
                        prepared_hyphen:shape.shape_prepared("-",fonts,ctx,cache.fonts)
                        .cache:with_fonts(cache,prepared_hyphen.state)
                        hyphen:prepared_hyphen.run
                        hyphens.(count):hyphen.width
                        cache.atoms:cache.atoms+hyphen.atoms
                        cache.diagnostics:merge_diagnostics(cache.diagnostics,hyphen.diagnostics)
                    .count:count+1
                .segment:end
                .prefix:cache.widths.(full_index)
                final /\ marks.(end)?
                    # Exception opportunities may include the word end; the
                    # production appendText emits its final empty box too.
                    kinds.(count):0
                    word_ids.(count):id
                    word_starts.(count):end
                    word_ends.(count):end
                    prefix_starts.(count):prefix
                    prefix_ends.(count):prefix
                    .count:count+1
            .end:end+1
        eligible /\ size>0?
            codes.(size-1)=45?
                kinds.(count):3
                penalties.(count):50
                flagged.(count):true
                word_ids.(count): -1
                .count:count+1
    nodes:p.from_arrays(kinds,widths,stretches,shrinks,breakable,penalties,flagged,autos,hyphens,count)
    correction_starts:p.ints(32)
    correction_ends:p.ints(32)
    correction_deltas:p.nums(32)
    corrections:0
    i:0
    i<count?>
        kinds.(i)=0 /\ word_starts.(i)>0?
            id:word_ids.(i)
            word:words.(id)
            first:word_starts.(i)
            last:lengths.(id)
            full_index:find_measure(cache,id,0,last)
            full_index<0?
                full:measure(cache,id,word,0,last,fonts,ctx)
                .cache:full.cache
                .full_index:full.run_index
            tail_index:find_measure(cache,id,first,last)
            tail_index<0?
                tail:measure(cache,id,word,first,last,fonts,ctx)
                .cache:tail.cache
                .tail_index:tail.run_index
            corrections>=correction_starts.length()?
                .correction_starts:correction_starts&p.ints(correction_starts.length())
                .correction_ends:correction_ends&p.ints(correction_ends.length())
                .correction_deltas:correction_deltas&p.nums(correction_deltas.length())
            correction_starts.(corrections):i
            correction_ends.(corrections): -1
            correction_deltas.(corrections):cache.widths.(tail_index)-(cache.widths.(full_index)-prefix_starts.(i))
            .corrections:corrections+1
            k:i+1
            k<count?>
                word_ids.(k)~=id? @|
                kinds.(k)=3?
                    stop:word_starts.(k)
                    prefix_stop_index:find_measure(cache,id,0,stop)
                    prefix_stop_index<0?
                        prefix_stop:measure(cache,id,word,0,stop,fonts,ctx)
                        .cache:prefix_stop.cache
                        .prefix_stop_index:prefix_stop.run_index
                    piece_index:find_measure(cache,id,first,stop)
                    piece_index<0?
                        piece:measure(cache,id,word,first,stop,fonts,ctx)
                        .cache:piece.cache
                        .piece_index:piece.run_index
                    corrections>=correction_starts.length()?
                        .correction_starts:correction_starts&p.ints(correction_starts.length())
                        .correction_ends:correction_ends&p.ints(correction_ends.length())
                        .correction_deltas:correction_deltas&p.nums(correction_deltas.length())
                    correction_starts.(corrections):i
                    correction_ends.(corrections):k
                    correction_deltas.(corrections):cache.widths.(piece_index)-(cache.widths.(prefix_stop_index)-prefix_starts.(i))
                    .corrections:corrections+1
                .k:k+1
        .i:i+1
    @:(nodes:nodes,word_ids:word_ids,word_starts:word_starts,word_ends:word_ends,words:words,lengths:lengths,cache:cache,corrections:p.corrections(correction_starts,correction_ends,correction_deltas,corrections))
