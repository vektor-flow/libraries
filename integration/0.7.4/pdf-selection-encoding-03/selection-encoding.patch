diff --git a/examples/gpu-math/native-vkf/pdf_selection.vkf b/examples/gpu-math/native-vkf/pdf_selection.vkf
new file mode 100644
--- /dev/null
+++ b/examples/gpu-math/native-vkf/pdf_selection.vkf
@@ -0,0 +1,42 @@
+# Explicit PDF Unicode text strings; pdf_syntax.hex_string remains UTF-8.
+# ISO 32000-1:2008, 7.3.4.3, 7.9.2.2, 14.6 and 14.9.4:
+# https://opensource.adobe.com/dc-acrobat-sdk-docs/standards/pdfstandards/pdf/PDF32000_2008.pdf
+# Unicode 17.0, 3.9.2 (UTF-16) and 3.10 (UTF-16BE):
+# https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-3/
+syntax:.pdf_syntax
+
+# One code unit, most significant byte first. Surrogate code units are valid
+# here only as the paired output of utf16be_scalar_hex below.
+utf16be_unit_hex(value:int)->str:
+    (value>=0 /\ value<=65535)?! "Invalid UTF-16 code unit"
+    @:syntax.hex_byte(value//256)&syntax.hex_byte(value%256)
+
+# The input is a Unicode scalar, not a UTF-16 code unit or a glyph identifier.
+utf16be_scalar_hex(value:int)->str:
+    (value>=0 /\ value<=1114111 /\ (value<55296 \/ value>57343))?! "Invalid Unicode scalar for PDF text"
+    value<65536? @:utf16be_unit_hex(value)
+    supplementary:value-65536
+    high:55296+supplementary//1024
+    low:56320+supplementary%1024
+    @:utf16be_unit_hex(high)&utf16be_unit_hex(low)
+
+# VKF string mapping visits Unicode scalars, as in pdf_syntax.hex_string.
+# Always include the FE FF BOM, including for empty text. Preserve all supplied
+# scalars: no newline, normalization, ligature, TeX or whitespace rewriting.
+# Return an ASCII PDF hex string token, never literal UTF-16 in the UTF-8 stream.
+utf16be_text_string(value:str)->str:
+    encoded:value >> utf16be_scalar_hex(int($))
+    @:"<FEFF"&encoded&">"
+
+# PDF 1.5+ replacement text for ONE supplied logical span. The caller must
+# authenticate the text and associate it with exactly this drawing sequence;
+# this serializer cannot recover ownership/order/text from outlines or IDs.
+# ActualText substitutes equivalent visible character content (14.9.4); deciding
+# which authored source span supplies that replacement belongs to the caller.
+# drawing_content contains complete graphics objects within one page/content
+# stream, with balanced marked/text objects and no enclosing/nested ActualText.
+# Preserve its bytes and graphics operators; surrounding LF separates tokens
+# and terminates any trailing comment before EMC. No q/Q or font is introduced.
+# Empty logical_text is an intentional empty replacement, not missing provenance.
+actual_text(logical_text:str,drawing_content:str)->str:
+    @:"/Span << /ActualText "&utf16be_text_string(logical_text)&" >> BDC\n"&drawing_content&"\nEMC\n"
diff --git a/examples/gpu-math/native-vkf/pdf_selection_tests.vkf b/examples/gpu-math/native-vkf/pdf_selection_tests.vkf
new file mode 100644
--- /dev/null
+++ b/examples/gpu-math/native-vkf/pdf_selection_tests.vkf
@@ -0,0 +1,62 @@
+# Native tests prepared only: NOT compiled or executed by encoding-03.
+# Expected hex is authored explicitly; verify_oracles.py checks it with Python's
+# independent utf-16-be codec. That host check does not execute this VKF source.
+p:.pdf_selection
+legacy:.pdf_syntax
+
+text_strings():
+    (p.utf16be_text_string("ASCII")="<FEFF00410053004300490049>")?! "ASCII is UTF-16BE, not UTF-8"
+    (p.utf16be_text_string("éÅΩ")="<FEFF00E900C503A9>")?! "accented and Greek BMP"
+    (p.utf16be_text_string("🙂")="<FEFFD83DDE42>")?! "supplementary scalar surrogate pair"
+    (p.utf16be_text_string("")="<FEFF>")?! "empty text retains BOM"
+    (p.utf16be_text_string("office")="<FEFF006F00660066006900630065>")?! "logical ligature text stays authored letters"
+    (p.utf16be_text_string("ﬃ")="<FEFFFB03>")?! "authored ligature scalar is not expanded"
+    (p.utf16be_text_string("A\r\nB")="<FEFF0041000D000A0042>")?! "CRLF survives as two code units"
+    (p.utf16be_text_string("()<>[]{}/%\\")="<FEFF00280029003C003E005B005D007B007D002F0025005C>")?! "all PDF delimiters are data"
+    (p.utf16be_text_string("é")="<FEFF00650301>")?! "decomposed accent is not normalized"
+    (p.utf16be_text_string("Aé🙂Z")="<FEFF004100E9D83DDE42005A>")?! "mixed UTF-8 widths iterate by scalar"
+    (p.utf16be_text_string("\\frac{a}{b}")="<FEFF005C0066007200610063007B0061007D007B0062007D>")?! "supplied TeX is serialized exactly"
+    (p.utf16be_text_string(" >> BDC\nEMC %")="<FEFF0020003E003E0020004200440043000A0045004D004300200025>")?! "logical text cannot inject PDF operators"
+    (p.utf16be_text_string(str(chr(0)))="<FEFF0000>")?! "NUL is data"
+    (p.utf16be_text_string(str(chr(65279)))="<FEFFFEFF>")?! "authored BOM scalar follows encoding BOM"
+    (p.utf16be_text_string(str(chr(65536)))="<FEFFD800DC00>")?! "first supplementary scalar"
+    (p.utf16be_text_string(str(chr(1114111)))="<FEFFDBFFDFFF>")?! "last Unicode scalar"
+
+scalar_boundaries():
+    (p.utf16be_scalar_hex(0)="0000")?! "scalar zero"
+    (p.utf16be_scalar_hex(127)="007F")?! "ASCII maximum"
+    (p.utf16be_scalar_hex(128)="0080")?! "UTF-8 two-byte boundary"
+    (p.utf16be_scalar_hex(255)="00FF")?! "low byte maximum"
+    (p.utf16be_scalar_hex(256)="0100")?! "big endian byte order"
+    (p.utf16be_scalar_hex(2047)="07FF")?! "UTF-8 two-byte maximum"
+    (p.utf16be_scalar_hex(2048)="0800")?! "UTF-8 three-byte boundary"
+    (p.utf16be_scalar_hex(55295)="D7FF")?! "before surrogate range"
+    (p.utf16be_scalar_hex(57344)="E000")?! "after surrogate range"
+    (p.utf16be_scalar_hex(65535)="FFFF")?! "BMP maximum"
+    (p.utf16be_scalar_hex(65536)="D800DC00")?! "first surrogate pair"
+    (p.utf16be_scalar_hex(66559)="D800DFFF")?! "last low surrogate before carry"
+    (p.utf16be_scalar_hex(66560)="D801DC00")?! "high surrogate carry"
+    (p.utf16be_scalar_hex(128578)="D83DDE42")?! "emoji pair"
+    (p.utf16be_scalar_hex(1114111)="DBFFDFFF")?! "maximum pair"
+
+marked_content():
+    (p.actual_text("office","q 1 0 0 1 12 34 cm /G0 Do Q")="/Span << /ActualText <FEFF006F00660066006900630065> >> BDC\nq 1 0 0 1 12 34 cm /G0 Do Q\nEMC\n")?! "wrap unchanged outline drawing with logical text"
+    (p.actual_text("é🙂","q\n0 0 m 1 1 l S\nQ\n")="/Span << /ActualText <FEFF00E9D83DDE42> >> BDC\nq\n0 0 m 1 1 l S\nQ\n\nEMC\n")?! "multiline drawing and trailing LF stay exact"
+    (p.actual_text("","/G0 Do")="/Span << /ActualText <FEFF> >> BDC\n/G0 Do\nEMC\n")?! "intentional empty replacement"
+    (p.actual_text("A","")="/Span << /ActualText <FEFF0041> >> BDC\n\nEMC\n")?! "empty supplied drawing"
+    (p.actual_text("A","/G0 Do%tail")="/Span << /ActualText <FEFF0041> >> BDC\n/G0 Do%tail\nEMC\n")?! "trailing comment cannot swallow EMC"
+    (p.actual_text("A\r\nB","q\r\n/G0 Do\r\nQ")="/Span << /ActualText <FEFF0041000D000A0042> >> BDC\nq\r\n/G0 Do\r\nQ\nEMC\n")?! "preserve drawing CRLF bytes"
+    (p.actual_text("()<>[]{}/%\\","/G0 Do")="/Span << /ActualText <FEFF00280029003C003E005B005D007B007D002F0025005C> >> BDC\n/G0 Do\nEMC\n")?! "replacement delimiters stay inside hex token"
+
+legacy_strings():
+    (legacy.hex_string("a(b)\\c")="<612862295C63>")?! "legacy delimiter encoding unchanged"
+    (legacy.hex_string("é🙂")="<C3A9F09F9982>")?! "legacy UTF-8 unchanged"
+    (legacy.hex_string("")="<>")?! "legacy empty string unchanged"
+
+renderer_tests()->bit:
+    text_strings()
+    scalar_boundaries()
+    marked_content()
+    legacy_strings()
+    @:true
+renderer_tests()
