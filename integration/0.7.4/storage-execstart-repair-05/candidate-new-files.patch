+        env = {**os.environ, 'PATH':'/home/viktor/.local/bin:'+os.environ['PATH'],
+               'TMPDIR':self.m['tmpdir'], 'XDG_CACHE_HOME':self.m['cache'],
+               'CCACHE_DIR':self.m['ccache'], 'PYTHONDONTWRITEBYTECODE':'1'}
