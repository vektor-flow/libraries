m:.document_paragraph_metrics
Columns:(heights:[num],depths:[num],natural_depths:[num],widths:[num],baselines:[num],indents:[num],flagged:[bit],count:int,width:num,height:num,depth:num,has_last_row:bit,last_row_baseline:num,last_row_depth:num,tag_width:num)
equal(a:Columns,b:Columns)->bit:
    (a.count=b.count /\ a.width=b.width /\ a.height=b.height /\ a.depth=b.depth)?!
    at:0
    at<a.count?>
        (a.heights.(at)=b.heights.(at))?! "heights"
        (a.depths.(at)=b.depths.(at))?! "depths"
        (a.widths.(at)=b.widths.(at))?! "widths"
        (a.baselines.(at)=b.baselines.(at))?! "baselines"
        (a.indents.(at)=b.indents.(at))?! "indents"

        (a.flagged.(at)=b.flagged.(at))?!
        .at:at+1
    @:true


typed_matches_reference_transport():
    q:m.paragraph([7.5,8.25],[1.25,2.5],[91.125,64.5],[0.0,12.0],[4.0,-3.0],[true,false],2,91.125,7.5,14.5)
    legacy:m.legacy("{\"width\":91.125,\"height\":7.5,\"depth\":14.5,\"items\":[],\"lines\":[{\"height\":7.5,\"depth\":1.25,\"naturalDepth\":1.25,\"width\":91.125,\"baseline\":0,\"indent\":4,\"flagged\":true},{\"height\":8.25,\"depth\":2.5,\"naturalDepth\":2.5,\"width\":64.5,\"baseline\":12,\"indent\":-3,\"flagged\":false}]}")
    equal(q,legacy)?! "Typed columns changed reference transport values"
    (m.last_depth(q)=2.5)?!

legacy_metadata_and_empty():
    q:m.legacy("{\"width\":20,\"height\":5,\"depth\":3,\"items\":[{\"equationTag\":true,\"tagWidth\":8},{\"equationTag\":false,\"tagWidth\":100},{\"equationTag\":true,\"tagWidth\":12}],\"lastRow\":{\"baseline\":4,\"depth\":2},\"lines\":[]}")
    (q.count=0 /\ q.width=20 /\ q.height=5 /\ q.depth=3)?!
    (q.has_last_row /\ q.last_row_baseline=4 /\ q.last_row_depth=2 /\ q.tag_width=12)?!
    (m.last_depth(q)=3)?!
    retained:["{\"items\":[{\"equationTag\":true,\"tagWidth\":9}]}","{\"items\":[{\"equationTag\":true,\"tagWidth\":12}]}"]
    (m.retained_tag_width(retained,2)=12)?!
    (m.retained_tag_width(retained,0)=0)?!

legacy_natural_depth():
    q:m.legacy("{\"lines\":[{\"depth\":2,\"naturalDepth\":3},{\"depth\":4}]}")
    (q.natural_depths.0=3 /\ q.natural_depths.1=4)?!
    (m.last_depth(q)=4)?!

tn:m.trim_numbers([1.0,2.0,3.0],2)
(tn.length()=2 /\ tn.0=1 /\ tn.1=2)?! "numeric trim"
ti:m.trim_ints([1,2,3],2)
(ti.length()=2 /\ ti.0=1 /\ ti.1=2)?! "integer trim"
(m.trim_flags([true,false,true],2).length()=2)?!
(m.trim_numbers([1.0],0).length()=0)?!
distinct_natural_depth():
    q:m.legacy("{\"depth\":9,\"lines\":[{\"depth\":4,\"naturalDepth\":2},{\"depth\":5,\"naturalDepth\":null}]}")
    (q.depths.0=4 /\ m.line_natural_depth(q,0)=2)?! "Natural depth survives distinct measured depth"
    (m.label_natural_depth(m.line_natural_depth(q,0),3,1)=3)?! "AMS label uses prior natural depth, not raised measured depth"
    (m.label_natural_depth(m.line_natural_depth(q,0),1,1)=2)?! "Smaller label preserves natural depth"
    (m.line_natural_depth(q,1)=5)?! "Null naturalDepth falls back to measured depth as JS ??"
    (m.line_natural_depth(q,2)=9)?! "Synthetic fallback line uses scene depth"

typed_matches_reference_transport()
legacy_metadata_and_empty()
distinct_natural_depth()
legacy_natural_depth()
::true
