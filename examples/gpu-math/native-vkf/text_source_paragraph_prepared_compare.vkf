check(source:str,fonts:Catalog,text_context:TextContext,math_context:MathContext,language:Language,overrides:[str],options:Options,text_options:TextOptions,tables:Tables,directory:str="{}",links:str="{}")->bit:
    before:text_source_paragraph_reference.typeset(source,fonts,text_context,math_context,language,overrides,options,text_options,directory,links)
    after:text_source_paragraph.typeset_prepared(source,fonts,text_context,math_context,language,overrides,options,text_options,tables,directory,links)
    same(before,after)?! "document-owned prepared Tables"
    compatibility:text_source_paragraph.typeset(source,fonts,text_context,math_context,language,overrides,options,text_options,directory,links)
    same(before,compatibility)?! "unchanged legacy paragraph API"
    @:true
