a:.math_assembly
f:.font_catalog
data:.test_font_data

renderer_tests()->bit:
    keys:["math/display/@ext:0","math/display/@ext:1","math/display/@ext:2","math/display/@ext:3","math/display/@ext:4","math/display/@ext:5"]
    values:["{\"width\":2,\"height\":1,\"depth\":2,\"nextLarger\":1}","{\"width\":3,\"height\":2,\"depth\":3,\"nextLarger\":null,\"extension\":{\"top\":3,\"mid\":4,\"bot\":5,\"rep\":2}}","{\"width\":4,\"height\":2,\"depth\":1}","{\"width\":5,\"height\":2,\"depth\":1}","{\"width\":6,\"height\":1,\"depth\":2}","{\"width\":7,\"height\":1,\"depth\":2}"]
    fonts:f.load(data.pack(keys,values))
    small:a.assemble(fonts,"@ext:0",0,2)
    (small.count=1 /\ small.width=2 /\ small.height=1 /\ small.depth=2)?! "native delimiter already sufficient"
    larger:a.assemble(fonts,"@ext:0",0,4)
    large_keys:larger.keys
    (larger.count=1 /\ large_keys.(0)="display/@ext:1")?! "next-larger chain"
    tall:a.assemble(fonts,"@ext:0",0,26)
    tall_keys:tall.keys
    tall_ys:tall.ys
    (tall.count=9 /\ tall.width=4 /\ tall.height=2 /\ tall.depth=25)?! "symmetric extensible recipe and ceiling"
    (tall_keys.(0)="display/@ext:3" /\ tall_keys.(4)="display/@ext:4" /\ tall_keys.(8)="display/@ext:5")?! "top repeats middle repeats bottom"
    (tall_ys.(0)=0 /\ tall_ys.(1)=3 /\ tall_ys.(4)=11 /\ tall_ys.(8)=23)?! "piece baselines"
    @:true
renderer_tests()
