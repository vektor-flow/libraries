n:.resource_numbers

signed_and_fractional():
    (n.parse("0")=0 /\ n.parse("-0")=0)?! "zero signs"
    (n.parse("-7")= -7 /\ n.parse("107")=107)?! "signed integer"
    (n.parse("-0.125")= -0.125 /\ n.parse("19.375")=19.375)?! "signed fractions"
    (|n.parse("9.962640099626402")-9.962640099626402|<0.0000000000001)?! "font em precision"

scientific_and_boundaries():
    (|n.parse("1e-7")-0.0000001|<0.00000000000000000001)?! "negative exponent"
    (n.parse("-12.5E+2")= -1250)?! "signed mantissa and exponent"
    (n.parse("1e0")=1 /\ n.parse("0.5e1")=5)?! "zero and unit exponents"
    result:n.scan("[-2.5,4]",1)
    (result.valid /\ result.value= -2.5 /\ result.stop=5)?! "leave delimiter to caller"

malformed():
    (~n.scan("").valid)?! "empty value"
    (~n.scan("-").valid)?! "bare sign"
    (~n.scan("+1").valid)?! "JSON forbids leading plus"
    (~n.scan("01").valid /\ ~n.scan("-07").valid)?! "JSON forbids leading zero"
    (~n.scan(".1").valid /\ ~n.scan("1.").valid)?! "fraction requires both sides"
    (~n.scan("1e").valid /\ ~n.scan("1e-").valid /\ ~n.scan("1e-+2").valid)?! "exponent grammar"
    (~n.scan("NaN").valid /\ ~n.scan("Infinity").valid)?! "finite decimal only"
    (~n.scan("1e301").valid)?! "resource magnitude limit"

lexical_boundaries():
    result:n.boundary("[-1.25e-7,0]",1)
    (result.valid /\ result.stop=9)?! "scan syntax without computing a float"
    (~n.boundary("01").valid /\ ~n.boundary("1.").valid /\ ~n.boundary("1e-+2").valid)?! "lexical numeric grammar"
    (n.boundary("1e999").valid /\ ~n.scan("1e999").valid)?! "JSON syntax and finite resource conversion are separate"

renderer_tests()->bit:
    signed_and_fractional()
    scientific_and_boundaries()
    malformed()
    lexical_boundaries()
    @:true
renderer_tests()
