# Public LaTeX-to-PDF entry. Inputs and result match the shared renderer.
library:.latex_library
Catalog:(source:str,capacity:int,count:int,payload:int,size:int,valid:bit)
Language:(source:str,nodes:int,edges:int,weights:int,exceptions:int,node_start:int,edge_start:int,weight_start:int,exception_start:int,size:int)
# Optional bindings address this prepared plan and exact parser inputs;
# layout validates them. Empty bindings preserve unknown ownership.
tex2pdf(source:str,fonts:Catalog,operators:str,ordered_roles:[str],language:Language,files_json:str="{}",job:str="main",entry:str="main.tex",include_layout:bit=true,a261_blocks:[int]=[],a261_scopes:[str]=[],a261_texts:[str]=[],a263_kinds:[str]=[],a267_notes:[int]=[],a267_scopes:[str]=[],a267_texts:[str]=[],a267_kinds:[str]=[]):
    @:library.tex2pdf(source,fonts,operators,ordered_roles,language,files_json,job,entry,include_layout,a261_blocks,a261_scopes,a261_texts,a263_kinds,a267_notes,a267_scopes,a267_texts,a267_kinds)

# Shared fragment API: retain resources across calls; no implicit owner identity.
Metadata:(kinds:[int],ends:[int],texts:[str],numbers:[num],count:int)
Paint:(red:num,green:num,blue:num,alpha:num)
Payload:(crop_x:bit,crop_y:bit,crop_left:bit,crop_right:bit,crop_top:bit,crop_bottom:bit,left:num,right:num,top:num,bottom:num,dx:num,dy:num,c1x:num,c1y:num,c2x:num,c2y:num,line_width:num,fill:bit,fill_paint:int,stroke_paint:int,dash:int,target_type:int,target:str,border_width:num,asset:str)
Arena:(kinds:[int],keys:[str],xs:[num],ys:[num],sxs:[num],sys:[num],widths:[num],heights:[num],lines:[int],equation_tags:[bit],tag_widths:[num],draws:[bit],metadata:Metadata,metadata_roots:[int],glyph_parts:[int],flow_xs:[num],flow_widths:[num],has_flows:[bit],vertical_shrinks:[num],vertical_stretches:[num],paints:[int],payloads:[int],destination_firsts:[int],destination_counts:[int],destination_ids:[str],count:int,paint_table:[Paint],paint_count:int,payload_table:[Payload],payload_count:int,footnote_numbers:[int],a260_scopes:[str],a260_texts:[str],a260_operations:[int],a260_starts:[int],a260_stops:[int],a260_parts:[int])
Scene:(arena:Arena,anchor_ids:[str],anchor_xs:[num],anchor_ys:[num],anchor_lines:[int],anchor_metadata:Metadata,anchor_roots:[int],anchor_count:int,width:num,height:num,depth:num,tag_width:num,inline_destinations:bit)
Tables:(values:[num],ems:[num],delim1:[num],delim2:[num],mus:[num])
Resources:(fonts:Catalog,roles:[str],language:Language,tables:Tables,resource_id:str)
FragmentOptions:(width:num,font:str,optical:bit,justify:bit,hyphens:bit)
Fragment:(scene:Scene,complete:bit,diagnostics:str,pending_count:int,a272_anchor_origins:A272AnchorOrigins,a277_anchor_placements:A277AnchorPlacements,a280_anchor_receipts:A280AnchorReceipts,a282_point_receipts:A282PointReceipts,a283_final_anchors:A283FinalAnchors)
prepare(font_source:str,language_source:str,roles:[str],resource_id:str)->Resources:
    @:library.prepare(font_source,language_source,roles,resource_id)
defaults(width:num=400)->FragmentOptions:
    @:library.defaults(width)
# TeX text fragment, not literal escaping or a full-document entry.
text(source:str,resources:Resources,options:FragmentOptions)->Fragment:
    @:library.text(source,resources,options)
# Delimiter-free inline TeX math, using the same prepared engine resources.
math(source:str,resources:Resources,options:FragmentOptions)->Fragment:
    @:library.math(source,resources,options)
# Preserve the caller's stable edit-owner scope unchanged.
text_owned(source:str,resources:Resources,options:FragmentOptions,scope:str)->Fragment:
    @:library.text_owned(source,resources,options,scope)

A272AnchorOrigins:(scope:str,text:str,ids:[str],operations:[int],starts:[int],stops:[int])
A277AnchorPlacements:(scenes:[int],scene_count:int)
A280AnchorReceipts:(leaves:[int],slots:[int])
A282PointReceipts:(points:[int])
A283FinalAnchors:(leaves:[int],slots:[int],points:[int])

math_owned(source:str,resources:Resources,options:FragmentOptions,scope:str)->Fragment:
    @:library.math_owned(source,resources,options,scope)
