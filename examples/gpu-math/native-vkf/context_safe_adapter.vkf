prepare(seed:Prepared,source:str,role:str,fonts:Catalog,roles:[str],language:Language,c:Configuration,reuse_fixed_context:bit=false)->Prepared:
    plan:present.empty("[]")
    plan.kinds:["paragraph"]
    plan.sources:[source]
    plan.contexts:["{\"font\":\""&role&"\"}"]
    plan.attrs:[""]
    plan.origins:[0]
    plan.scenes:[""]
    plan.count:1
    generation:metrics.prepare_main_request(seed,[source],plan,fonts,roles,language,c,plan.references,"{}",", ",reuse_fixed_context:reuse_fixed_context)
    @:generation.request
