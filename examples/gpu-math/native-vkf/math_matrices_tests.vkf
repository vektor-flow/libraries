m:.math_matrices
c:.math_commands
p:.math_command_pages
t:.tex_numeric

close(a:num,b:num)->bit:|a-b|<0.000000001
renderer_tests()->bit:
    m.child_style("smallmatrix",0)=2?! "small matrix scripts"
    m.child_style("aligned",0)=1?! "aligned text style"
    m.child_style("align*",3)=0?! "align display style"
    m.child_style("matrix",3)=3?! "ordinary matrix inherits script style"
    delimiters:m.pair("cases")
    (delimiters.left="\\lbrace" /\ delimiters.right=".")?! "cases invisible right delimiter"
    (m.cline("1-2",2).valid /\ ~m.cline("0-2",2).valid /\ ~m.cline("1-3",2).valid /\ ~m.cline("1--2",2).valid)?! "cline validation"
    cells:m.empty_cells(2,2)
    ids:cells.ids
    widths:cells.widths
    heights:cells.heights
    i:0
    i<4?>
        ids.(i):i+1
        widths.(i):2
        heights.(i):1
        .i:i+1
    widths.(1):4
    widths.(2):6
    cells.ids:ids
    cells.widths:widths
    cells.heights:heights
    rules:m.empty_rules(0)
    result:m.layout(c.empty(5),0,"matrix","",cells,rules,0.4,2.0)
    close(result.width,10+10*t.pt())?! "column maxima and matrix gap"
    close(result.height,12*t.pt()+2)?! "centered matrix axis"
    close(result.depth,12*t.pt()-2)?! "centered matrix depth"
    (result.buffer.count=4 /\ close(p.number(result.buffer.xs,0),2) /\ close(p.number(result.buffer.xs,3),6+10*t.pt()+1))?! "centered variable-width cells"
    aligned:m.layout(c.empty(5),0,"aligned","",cells,rules,0.4,2.0,"null",true,12*t.pt(),3*t.pt(),t.pt(),0,true)
    close(aligned.width,10)?! "aligned pair has zero intercolumn gap"
    close(p.number(aligned.buffer.xs,0),4)?! "aligned left cell right aligned"
    close(p.number(aligned.buffer.xs,3),6)?! "aligned right cell left aligned"
    array_rules:m.empty_rules(2)
    rule_rows:array_rules.rows
    rule_columns:array_rules.columns
    rule_rows.(1):2
    rule_columns.(1):"1-1"
    array_rules.rows:rule_rows
    array_rules.columns:rule_columns
    array:m.layout(c.empty(5),0,"array","|l||r|",cells,array_rules,0.4,2)
    close(array.width,10+20*t.pt()+4*0.4+2*t.pt())?! "array padding and repeated vertical bars"
    array.buffer.count=10?! "cells horizontal and vertical rules"
    bad_rules:m.empty_rules(1)
    bad_columns:bad_rules.columns
    bad_columns.(0):"0-2"
    bad_rules.columns:bad_columns
    malformed:m.layout(c.empty(5),0,"array","cc",cells,bad_rules,0.4,2)
    (malformed.diagnostic="\"Unsupported cline range\"" /\ malformed.buffer.count=4)?! "bad cline reports without rule emission"
    twice_rules:m.empty_rules(2)
    twice_rows:twice_rules.rows
    twice_columns:twice_rules.columns
    twice_rows.(1):2
    twice_columns.(0):"0-1"
    twice_columns.(1):"2-3"
    twice_rules.rows:twice_rows
    twice_rules.columns:twice_columns
    twice:m.layout(c.empty(5),0,"array","cc",cells,twice_rules,0.4,2)
    (twice.diagnostic="\"Unsupported cline range\",\"Unsupported cline range\"" /\ twice.buffer.count=4)?! "each invalid cline retains its own diagnostic"
    extras:m.nil(2)
    extras.(0):5
    decorated:m.layout_with_extras(c.empty(6),0,"matrix","",cells,rules,extras,0.4,2)
    (decorated.buffer.count=5 /\ p.integer(decorated.buffer.children,0)=1 /\ p.integer(decorated.buffer.children,1)=2 /\ p.integer(decorated.buffer.children,2)=5 /\ p.integer(decorated.buffer.children,3)=3)?! "row extra follows its own cells and precedes next row"
    (close(p.number(decorated.buffer.xs,2),decorated.width+10*t.pt()) /\ close(p.number(decorated.buffer.ys,2),p.number(decorated.buffer.ys,0)))?! "row extra lies after table at row baseline"
    (decorated.row_first_commands.(0)=0 /\ decorated.row_stop_commands.(0)=3 /\ decorated.row_first_commands.(1)=3 /\ decorated.row_stop_commands.(1)=5)?! "row command ranges include extras and exclude other rows"
    @:true
renderer_tests()
