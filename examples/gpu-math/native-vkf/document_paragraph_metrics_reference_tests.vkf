m:.document_paragraph_metrics
Columns:(heights:[num],depths:[num],natural_depths:[num],widths:[num],baselines:[num],indents:[num],flagged:[bit],count:int,width:num,height:num,depth:num,has_last_row:bit,last_row_baseline:num,last_row_depth:num,tag_width:num)
equal(a:Columns,b:Columns)->bit:
    (a.count=b.count /\ a.width=b.width /\ a.height=b.height /\ a.depth=b.depth)?!
    at:0
    at<a.count?>
        (a.heights.(at)=b.heights.(at))?! "heights"
        (a.depths.(at)=b.depths.(at))?! "depths"
        (a.widths.(at)=b.widths.(at))?! "widths"
        (a.baselines.(at)=b.baselines.(at))?! "baselines"
        (a.indents.(at)=b.indents.(at))?! "indents"

        (a.flagged.(at)=b.flagged.(at))?!
        .at:at+1
    @:true


