meta:.scene_metadata
Metadata:(kinds:[int],ends:[int],texts:[str],numbers:[num],count:int)
# Composite list labels retain one placement origin and source draw order.
document_scene:.document_scene
tex_numeric:.tex_numeric
Paint:(red:num,green:num,blue:num,alpha:num)
Payload:(crop_x:bit,crop_y:bit,crop_left:bit,crop_right:bit,crop_top:bit,crop_bottom:bit,left:num,right:num,top:num,bottom:num,dx:num,dy:num,c1x:num,c1y:num,c2x:num,c2y:num,line_width:num,fill:bit,fill_paint:int,stroke_paint:int,dash:int,target_type:int,target:str,border_width:num,asset:str)
Leaf:(kind:int,key:str,x:num,y:num,sx:num,sy:num,width:num,height:num,line:int,equation_tag:bit,tag_width:num,draw:bit,metadata:Metadata,glyph_parts:int,flow_x:num,flow_width:num,has_flow:bit,vertical_shrink:num,vertical_stretch:num,paint:Paint,has_paint:bit,payload:Payload,has_payload:bit,fill_paint:Paint,has_fill_paint:bit,stroke_paint:Paint,has_stroke_paint:bit,destination_ids:[str],footnote_number:int,a260_scope:str,a260_text:str,a260_operation:int,a260_start:int,a260_stop:int,a260_part:int)
Arena:(kinds:[int],keys:[str],xs:[num],ys:[num],sxs:[num],sys:[num],widths:[num],heights:[num],lines:[int],equation_tags:[bit],tag_widths:[num],draws:[bit],metadata:Metadata,metadata_roots:[int],glyph_parts:[int],flow_xs:[num],flow_widths:[num],has_flows:[bit],vertical_shrinks:[num],vertical_stretches:[num],paints:[int],payloads:[int],destination_firsts:[int],destination_counts:[int],destination_ids:[str],count:int,paint_table:[Paint],paint_count:int,payload_table:[Payload],payload_count:int,footnote_numbers:[int],a260_scopes:[str],a260_texts:[str],a260_operations:[int],a260_starts:[int],a260_stops:[int],a260_parts:[int])
Scene:(arena:Arena,anchor_ids:[str],anchor_xs:[num],anchor_ys:[num],anchor_lines:[int],anchor_metadata:Metadata,anchor_roots:[int],anchor_count:int,width:num,height:num,depth:num,tag_width:num,inline_destinations:bit)
part(primary:Scene,outers:[Scene],lefts:[num],context_left:num,label_sep:num,firsts:[int],index:int)->Leaf:
    item:document_scene.leaf()
    index<primary.arena.count? .item:document_scene.leaf_at(primary.arena,index)
    index>=primary.arena.count?
        outer:0
        outer+1<outers.length() /\ firsts.(outer+1)<=index?>
            .outer:outer+1
        leaf_index:index-firsts.(outer)
        .item:document_scene.leaf_at(outers.(outer).arena,leaf_index)
        dx:lefts.(outer)-5*tex_numeric.pt()-outers.(outer).width-context_left+label_sep+primary.width
        item.x:item.x+dx
    @:item
compose(primary:Scene,outers:[Scene],outer_lefts:[num],context_left:num,label_sep:num):
    count:primary.arena.count
    anchor_count:primary.anchor_count
    [int] firsts:[0:outers.length()]
    i:0
    i<outers.length()?>
        firsts.(i):count
        .count:count+outers.(i).arena.count
        .anchor_count:anchor_count+outers.(i).anchor_count
        .i:i+1
    [int] indices:[0:count]
    leaves:indices >> part(primary,outers,outer_lefts,context_left,label_sep,firsts,$0)
    arena:document_scene.from_leaves(leaves,count)
    anchor_metadata:primary.anchor_metadata
    [int] anchor_roots:[-1:anchor_count]
    inline_destinations:primary.inline_destinations
    ids:document_scene.strings(anchor_count)
    [num] xs:[0.0:anchor_count]
    [num] ys:[0.0:anchor_count]
    [int] lines:[0:anchor_count]
    .i:0
    i<primary.anchor_count?>
        i<primary.anchor_roots.length()? anchor_roots.(i):primary.anchor_roots.(i)
        ids.(i):primary.anchor_ids.(i)
        xs.(i):primary.anchor_xs.(i)
        ys.(i):primary.anchor_ys.(i)
        lines.(i):primary.anchor_lines.(i)
        .i:i+1
    at:primary.anchor_count
    outer:0
    outer<outers.length()?>
        metadata_base:anchor_metadata.count
        .anchor_metadata:meta.append(anchor_metadata,outers.(outer).anchor_metadata)
        .inline_destinations:inline_destinations \/ outers.(outer).inline_destinations
        dx:outer_lefts.(outer)-5*tex_numeric.pt()-outers.(outer).width-context_left+label_sep+primary.width
        .i:0
        i<outers.(outer).anchor_count?>
            i<outers.(outer).anchor_roots.length()? anchor_roots.(at):meta.shift(outers.(outer).anchor_roots.(i),metadata_base)
            ids.(at):outers.(outer).anchor_ids.(i)
            xs.(at):outers.(outer).anchor_xs.(i)+dx
            ys.(at):outers.(outer).anchor_ys.(i)
            lines.(at):outers.(outer).anchor_lines.(i)
            .at:at+1
            .i:i+1
        .outer:outer+1
    @:(arena:arena,anchor_ids:ids,anchor_xs:xs,anchor_ys:ys,anchor_lines:lines,anchor_metadata:anchor_metadata,anchor_roots:anchor_roots,anchor_count:anchor_count,width:primary.width,height:primary.height,depth:primary.depth,tag_width:primary.tag_width,inline_destinations:inline_destinations)
