                    a281_edit:scene_legacy.a281_edit_mapped(retained,color,anchor_ids_json)
                    # Rebase the actual local leaf before append into the retained arena.
                    a281_edit.leaf>=0 /\ a281_edit.leaf<a281_edit.scene.arena.count /\ a281_edit.first>=0 /\ a281_edit.count=next_anchor-a281_begin?
                        a281_event:a281_begin
