            kind:kinds.(n)
            kind~=0 /\ operation>=0 /\ operation<nonbox_scopes.length()? .link_scope:nonbox_scopes.(operation)
            kind=0?
                id:word_ids.(n)
                id<0?
                    retained:scene_store.empty_scene()
                    node_scenes.(n)>=0? .retained:scene_store.get(built.scene_store,node_scenes.(n))
                    visible:false
                    anchor_operations.length()>0? .visible:scene_store.visible(retained)
                    a281_begin:next_anchor
