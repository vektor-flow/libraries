# Standalone call is one request; multi-paragraph callers seal their union first
# and call position_request_with_link_events for every paragraph with that value.
position_with_link_events(source:str,stream:Stream,fonts:Catalog,language:Language,overrides:[str],o:Options,t:TextOptions,provided:Provider,operation_scopes:[int],scope_directory:str,anchor_operations:[int],anchor_ids:[str],close_operations:[int],close_first:[int],close_last:[int],a268_scope_owners:[int]=[]):
    collection:collect_request(prepared_runs.empty_collection(),stream,language,overrides,o.hyphens,provided)
    request:prepared_runs.seal(fonts,collection)
    @:position_request_with_link_events(request,source,stream,fonts,language,overrides,o,t,provided,operation_scopes,scope_directory,anchor_operations,anchor_ids,close_operations,close_first,close_last,a268_scope_owners)

position_with_links(source:str,stream:Stream,fonts:Catalog,language:Language,overrides:[str],o:Options,t:TextOptions,provided:Provider,operation_scopes:[int],scope_directory:str,anchor_operations:[int],anchor_ids:[str]):
    @:position_with_link_events(source,stream,fonts,language,overrides,o,t,provided,operation_scopes,scope_directory,anchor_operations,anchor_ids,p.ints(0),p.ints(0),p.ints(0))

position(source:str,stream:Stream,fonts:Catalog,language:Language,overrides:[str],o:Options,t:TextOptions,provided:Provider):
    @:position_with_links(source,stream,fonts,language,overrides,o,t,provided,p.ints(0),"{}",p.ints(0),chunks.empty(0))

# Parsing and providers stay separable so root math evaluation can carry state.
typeset(source:str,fonts:Catalog,c:Context,language:Language,overrides:[str],o:Options,t:TextOptions,provided:Provider):
    parsed:inline_parser.parse(source,fonts,c)
    @:position(source,parsed.stream,fonts,language,overrides,o,t,provided)

Collection:(sources:[str],roles:[str],starts:[int],stops:[int],count:int,context_roles:[str])
collect_request(c:Collection,stream:Stream,language:Language,overrides:[str],automatic:bit,provided:Provider)->Collection:
    ids:p.ints(provided.count)
    i:0
    i<provided.count?>
        ids.(i):provided.operation_ids.(i)
        .i:i+1
    @:prepared_runs.collect_append(c,stream,language,overrides,automatic,ids)
position_request(request:Prepared,source:str,stream:Stream,fonts:Catalog,language:Language,overrides:[str],o:Options,t:TextOptions,provided:Provider):
    @:position_request_with_link_events(request,source,stream,fonts,language,overrides,o,t,provided,p.ints(0),"{}",p.ints(0),chunks.empty(0),p.ints(0),p.ints(0),p.ints(0))
# Existing retained link export, reading glyph columns without restoring an owned run.
# Typed Provider/Packet/scene schemas are deliberately outside this function delta.
request_glyph_scene(request:Prepared,id:int)->Scene:
    count:prepared_runs.glyph_count(request,id)
    keys:chunks.empty(count)
    xs:p.nums(count)
    index:0
    index<count?>
        keys.(index):prepared_runs.glyph_key(request,id,index)
        xs.(index):prepared_runs.glyph_x(request,id,index)
        .index:index+1
    @:scene_legacy.glyph_run(keys,xs,count,prepared_runs.width(request,id),prepared_runs.height(request,id),prepared_runs.depth(request,id))

prepare_sources(sources:[str],fonts:Catalog,c:Context,language:Language,overrides:[str],automatic:bit)->Prepared:
    collection:prepared_runs.empty_collection()
    i:0
    i<sources.length()?>
        parsed:inline_parser.parse(sources.(i),fonts,c)
        .collection:collect_request(collection,parsed.stream,language,overrides,automatic,providers.empty())
        .i:i+1
    @:prepared_runs.seal(fonts,collection)
typeset_request(request:Prepared,source:str,fonts:Catalog,c:Context,language:Language,overrides:[str],o:Options,t:TextOptions):
    parsed:inline_parser.parse(source,fonts,c)
    @:position_request(request,source,parsed.stream,fonts,language,overrides,o,t,providers.empty())
typeset_many(sources:[str],fonts:Catalog,c:Context,language:Language,overrides:[str],o:Options,t:TextOptions):
    request:prepare_sources(sources,fonts,c,language,overrides,o.hyphens)
    indices:p.ints(sources.length())
    i:0
    i<sources.length()?>
        indices.(i):i
        .i:i+1
    @:indices >> typeset_request(request,sources.($),fonts,c,language,overrides,o,t)
