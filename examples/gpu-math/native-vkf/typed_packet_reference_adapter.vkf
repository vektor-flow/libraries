store:.paragraph_scene_store
legacy:.paragraph_scene_legacy
from_legacy(input:LegacyPacket)->Packet:
    scenes:store.empty()
    i:0
    i<input.scene_count?>
        .scenes:legacy.append_legacy(scenes,input.scenes.(i))
        .i:i+1
    @:(keys:input.keys,xs:input.xs,ys:input.ys,flow_lines:input.flow_lines,glyph_operations:input.glyph_operations,scenes:scenes,scene_xs:input.scene_xs,scene_ys:input.scene_ys,scene_lines:input.scene_lines,scene_operations:input.scene_operations,scene_count:input.scene_count,pending:input.pending,pending_count:input.pending_count,complete:input.complete,lowering_complete:input.lowering_complete,glyph_count:input.glyph_count,line_heights:input.line_heights,line_depths:input.line_depths,line_widths:input.line_widths,line_baselines:input.line_baselines,line_ratios:input.line_ratios,line_indents:input.line_indents,line_flagged:input.line_flagged,line_count:input.line_count,width:input.width,height:input.height,depth:input.depth,measurement_work:input.measurement_work,diagnostics:input.diagnostics,solved:input.solved,pass:input.pass)
