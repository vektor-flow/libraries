# Page flow over real provider-owned line/scene metrics. No source-specific
# coordinates or cached documents enter this module. Units are bp.
document_float_queue:.frozen285_document_float_queue
tex_numeric:.frozen285_tex_numeric
text_chunks:.frozen285_text_chunks
resource_json:.frozen285_resource_json
Config:(values:[num],flags:[bit],penalties:[int])
Blocks:(texts:[str],indices:[int],numbers:[num],booleans:[bit],count:int)
Lines:(scenes:[int],source_lines:[int],heights:[num],depths:[num],natural_depths:[num],widths:[num],indents:[num],baselines:[num],flagged:[bit],marker_firsts:[int],marker_counts:[int],count:int)
Notes:(firsts:[int],counts:[int],first_heights:[num],depths:[num],reserves:[num],indents:[num],admin:[bit],count:int)
Markers:(ids:[int],count:int)
Placements:(scenes:[int],source_lines:[int],pages:[int],blocks:[int],lines:[int],kinds:[int],xs:[num],ys:[num],units:[num],tag_bases:[num],line_heights:[num],line_depths:[num],shrink:[num],stretch:[num],count:int)
Assignments:(notes:[int],pages:[int],count:int)
Pages:(last_baselines:[num],last_depths:[num],limits:[num],shrink_ratios:[num],stretch_ratios:[num],note_stretch:[num],note_flex:[bit],forced:[bit],count:int)
BreakState:(last_baseline:num,last_depth:num,last_used_shrink:num,last_used_stretch:num,ragged:bit,shrink:num,stretch:num,has_notes:bit)
State:(pages:Pages,notes:Assignments,page:int,y:num,last_baseline:num,last_depth:num,pending_after:num,last_line_right:num,first_paragraph:bit,ragged:bit,shrink:num,stretch:num,last_used_shrink:num,last_used_stretch:num,footnote_stretch:num,footnote_flex:bit,limit:num,forced:bit,diagnostics:str)

FloatQueue:(ids:[int],head:int,count:int,top_count:int,bottom_count:int,top_height:num,bottom_reserve:num)
FloatStart:(state:State,queue:FloatQueue,placements:Placements,float_pages:[bit])

zeros(size:int)->[num]:[0.0:size]
ones(size:int)->[num]:[1.0:size]
ints(size:int)->[int]:[0:size]
nil(size:int)->[int]:[-1:size]
bits(size:int)->[bit]:[false:size]

settings(paper_width:num,paper_height:num,left:num,top:num,text_width:num,text_height:num,line_height:num,font_size:num,ams:bit=false)->Config:
    values:zeros(15)
    flags:bits(3)
    penalties:ints(5)
    values.(0):paper_width
    values.(1):paper_height
    values.(2):left
    values.(3):top
    values.(4):text_width
    values.(5):text_height
    values.(6):line_height
    values.(7):font_size
    values.(8):5*tex_numeric.pt()
    values.(9):0
    values.(10):10*tex_numeric.pt()
    values.(11):6*tex_numeric.pt()
    values.(12):9*tex_numeric.pt()
    values.(13):9.5*tex_numeric.pt()
    values.(14):6.65*tex_numeric.pt()
    flags.(0):ams
    flags.(1):true
    penalties.(1):150
    penalties.(2):150
    penalties.(4):100
    @:(values:values,flags:flags,penalties:penalties)

number_at(config:Config,index:int)->num:
    @:config.values.(index)
flag_at(config:Config,index:int)->bit:
    config.flags.(index)? @:true
    @:false
integer_at(config:Config,index:int)->int:
    @:config.penalties.(index)

with_number(config:Config,key:str,value:num)->Config:
    names:["paper_width","paper_height","left","top","text_width","text_height","line_height","font_size","max_depth","line_skip_limit","display_skip","short_display_skip","footnote_skip","footnote_leading","footnote_native_sep"]
    index:0
    index<names.length()?>
        names.(index)=key? @|
        .index:index+1
    index<names.length()?! "Unknown page numeric setting"
    values:config.values
    values.(index):value
    @:(values:values,flags:config.flags,penalties:config.penalties)

with_flag(config:Config,key:str,value:bit)->Config:
    names:["ams","native_text","ragged_bottom"]
    index:0
    index<names.length()?>
        names.(index)=key? @|
        .index:index+1
    index<names.length()?! "Unknown page flag setting"
    values:config.flags
    values.(index):value
    @:(values:config.values,flags:values,penalties:config.penalties)

with_penalty(config:Config,key:str,value:int)->Config:
    names:["interline","club","widow","broken","max_pages"]
    index:0
    index<names.length()?>
        names.(index)=key? @|
        .index:index+1
    index<names.length()?! "Unknown page penalty setting"
    values:config.penalties
    values.(index):value
    @:(values:config.values,flags:config.flags,penalties:values)

# Exact-length owned prefixes avoid singleton-concat maps in final line columns.
prefix_numbers(values:[num],count:int)->[num]:
    [num] result:[0.0:count]
    i:0
    i<count?>
        result.(i):values.(i)
        .i:i+1
    @:result
prefix_ints(values:[int],count:int)->[int]:
    [int] result:[0:count]
    i:0
    i<count?>
        result.(i):values.(i)
        .i:i+1
    @:result
prefix_flags(values:[bit],count:int)->[bit]:
    [bit] result:[false:count]
    i:0
    i<count?>
        result.(i):values.(i)
        .i:i+1
    @:result

empty_blocks(count:int)->Blocks:
    values:zeros(count*25)
    i:0
    i<count?>
        values.(count+i):1
        .i:i+1
    @:(texts:text_chunks.empty(count*2),indices:ints(count*3),numbers:values,booleans:bits(count*10),count:count)
# Assemble four owned block columns once after local indexed writes.
