prepare(font_source:str,language_source:str,roles:[str],resource_id:str)->Resources:
    fonts:fonts_import.load(font_source)
    @:(fonts:fonts,roles:roles,language:language_import.load(language_source),tables:profiles_import.load(fonts),resource_id:resource_id)
defaults(width:num=400)->FragmentOptions:
    @:(width:width,font:"roman",optical:false,justify:false,hyphens:false)
text(source:str,resources:Resources,options:FragmentOptions)->Fragment:
    options.width>0?! "Fragment width must be positive"
    context:context_import.context(options.font,resources.roles,options.optical,false)
    breaks:breaks_import.options(options.width)
    breaks.justify:options.justify
    breaks.hyphens:options.hyphens
    packet:paragraph_import.typeset_prepared(source,resources.fonts,context,packages_import.defaults(),resources.language,[],breaks,words_import.text_options(),resources.tables)
    emitted:scene_import.a278_from_paragraph_mapped(packet)
    anchors:scene_import.a283_final_anchors(packet,emitted.scene,emitted.retained_to_leaf,emitted.scene_firsts,emitted.scene_counts)
    @:(scene:emitted.scene,complete:packet.complete,diagnostics:packet.diagnostics,pending_count:packet.pending_count,a272_anchor_origins:scene_import.a272_anchor_origins(packet,""),a277_anchor_placements:scene_import.a277_anchor_placements(packet),a280_anchor_receipts:scene_import.a280_anchor_receipts(packet),a282_point_receipts:scene_import.a282_point_receipts(packet),a283_final_anchors:anchors)
# Math input is delimiter-free TeX. Only inline delimiters are supplied; no
# class, package, document environment or preamble is synthesized.
math(source:str,resources:Resources,options:FragmentOptions)->Fragment:
    @:text("\$"&source&"\$",resources,options)

# Explicit edit-owner scope, issued before rendering and stable across edits.
text_owned(source:str,resources:Resources,options:FragmentOptions,scope:str)->Fragment:
    (options.width>0 /\ scope~="")?! "Missing fragment width/owner scope"
    context:context_import.context(options.font,resources.roles,options.optical,false)
    breaks:breaks_import.options(options.width)
    breaks.justify:options.justify
    breaks.hyphens:options.hyphens
    packet:paragraph_import.typeset_prepared(source,resources.fonts,context,packages_import.defaults(),resources.language,[],breaks,words_import.text_options(),resources.tables)
    emitted:scene_import.a278_from_paragraph_owned_mapped(packet,scope)
    anchors:scene_import.a283_final_anchors(packet,emitted.scene,emitted.retained_to_leaf,emitted.scene_firsts,emitted.scene_counts)
    @:(scene:emitted.scene,complete:packet.complete,diagnostics:packet.diagnostics,pending_count:packet.pending_count,a272_anchor_origins:scene_import.a272_anchor_origins(packet,scope),a277_anchor_placements:scene_import.a277_anchor_placements(packet),a280_anchor_receipts:scene_import.a280_anchor_receipts(packet),a282_point_receipts:scene_import.a282_point_receipts(packet),a283_final_anchors:anchors)

# Owner supplies THIS prepared plan's block selectors, scopes and exact parse text.
# Kinds distinguish body and primary label parser invocations of the same block.
# Unknown outer labels, notes and decorations remain unbound.
document_owned(source:str,resources:Resources,blocks:[int],scopes:[str],texts:[str],files_json:str="{}",job:str="main",entry:str="main.tex",a263_kinds:[str]=[],a267_notes:[int]=[],a267_scopes:[str]=[],a267_texts:[str]=[],a267_kinds:[str]=[]):
    @:a261_document.layout(source,resources.fonts,resources.roles,resources.language,files_json,job,entry,false,blocks,scopes,texts,a263_kinds,a267_notes,a267_scopes,a267_texts,a267_kinds)

# Public PDF route preserves the document renderer inputs and complete result.
tex2pdf(source:str,fonts:Catalog,operators:str,ordered_roles:[str],language:Language,files_json:str="{}",job:str="main",entry:str="main.tex",include_layout:bit=true):
    @:a261_document.render(source,fonts,operators,ordered_roles,language,files_json,job,entry,include_layout)

# Delimiter-free math uses the same real parser and leaf provenance path as text.
# Owner scope must describe the wrapped parser input, with explicit source origins
# for the synthetic delimiters (host mathEntry validates this before invocation).
math_owned(source:str,resources:Resources,options:FragmentOptions,scope:str)->Fragment:
    @:text_owned("\$"&source&"\$",resources,options,scope)
