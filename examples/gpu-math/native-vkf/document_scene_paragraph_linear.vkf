    Arena arena:(kinds:kinds,keys:keys,xs:xs,ys:ys,sxs:sxs,sys:sys,widths:widths,heights:heights,lines:lines,equation_tags:equation_tags,tag_widths:tag_widths,draws:draws,metadata:metadata,metadata_roots:metadata_roots,glyph_parts:glyph_parts,flow_xs:flow_xs,flow_widths:flow_widths,has_flows:has_flows,vertical_shrinks:vertical_shrinks,vertical_stretches:vertical_stretches,paints:paints,payloads:payloads,destination_firsts:destination_firsts,destination_counts:destination_counts,destination_ids:retained.destination_ids,count:count,paint_table:retained.paint_table,paint_count:retained.paint_count,payload_table:retained.payload_table,payload_count:retained.payload_count,footnote_numbers:footnote_numbers,a260_scopes:a260_scopes,a260_texts:a260_texts,a260_operations:a260_operations,a260_starts:a260_starts,a260_stops:a260_stops,a260_parts:a260_parts)
