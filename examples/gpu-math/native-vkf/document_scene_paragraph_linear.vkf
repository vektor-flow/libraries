# Validate only provenance transport; active prefixes may have spare capacity.
# stream.count is the existing generated link/anchor sentinel, NOT an operation.
a265_provenance_valid(bytes:int,starts:[int],stops:[int],glyphs:[int],glyph_count:int,scenes:[int],scene_count:int)->bit:
    (bytes<0 \/ starts.length()~=stops.length() \/ glyph_count<0 \/ scene_count<0)? @:false
    (glyph_count>glyphs.length() \/ scene_count>scenes.length())? @:false
    at:0
    at<starts.length()?>
        start:starts.(at)
        stop:stops.(at)
        ~((start= -1 /\ stop= -1) \/ (start>=0 /\ stop>=start /\ stop<=bytes))? @:false
        .at:at+1
    .at:0
    at<glyph_count?>
        (glyphs.(at)< -1 \/ glyphs.(at)>starts.length())? @:false
        .at:at+1
    .at:0
    at<scene_count?>
        (scenes.(at)< -1 \/ scenes.(at)>starts.length())? @:false
        .at:at+1
    @:true

# Scope is issued by the edit owner before layout, never from a source offset.
# Bind each paragraph before concatenation/materialization; unknown generated
# operations remain unknown and are rejected by the host metadata binder.
from_paragraph_owned(q:Packet,scope:str)->Scene:
    (scope~="")?! "Missing edit-owner scope"
    out:from_paragraph(q)
    arena:out.arena
    scopes:arena.a260_scopes
    i:0
    i<arena.count?>
        scopes.(i):scope
        .i:i+1
    arena.a260_scopes:scopes
    out.arena:arena
    @:out

# Provenance offsets must be scalar boundaries, including empty spans.
# Build once per paragraph; operation spans can overlap or arrive out of order.
a266_scalar_spans_valid(source:str,starts:[int],stops:[int])->bit:
    starts.length()~=stops.length()? @:false
    starts.length()=0? @:true
    size:a265_text.byte_length(source)
    [bit] boundaries:[false:size+1]
    boundaries.(0):true
    cursor:0
    cursor<size?>
        following:a265_text.next(source,cursor)
        (following<=cursor \/ following>size)? @:false
        boundaries.(following):true
        .cursor:following
    at:0
    at<starts.length()?>
        start:starts.(at)
        stop:stops.(at)
        ~(start= -1 /\ stop= -1)?
            (start<0 \/ stop<start \/ stop>size)? @:false
            (~boundaries.(start) \/ ~boundaries.(stop))? @:false
        .at:at+1
    @:true


# Capture the anchor command's actual parser operation, never the scene ordering
# sentinel or the visible glyph carrying its destination. Payload IDs stay payload.
a272_anchor_origins(q:Packet,scope:str):
    count:q.a272_anchor_operations.length()
    (count=q.a272_anchor_ids.length())?! "Invalid anchor provenance columns"
    (a266_scalar_spans_valid(q.a260_text,q.a260_starts,q.a260_stops))?! "Invalid anchor parser spans"
    [int] starts:[-1:count]
    [int] stops:[-1:count]
    at:0
    at<count?>
        operation:q.a272_anchor_operations.(at)
        ((operation>=0 /\ operation<q.a260_starts.length()))?! "Anchor operation outside parser"
        ((q.a260_starts.(operation)>=0 /\ q.a260_stops.(operation)>=q.a260_starts.(operation)))?! "Unknown anchor parser span"
        starts.(at):q.a260_starts.(operation)
        stops.(at):q.a260_stops.(operation)
        .at:at+1
    @:(scope:scope,text:q.a260_text,ids:q.a272_anchor_ids,operations:q.a272_anchor_operations,starts:starts,stops:stops)

# Actual event-to-retained-scene assignment captured where mark/edit occurs.
# Scene indices are current-layout selectors only; no destination-name search.
# This is not yet final page destination association or reuse authorization.
a277_anchor_placements(q:Packet):
    count:q.a272_anchor_operations.length()
    (count=q.a277_anchor_scenes.length() /\ count=q.a272_anchor_ids.length())?! "Invalid anchor placement columns"
    i:0
    i<count?>
        target:q.a277_anchor_scenes.(i)
        (target>=0 /\ target<q.scene_count /\ target<q.scenes.count)?! "Unbound anchor placement"
        .i:i+1
    @:(scenes:q.a277_anchor_scenes,scene_count:q.scene_count)

# Event-aligned actual mark receipt, not name/geometry-based association.
# Unknown pairs are transport only; a280_emitted_anchor rejects them for binding.
a280_anchor_receipts(q:Packet):
    count:q.a272_anchor_operations.length()
    (count=q.a280_anchor_leaves.length() /\ count=q.a280_anchor_slots.length())?! "Invalid anchor receipt columns"
    i:0
    i<count?>
        leaf:q.a280_anchor_leaves.(i)
        slot:q.a280_anchor_slots.(i)
        ((leaf= -1 /\ slot= -1) \/ (leaf>=0 /\ slot>=0))?! "Invalid anchor receipt pair"
        .i:i+1
    @:(leaves:q.a280_anchor_leaves,slots:q.a280_anchor_slots)

# Compose an individual bound event with the A278 emission map.
# Selectors are never stable semantic IDs. Owner/source binding remains required.
a280_emitted_anchor(leaves:[int],slots:[int],event:int,retained_to_leaf:[int],destination_counts:[int]):
    (leaves.length()=slots.length() /\ event>=0 /\ event<leaves.length())?! "Invalid anchor event"
    retained:leaves.(event)
    (retained>=0 /\ retained<retained_to_leaf.length())?! "Unknown anchor leaf"
    leaf:retained_to_leaf.(retained)
    (leaf>=0 /\ leaf<destination_counts.length())?! "Unemitted anchor leaf"
    slot:slots.(event)
    (slot>=0 /\ slot<destination_counts.(leaf))?! "Invalid anchor occurrence"
    @:(leaf:leaf,slot:slot)

# Generated point occurrences are a separate channel from leaf destinations.
# Current-layout selectors only; owner/span binding is still required for reuse.
A282PointReceipts:(points:[int])
a282_point_receipts(q:Packet)->A282PointReceipts:
    count:q.a272_anchor_operations.length()
    (count=q.a282_anchor_points.length() /\ count=q.a280_anchor_leaves.length() /\ count=q.a280_anchor_slots.length() /\ count=q.a277_anchor_scenes.length())?! "Invalid point receipt columns"
    i:0
    i<count?>
        point:q.a282_anchor_points.(i)
        (point>= -1)?! "Invalid point sentinel"
        point>=0?
            (q.a280_anchor_leaves.(i)= -1 /\ q.a280_anchor_slots.(i)= -1)?! "Ambiguous anchor receipt channels"
            scene:q.a277_anchor_scenes.(i)
            (scene>=0 /\ scene<q.scenes.count)?! "Unknown point scene"
            (point<q.scenes.anchor_count /\ point>=q.scenes.anchor_firsts.(scene) /\ point<q.scenes.anchor_firsts.(scene)+q.scenes.anchor_counts.(scene))?! "Point outside actual scene"
            (q.scenes.anchor_scenes.(point)=scene)?! "Point scene mismatch"
        .i:i+1
    @:(points:q.a282_anchor_points,)

# A278 preserves flat anchor encounter order during placement. No name lookup.
a282_emitted_point(points:[int],event:int,anchor_count:int)->int:
    (event>=0 /\ event<points.length())?! "Invalid point event"
    point:points.(event)
    (point>=0 /\ point<anchor_count)?! "Unknown or unemitted point"
    @:point

# Preserve the existing Scene API; mapped entry returns the same single layout.
from_paragraph(q:Packet)->Scene:
    @:a278_from_paragraph_mapped(q).scene

# Range validation never turns empty scenes or unknown mappings into leaf IDs.
a278_range_valid(first:int,count:int,total:int)->bit:
    @:first>=0 /\ count>=0 /\ total>=0 /\ first<=total /\ count<=total-first

a278_from_paragraph_owned_mapped(q:Packet,scope:str):
    (scope~="")?! "Missing edit-owner scope"
    out:a278_from_paragraph_mapped(q)
    scene:out.scene
    arena:scene.arena
    scopes:arena.a260_scopes
    i:0
    i<arena.count?>
        scopes.(i):scope
        .i:i+1
    arena.a260_scopes:scopes
    scene.arena:arena
    out.scene:scene
    @:out

# Event to FINAL emitted range, without destination-name/geometry matching.
# A range is placement evidence, NOT exact destination-slot ownership or reuse.
a278_anchor_ranges(scenes:[int],firsts:[int],counts:[int],total:int):
    (firsts.length()=counts.length())?! "Invalid emitted range columns"
    [int] event_firsts:[-1:scenes.length()]
    [int] event_counts:[0:scenes.length()]
    i:0
    i<scenes.length()?>
        scene:scenes.(i)
        (scene>=0 /\ scene<firsts.length())?! "Unbound emitted scene"
        first:firsts.(scene)
        count:counts.(scene)
        (a278_range_valid(first,count,total))?! "Invalid emitted leaf range"
        event_firsts.(i):first
        event_counts.(i):count
        .i:i+1
    @:(firsts:event_firsts,counts:event_counts)

# Compose receipts at the actual Fragment emission boundary. These are selectors
# into THIS result, never semantic identity or permission to reuse an old result.
a283_final_anchors(q:Packet,scene:Scene,retained_to_leaf:[int],scene_firsts:[int],scene_counts:[int]):
    receipts:a280_anchor_receipts(q)
    points:a282_point_receipts(q)
    placements:a277_anchor_placements(q)
    origins:a272_anchor_origins(q,"")
    ranges:a278_anchor_ranges(placements.scenes,scene_firsts,scene_counts,scene.arena.count)
    count:origins.operations.length()
    [int] leaves:[-1:count]
    [int] slots:[-1:count]
    [int] emitted_points:[-1:count]
    i:0
    i<count?>
        points.points.(i)>=0?
            point:a282_emitted_point(points.points,i,scene.anchor_count)
            (point<scene.anchor_ids.length() /\ scene.anchor_ids.(point)=origins.ids.(i))?! "Point destination payload mismatch"
            emitted_points.(i):point
        points.points.(i)<0?
            bound:a280_emitted_anchor(receipts.leaves,receipts.slots,i,retained_to_leaf,scene.arena.destination_counts)
            (bound.leaf>=ranges.firsts.(i) /\ bound.leaf<ranges.firsts.(i)+ranges.counts.(i))?! "Anchor leaf outside emitted scene"
            retained:receipts.leaves.(i)
            owner:placements.scenes.(i)
            (retained>=q.scenes.firsts.(owner) /\ retained<q.scenes.firsts.(owner)+q.scenes.counts.(owner))?! "Anchor retained owner mismatch"
            (bound.leaf<scene.arena.destination_firsts.length())?! "Missing destination prefix"
            first:scene.arena.destination_firsts.(bound.leaf)
            (a278_range_valid(first,scene.arena.destination_counts.(bound.leaf),scene.arena.destination_ids.length()))?! "Invalid destination prefix"
            (scene.arena.destination_ids.(first+bound.slot)=origins.ids.(i))?! "Leaf destination payload mismatch"
            leaves.(i):bound.leaf
            slots.(i):bound.slot
        prior:0
        prior<i?>
            (~(emitted_points.(i)>=0 /\ emitted_points.(prior)=emitted_points.(i)))?! "Duplicate emitted point receipt"
            (~(leaves.(i)>=0 /\ leaves.(prior)=leaves.(i) /\ slots.(prior)=slots.(i)))?! "Duplicate emitted leaf receipt"
            .prior:prior+1
        .i:i+1
    @:(leaves:leaves,slots:slots,points:emitted_points)
