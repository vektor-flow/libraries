a278_from_paragraph_mapped(q:Packet):
    (a265_provenance_valid(a265_text.byte_length(q.a260_text),q.a260_starts,q.a260_stops,q.glyph_operations,q.glyph_count,q.scene_operations,q.scene_count))?! "Invalid parser provenance columns"
