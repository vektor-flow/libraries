                    ((retained.a260_starts.(source)=q.a260_starts.(a268_owner) /\ retained.a260_stops.(source)=q.a260_stops.(a268_owner)))?! "Retained link span mismatch"
                    .a260_op:a268_owner
                a260_texts.(at):q.a260_text
                a260_op>=0 /\ a260_op<q.a260_starts.length() /\ q.a260_starts.(a260_op)>=0?
                    a260_operations.(at):a260_op
                    a260_starts.(at):q.a260_starts.(a260_op)
                    a260_stops.(at):q.a260_stops.(a260_op)
                    a260_parts.(at):a260_next.(a260_op)
                    a260_next.(a260_op):a260_next.(a260_op)+1
                .destination_cursor:destination_firsts.(at)+destination_counts.(at)
                .at:at+1
                .source:source+1
            .fragment:fragment+1
            @>
        a260_op:q.glyph_operations.(glyph)
        a260_texts.(at):q.a260_text
        a260_op>=0 /\ a260_op<q.a260_starts.length() /\ q.a260_starts.(a260_op)>=0?
            a260_operations.(at):a260_op
            a260_starts.(at):q.a260_starts.(a260_op)
            a260_stops.(at):q.a260_stops.(a260_op)
