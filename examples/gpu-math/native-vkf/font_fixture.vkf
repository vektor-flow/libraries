# Integration fixture: compile once, then read the installed font files and
# arbitrary glyph key at runtime. This is a font/PDF fixture, not a typesetter.
io:.io
fonts:.font_resources
j:.resource_json
syntax:.pdf_syntax
objects:.pdf_objects
resources:.pdf_resources
paths:.pdf_paths
collections:.collections

run()->int:
    metric_path:io.read_line()
    index_path:io.read_line()
    operators_path:io.read_line()
    glyph_key:io.read_line()
    output_path:io.read_line()
    data:fonts.load(io.read_text(metric_path),io.read_text(index_path),io.read_text(operators_path))
    form:fonts.vector_form(data,glyph_key)
    content:paths.glyph(0,20,40,4,-4)
    tape:objects.pack([
        resources.catalog(2),
        resources.pages(collections.list(3)),
        resources.page(2,4,5,80,80,collections.list()),
        resources.resources(collections.list(6),collections.list()),
        syntax.stream("",content),
        form
    ])
    io.write_text(output_path,objects.serialize(tape,1))
    ::data.metrics.count
    ::data.index.count
    @:0
run()
