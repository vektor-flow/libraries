compare(q:Packet)->bit:
    before:document_scene_paragraph.from_paragraph(q)
    after:document_scene_paragraph_linear.from_paragraph(q)
    (before.width=after.width /\ before.height=after.height /\ before.depth=after.depth /\ before.tag_width=after.tag_width /\ before.anchor_count=after.anchor_count)?! "scene metrics exact"
    a:before.arena
    b:after.arena
    (a.count=b.count /\ a.paint_count=b.paint_count /\ a.payload_count=b.payload_count /\ a.destination_ids.length()=b.destination_ids.length())?! "typed column sizes exact"
    i:0
