        (a.flow_xs.(i)=b.flow_xs.(i))?! "column flow_xs exact"
        (a.flow_widths.(i)=b.flow_widths.(i))?! "column flow_widths exact"
        (a.has_flows.(i)=b.has_flows.(i))?! "column has_flows exact"
        (a.vertical_shrinks.(i)=b.vertical_shrinks.(i))?! "column vertical_shrinks exact"
        (a.vertical_stretches.(i)=b.vertical_stretches.(i))?! "column vertical_stretches exact"
        (a.paints.(i)=b.paints.(i))?! "column paints exact"
        (a.payloads.(i)=b.payloads.(i))?! "column payloads exact"
        (a.destination_firsts.(i)=b.destination_firsts.(i))?! "column destination_firsts exact"
        (a.destination_counts.(i)=b.destination_counts.(i))?! "column destination_counts exact"
        (a.footnote_numbers.(i)=b.footnote_numbers.(i))?! "column footnote_numbers exact"
        old_json:document_scene_export.leaf(a,i,1,1)
        new_json:document_scene_export.leaf(b,i,1,1)
        (old_json=new_json)?! "debug leaf export exact"
        .i:i+1
    .i:0
    i<a.destination_ids.length()?>
        (a.destination_ids.(i)=b.destination_ids.(i))?! "leaf destinations exact"
        .i:i+1
    .i:0
    i<a.paint_count?>
        (a.paint_table.(i).red=b.paint_table.(i).red)?! "paint red exact"
        (a.paint_table.(i).green=b.paint_table.(i).green)?! "paint green exact"
        (a.paint_table.(i).blue=b.paint_table.(i).blue)?! "paint blue exact"
        (a.paint_table.(i).alpha=b.paint_table.(i).alpha)?! "paint alpha exact"
        .i:i+1
    .i:0
    i<a.payload_count?>
        (a.payload_table.(i).crop_x=b.payload_table.(i).crop_x)?! "payload crop_x exact"
        (a.payload_table.(i).crop_y=b.payload_table.(i).crop_y)?! "payload crop_y exact"
