math_paragraph_nodes:.math_paragraph_nodes
math_draw:.math_draw
math_commands:.math_commands
Pool:(values:[str],slots:[int],hashes:[int],count:int)
Buffer:(heads:[[int]],tails:[[int]],boxes:int,nexts:[[int]],children:[[int]],pool:Pool,payload_ids:[[int]],xs:[[num]],ys:[[num]],flow:[[bit]],flow_x:[[num]],flow_width:[[num]],count:int)

renderer_tests()->bit:
    buffer:math_commands.empty(3)
    index:0
    index<270?>
        .buffer:math_commands.append(buffer,1, -1,"\"kind\":\"glyph\",\"key\":\"test/a\"",num(index), -2)
        .index:index+1
    .buffer:math_commands.append(buffer,2, -1,"\"kind\":\"glyph\",\"key\":\"test/b\"",1,3)
    .buffer:math_commands.append(buffer,0,1,"",10,20,true,10,270)
    .buffer:math_commands.append(buffer,0,2,"",50,0)
    pool:buffer.pool
    scene:(width:0.0,height:0.0,depth:0.0,heads:buffer.heads,box_count:buffer.boxes,nexts:buffer.nexts,children:buffer.children,payload:pool.values,payload_ids:buffer.payload_ids,payload_count:pool.count,xs:buffer.xs,ys:buffer.ys,flow:buffer.flow,flow_x:buffer.flow_x,flow_width:buffer.flow_width,count:buffer.count,diagnostics:"",atoms:0,next_equation_number:1,equation_references:"{}",has_last_row:false,last_row_baseline:0.0,last_row_depth:0.0,paragraph:math_paragraph_nodes.empty(0),has_paragraph:false)
    root:math_draw.flatten(scene)
    child:math_draw.flatten_from(scene,1)
    small:math_draw.flatten_from(scene,2)
    (root.count=271 /\ child.count=270 /\ small.count=1)?! "root-specific flattening grows across multiple output pages"
    root_xs:root.xs
    root_ys:root.ys
    root_flow:root.flow
    child_xs:child.xs
    child_flow:child.flow
    .index:0
    index<270?>
        (root_xs.(index)=num(index)+10 /\ root_ys.(index)=18 /\ child_xs.(index)=num(index))?! "requested root preserves relative and accumulated transforms"
        (root_flow.(index) /\ ~child_flow.(index))?! "parent flow does not leak into a standalone child packet"
        .index:index+1
    (root_xs.(270)=51 /\ root_ys.(270)=3 /\ ~root_flow.(270))?! "sibling does not inherit preceding child flow"
    @:true
renderer_tests()
