# Linear source-scene -> positioned-page vector leaf materialization.
document_pages:.document_pages
document_present:.document_present
document_present_context:.document_present_context
document_present_maps:.document_present_maps
document_materialize_config:.document_materialize_config
document_materialize_items:.document_materialize_items
document_materialize_marks:.document_materialize_marks
font_catalog:.font_catalog
resource_json:.resource_json
json_numbers:.json_numbers
text_chunks:.text_chunks
tex_text:.tex_text
Catalog:(source:str,capacity:int,count:int,payload:int,size:int,valid:bit)
Language:(source:str,nodes:int,edges:int,weights:int,exceptions:int,node_start:int,edge_start:int,weight_start:int,exception_start:int,size:int)
PageConfig:(values:[num],flags:[bit],penalties:[int])
MathContext:(restricted:bit,amsmath:bit,amsthm:bit,bbm:bit,latexsym:bit,faktor:bit,qed_symbol:str)
Configuration:(config:str,pages:PageConfig,packages:[str],math:MathContext,overrides:[str],class_name:str,optical:bit,hyperref:bit,diagnostics:str)
Tape:(source:str,kinds:[int],starts:[int],stops:[int],ends:[int],count:int,valid:bit)
Pool:(values:[str],slots:[int],hashes:[int],count:int)
Map:(keys:Pool,values:[str])
Plan:(kinds:[str],sources:[str],contexts:[str],attrs:[str],origins:[int],scenes:[str],count:int,references:Map,reference_destinations:Map,footnotes:str,diagnostics:str,unresolved:str)
Blocks:(texts:[str],indices:[int],numbers:[num],booleans:[bit],count:int)
Lines:(scenes:[int],source_lines:[int],heights:[num],depths:[num],natural_depths:[num],widths:[num],indents:[num],baselines:[num],flagged:[bit],marker_firsts:[int],marker_counts:[int],count:int)
Placements:(scenes:[int],source_lines:[int],pages:[int],blocks:[int],lines:[int],kinds:[int],xs:[num],ys:[num],units:[num],tag_bases:[num],line_heights:[num],line_depths:[num],shrink:[num],stretch:[num],count:int)
Pages:(last_baselines:[num],last_depths:[num],limits:[num],shrink_ratios:[num],stretch_ratios:[num],note_stretch:[num],note_flex:[bit],forced:[bit],count:int)
Rules:(pages:[int],xs:[num],ys:[num],widths:[num],heights:[num],count:int)
Items:(values:[str],nexts:[int],heads:[int],tails:[int],count:int)
number(tape:Tape,node:int,key:str,fallback:num=0)->num:document_materialize_config.number(tape,node,key,fallback)
raw(tape:Tape,node:int)->str:document_materialize_config.raw(tape,node)
string(tape:Tape,node:int,key:str)->str:document_present.string(tape,node,key)
empty(pages:int)->Items:
    @:(values:text_chunks.empty(1024),nexts:[-1:1024],heads:[-1:pages],tails:[-1:pages],count:0)
append(input:Items,page:int,value:str)->Items:
    values:input.values
    nexts:input.nexts
    heads:input.heads
    tails:input.tails
    id:input.count
    id>=values.length()?
        .values:values&text_chunks.empty(values.length())
        .nexts:nexts&[-1:nexts.length()]
    values.(id):value
    prior:tails.(page)
    prior<0? heads.(page):id
    prior>=0? nexts.(prior):id
    tails.(page):id
    @:(values:values,nexts:nexts,heads:heads,tails:tails,count:id+1)
object(map:Map)->str:
    pool:map.keys
    keys:pool.values
    values:map.values
    chunks:text_chunks.empty(pool.count)
    i:0
    i<pool.count?>
        prefix:""
        i>0? .prefix:","
        chunks.(i):prefix&resource_json.quote(keys.(i))&":"&values.(i)
        .i:i+1
    @:"{"&text_chunks.join(chunks,0,pool.count)&"}"
point(page:int,x:num,y:num)->str:
    @:"{\"page\":"&tex_text.integer(page)&",\"x\":"&json_numbers.roundtrip(x)&",\"y\":"&json_numbers.roundtrip(y)&"}"
collect(destinations:Map,leaf:str,page:int,fonts:Catalog)->Map:
    tape:resource_json.parse(leaf)
    ids:resource_json.member(tape,0,"destinationIds")
    ids<0? @:destinations
    ends:tape.ends
    at:ids+1
    out:destinations
    y:number(tape,0,"y")
    key:string(tape,0,"key")
    key~=""?
        tile_source:font_catalog.raw(fonts,"tile/"&key)
        tile_source~=""?
            tile:resource_json.parse(tile_source)
            plane:resource_json.member(tile,0,"plane")
            plane>=0?
                top:resource_json.element(tile,plane,1)
                top>=0? .y:y+resource_json.number(tile,top)*number(tape,0,"sy",1)
    at<ends.(ids)?>
        id:resource_json.string(tape,at)
        found:document_present_maps.get(out,id)
        ~found.found? .out:document_present_maps.put(out,id,point(page,number(tape,0,"x"),y))
        .at:ends.(at)
    @:out
rule_json(rules:Rules,index:int)->str:
    @:"{\"kind\":\"rule\",\"x\":"&json_numbers.roundtrip(rules.xs.(index))&",\"y\":"&json_numbers.roundtrip(rules.ys.(index))&",\"width\":"&json_numbers.roundtrip(rules.widths.(index))&",\"height\":"&json_numbers.roundtrip(rules.heights.(index))&"}"
build(plan:Plan,blocks:Blocks,lines:Lines,scenes:[str],labels:[str],placements:Placements,pages:Pages,config:Configuration,fonts:Catalog,decorations:[str],rules:Rules):
    settings:resource_json.parse(config.config)
    source_chunks:text_chunks.empty(scenes.length())
    i:0
    i<scenes.length()?>
        prefix:""
        i>0? .prefix:","
        source_chunks.(i):prefix&scenes.(i)
        .i:i+1
    tape:resource_json.parse("["&text_chunks.join(source_chunks,0,scenes.length())&"]")
    ends:tape.ends
    heads:[-1:lines.count]
    tails:[-1:lines.count]
    nexts:[-1:tape.count]
    packet_ids:[0:scenes.length()]
    scene_firsts:[-1:scenes.length()]
    scene_counts:[0:scenes.length()]
    full_scenes:[false:scenes.length()]
    placement_index:0
    placement_index<placements.count?>
        placements.kinds.(placement_index)>=3?
            full_scene:placements.scenes.(placement_index)
            full_scene>=0 /\ full_scene<scenes.length()? full_scenes.(full_scene):true
        .placement_index:placement_index+1
    line_scenes:lines.scenes
    source_lines:lines.source_lines
    global_line:0
    global_line<lines.count?>
        scene_id:line_scenes.(global_line)
        scene_id>=0 /\ scene_id<scenes.length()?
            source_line:source_lines.(global_line)
            scene_firsts.(scene_id):global_line-source_line
            scene_counts.(scene_id):source_line+1
        .global_line:global_line+1
    # Index all original leaves once. Placement never rescans a paragraph.
    node:1
    .i:0
    i<scenes.length()?>
        packet_ids.(i):node
        first:scene_firsts.(i)
        count:scene_counts.(i)
        items:resource_json.member(tape,node,"items")
        item:items+1
        items>=0?
            item<ends.(items)?>
                line:int(number(tape,item,"flowLine"))
                full_scenes.(i)? .line:0
                line>=0 /\ line<count?
                    target:first+line
                    prior:tails.(target)
                    prior<0? heads.(target):item
                    prior>=0? nexts.(prior):item
                    tails.(target):item
                .item:ends.(item)
        .node:ends.(node)
        .i:i+1
    output_values:text_chunks.empty(1024)
    [int] output_nexts:[-1:1024]
    output_heads:[-1:pages.count]
    output_tails:[-1:pages.count]
    output_count:0
    rule_ids:[-1:pages.count]
    emitted_rules:[false:pages.count]
    rule_index:0
    rule_index<rules.count?>
        rule_ids.(rules.pages.(rule_index)):rule_index
        .rule_index:rule_index+1
    destinations:document_present_maps.put(document_present_maps.empty(),"document",point(0,0,0))
    .i:0
    i<pages.count?>
        .destinations:document_present_maps.put(destinations,"page:"&tex_text.integer(i+1),point(i,0,0))
        .i:i+1
    placement_pages:placements.pages
    placement_scenes:placements.scenes
    placement_sources:placements.source_lines
    placement_lines:placements.lines
    line_baselines:lines.baselines
    origins:plan.origins
    contexts:plan.contexts
    marked:[false:plan.count]
    .i:0
    i<placements.count?>
        scene:placement_scenes.(i)
        line:placement_sources.(i)
        page:placement_pages.(i)
        placements.kinds.(i)=1 /\ ~emitted_rules.(page) /\ rule_ids.(page)>=0?
            output_count>=output_values.length()?
                .output_values:output_values&text_chunks.empty(output_values.length())
                .output_nexts:output_nexts&[-1:output_nexts.length()]
            output_values.(output_count):rule_json(rules,rule_ids.(page))
            prior_output:output_tails.(page)
            prior_output<0? output_heads.(page):output_count
            prior_output>=0? output_nexts.(prior_output):output_count
            output_tails.(page):output_count
            .output_count:output_count+1
            emitted_rules.(page):true
        scene>=0 /\ scene<scenes.length()?
            first:scene_firsts.(scene)
            global:first+line
            scene<plan.count /\ line=0 /\ labels.(scene)~="{}"?
                label_tape:resource_json.parse(labels.(scene))
                label_items:resource_json.member(label_tape,0,"items")
                label_ends:label_tape.ends
                label_at:label_items+1
                label_context:document_present_context.parse(contexts.(scene))
                label_x:number(settings,0,"left")+label_context.left-label_context.label_sep-number(label_tape,0,"width")
                placement_ys:placements.ys
                placement_units:placements.units
                label_y:placement_ys.(i)+line_baselines.(global)*placement_units.(i)
                shrink:placements.shrink
                stretch:placements.stretch
                label_at<label_ends.(label_items)?>
                    label_leaf:document_materialize_marks.translate(label_tape,label_at,label_x,label_y,true,shrink.(i),stretch.(i))
                    output_count>=output_values.length()?
                        .output_values:output_values&text_chunks.empty(output_values.length())
                        .output_nexts:output_nexts&[-1:output_nexts.length()]
                    output_values.(output_count):label_leaf
                    prior_output:output_tails.(page)
                    prior_output<0? output_heads.(page):output_count
                    prior_output>=0? output_nexts.(prior_output):output_count
                    output_tails.(page):output_count
                    .output_count:output_count+1
                    .label_at:label_ends.(label_at)
            item:heads.(global)
            item>=0?>
                leaf:document_materialize_items.transform(tape,item,placements,i,line_baselines.(global))
                scene<plan.count /\ ~marked.(scene) /\ string(tape,item,"kind")~="link"?
                    context:document_present_context.parse(contexts.(scene))
                    context.destination~=""?
                        .leaf:tex_text.span(leaf,0,tex_text.byte_length(leaf)-1)&",\"destinationIds\":["&resource_json.quote(context.destination)&"]}"
                    marked.(scene):true
                output_count>=output_values.length()?
                    .output_values:output_values&text_chunks.empty(output_values.length())
                    .output_nexts:output_nexts&[-1:output_nexts.length()]
                output_values.(output_count):leaf
                prior_output:output_tails.(page)
                prior_output<0? output_heads.(page):output_count
                prior_output>=0? output_nexts.(prior_output):output_count
                output_tails.(page):output_count
                .output_count:output_count+1
                .destinations:collect(destinations,leaf,page,fonts)
                .item:nexts.(item)
        .i:i+1
    # An empty note still has its separator even when it emitted no lines.
    .rule_index:0
    rule_index<rules.count?>
        rule_page:rules.pages.(rule_index)
        ~emitted_rules.(rule_page)?
            output_count>=output_values.length()?
                .output_values:output_values&text_chunks.empty(output_values.length())
                .output_nexts:output_nexts&[-1:output_nexts.length()]
            output_values.(output_count):rule_json(rules,rule_index)
            prior_output:output_tails.(rule_page)
            prior_output<0? output_heads.(rule_page):output_count
            prior_output>=0? output_nexts.(prior_output):output_count
            output_tails.(rule_page):output_count
            .output_count:output_count+1
        .rule_index:rule_index+1
    # Source-shaped headers and footers follow all page body leaves.
    .i:0
    i<decorations.length()?>
        decoration:resource_json.parse(decorations.(i))
        decoration_ends:decoration.ends
        decoration_at:1
        decoration_at<decoration.count?>
            output_count>=output_values.length()?
                .output_values:output_values&text_chunks.empty(output_values.length())
                .output_nexts:output_nexts&[-1:output_nexts.length()]
            output_values.(output_count):raw(decoration,decoration_at)
            prior_output:output_tails.(i)
            prior_output<0? output_heads.(i):output_count
            prior_output>=0? output_nexts.(prior_output):output_count
            output_tails.(i):output_count
            .output_count:output_count+1
            .decoration_at:decoration_ends.(decoration_at)
        .i:i+1
    # Label aliases retain actual first-leaf destination coordinates.
    refs:plan.reference_destinations
    keys:refs.keys.values
    values:refs.values
    .i:0
    i<refs.keys.count?>
        destination:document_present_maps.get(destinations,values.(i))
        destination.found? .destinations:document_present_maps.put(destinations,"label:"&keys.(i),destination.value)
        .i:i+1
    page_values:document_present_maps.empty()
    .i:0
    i<refs.keys.count?>
        destination:document_present_maps.get(destinations,"label:"&keys.(i))
        destination.found?
            target_point:resource_json.parse(destination.value)
            .page_values:document_present_maps.put(page_values,keys.(i),tex_text.integer(int(number(target_point,0,"page"))+1))
        .i:i+1
    page_json:text_chunks.empty(pages.count)
    .i:0
    i<pages.count?>
        count:0
        .node:output_heads.(i)
        page_item_count:0
        node>=0?>
            .page_item_count:page_item_count+1
            .node:output_nexts.(node)
        .node:output_heads.(i)
        chunks:text_chunks.empty(page_item_count)
        node>=0?>
            prefix:""
            count>0? .prefix:","
            chunks.(count):prefix&output_values.(node)
            .count:count+1
            .node:output_nexts.(node)
        prefix:""
        i>0? .prefix:","
        page_json.(i):prefix&"{\"width\":"&json_numbers.roundtrip(number(settings,0,"paperWidth"))&",\"height\":"&json_numbers.roundtrip(number(settings,0,"paperHeight"))&",\"number\":"&tex_text.integer(i+1)&",\"items\":["&text_chunks.join(chunks,0,count)&"]}"
        .i:i+1
    @:(layout_json:"{\"pages\":["&text_chunks.join(page_json,0,pages.count)&"],\"destinations\":"&object(destinations)&"}",page_values:page_values)
