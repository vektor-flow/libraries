# Native integration adapter. Inputs are supplied after compilation; the same
# resolver is exported through the WASM test route for the browser host.
io:.io
project:.document_project
pdf:.pdf_syntax

run()->int:
    source_path:io.read_line()
    files_path:io.read_line()
    job:io.read_line()
    entry:io.read_line()
    output_path:io.read_line()
    result:project.resolve(io.read_text(source_path),io.read_text(files_path),job,entry)
    io.write_text(output_path,result.source)
    io.write_text(output_path&".diagnostics",result.diagnostics)
    ::result.input_count
    index:0
    index<result.input_count?>
        ::pdf.hex_string(project.input_name(result,index))
        .index:index+1
    @:0
run()
