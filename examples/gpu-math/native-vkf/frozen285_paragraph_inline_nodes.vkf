                        prefix_stop:measure(cache,id,word,0,stop,fonts,ctx)
                        .cache:prefix_stop.cache
                        .prefix_stop_index:prefix_stop.run_index
                    piece_index:find_measure(cache,id,first,stop)
                    piece_index<0?
                        piece:measure(cache,id,word,first,stop,fonts,ctx)
                        .cache:piece.cache
                        .piece_index:piece.run_index
                    corrections>=correction_starts.length()?
                        .correction_starts:correction_starts&p.ints(correction_starts.length())
                        .correction_ends:correction_ends&p.ints(correction_ends.length())
                        .correction_deltas:correction_deltas&p.nums(correction_deltas.length())
                    correction_starts.(corrections):i
                    correction_ends.(corrections):k
                    correction_deltas.(corrections):cache.widths.(piece_index)-(cache.widths.(prefix_stop_index)-prefix_starts.(i))
                    .corrections:corrections+1
                .k:k+1
        .i:i+1
    previous_operation>=0 /\ previous_operation<operation_scopes.length() /\ scope_count>0?
        previous_scope:operation_scopes.(previous_operation)
        previous_scope>=0? scope_nodes.(previous_scope):scope_nodes.(previous_scope)+count-previous_count
    next_close<close_operations.length()?>
        first_scope:close_first.(next_close)
        last_scope:close_last.(next_close)
        nested_node:false
        first_scope<=last_scope?>
            scope_nodes.(first_scope)>0? .nested_node:true
            .first_scope:first_scope+1
        nested_node? cache.diagnostics:merge_diagnostics(cache.diagnostics,"\"Nested PDF links are not supported\"")
        .next_close:next_close+1
    @:(nodes:nodes,word_ids:word_ids,roles:roles,operation_ids:operation_ids,scenes:scenes,box_heights:box_heights,box_depths:box_depths,italics:italics,pending:pending,pending_count:pending_count,word_starts:word_starts,word_ends:word_ends,words:words,lengths:lengths,cache:cache,corrections:p.corrections(correction_starts,correction_ends,correction_deltas,corrections))

build(source:str,stream:Stream,fonts:Catalog,language:Language,overrides:[str],automatic:bit,o:TextOptions,provided:Provider):
    @:build_with_link_events(source,stream,fonts,language,overrides,automatic,o,provided,p.ints(0),p.ints(0),p.ints(0),p.ints(0))

font_stretch(fonts:FontState,index:int)->num:fonts.role_stretches.(index)

font_shrink(fonts:FontState,index:int)->num:fonts.role_shrinks.(index)

font_extra(fonts:FontState,index:int)->num:fonts.role_extras.(index)

font_size(fonts:FontState,index:int)->num:fonts.role_sizes.(index)

font_quad(fonts:FontState,index:int)->num:fonts.role_quads.(index)

font_slant(fonts:FontState,index:int)->num:fonts.role_slants.(index)
