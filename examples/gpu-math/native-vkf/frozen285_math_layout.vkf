commands:.frozen285_math_commands
math_display_width:.frozen285_math_display_width
math_arena_import:.frozen285_math_arena_import
math_middle:.frozen285_math_middle
math_enclosures:.frozen285_math_enclosures
math_qed:.frozen285_math_qed
math_qed_actions:.frozen285_math_qed_actions
math_qed_tag_leaves:.frozen285_math_qed_tag_leaves
math_command_pages:.frozen285_math_command_pages
# One owner computes the math box tree with explicit postorder tasks. Child
# drawings remain references; math_draw flattens them only at the output edge.
parser:.frozen285_math_parser
tokens:.frozen285_math_tokens
glyphs:.frozen285_math_glyphs
geometry:.frozen285_math_geometry
profiles:.frozen285_math_profiles
dimensions:.frozen285_math_dimensions
math_text:.frozen285_math_text_layout
assembly:.frozen285_math_assembly
arrows:.frozen285_math_arrows
modulo:.frozen285_math_modulo
matrices:.frozen285_math_matrices
decorations:.frozen285_math_decorations
measurements:.frozen285_math_measurements
tags:.frozen285_math_tags
references:.frozen285_math_references
destinations:.frozen285_math_destinations
equations:.frozen285_math_equations
effects:.frozen285_math_effects
quotients:.frozen285_math_quotient
paragraphs:.frozen285_math_paragraph_nodes
draw:.frozen285_math_draw
catalog:.frozen285_font_catalog
j:.frozen285_resource_json
text:.frozen285_tex_text
tex:.frozen285_tex_numeric
chunks:.frozen285_text_chunks
numbers:.frozen285_json_numbers
Catalog:(source:str,capacity:int,count:int,payload:int,size:int,valid:bit)
Arena:(kinds:[str],attrs:[str],first:[int],last:[int],nexts:[int],a:[int],b:[int],sup:[int],sub:[int],limits:[int],count:int,diagnostics:str,atoms:int)
Tape:(source:str,kinds:[int],starts:[int],stops:[int],ends:[int],count:int,valid:bit)
Tables:(values:[num],ems:[num],delim1:[num],delim2:[num],mus:[num])
ParagraphNodes:(kinds:[int],owners:[int],widths:[num],heights:[num],depths:[num],stretches:[num],shrinks:[num],penalties:[int],count:int)
Scene:(width:num,height:num,depth:num,heads:[[int]],box_count:int,nexts:[[int]],children:[[int]],payload:[str],payload_ids:[[int]],payload_count:int,xs:[[num]],ys:[[num]],flow:[[bit]],flow_x:[[num]],flow_width:[[num]],count:int,diagnostics:str,atoms:int,next_equation_number:int,equation_references:str,has_last_row:bit,last_row_baseline:num,last_row_depth:num,paragraph:ParagraphNodes,has_paragraph:bit)
PackageContext:(restricted:bit,amsmath:bit,amsthm:bit,bbm:bit,latexsym:bit,faktor:bit,qed_symbol:str)

raw(tape:Tape,key:str,fallback:str="null")->str:
    node:j.member(tape,0,key)
    node<0? @:fallback
    starts:tape.starts
    stops:tape.stops
    @:text.span(tape.source,starts.(node),stops.(node))

flag(tape:Tape,key:str)->bit:
    node:j.member(tape,0,key)
    node<0? @:false
    kinds:tape.kinds
    @:kinds.(node)=5

nucleus(metric:str,klass:int):
    italic:0.0
    metric~=""? .italic:glyphs.numeric(j.parse(metric),0,"italic")
    @:(token:"",key:"",width:0.0,height:0.0,depth:0.0,class_id:klass,italic:italic,character:true,metric:metric,diagnostic:"",placeholder:metric="")

limit_operator(token:str)->bit:
    @:tokens.one_of(token,["\\sum","\\prod","\\coprod","\\bigcup","\\bigcap","\\bigvee","\\bigwedge","\\bigsqcup","\\bigoplus","\\bigotimes","\\bigodot","\\lim","\\max","\\min","\\sup","\\inf"])

matrix_base(name:str)->str:
    length:text.byte_length(name)
    length>0?
        text.at(name,length-1)="*"? @:text.span(name,0,length-1)
    @:name

row_labels(arena:Arena,first_row:int,all_rows:bit=false):
    firsts:arena.first
    nexts:arena.nexts
    kinds:arena.kinds
    attrs:arena.attrs
    ids:chunks.empty(8)
    count:0
    row:first_row
    row>=0?>
        cell:firsts.(row)
        cell>=0?>
            node:firsts.(cell)
            node>=0?>
                kinds.(node)="label"?
                    count>=ids.length()? .ids:ids&chunks.empty(ids.length())
                    properties:j.parse("{"&attrs.(node)&"}")
                    ids.(count):"label:"&glyphs.string(properties,"key")
                    .count:count+1
                .node:nexts.(node)
            .cell:nexts.(cell)
        ~all_rows? .row: -1
        all_rows? .row:nexts.(row)
    @:(ids:ids,count:count)

# Stable draw namespaces remain valid when future execution nodes are appended.
# AST IDs continue to index metric/parser columns; only command IDs use this map.
draw_owner(node:int,kind:int=0)->int:
    node<0? @: -1
    (kind>=0 /\ kind<4)?! "Invalid draw owner kind"
    @:node*4+kind

layout_with_profiles(input_arena:Arena,fonts:Catalog,constants:Tables,inline:bit=false,native:bit=true,display_environment:bit=false,equation_start:int=1,paragraph_mode:bit=false,text_spacing:str="",math_metrics:str="",display_width:num= -1,legacy_equation_anchor:bit=false,qed_symbol:str="")->Scene:
    (display_width= -1 \/ (display_width>0 /\ display_width<=10.0^300))?! "Invalid display width"
    retain_paragraph:paragraph_mode \/ display_width>0
    native_metrics:math_metrics~=""
    metric_baseline:12*tex.pt()
    metric_jot:3*tex.pt()
    metric_skip:tex.pt()
    metric_skip_limit:0.0
    native_metrics?
        metric_data:j.parse(math_metrics)
        metric_data.valid?! "Invalid math metrics"
        .metric_baseline:glyphs.numeric(metric_data,0,"baseline",metric_baseline)
        .metric_jot:glyphs.numeric(metric_data,0,"jot",metric_jot)
        .metric_skip:glyphs.numeric(metric_data,0,"lineSkip",metric_skip)
        .metric_skip_limit:glyphs.numeric(metric_data,0,"lineSkipLimit",metric_skip_limit)
    arena:equations.prepare(input_arena)
    measurement_roots:parser.nil(arena.count)
    kinds:arena.kinds
    attrs:arena.attrs
    firsts:arena.first
    nexts:arena.nexts
    arguments:arena.a
    denominators:arena.b
    supers:arena.sup
    subs:arena.sub
    limits:arena.limits
    size:arena.count
    capacity:size
    paragraph_capacity:0
    retain_paragraph? .paragraph_capacity:size*4+1
    paragraph_data:paragraphs.empty(paragraph_capacity)
    spacing:j.parse(text_spacing)
    widths:draw.zeros(size)
    heights:draw.zeros(size)
    depths:draw.zeros(size)
    italics:draw.zeros(size)
    classes:draw.ints(size)
    end_classes:parser.nil(size)
    spaces:draw.bits(size)
    characters:draw.bits(size)
    skipped:draw.bits(size)
    leading_anchor:draw.bits(size)
    trailing_anchor:draw.bits(size)
    incomplete_cell:draw.bits(size)
    ready:draw.bits(size)
    tag_nodes:draw.bits(size)
    table_cells:draw.bits(size)
    has_last_row:draw.bits(size)
    last_row_baselines:draw.zeros(size)
    last_row_depths:draw.zeros(size)
    qed_stack:math_qed.empty()
    middle_required:0.0
    middle_previous:draw.zeros(size)
    middle_first:parser.nil(size)
    qed_roots:parser.nil(size)
    qed_entry_depth:draw.ints(size)
    qed_tag_nodes:draw.bits(size)
    arrow_measured:draw.bits(size)
    arrow_first_sup:parser.nil(size)
    arrow_first_sub:parser.nil(size)
    equation_number:equation_start
    equation_refs:references.empty()
    nuclei:chunks.empty(size)
    styles:draw.ints(size)
    cramped:draw.bits(size)
    active_fonts:chunks.empty(size)
    colors:chunks.empty(size)
    colors.(0):"null"
    inline? styles.(0):1
    buffer:commands.empty(size*4)
    # Decode each distinct scoped glyph record once within this request. The
    # table starts empty on every layout; no prior source or result is reused.
    glyph_capacity:8
    glyph_capacity<size*2?> .glyph_capacity:glyph_capacity*2
    glyph_slots:parser.nil(glyph_capacity)
    glyph_cache_keys:chunks.empty(size)
    glyph_cache_tokens:chunks.empty(size)
    glyph_cache_keys_out:chunks.empty(size)
    glyph_cache_metrics:chunks.empty(size)
    glyph_cache_diagnostics:chunks.empty(size)
    glyph_cache_widths:draw.zeros(size)
    glyph_cache_heights:draw.zeros(size)
    glyph_cache_depths:draw.zeros(size)
    glyph_cache_italics:draw.zeros(size)
    glyph_cache_classes:draw.ints(size)
    glyph_cache_characters:draw.bits(size)
    glyph_cache_placeholders:draw.bits(size)
    glyph_count:0
    stack:draw.ints(size*2+8)
    phases:draw.ints(size*2+8)
    pending_styles:draw.ints(size*2+8)
    pending_fonts:chunks.empty(size*2+8)
    pending_colors:chunks.empty(size*2+8)
    pending_cramped:draw.bits(size*2+8)
    top:0
    diagnostics:arena.diagnostics
    empty_data:j.parse("{}")
    empty_shape:assembly.empty(0)
    kern_prior:""
    kern_current:""
    kern_prior_class: -1
    kern_current_class: -1
    kern_value:0.0
    top>=0?>
        arena.count>size?
            .size:arena.count
            .kinds:arena.kinds
            .attrs:arena.attrs
            .firsts:arena.first
            .nexts:arena.nexts
            .arguments:arena.a
            .denominators:arena.b
            .supers:arena.sup
            .subs:arena.sub
            .limits:arena.limits
            old_capacity:capacity
            capacity<size?> .capacity:capacity*2
            additional:capacity-old_capacity
            additional>0?
                .widths:widths&draw.zeros(additional)
                .heights:heights&draw.zeros(additional)
                .depths:depths&draw.zeros(additional)
                .italics:italics&draw.zeros(additional)
                .last_row_baselines:last_row_baselines&draw.zeros(additional)
                .last_row_depths:last_row_depths&draw.zeros(additional)
                .middle_previous:middle_previous&draw.zeros(additional)
                .glyph_cache_widths:glyph_cache_widths&draw.zeros(additional)
                .glyph_cache_heights:glyph_cache_heights&draw.zeros(additional)
                .glyph_cache_depths:glyph_cache_depths&draw.zeros(additional)
                .glyph_cache_italics:glyph_cache_italics&draw.zeros(additional)
                .classes:classes&draw.ints(additional)
                .styles:styles&draw.ints(additional)
                .qed_entry_depth:qed_entry_depth&draw.ints(additional)
                .glyph_cache_classes:glyph_cache_classes&draw.ints(additional)
                .end_classes:end_classes&parser.nil(additional)
                .measurement_roots:measurement_roots&parser.nil(additional)
                .middle_first:middle_first&parser.nil(additional)
                .qed_roots:qed_roots&parser.nil(additional)
                .arrow_first_sup:arrow_first_sup&parser.nil(additional)
                .arrow_first_sub:arrow_first_sub&parser.nil(additional)
                .spaces:spaces&draw.bits(additional)
                .characters:characters&draw.bits(additional)
                .skipped:skipped&draw.bits(additional)
                .leading_anchor:leading_anchor&draw.bits(additional)
                .trailing_anchor:trailing_anchor&draw.bits(additional)
                .incomplete_cell:incomplete_cell&draw.bits(additional)
                .ready:ready&draw.bits(additional)
                .tag_nodes:tag_nodes&draw.bits(additional)
                .table_cells:table_cells&draw.bits(additional)
                .has_last_row:has_last_row&draw.bits(additional)
                .cramped:cramped&draw.bits(additional)
                .qed_tag_nodes:qed_tag_nodes&draw.bits(additional)
                .arrow_measured:arrow_measured&draw.bits(additional)
                .glyph_cache_characters:glyph_cache_characters&draw.bits(additional)
                .glyph_cache_placeholders:glyph_cache_placeholders&draw.bits(additional)
                .nuclei:nuclei&chunks.empty(additional)
                .active_fonts:active_fonts&chunks.empty(additional)
                .colors:colors&chunks.empty(additional)
                .glyph_cache_keys:glyph_cache_keys&chunks.empty(additional)
                .glyph_cache_tokens:glyph_cache_tokens&chunks.empty(additional)
                .glyph_cache_keys_out:glyph_cache_keys_out&chunks.empty(additional)
                .glyph_cache_metrics:glyph_cache_metrics&chunks.empty(additional)
                .glyph_cache_diagnostics:glyph_cache_diagnostics&chunks.empty(additional)
                task_additional:2*additional
                .stack:stack&draw.ints(task_additional)
                .phases:phases&draw.ints(task_additional)
                .pending_styles:pending_styles&draw.ints(task_additional)
                .pending_fonts:pending_fonts&chunks.empty(task_additional)
                .pending_colors:pending_colors&chunks.empty(task_additional)
                .pending_cramped:pending_cramped&draw.bits(task_additional)
                .glyph_capacity:glyph_capacity*2
                glyph_capacity<capacity*2?> .glyph_capacity:glyph_capacity*2
                .glyph_slots:parser.nil(glyph_capacity)
                rehash:0
                rehash<glyph_count?>
                    slot:catalog.hash(glyph_cache_keys.(rehash))%glyph_capacity
                    glyph_slots.(slot)>=0?> .slot:(slot+1)%glyph_capacity
                    glyph_slots.(slot):rehash
                    .rehash:rehash+1
                owner_rows:(capacity*4+math_command_pages.width()-1)//math_command_pages.width()
                owner_heads:buffer.heads
                owner_tails:buffer.tails
                owner_heads.length()<owner_rows?>
                    .owner_heads:math_command_pages.grow_integers(owner_heads)
                    .owner_tails:math_command_pages.grow_integers(owner_tails)
                buffer.heads:owner_heads
                buffer.tails:owner_tails
                buffer.boxes:capacity*4
        node:stack.(top)
        phase:phases.(top)
        .top:top-1
        phase= -1?
            styles.(node):pending_styles.(top+1)
            active_fonts.(node):pending_fonts.(top+1)
            colors.(node):pending_colors.(top+1)
            cramped.(node):pending_cramped.(top+1)
            .phase:0
        (node>=0 /\ node<kinds.length() /\ node<styles.length() /\ node<widths.length())?! "Execution task metric capacity"
        kind:kinds.(node)
        style:styles.(node)
        font:active_fonts.(node)
        color:colors.(node)
        data:empty_data
        (phase=1 /\ kind~="list" /\ kind~="glyph") \/ tokens.one_of(kind,["font","paint","frac","box","decoration","matrix","delimited"])? .data:j.parse("{"&attrs.(node)&"}")
        phase=2?
            copied_measurement:math_arena_import.import_into(arena,arena,arguments.(node))
            .arena:copied_measurement.arena
            measurement_roots.(node):copied_measurement.root
            .top:top+1
            stack.(top):copied_measurement.root
            phases.(top): -1
            pending_styles.(top):1
            pending_fonts.(top):font
            pending_colors.(top):color
            pending_cramped.(top):true
            @>
        phase=4?
            sizing_root:middle_first.(node)
            middle_p:profiles.parameters(constants,style,font)
            .middle_required:math_middle.required(heights.(sizing_root),depths.(sizing_root),middle_p.axis)
            child:arguments.(node)
            styles.(child):style
            active_fonts.(child):font
            colors.(child):color
            cramped.(child):cramped.(node)
            .top:top+1
            stack.(top):child
            phases.(top):0
            @>
        phase=5?
            real_body:arguments.(node)
            enclosure_p:profiles.parameters(constants,style,font)
            enclosure_required:geometry.delimiter_required((width:widths.(real_body),height:heights.(real_body),depth:depths.(real_body)),enclosure_p,flag(data,"scalable"))
            enclosed:math_enclosures.layout(buffer,draw_owner(node,1),draw_owner(real_body),fonts,(width:widths.(real_body),height:heights.(real_body),depth:depths.(real_body)),glyphs.string(data,"left"),glyphs.string(data,"right"),style,enclosure_required,flag(data,"scalable"),font,color)
            .buffer:enclosed.buffer
            widths.(node):enclosed.width
            heights.(node):enclosed.height
            depths.(node):enclosed.depth
            classes.(node):enclosed.class_id
            end_classes.(node):enclosed.end_class
            characters.(node):enclosed.character
            enclosed.left_diagnostic~=""? .diagnostics:parser.repair(diagnostics,enclosed.left_diagnostic)
            enclosed.right_diagnostic~=""? .diagnostics:parser.repair(diagnostics,enclosed.right_diagnostic)
            .middle_required:middle_previous.(node)
            @>
        phase=6?
            captured_root:qed_roots.(node)
            .qed_stack:math_qed_actions.finish(qed_stack,qed_entry_depth.(node))
            widths.(node):widths.(captured_root)
            heights.(node):heights.(captured_root)
            depths.(node):depths.(captured_root)
            italics.(node):italics.(captured_root)
            nuclei.(node):nuclei.(captured_root)
            has_last_row.(node):has_last_row.(captured_root)
            last_row_baselines.(node):last_row_baselines.(captured_root)
            last_row_depths.(node):last_row_depths.(captured_root)
            .buffer:commands.append(buffer,draw_owner(node),draw_owner(captured_root))
            ready.(node):true
            @>
        phase=0?
            ready.(node)? @>
            tokens.one_of(kind,["qedpush","qedpop","qedhere","qed"])?
                action:math_qed_actions.enter(qed_stack,kind,arguments.(node),style,cramped.(node),font,color,display_environment)
                .qed_stack:action.stack
                tag_nodes.(node):action.tag
                qed_tag_nodes.(node):action.qed_tag
                spaces.(node):action.space
                action.diagnostic~=""?
                    diagnostics~=""? .diagnostics:diagnostics&","
                    .diagnostics:diagnostics&j.quote(action.diagnostic)
                action.operation=math_qed_actions.evaluate_operation()?
                    capture:math_qed_actions.instantiate(arena,action)
                    .arena:capture.arena
                    qed_roots.(node):capture.root
                    qed_entry_depth.(node):action.entry_depth
                    .top:top+1
                    stack.(top):node
                    phases.(top):6
                    .top:top+1
                    stack.(top):capture.root
                    phases.(top): -1
                    pending_styles.(top):action.style
                    pending_fonts.(top):action.font
                    pending_colors.(top):action.color
                    pending_cramped.(top):action.cramped
                    @>
                action.operation=math_qed_actions.symbol_operation()?
                    quad_override: -1.0
                    spacing_quad: -1
                    spacing.valid? .spacing_quad:j.member(spacing,0,"quad")
                    spacing_quad>=0? .quad_override:j.number(spacing,spacing_quad)
                    symbol:math_qed.symbol(buffer,draw_owner(node),fonts,quad_override,font,color,qed_symbol)
                    .buffer:symbol.buffer
                    widths.(node):symbol.width
                    heights.(node):symbol.height
                    depths.(node):symbol.depth
                    italics.(node):symbol.italic
                    classes.(node):symbol.class_id
                    characters.(node):symbol.character
                    nuclei.(node):symbol.nucleus
                    symbol.diagnostic~=""? .diagnostics:parser.repair(diagnostics,symbol.diagnostic)
                action.operation=math_qed_actions.hole_operation()?
                    missing_qed:glyphs.hole(fonts,style)
                    widths.(node):missing_qed.width
                    heights.(node):missing_qed.height
                    depths.(node):missing_qed.depth
                    classes.(node):missing_qed.class_id
                    hole_value:"\"kind\":\"placeholder\",\"color\":"&color&",\"width\":"&numbers.roundtrip(missing_qed.width)&",\"height\":"&numbers.roundtrip(missing_qed.height)
                    .buffer:commands.append(buffer,draw_owner(node), -1,hole_value,0, -missing_qed.height)
                ready.(node):true
                @>
            kind="arrow" /\ ~arrow_measured.(node)?
                arrow_measured.(node):true
                arrow_sup:supers.(node)
                arrow_sub:subs.(node)
                arrow_style:3
                style<2? .arrow_style:2
                arrow_sup>=0?
                    copied_sup:math_arena_import.import_into(arena,arena,arrow_sup)
                    .arena:copied_sup.arena
                    arrow_first_sup.(node):copied_sup.root
                arrow_sub>=0?
                    copied_sub:math_arena_import.import_into(arena,arena,arrow_sub)
                    .arena:copied_sub.arena
                    arrow_first_sub.(node):copied_sub.root
                .top:top+1
                stack.(top):node
                phases.(top):0
                arrow_pass:0
                arrow_pass<2?>
                    first_label:arrow_first_sub.(node)
                    arrow_pass=1? .first_label:arrow_first_sup.(node)
                    first_label>=0?
                        .top:top+1
                        stack.(top):first_label
                        phases.(top): -1
                        pending_styles.(top):arrow_style
                        pending_fonts.(top):font
                        pending_colors.(top):color
                        pending_cramped.(top):false
                    .arrow_pass:arrow_pass+1
                .phase:0
                @>
            .top:top+1
            stack.(top):node
            phases.(top):1
            kind="list"?
                child_start:top+1
                child:firsts.(node)
                current_style:style
                current_color:color
                child>=0?>
                    child_kind:kinds.(child)
                    child_kind="tag"? tag_nodes.(child):true
                    table_cells.(node) /\ child_kind="tag"? skipped.(child):true
                    (child_kind="style" \/ child_kind="color")?
                        child_data:j.parse("{"&attrs.(child)&"}")
                        child_kind="style"? .current_style:int(glyphs.numeric(child_data,0,"style"))
                        child_kind="color"? .current_color:raw(child_data,"color")
                    (child_kind="style" \/ child_kind="color" \/ child_kind="label")? skipped.(child):true
                    ~skipped.(child)?
                        styles.(child):current_style
                        colors.(child):current_color
                        active_fonts.(child):font
                        cramped.(child):cramped.(node)
                        .top:top+1
                        stack.(top):child
                        phases.(top):0
                    .child:nexts.(child)
                left_index:child_start
                right_index:top
                left_index<right_index?>
                    saved:stack.(left_index)
                    stack.(left_index):stack.(right_index)
                    stack.(right_index):saved
                    .left_index:left_index+1
                    .right_index:right_index-1
                .phase:1
                @>
            kind="matrix"?
                matrix_name:glyphs.string(data,"name")
                .matrix_name:matrix_base(matrix_name)
                matrix_style:style
                style<1? .matrix_style:1
                tokens.one_of(matrix_name,["eqnarray","align","split","equation","multline","gather","gathered"])? .matrix_style:0
                tokens.one_of(matrix_name,["smallmatrix","substack","subarray"])? .matrix_style:2
                matrix_name="equation"?
                    label_row:firsts.(arguments.(node))
                    label_row>=0?>
                        label_cell:firsts.(label_row)
                        label_cell>=0?>
                            label_atom:firsts.(label_cell)
                            label_atom>=0?>
                                kinds.(label_atom)="label"?
                                    label_properties:j.parse("{"&attrs.(label_atom)&"}")
                                    .equation_refs:references.put(equation_refs,glyphs.string(label_properties,"key"),text.integer(equation_number))
                                .label_atom:nexts.(label_atom)
                            .label_cell:nexts.(label_cell)
                        .label_row:nexts.(label_row)
                matrix_start:top+1
                matrix_root:arguments.(node)
                matrix_row:firsts.(matrix_root)
                matrix_row>=0?>
                    matrix_column:0
                    matrix_cell:firsts.(matrix_row)
                    matrix_cell>=0?>
                        table_cells.(matrix_cell):matrix_name~="equation"
                        styles.(matrix_cell):matrix_style
                        colors.(matrix_cell):color
                        active_fonts.(matrix_cell):font
                        cramped.(matrix_cell):false
                        leading_anchor.(matrix_cell):tokens.one_of(matrix_name,["aligned","align","alignat","split"]) /\ matrix_column%2=1 /\ firsts.(matrix_cell)>=0
                        legacy_equation_anchor /\ matrix_name="equation" /\ glyphs.string(data,"name")="equation"? leading_anchor.(matrix_cell):true
                        trailing_anchor.(matrix_cell):matrix_name="eqnarray" /\ nexts.(matrix_row)>=0 /\ nexts.(matrix_cell)<0 /\ firsts.(matrix_cell)>=0
                        incomplete_cell.(matrix_cell):flag(data,"incomplete") /\ nexts.(matrix_row)<0 /\ nexts.(matrix_cell)<0 /\ firsts.(matrix_cell)<0
                        .top:top+1
                        stack.(top):matrix_cell
