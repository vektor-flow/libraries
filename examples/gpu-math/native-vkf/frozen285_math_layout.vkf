    paragraph_metadata:""
    scene.has_paragraph? .paragraph_metadata:",\"paragraphNodes\":"&paragraph_json(scene)
    @:"{\"width\":"&numbers.roundtrip(scene.width)&",\"height\":"&numbers.roundtrip(scene.height)&",\"depth\":"&numbers.roundtrip(scene.depth)&",\"items\":"&draw.items(scene)&",\"diagnostics\":["&scene.diagnostics&"],\"atoms\":"&text.integer(scene.atoms)&",\"complete\":"&complete&",\"nextEquationNumber\":"&text.integer(scene.next_equation_number)&",\"equationReferences\":"&scene.equation_references&row_metadata&paragraph_metadata&"}"

display_context(source:str,explicit:bit=false)->bit:
    explicit? @:true
    names:["eqnarray","align","equation","gather","multline"]
    index:0
    index<5?>
        prefix:"\\begin{"&names.(index)
        (text.find(source,prefix&"}")>=0 \/ text.find(source,prefix&"*}")>=0)? @:true
        .index:index+1
    @:false

typeset(source:str,fonts:Catalog,inline:bit=false,native:bit=true,display_environment:bit=false,equation_start:int=1,math_metrics:str="",display_width:num= -1,legacy_equation_anchor:bit=false)->str:
    @:json(layout(parser.parse(source,fonts,native),fonts,inline,native,display_context(source,display_environment),equation_start,false,"",math_metrics,display_width,legacy_equation_anchor))

typeset_with_context(source:str,fonts:Catalog,context:PackageContext,inline:bit=false,native:bit=true,display_environment:bit=false,equation_start:int=1,math_metrics:str="",display_width:num= -1,legacy_equation_anchor:bit=false)->str:
    @:json(layout(parser.parse_with_context(source,fonts,context,native),fonts,inline,native,display_context(source,display_environment),equation_start,false,"",math_metrics,display_width,legacy_equation_anchor,context.qed_symbol))
