# Compare direct output columns against the independent former Leaf-map path.
output:.document_materialize_output_typed
scene:.document_scene
scene_json:.document_scene_json
placement:.document_scene_pages
pages:.document_pages
Paint:(red:num,green:num,blue:num,alpha:num)
Payload:(crop_x:bit,crop_y:bit,crop_left:bit,crop_right:bit,crop_top:bit,crop_bottom:bit,left:num,right:num,top:num,bottom:num,dx:num,dy:num,c1x:num,c1y:num,c2x:num,c2y:num,line_width:num,fill:bit,fill_paint:int,stroke_paint:int,dash:int,target_type:int,target:str,border_width:num,asset:str)
Leaf:(kind:int,key:str,x:num,y:num,sx:num,sy:num,width:num,height:num,line:int,equation_tag:bit,tag_width:num,draw:bit,extra:str,flow_x:num,flow_width:num,has_flow:bit,vertical_shrink:num,vertical_stretch:num,paint:Paint,has_paint:bit,payload:Payload,has_payload:bit,fill_paint:Paint,has_fill_paint:bit,stroke_paint:Paint,has_stroke_paint:bit,destination_ids:[str],footnote_number:int)
same(a:Leaf,b:Leaf)->bit:
    (a.kind=b.kind)?! "bulk output kind"
    (a.key=b.key)?! "bulk output key"
    (a.x=b.x)?! "bulk output x"
    (a.y=b.y)?! "bulk output y"
    (a.sx=b.sx)?! "bulk output sx"
    (a.sy=b.sy)?! "bulk output sy"
    (a.width=b.width)?! "bulk output width"
    (a.height=b.height)?! "bulk output height"
    (a.line=b.line)?! "bulk output line"
    (a.equation_tag=b.equation_tag)?! "bulk output equation_tag"
    (a.tag_width=b.tag_width)?! "bulk output tag_width"
    (a.draw=b.draw)?! "bulk output draw"
    (a.extra=b.extra)?! "bulk output extra"
    (a.flow_x=b.flow_x)?! "bulk output flow_x"
    (a.flow_width=b.flow_width)?! "bulk output flow_width"
    (a.has_flow=b.has_flow)?! "bulk output has_flow"
    (a.vertical_shrink=b.vertical_shrink)?! "bulk output vertical_shrink"
    (a.vertical_stretch=b.vertical_stretch)?! "bulk output vertical_stretch"
    (a.has_paint=b.has_paint)?! "bulk output has_paint"
    (a.has_payload=b.has_payload)?! "bulk output has_payload"
    (a.has_fill_paint=b.has_fill_paint)?! "bulk output has_fill_paint"
    (a.has_stroke_paint=b.has_stroke_paint)?! "bulk output has_stroke_paint"
