    (a.paint.red=b.paint.red)?! "bulk output paint.red"
    (a.paint.green=b.paint.green)?! "bulk output paint.green"
    (a.paint.blue=b.paint.blue)?! "bulk output paint.blue"
    (a.paint.alpha=b.paint.alpha)?! "bulk output paint.alpha"
    (a.fill_paint.red=b.fill_paint.red)?! "bulk output fill_paint.red"
    (a.fill_paint.green=b.fill_paint.green)?! "bulk output fill_paint.green"
    (a.fill_paint.blue=b.fill_paint.blue)?! "bulk output fill_paint.blue"
    (a.fill_paint.alpha=b.fill_paint.alpha)?! "bulk output fill_paint.alpha"
    (a.stroke_paint.red=b.stroke_paint.red)?! "bulk output stroke_paint.red"
    (a.stroke_paint.green=b.stroke_paint.green)?! "bulk output stroke_paint.green"
    (a.stroke_paint.blue=b.stroke_paint.blue)?! "bulk output stroke_paint.blue"
    (a.stroke_paint.alpha=b.stroke_paint.alpha)?! "bulk output stroke_paint.alpha"
    (a.payload.crop_x=b.payload.crop_x)?! "bulk output payload.crop_x"
    (a.payload.crop_y=b.payload.crop_y)?! "bulk output payload.crop_y"
    (a.payload.crop_left=b.payload.crop_left)?! "bulk output payload.crop_left"
    (a.payload.crop_right=b.payload.crop_right)?! "bulk output payload.crop_right"
    (a.payload.crop_top=b.payload.crop_top)?! "bulk output payload.crop_top"
    (a.payload.crop_bottom=b.payload.crop_bottom)?! "bulk output payload.crop_bottom"
    (a.payload.left=b.payload.left)?! "bulk output payload.left"
    (a.payload.right=b.payload.right)?! "bulk output payload.right"
    (a.payload.top=b.payload.top)?! "bulk output payload.top"
    (a.payload.bottom=b.payload.bottom)?! "bulk output payload.bottom"
    (a.payload.dx=b.payload.dx)?! "bulk output payload.dx"
    (a.payload.dy=b.payload.dy)?! "bulk output payload.dy"
    (a.payload.c1x=b.payload.c1x)?! "bulk output payload.c1x"
    (a.payload.c1y=b.payload.c1y)?! "bulk output payload.c1y"
    (a.payload.c2x=b.payload.c2x)?! "bulk output payload.c2x"
    (a.payload.c2y=b.payload.c2y)?! "bulk output payload.c2y"
    (a.payload.line_width=b.payload.line_width)?! "bulk output payload.line_width"
    (a.payload.fill=b.payload.fill)?! "bulk output payload.fill"
    (a.payload.fill_paint=b.payload.fill_paint)?! "bulk output payload.fill_paint"
    (a.payload.stroke_paint=b.payload.stroke_paint)?! "bulk output payload.stroke_paint"
    (a.payload.dash=b.payload.dash)?! "bulk output payload.dash"
    (a.payload.target_type=b.payload.target_type)?! "bulk output payload.target_type"
    (a.payload.target=b.payload.target)?! "bulk output payload.target"
    (a.payload.border_width=b.payload.border_width)?! "bulk output payload.border_width"
    (a.payload.asset=b.payload.asset)?! "bulk output payload.asset"
    (a.destination_ids.length()=b.destination_ids.length())?! "bulk destination count"
    i:0
    i<a.destination_ids.length()?>
        (a.destination_ids.(i)=b.destination_ids.(i))?! "bulk destination order"
        .i:i+1
    @:true
renderer_tests()->bit:
