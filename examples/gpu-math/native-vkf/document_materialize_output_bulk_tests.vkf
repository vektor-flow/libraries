    arena:source.arena
    count:arena.count*4
    placed:pages.empty_placements(1)
    .placed:pages.append(placed,0,0,0,0,0,0,10,20,2,100,7,3,0.2,0.3)
    body:placement.index_flat(arena,[0],[arena.count],placed,[0],[0],1,1)
    [int] kinds:[0:count]
    [int] sources:[0:count]
    [int] leaves:[0:count]
    [int] placement_ids:[0:count]
    contexts:scene.strings(count)
    [num] label_ys:[0.0:count]
    [int] ordered:[0:count]
    [int] modes:[0:count]
    [bit] has_lines:[false:count]
    i:0
    i<count?>
        kinds.(i):i%4
        sources.(i):0
        i%4=0? sources.(i):i//4
        leaves.(i):i//4
        contexts.(i):"context"
        label_ys.(i):5
        ordered.(i):count-1-i
        .i:i+1
    refs:(kinds:kinds,source_ids:sources,leaf_ids:leaves,placement_ids:placement_ids,context_ids:contexts,label_ys:label_ys,ordered:ordered,firsts:[0],counts:[count],modes:modes,has_lines:has_lines,count:count)
    rules:(pages:[0],xs:[1.0],ys:[2.0],widths:[3.0],heights:[0.5],count:1)
    [int] indices:[0:count]
    expected_leaves:indices >> output.output_leaf(arena,arena,arena,[4.0],placed,rules,body,[0.0],refs,20,[5.0],[2.0],$0)
    expected:scene.from_leaves(expected_leaves,count)
    actual:output.output_arena(arena,arena,arena,[4.0],placed,rules,body,[0.0],refs,20,[5.0],[2.0],count)
    (actual.count=expected.count /\ actual.paint_count=expected.paint_count /\ actual.payload_count=expected.payload_count)?! "bulk table counts"
    .i:0
    i<count?>
        a:scene.leaf_at(actual,i)
        b:scene.leaf_at(expected,i)
        same(a,b)?! "all placed leaf metadata and ownership"
        .i:i+1
    @:true
renderer_tests()
