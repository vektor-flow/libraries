# Native development adapter; all parsing/serialization is shared VKF code.
io:.io
catalog:.font_catalog
parser:.math_parser

run()->int:
    font_path:io.read_line()
    source_path:io.read_line()
    output_path:io.read_line()
    native_mode:io.read_line()
    fonts:catalog.load(io.read_text(font_path))
    arena:parser.parse(io.read_text(source_path),fonts,native_mode~="preview")
    io.write_text(output_path,parser.json(arena))
    @:0
run()
