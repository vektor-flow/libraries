        scene:scenes.(sid)
        source:scene.arena
        firsts.(sid):count
        counts.(sid):source.count
        scene_widths.(sid):scene.width
        .count:count+source.count
        .paint_count:paint_count+source.paint_count
        .payload_count:payload_count+source.payload_count
        .destination_count:destination_count+source.destination_ids.length()
        .anchor_count:anchor_count+scene.anchor_count
        .sid:sid+1
    [int] kinds:[0:count]
    keys:document_scene.strings(count)
    [num] xs:[0.0:count]
    [num] ys:[0.0:count]
