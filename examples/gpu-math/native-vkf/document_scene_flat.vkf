            v_dys.(payload_at+i):payload_value.dy
            v_c1xs.(payload_at+i):payload_value.c1x
            v_c1ys.(payload_at+i):payload_value.c1y
            v_c2xs.(payload_at+i):payload_value.c2x
            v_c2ys.(payload_at+i):payload_value.c2y
            v_line_widths.(payload_at+i):payload_value.line_width
            v_fills.(payload_at+i):payload_value.fill
            v_fill_paints.(payload_at+i):payload_value.fill_paint
            payload_value.fill_paint>=0? v_fill_paints.(payload_at+i):payload_value.fill_paint+paint_at
            v_stroke_paints.(payload_at+i):payload_value.stroke_paint
            payload_value.stroke_paint>=0? v_stroke_paints.(payload_at+i):payload_value.stroke_paint+paint_at
            v_dashs.(payload_at+i):payload_value.dash
            v_target_types.(payload_at+i):payload_value.target_type
            v_targets.(payload_at+i):payload_value.target
            v_border_widths.(payload_at+i):payload_value.border_width
            v_assets.(payload_at+i):payload_value.asset
            .i:i+1
        .i:0
        i<source.destination_ids.length()?>
            destination_ids.(destination_at+i):source.destination_ids.(i)
            .i:i+1
        .i:0
        i<scene.anchor_count?>
            i<scene.anchor_roots.length()? anchor_roots.(anchor_at+i):meta.shift(scene.anchor_roots.(i),anchor_metadata_base)
            anchor_ids.(anchor_at+i):scene.anchor_ids.(i)
            anchor_xs.(anchor_at+i):scene.anchor_xs.(i)
            anchor_ys.(anchor_at+i):scene.anchor_ys.(i)
            anchor_lines.(anchor_at+i):scene.anchor_lines.(i)
            anchor_scenes.(anchor_at+i):sid
            .i:i+1
        .at:at+source.count
        .paint_at:paint_at+source.paint_count
        .payload_at:payload_at+source.payload_count
        .destination_at:destination_at+source.destination_ids.length()
        .anchor_at:anchor_at+scene.anchor_count
        .sid:sid+1
    paint_table:paints_range(p_reds,p_greens,p_blues,p_alphas,0,paint_count)
    payload_columns:(crop_xs:v_crop_xs,crop_ys:v_crop_ys,crop_lefts:v_crop_lefts,crop_rights:v_crop_rights,crop_tops:v_crop_tops,crop_bottoms:v_crop_bottoms,lefts:v_lefts,rights:v_rights,tops:v_tops,bottoms:v_bottoms,dxs:v_dxs,dys:v_dys,c1xs:v_c1xs,c1ys:v_c1ys,c2xs:v_c2xs,c2ys:v_c2ys,line_widths:v_line_widths,fills:v_fills,fill_paints:v_fill_paints,stroke_paints:v_stroke_paints,dashs:v_dashs,target_types:v_target_types,targets:v_targets,border_widths:v_border_widths,assets:v_assets)
    payload_table:payloads_range(payload_columns,0,payload_count)
