            a260_stops.(at+i):source.a260_stops.(i)
            a260_parts.(at+i):source.a260_parts.(i)
            .i:i+1
        .i:0
        i<source.paint_count?>
            paint_value:source.paint_table.(i)
            p_reds.(paint_at+i):paint_value.red
            p_greens.(paint_at+i):paint_value.green
            p_blues.(paint_at+i):paint_value.blue
            p_alphas.(paint_at+i):paint_value.alpha
            .i:i+1
        .i:0
        i<source.payload_count?>
            payload_value:source.payload_table.(i)
