            flow_xs.(at+i):source.flow_xs.(i)
            flow_widths.(at+i):source.flow_widths.(i)
            has_flows.(at+i):source.has_flows.(i)
            vertical_shrinks.(at+i):source.vertical_shrinks.(i)
            vertical_stretches.(at+i):source.vertical_stretches.(i)
            source.paints.(i)>=0? paints.(at+i):source.paints.(i)+paint_at
            source.payloads.(i)>=0? payloads.(at+i):source.payloads.(i)+payload_at
            destination_firsts.(at+i):source.destination_firsts.(i)+destination_at
            destination_counts.(at+i):source.destination_counts.(i)
            footnote_numbers.(at+i):source.footnote_numbers.(i)
            a260_scopes.(at+i):source.a260_scopes.(i)
            a260_texts.(at+i):source.a260_texts.(i)
            a260_operations.(at+i):source.a260_operations.(i)
