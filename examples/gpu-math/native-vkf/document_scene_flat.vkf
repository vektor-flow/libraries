Scene:(arena:Arena,anchor_ids:[str],anchor_xs:[num],anchor_ys:[num],anchor_lines:[int],anchor_metadata:Metadata,anchor_roots:[int],anchor_count:int,width:num,height:num,depth:num,tag_width:num,inline_destinations:bit)
Flat:(arena:Arena,firsts:[int],counts:[int],scene_widths:[num],scene_count:int,anchor_ids:[str],anchor_xs:[num],anchor_ys:[num],anchor_lines:[int],anchor_metadata:Metadata,anchor_roots:[int],anchor_scenes:[int],anchor_count:int)
build_paint(reds:[num],greens:[num],blues:[num],alphas:[num],index:int)->Paint:
    @:(red:reds.(index),green:greens.(index),blue:blues.(index),alpha:alphas.(index))
PayloadColumns:(crop_xs:[bit],crop_ys:[bit],crop_lefts:[bit],crop_rights:[bit],crop_tops:[bit],crop_bottoms:[bit],lefts:[num],rights:[num],tops:[num],bottoms:[num],dxs:[num],dys:[num],c1xs:[num],c1ys:[num],c2xs:[num],c2ys:[num],line_widths:[num],fills:[bit],fill_paints:[int],stroke_paints:[int],dashs:[int],target_types:[int],targets:[str],border_widths:[num],assets:[str])
# The VM currently reads bit columns as numeric slots. Return actual boolean
# literals so retained Payload records preserve the shared native/WASM schema.
payload_bit(value:bit)->bit:
    value? @:true
    @:false
build_payload(columns:PayloadColumns,index:int)->Payload:
    @:(crop_x:payload_bit(columns.crop_xs.(index)),crop_y:payload_bit(columns.crop_ys.(index)),crop_left:payload_bit(columns.crop_lefts.(index)),crop_right:payload_bit(columns.crop_rights.(index)),crop_top:payload_bit(columns.crop_tops.(index)),crop_bottom:payload_bit(columns.crop_bottoms.(index)),left:columns.lefts.(index),right:columns.rights.(index),top:columns.tops.(index),bottom:columns.bottoms.(index),dx:columns.dxs.(index),dy:columns.dys.(index),c1x:columns.c1xs.(index),c1y:columns.c1ys.(index),c2x:columns.c2xs.(index),c2y:columns.c2ys.(index),line_width:columns.line_widths.(index),fill:payload_bit(columns.fills.(index)),fill_paint:columns.fill_paints.(index),stroke_paint:columns.stroke_paints.(index),dash:columns.dashs.(index),target_type:columns.target_types.(index),target:columns.targets.(index),border_width:columns.border_widths.(index),asset:columns.assets.(index))
paints_range(reds:[num],greens:[num],blues:[num],alphas:[num],start:int,stop:int)->[Paint]:
    start=stop? @:[]
    stop-start=1?
        value:build_paint(reds,greens,blues,alphas,start)
        [Paint] one:[value]
        @:one
    middle:(start+stop)//2
    before:paints_range(reds,greens,blues,alphas,start,middle)
    after:paints_range(reds,greens,blues,alphas,middle,stop)
    @:before&after
payloads_range(columns:PayloadColumns,start:int,stop:int)->[Payload]:
    start=stop? @:[]
    stop-start=1?
        value:build_payload(columns,start)
        [Payload] one:[value]
        @:one
    middle:(start+stop)//2
    before:payloads_range(columns,start,middle)
    after:payloads_range(columns,middle,stop)
    @:before&after
flatten(scenes:[Scene])->Flat:
    scene_count:scenes.length()
    [int] firsts:[0:scene_count]
    [int] counts:[0:scene_count]
    [num] scene_widths:[0.0:scene_count]
    count:0
