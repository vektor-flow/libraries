    payload_at:0
    destination_at:0
    anchor_at:0
    .sid:0
    sid<scene_count?>
        scene:scenes.(sid)
        anchor_metadata_base:anchor_metadata.count
        .anchor_metadata:meta.append(anchor_metadata,scene.anchor_metadata)
        source:scene.arena
        metadata_base:metadata.count
        .metadata:meta.append(metadata,source.metadata)
        i:0
        i<source.count?>
            kinds.(at+i):source.kinds.(i)
            keys.(at+i):source.keys.(i)
            xs.(at+i):source.xs.(i)
            ys.(at+i):source.ys.(i)
            sxs.(at+i):source.sxs.(i)
